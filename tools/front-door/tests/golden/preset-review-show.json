            {
              "name": "reliability",
              "tier": "",
              "when": ""
            },
            {
              "name": "conventions-readability",
              "tier": "",
              "when": ""
            },
            {
              "name": "refactor-cleanup",
              "tier": "",
              "when": ""
            },
            {
              "name": "flexibility",
              "tier": "",
              "when": ""
            },
            {
              "name": "security-privacy",
              "tier": "",
              "when": "security"
            },
            {
              "name": "concurrency-data-errors",
              "tier": "",
              "when": "concurrency"
            },
            {
              "name": "adversarial",
              "tier": "",
              "when": "terminal"
            }
          ],
          "inherit_explicit": true,
          "type": "list"
        },
        "local_check_policy": {
          "default": "",
          "doc": "Local check policy inherited by nested presets; empty uses the layered roles library.",
          "inherit": true,
          "type": "string"
        },
        "min_reviews": {
          "default": 0,
          "doc": "Lenses that must succeed. Fewer fails the lens group, which stops the council for the chair to substitute a lens or decide. 0 takes the review ladder minimum for risk_tier, at least 1.",
          "max": 32,
          "min": 0,
          "type": "integer"
        },
        "review_shape": {
          "default": "",
          "doc": "Review depth override from routing review shapes (quick, standard, deep).",
          "type": "string"
        },
        "risk_tags": {
          "default": [],
          "doc": "Tags that trigger conditional lenses: security, concurrency, terminal.",
          "type": "list"
        },
        "risk_tier": {
          "bind": "risk_tier",
          "default": "",
          "doc": "Risk tier that selects the review shape.",
          "inherit": true,
          "type": "string"
        },
        "selection_range": {
          "default": "",
          "doc": "Optional Git range used to select lenses and shape; empty measures the subject against base.",
          "type": "string"
        },
        "size": {
          "default": "",
          "doc": "Review size override: small, medium, or large.",
          "type": "string"
        },
        "spec": {
          "default": "",
          "doc": "Issue number or file the change answers.",
          "type": "string"
        },
        "spec_max_bytes": {
          "default": 16384,
          "doc": "Maximum bytes of a file spec included in each review brief.",
          "max": 65536,
          "min": 1,
          "type": "integer"
        },
        "subject": {
          "default": {
            "commit": "HEAD",
            "type": "commit"
          },
          "doc": "Immutable review subject: a commit, a node or the integration head.",
          "inherit": true,
          "type": "table"
        },
        "verifier_tier": {
          "default": "verifier",
          "doc": "Route for the verifier. Define a route named verifier in another model family; without one the senior route is used and the substitution is recorded.",
          "type": "string"
        },
        "verifiers": {
          "default": 1,
          "doc": "Verifier stages between the lenses and the synthesis, preferably from another model family; 0 skips verification.",
          "max": 1,
          "min": 0,
          "type": "integer"
        },
        "worktree": {
          "default": "",
          "doc": "Worktree the reviewers may read.",
          "type": "string"
        }
      },
      "pattern": {
        "citations": [
          "Google engineering practices, code review",
          "Claude Code review and Bugbot vendor reports (vendor-reported)"
        ],
        "cost": "1 framing attempt + one attempt per selected lens + verifiers + 1 synthesis",
        "level": "default",
        "select_when": "A change needs review before it lands; depth follows the routing review shape.",
        "summary": "Independent lenses review one immutable subject; a verifier, preferably from another model family through configured routing, tries to falsify the findings; a senior synthesis reconciles them with a disposition per finding.",
        "tags": [
          "review"
        ]
      },
      "plan": {
        "by_size": true,
        "explicit": [
          "lenses"
        ],
        "guidance": "Each catalogue pattern is one lens the review panel allows for this subject. Instantiate the lenses the change needs, at most once each, and choose a tier for each: a lower tier for mechanical checks, a higher one where a miss would be costly. Always include the correctness lens. You cannot add a lens the catalogue does not list.",
        "patterns": [
          {
            "exports": [
              {
                "node": "lens",
                "outputs": [
                  "result",
                  "findings",
                  "verdict",
                  "commit"
                ]
              }
            ],
            "for_each": "lenses",
            "name": "lens-${item.name}",
            "nodes": [
              {
                "acceptance_checks": [
                  "Review the pinned commit through this lens only",
                  "End with one exact VERDICT line"
                ],
                "id": "lens",
                "require_findings": true,
                "role": "lens.${item.name}",
                "source": "${subject}",
                "tier": "${tier}"
              }
            ],
            "parameters": {
              "tier": {
                "default": "${item.tier}",
                "doc": "Route alias for the lens.",
                "enum": [
                  "junior",
                  "senior",
                  "principal"
                ],
                "type": "string"
              }
            }
          }
        ],
        "replaces": "lenses",
        "subject_types": [
          "commit"
        ]
      },
      "shape_stages": {
        "frame": "subject",
        "panel": "lenses",
        "synthesis": "synthesis",
        "verifier": "verify"
      },
      "stages": [
        {
          "id": "subject",
          "role": "plan.review"
        },
        {
          "id": "lenses",
          "min_successful": "${min_reviews}",
          "parallel": [
            {
              "for_each": "${lenses}",
              "id": "lens",
              "require_findings": true,
              "review_lenses": true,
              "role": "lens.${item.name}"
            }
          ],
          "source": {
            "node": "subject",
            "type": "node"
          }
        },
        {
          "count": "${verifiers}",
          "id": "verify",
          "role": "review.verify",
          "source": {
            "node": "subject",
            "type": "node"
          }
        },
        {
          "depends_on": [
            "lenses"
          ],
          "id": "synthesis",
          "role": "review.synthesis"
        }
      ]
    }
  },
  "error": null,
  "schema_version": 1,
  "status": "ok"
}
