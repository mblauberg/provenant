        }
      ],
      "parameters": {
        "base": {
          "default": "",
          "doc": "Diff reference the change is measured from, for example origin/main.",
          "type": "string"
        },
        "kind": {
          "bind": "kind",
          "default": "",
          "doc": "Change kind, for example refactor, integration, or docs.",
          "type": "string"
        },
        "lenses": {
          "default": [
            {
              "name": "correctness-spec",
              "tier": "",
              "when": ""
            },
            {
              "name": "tests",
              "tier": "",
