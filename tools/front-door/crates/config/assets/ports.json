{
  "schema_version": 3,
  "verify": {
    "source": "default",
    "backend": {
      "kind": "builtin"
    },
    "base": "",
    "workspace": ".",
    "remote": "origin",
    "load_per_cpu": 1.0,
    "package_paths": [],
    "quarantine_command": [],
    "tiers": {
      "0": {
        "commands": [
          {
            "stack": "rust",
            "cwd": ".",
            "argv": [
              "cargo",
              "fmt",
              "{packages}",
              "--",
              "--check"
            ]
          },
          {
            "stack": "rust",
            "cwd": ".",
            "argv": [
              "cargo",
              "check",
              "--locked",
              "{packages}"
            ]
          },
          {
            "stack": "rust",
            "cwd": ".",
            "argv": [
              "cargo",
              "nextest",
              "run",
              "--profile",
              "lane",
              "--locked",
              "{packages}",
              "--lib",
              "--bins"
            ]
          }
        ],
        "selection": "packages",
        "warn_for_host_load": false
      },
      "1": {
        "commands": [
          {
            "stack": "rust",
            "cwd": ".",
            "argv": [
              "cargo",
              "nextest",
              "run",
              "--profile",
              "lane",
              "--locked",
              "{integration_args}"
            ]
          }
        ],
        "selection": "integrations",
        "warn_for_host_load": false
      },
      "2": {
        "commands": [
          {
            "stack": "rust",
            "cwd": ".",
            "argv": [
              "cargo",
              "nextest",
              "run",
              "--profile",
              "ci",
              "--workspace",
              "--locked"
            ]
          }
        ],
        "selection": "all",
        "warn_for_host_load": true
      },
      "3": {
        "commands": [
          {
            "stack": "rust",
            "cwd": ".",
            "argv": [
              "cargo",
              "nextest",
              "run",
              "--profile",
              "ci",
              "--workspace",
              "--locked",
              "--stress-count",
              "20"
            ]
          }
        ],
        "selection": "all",
        "warn_for_host_load": true
      }
    },
    "integrations": [],
    "runners": {},
    "default_tier": "0",
    "affected": {
      "enabled": false,
      "global_paths": [],
      "full_every": 10,
      "full_after": "24h"
    }
  },
  "land": {
    "source": "default",
    "backend": {
      "kind": "builtin"
    }
  },
  "ci_observation": {
    "source": "default",
    "backend": {
      "kind": "builtin"
    }
  },
  "worktree_layout": {
    "source": "default",
    "backend": {
      "kind": "builtin"
    },
    "roots": [
      ".worktrees"
    ],
    "default": ".worktrees/<branch>"
  },
  "naming": {
    "source": "default",
    "backend": {
      "kind": "builtin"
    }
  },
  "post_create": {
    "source": "default",
    "backend": {
      "kind": "builtin"
    }
  },
  "tracker": {
    "source": "default",
    "backend": {
      "kind": "builtin"
    }
  },
  "release": {
    "source": "default",
    "backend": {
      "kind": "builtin"
    }
  },
  "admission": {
    "source": "default",
    "backend": {
      "kind": "builtin"
    }
  },
  "forge": {
    "source": "default",
    "backend": {
      "kind": "builtin"
    }
  },
  "build": {
    "source": "default",
    "prepare": [],
    "strategy": "slots",
    "offload": "auto",
    "overflow": "auto",
    "clean": "untracked",
    "stacks": [],
    "snapshot_retention": "7d",
    "priority": {
      "check": "interactive",
      "clippy": "interactive",
      "test": "test",
      "nextest": "test",
      "tier": "test",
      "gate": "train",
      "maintenance": "prewarm",
      "other": "interactive"
    },
    "queue_aging": "120s",
    "prewarm_budget": 1,
    "canary_every": "24h",
    "slot_idle": "7d",
    "soak": {
      "min_runs": 50,
      "min_days": 7,
      "interactive_wait_p95": "60s",
      "test_wait_p95": "300s",
      "rss_fraction": 0.75,
      "local_exception_fraction": 0.05,
      "churn_clean_fraction": 0.99
    }
  }
}
