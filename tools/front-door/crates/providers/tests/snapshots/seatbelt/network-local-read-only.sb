(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.securityd.xpc"))
(deny mach-lookup (global-name-prefix "com.apple.securityd") (global-name-prefix "com.apple.security.cloudkeychain") (global-name-prefix "com.apple.keychainsharing"))
(deny mach-lookup (require-all (global-name-prefix "com.apple.SecurityServer") (require-not (global-name "com.apple.SecurityServer"))))
(deny process-exec (literal "/usr/bin/security"))
