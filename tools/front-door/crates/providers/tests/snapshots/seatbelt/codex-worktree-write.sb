(version 1)
(deny default)

(deny file-link)
(allow file-read* (subpath "/System/Library"))
(allow file-read* (subpath "/usr/bin"))
(allow file-read* (subpath "/usr/lib"))
(allow file-read* (subpath "/usr/libexec"))
(allow file-read* (subpath "/bin"))
(allow file-read* file-test-existence file-map-executable
  (subpath "/System/Volumes/Preboot/Cryptexes/App/System")
  (subpath "/System/Volumes/Preboot/Cryptexes/Incoming/OS")
  (subpath "/System/Volumes/Preboot/Cryptexes/OS")
  (subpath "/System/Volumes/Preboot/Cryptexes/Rosetta")
  (subpath "/System/Cryptexes/App")
  (subpath "/System/Cryptexes/OS")
  (subpath "/System/Cryptexes/Rosetta"))
(allow file-read* file-test-existence
  (path-ancestors "/System/Volumes/Preboot/Cryptexes/App/System")
  (path-ancestors "/System/Volumes/Preboot/Cryptexes/Incoming/OS")
  (path-ancestors "/System/Volumes/Preboot/Cryptexes/OS")
  (path-ancestors "/System/Volumes/Preboot/Cryptexes/Rosetta")
  (path-ancestors "/System/Cryptexes/App")
  (path-ancestors "/System/Cryptexes/OS")
  (path-ancestors "/System/Cryptexes/Rosetta"))
(allow file-read* file-test-existence (literal "/"))
(allow file-map-executable
  (subpath "/Library/Apple/System/Library/Frameworks")
  (subpath "/Library/Apple/System/Library/PrivateFrameworks")
  (subpath "/Library/Apple/usr/lib")
  (subpath "/System/Library/Extensions")
  (subpath "/System/Library/Frameworks")
  (subpath "/System/Library/PrivateFrameworks")
  (subpath "/System/Library/SubFrameworks")
  (subpath "/System/iOSSupport/System/Library/Frameworks")
  (subpath "/System/iOSSupport/System/Library/PrivateFrameworks")
  (subpath "/System/iOSSupport/System/Library/SubFrameworks")
  (subpath "/System/iOSSupport/usr/lib")
  (subpath "/usr/lib"))
(allow syscall-unix
  (syscall-number SYS___mac_syscall)
  (syscall-number SYS_getfsstat SYS_getfsstat64)
  (syscall-number SYS_map_with_linking_np)
  (syscall-number SYS_open SYS_openat)
  (syscall-number SYS_fstatat SYS_fstatat64)
  (syscall-number SYS_dup))
(allow system-fcntl
  (fcntl-command F_ADDFILESIGS_RETURN F_CHECK_LV F_GETPATH))
(with-filter (mac-policy-name "Sandbox")
  (allow system-mac-syscall (mac-syscall-number 2)))
(allow sysctl-read)
(allow file-read-metadata)
(allow ipc-posix-shm-read* (ipc-posix-name-prefix "apple.cfprefs."))
(allow mach-lookup
  (global-name "com.apple.cfprefsd.agent")
  (global-name "com.apple.cfprefsd.daemon")
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.trustd")
  (global-name "com.apple.trustd.agent")
  (global-name "com.apple.ocspd")
  (global-name "com.apple.SystemConfiguration.configd")
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.networkd"))
(allow network-outbound (remote unix-socket (path-literal "/private/var/run/mDNSResponder")))
(allow file-read* file-write-data (literal "/dev/null"))
(allow file-read* (literal "/dev/urandom") (literal "/dev/random"))
(allow file-read* (literal "/dev/fd"))
(allow file-read* (subpath "/usr/share") (subpath "/private/var/db/timezone") (literal "/private/etc/localtime"))
(allow file-read* (subpath "/fixture/repo"))
(allow file-read* (subpath "/fixture/worktrees/lane"))
(allow file-read* (subpath "/opt/homebrew/Cellar/provider/1.0"))
(allow file-read* (subpath "/fixture/home/.cargo"))
(allow file-read* (subpath "/fixture/home/.rustup"))
(allow file-read* (literal "/fixture/provenant/bin/provenant"))
(allow file-read* (literal "/fixture/git/bin/git"))
(allow file-read* (literal "/fixture/provenant/release.json"))
(allow file-read* (literal "/fixture/state/config.toml"))
(allow file-read* (literal "/fixture/state/host-id"))
(allow file-read* (subpath "/fixture/state/projects"))
(allow file-read* (literal "/fixture/state/fabric/fabric.sqlite3"))
(allow file-read* (literal "/fixture/state/fabric/fabric.sqlite3-wal"))
(allow file-read* (literal "/fixture/state/fabric/fabric.sqlite3-shm"))
(allow file-read* (literal "/fixture/state/fabric/fabric.sqlite3-journal"))
(allow file-read* (literal "/opt/homebrew/Cellar/provider/1.0/bin/provider"))
(allow file-read* (literal "/fixture/provenant/bin/provenant"))
(allow file-read* (literal "/fixture/git/bin/git"))
(allow file-read* (literal "/bin/sh"))
(allow file-read* (literal "/fixture/git/bin/git"))
(allow file-read* (literal "/fixture/home/.codex/auth.json"))
(allow process-exec (literal "/opt/homebrew/Cellar/provider/1.0/bin/provider"))
(allow process-exec (literal "/fixture/provenant/bin/provenant"))
(allow process-exec (literal "/fixture/git/bin/git"))
(allow process-exec (literal "/bin/sh"))
(allow process-exec (literal "/fixture/git/bin/git"))
(allow process-exec (subpath "/bin"))
(allow process-exec (subpath "/usr/bin"))
(allow process-exec (subpath "/usr/libexec"))
(allow process-exec (subpath "/opt/homebrew/Cellar/provider/1.0"))
(allow process-exec (subpath "/fixture/home/Library/Caches/provenant-lane-cargo/fixture"))
(allow process-exec (subpath "/fixture/home/.cargo/bin"))
(allow process-exec (subpath "/fixture/home/.rustup/toolchains"))
(allow process-exec (subpath "/fixture/repo"))
(allow process-exec (subpath "/fixture/scratch/bin"))
(allow process-exec (subpath "/fixture/scratch"))
(allow signal (target children))
(allow file-read* (subpath "/dev/fd"))
(allow process-fork)
(allow file-read* (subpath "/fixture/state/children/attempt"))
(allow file-write* (subpath "/fixture/state/children/attempt"))
(allow file-write-data (literal "/fixture/home/.codex/auth.json"))
(allow file-read* (subpath "/fixture/scratch"))
(allow file-write* (subpath "/fixture/scratch"))
(allow file-read* (subpath "/fixture/provider-state"))
(allow file-write* (subpath "/fixture/provider-state"))
(deny file-write-create (require-all (vnode-type SYMLINK) (subpath "/fixture/state/children/attempt")))
(deny file-write-create (require-all (vnode-type SYMLINK) (subpath "/fixture/provider-state")))
(deny file-write-create (require-all (vnode-type SYMLINK) (subpath "/fixture/scratch/git-objects")))
(allow file-read* (subpath "/fixture/repo/.git/worktrees/lane") (subpath "/fixture/repo/.git"))
(allow file-write* (require-all (subpath "/fixture/worktrees/lane") (require-not (subpath "/fixture/repo/.git/worktrees/lane")) (require-not (subpath "/fixture/repo/.git"))))
(deny file-write* (subpath "/fixture/repo/.git"))
(deny file-write* (subpath "/fixture/repo/.git/worktrees/lane"))
(allow file-read* (subpath "/fixture/home/Library/Caches/provenant-lane-cargo/fixture"))
(allow file-write* (subpath "/fixture/home/Library/Caches/provenant-lane-cargo/fixture"))
(allow file-read* (literal "/fixture/host/fabric-relay.sock"))
(allow network-outbound (remote unix-socket (path-literal "/fixture/host/fabric-relay.sock")))
(allow network-outbound (remote tcp "*:443"))
(deny file-read* (subpath "/fixture/home/.ssh"))
(deny file-write* (subpath "/fixture/home/.ssh"))
(deny file-read* (subpath "/fixture/home/.aws"))
(deny file-write* (subpath "/fixture/home/.aws"))
(deny file-read* (subpath "/fixture/home/.azure"))
(deny file-write* (subpath "/fixture/home/.azure"))
(deny file-read* (subpath "/fixture/home/.gnupg"))
(deny file-write* (subpath "/fixture/home/.gnupg"))
(deny file-read* (subpath "/fixture/home/.config/gh"))
(deny file-write* (subpath "/fixture/home/.config/gh"))
(deny file-read* (subpath "/fixture/home/Library/Application Support/GitHub CLI"))
(deny file-write* (subpath "/fixture/home/Library/Application Support/GitHub CLI"))
(deny file-read* (subpath "/fixture/home/.kube"))
(deny file-write* (subpath "/fixture/home/.kube"))
(deny file-read* (subpath "/fixture/home/.secrets"))
(deny file-write* (subpath "/fixture/home/.secrets"))
(deny file-read* (subpath "/fixture/home/Monero"))
(deny file-write* (subpath "/fixture/home/Monero"))
(deny file-read* (subpath "/fixture/home/Archives/git-preservation"))
(deny file-write* (subpath "/fixture/home/Archives/git-preservation"))
(deny file-read* (literal "/fixture/home/.cargo/credentials"))
(deny file-write* (literal "/fixture/home/.cargo/credentials"))
(deny file-read* (literal "/fixture/home/.cargo/credentials.toml"))
(deny file-write* (literal "/fixture/home/.cargo/credentials.toml"))
(deny file-write* (literal "/fixture/worktrees/lane/.git"))
