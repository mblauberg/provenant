(deny file-write* (subpath "/fixture/home/.azure"))
(deny process-exec (subpath "/fixture/home/.azure"))
(deny file-read* (subpath "/fixture/home/.gnupg"))
(deny file-write* (subpath "/fixture/home/.gnupg"))
(deny process-exec (subpath "/fixture/home/.gnupg"))
(deny file-read* (subpath "/fixture/home/.kube"))
(deny file-write* (subpath "/fixture/home/.kube"))
(deny process-exec (subpath "/fixture/home/.kube"))
(deny file-read* (subpath "/fixture/home/.secrets"))
(deny file-write* (subpath "/fixture/home/.secrets"))
(deny process-exec (subpath "/fixture/home/.secrets"))
(deny file-read* (subpath "/fixture/home/.codex"))
(deny file-write* (subpath "/fixture/home/.codex"))
(deny process-exec (subpath "/fixture/home/.codex"))
(deny file-read* (subpath "/fixture/home/.claude"))
(deny file-write* (subpath "/fixture/home/.claude"))
(deny process-exec (subpath "/fixture/home/.claude"))
(deny file-read* (subpath "/fixture/home/.cursor"))
(deny file-write* (subpath "/fixture/home/.cursor"))
(deny process-exec (subpath "/fixture/home/.cursor"))
(deny file-read* (subpath "/fixture/home/.gemini"))
(deny file-write* (subpath "/fixture/home/.gemini"))
(deny process-exec (subpath "/fixture/home/.gemini"))
(deny file-read* (subpath "/fixture/home/Monero"))
(deny file-write* (subpath "/fixture/home/Monero"))
(deny process-exec (subpath "/fixture/home/Monero"))
(deny file-read* (subpath "/fixture/home/.config/gh"))
(deny file-write* (subpath "/fixture/home/.config/gh"))
(deny process-exec (subpath "/fixture/home/.config/gh"))
(deny file-read* (subpath "/fixture/home/.config/gcloud"))
(deny file-write* (subpath "/fixture/home/.config/gcloud"))
(deny process-exec (subpath "/fixture/home/.config/gcloud"))
(deny file-read* (subpath "/fixture/home/Library/Keychains"))
(deny file-write* (subpath "/fixture/home/Library/Keychains"))
(deny process-exec (subpath "/fixture/home/Library/Keychains"))
(deny file-read* (subpath "/fixture/home/Archives/git-preservation"))
(deny file-write* (subpath "/fixture/home/Archives/git-preservation"))
(deny process-exec (subpath "/fixture/home/Archives/git-preservation"))
(deny file-read* (subpath "/fixture/home/Library/Application Support/GitHub CLI"))
(deny file-write* (subpath "/fixture/home/Library/Application Support/GitHub CLI"))
(deny process-exec (subpath "/fixture/home/Library/Application Support/GitHub CLI"))
(deny file-read* (subpath "/fixture/home/.config/cursor"))
(deny file-write* (subpath "/fixture/home/.config/cursor"))
(deny process-exec (subpath "/fixture/home/.config/cursor"))
(deny file-read* (subpath "/fixture/home/.config/opencode"))
(deny file-write* (subpath "/fixture/home/.config/opencode"))
(deny process-exec (subpath "/fixture/home/.config/opencode"))
(deny file-read* (subpath "/fixture/home/.local/share/opencode"))
(deny file-write* (subpath "/fixture/home/.local/share/opencode"))
(deny process-exec (subpath "/fixture/home/.local/share/opencode"))
