{
  "$id": "https://provenant.dev/schemas/v1/error.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A refused or failed command: `error` is set.",
  "properties": {
    "command": {
      "type": "string"
    },
    "data": {},
    "error": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string"
        },
        "cause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "repair": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "cause",
        "repair"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "failed",
        "refused",
        "invalid",
        "error",
        "unavailable",
        "timeout",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "command",
    "status",
    "data",
    "error"
  ],
  "title": "provenant error envelope",
  "type": "object"
}
