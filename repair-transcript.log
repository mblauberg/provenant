   135	def _plan(
   136	    managed_catalogue: dict[str, Path],
   137	    custom_catalogue: dict[str, Path],
   138	    target: Path,
   139	    manifest: dict[str, Any],
   140	    *,
   141	    custom_source_provided: bool,
   142	) -> list[dict[str, str]]:
   143	    managed = manifest["managed"]
   144	    custom = manifest["custom"]
   145	    items: list[dict[str, str]] = []
   146	    for name, source_path in managed_catalogue.items():
   147	        if not custom_source_provided and name in custom:
   148	            continue
   149	        destination = target / name
   150	        entry = managed.get(name)
   151	        if entry is None:
   152	            previous_custom = custom.get(name)
   153	            if previous_custom is not None and name not in custom_catalogue:
   154	                if _same_link(
   155	                    destination, Path(previous_custom["source_target"])
   156	                ):
   157	                    state = "custom-to-managed"
   158	                elif destination.exists() or destination.is_symlink():
   159	                    state = "conflicting"
   160	                else:
   161	                    state = "missing"
   162	            else:
   163	                state = (
   164	                    "unmanaged"
   165	                    if destination.exists() or destination.is_symlink()
   166	                    else "missing"
   167	                )
   168	        elif _same_link(destination, source_path):
   169	            state = "managed" if entry.get("source_sha256") == _sha_skill(source_path) else "stale"
   170	        elif destination.is_symlink() and not destination.exists():
   171	            state = "stale"
   172	        elif not destination.exists() and not destination.is_symlink():
   173	            state = "stale"
   174	        else:
   175	            state = "conflicting"
   176	        items.append({"name": name, "state": state})
   177	    for name in sorted(
   178	        set(managed) - set(managed_catalogue) - set(custom_catalogue)
   179	    ):
   180	        destination = target / name
   181	        if _same_link(destination, Path(managed[name].get("source_target", "/missing"))):
   182	            state = "retired-managed"
   183	        elif not destination.exists() and not destination.is_symlink():
   184	            state = "retired-missing"
   185	        else:
   186	            state = "conflicting"
   187	        items.append({"name": name, "state": state})
   188	    for name, source_path in custom_catalogue.items():
   189	        destination = target / name
   190	        entry = custom.get(name)
   191	        if entry is None:
   192	            previous_managed = managed.get(name)
   193	            if previous_managed is not None and name not in managed_catalogue:
   194	                if _same_link(
   195	                    destination, Path(previous_managed["source_target"])
   196	                ):
   197	                    state = "managed-to-custom"
   198	                else:
   199	                    state = "conflicting"
   200	            elif _same_link(destination, source_path):
   201	                state = "custom-untracked"
   202	            elif destination.exists() or destination.is_symlink():
   203	                state = "conflicting"
   204	            else:
   205	                state = "custom-missing"
   206	        else:
   207	            recorded_source = Path(entry["source_target"])
   208	            if recorded_source.resolve() != source_path:
   209	                state = (
   210	                    "custom-rebind"
   211	                    if _same_link(destination, recorded_source)
   212	                    else "custom-conflicting"
   213	                )
   214	            else:
   215	                state = (
   216	                    "custom"
   217	                    if _same_link(destination, source_path)
   218	                    else "custom-conflicting"
   219	                )
   220	        items.append({"name": name, "state": state})
   221	    if custom_source_provided:
   222	        for name in sorted(
   223	            set(custom) - set(custom_catalogue) - set(managed_catalogue)
   224	        ):
   225	            destination = target / name
   226	            old_source = Path(custom[name]["source_target"])
   227	            state = (
   228	                "custom-retired"
   229	                if _same_link(destination, old_source)
   230	                else "custom-retired-missing"
   231	                if not destination.exists() and not destination.is_symlink()
