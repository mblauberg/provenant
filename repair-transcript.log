   197	def install(target: Path) -> tuple[int, int, list[str]]:
   198	    target = target.resolve()
   199	    sources = _sources()
   200	    manifest = _load_manifest(target)
   201	    states: dict[str, str] = {}
   202	    for name, source in sources.items():
   203	        destination = target / name
   204	        states[name] = _state(destination, source, manifest["managed"].get(name))
   205	    conflicts = [name for name, state in states.items() if state == "conflicting"]
   206	    for name in sorted(set(manifest["managed"]) - set(sources)):
   207	        destination = target / name
   208	        recorded_source = Path(manifest["managed"][name]["source_target"])
   209	        if (
   210	            destination.exists() or destination.is_symlink()
   211	        ) and not _same_link(destination, recorded_source):
   212	            conflicts.append(name)
   213	    if conflicts:
   214	        raise InstallError("conflicting managed targets: " + ", ".join(conflicts))
   215	
   216	    target.mkdir(parents=True, exist_ok=True)
   217	    newly_managed = [name for name, state in states.items() if state == "missing"]
   218	    for name in newly_managed:
   219	        manifest["managed"][name] = _entry(sources[name])
   220	    if newly_managed:
   221	        # Persist ownership before publishing a new link. A hard interruption
   222	        # then leaves a managed missing/stale entry that the next run repairs,
   223	        # never an indistinguishable unmanaged link.
   224	        _write_manifest(target, manifest)
   225	
   226	    linked = 0
   227	    for name, source in sources.items():
   228	        destination = target / name
   229	        if states[name] in {"missing", "stale"}:
   230	            _replace_link(destination, source)
   231	            manifest["managed"][name] = _entry(source)
   232	            linked += 1
   233	    for name in sorted(set(manifest["managed"]) - set(sources)):
   234	        destination = target / name
   235	        if destination.is_symlink():
   236	            destination.unlink()
   237	        del manifest["managed"][name]
   238	        linked += 1
   239	    _write_manifest(target, manifest)
   240	    failures = []
   241	    for name, source in sources.items():
   242	        if states[name] == "unmanaged":
   243	            failures.append(f"{name}=unmanaged")
   244	            continue
   245	        integrity = _integrity_state(target / name, source)
   246	        if integrity != "present":
   247	            failures.append(f"{name}={integrity}")
   248	    return linked, len(sources) - linked, failures
