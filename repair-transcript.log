   115	def _replace_link(destination: Path, source: Path) -> None:
   116	    """Publish one staged link; the temporary path stays on the target filesystem."""
   117	    temporary: Path | None = None
   118	    try:
   119	        descriptor, raw_path = tempfile.mkstemp(
   120	            dir=destination.parent,
   121	            prefix=f".{destination.name}.",
   122	            suffix=".tmp",
   123	        )
   124	        os.close(descriptor)
   125	        temporary = Path(raw_path)
   126	        temporary.unlink()
   127	        temporary.symlink_to(source)
   128	        os.replace(temporary, destination)
   129	        temporary = None
   130	    finally:
   131	        if temporary is not None:
   132	            temporary.unlink(missing_ok=True)
