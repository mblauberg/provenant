     1	"""Managed-link mechanics for root-level Claude agent definitions."""
     2	
     3	from __future__ import annotations
     4	
     5	from datetime import datetime, timezone
     6	import hashlib
     7	import json
     8	import os
     9	from pathlib import Path
    10	import re
    11	import sys
    12	import tempfile
    13	from typing import Any
    14	
    15	
    16	MANIFEST_NAME = ".agent-harness-agents-installation.json"
    17	AGENT_NAME = re.compile(r"^[a-z0-9][a-z0-9-]*\.md$")
    18	
    19	
    20	class InstallError(ValueError):
    21	    pass
    22	
    23	
    24	def _now() -> str:
    25	    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(
    26	        "+00:00", "Z"
    27	    )
    28	
    29	
    30	def _sha256(path: Path) -> str:
    31	    return hashlib.sha256(path.read_bytes()).hexdigest()
    32	
    33	
    34	def _sources(source: Path) -> dict[str, Path]:
    35	    if source.is_symlink():
    36	        raise InstallError("source must not be a symlink")
    37	    if not source.is_dir():
    38	        raise InstallError("source must be an existing agent definition directory")
    39	    paths = sorted(source.glob("*.md"))
    40	    if not paths or any(
    41	        not AGENT_NAME.fullmatch(path.name)
    42	        or path.is_symlink()
    43	        or not path.is_file()
    44	        for path in paths
    45	    ):
    46	        raise InstallError("source contains an invalid agent definition")
    47	    return {path.name: path.resolve() for path in paths}
    48	
    49	
    50	def _manifest_path(target: Path) -> Path:
    51	    return target.parent / MANIFEST_NAME
    52	
    53	
    54	def _load_manifest(target: Path) -> dict[str, Any]:
    55	    path = _manifest_path(target)
    56	    if not path.exists():
    57	        return {
    58	            "schema_version": 1,
    59	            "owner": "agent-harness",
    60	            "surface": "claude-agents",
    61	            "target_root": str(target.resolve()),
    62	            "updated_at": _now(),
    63	            "managed": {},
    64	        }
    65	    try:
    66	        manifest = json.loads(path.read_text())
    67	    except (OSError, json.JSONDecodeError) as exc:
    68	        raise InstallError(f"agent installation manifest is unreadable: {exc}") from exc
    69	    if (
    70	        not isinstance(manifest, dict)
    71	        or manifest.get("schema_version") != 1
    72	        or manifest.get("owner") != "agent-harness"
    73	        or manifest.get("surface") != "claude-agents"
    74	        or manifest.get("target_root") != str(target.resolve())
    75	        or not isinstance(manifest.get("managed"), dict)
    76	    ):
    77	        raise InstallError("agent installation manifest is invalid")
    78	    required_entry = {
    79	        "owner",
    80	        "source_target",
    81	        "source_sha256",
    82	        "installed_at",
    83	    }
    84	    for name, entry in manifest["managed"].items():
    85	        if (
    86	            not isinstance(name, str)
    87	            or not AGENT_NAME.fullmatch(name)
    88	            or not isinstance(entry, dict)
    89	            or set(entry) != required_entry
    90	            or entry.get("owner") != "agent-harness"
    91	            or not isinstance(entry.get("source_target"), str)
    92	            or not Path(entry["source_target"]).is_absolute()
    93	            or not isinstance(entry.get("source_sha256"), str)
    94	            or not re.fullmatch(r"[0-9a-f]{64}", entry["source_sha256"])
    95	        ):
    96	            raise InstallError(f"agent installation manifest entry is invalid: {name}")
    97	    return manifest
    98	
    99	
   100	def _same_link(destination: Path, source: Path) -> bool:
   101	    if not destination.is_symlink():
   102	        return False
   103	    try:
   104	        return destination.resolve(strict=False) == source.resolve()
   105	    except (OSError, RuntimeError):
   106	        return False
   107	
   108	
   109	def _replace_link(destination: Path, source: Path) -> None:
   110	    descriptor, raw_path = tempfile.mkstemp(
   111	        dir=destination.parent,
   112	        prefix=f".{destination.name}.",
   113	        suffix=".tmp",
   114	    )
   115	    os.close(descriptor)
   116	    temporary = Path(raw_path)
   117	    try:
   118	        temporary.unlink()
   119	        temporary.symlink_to(source)
   120	        os.replace(temporary, destination)
   121	    finally:
   122	        temporary.unlink(missing_ok=True)
   123	
   124	
   125	def _write_manifest(target: Path, manifest: dict[str, Any]) -> None:
   126	    path = _manifest_path(target)
   127	    manifest["updated_at"] = _now()
   128	    descriptor, raw_path = tempfile.mkstemp(
   129	        dir=path.parent,
   130	        prefix=".agents-installation.",
   131	        suffix=".tmp",
   132	    )
   133	    temporary = Path(raw_path)
   134	    try:
   135	        with os.fdopen(descriptor, "w") as handle:
   136	            json.dump(manifest, handle, indent=2, sort_keys=True)
   137	            handle.write("\n")
   138	            handle.flush()
   139	            os.fsync(handle.fileno())
   140	        os.replace(temporary, path)
   141	    finally:
   142	        temporary.unlink(missing_ok=True)
   143	
   144	
   145	def _state(
   146	    destination: Path,
   147	    source: Path,
   148	    entry: dict[str, Any] | None,
   149	) -> str:
   150	    if entry is None:
   151	        return (
   152	            "unmanaged"
   153	            if destination.exists() or destination.is_symlink()
   154	            else "missing"
   155	        )
   156	    if _same_link(destination, source):
   157	        return (
   158	            "managed"
   159	            if Path(entry["source_target"]).resolve() == source.resolve()
   160	            and entry["source_sha256"] == _sha256(source)
   161	            else "stale"
   162	        )
   163	    if _same_link(destination, Path(entry["source_target"])):
   164	        return "stale"
   165	    if not destination.exists() and not destination.is_symlink():
   166	        return "stale"
   167	    return "conflicting"
   168	
   169	
   170	def _entry(source: Path) -> dict[str, str]:
   171	    return {
   172	        "owner": "agent-harness",
   173	        "source_target": str(source),
   174	        "source_sha256": _sha256(source),
   175	        "installed_at": _now(),
   176	    }
   177	
   178	
   179	def _integrity_state(destination: Path, source: Path) -> str:
   180	    if _same_link(destination, source):
   181	        return "present"
   182	    if not destination.exists() and not destination.is_symlink():
   183	        return "missing"
   184	    if destination.is_symlink():
   185	        return "foreign"
   186	    try:
   187	        return "present" if _sha256(destination) == _sha256(source) else "noncanonical"
   188	    except OSError:
   189	        return "noncanonical"
   190	
   191	
   192	def install(source: Path, target: Path) -> tuple[int, int, list[str]]:
   193	    if target.is_symlink():
   194	        raise InstallError("target must not be a symlink")
   195	    target = target.resolve()
   196	    sources = _sources(source)
   197	    manifest = _load_manifest(target)
   198	    states = {
   199	        name: _state(target / name, path, manifest["managed"].get(name))
   200	        for name, path in sources.items()
   201	    }
   202	    conflicts = [name for name, state in states.items() if state == "conflicting"]
   203	    for name in sorted(set(manifest["managed"]) - set(sources)):
   204	        destination = target / name
   205	        recorded_source = Path(manifest["managed"][name]["source_target"])
   206	        if (destination.exists() or destination.is_symlink()) and not _same_link(
   207	            destination, recorded_source
   208	        ):
   209	            conflicts.append(name)
   210	    if conflicts:
   211	        raise InstallError("conflicting managed targets: " + ", ".join(conflicts))
   212	
   213	    target.mkdir(parents=True, exist_ok=True)
   214	    newly_managed = [name for name, state in states.items() if state == "missing"]
   215	    manifest_changed = bool(newly_managed)
   216	    for name in newly_managed:
   217	        manifest["managed"][name] = _entry(sources[name])
   218	    if newly_managed:
   219	        _write_manifest(target, manifest)
   220	
   221	    linked = 0
   222	    for name, path in sources.items():
   223	        destination = target / name
   224	        if states[name] in {"missing", "stale"}:
   225	            _replace_link(destination, path)
   226	            manifest["managed"][name] = _entry(path)
   227	            manifest_changed = True
   228	            linked += 1
   229	    for name in sorted(set(manifest["managed"]) - set(sources)):
   230	        destination = target / name
   231	        if destination.is_symlink():
   232	            destination.unlink()
   233	        del manifest["managed"][name]
   234	        manifest_changed = True
   235	        linked += 1
   236	    if manifest_changed:
   237	        _write_manifest(target, manifest)
   238	
   239	    failures = []
   240	    for name, path in sources.items():
   241	        if states[name] == "unmanaged":
   242	            failures.append(f"{name}=unmanaged")
   243	            continue
   244	        integrity = _integrity_state(target / name, path)
   245	        if integrity != "present":
   246	            failures.append(f"{name}={integrity}")
   247	    return linked, len(sources) - linked, failures
   248	
   249	
   250	def check(source: Path, target: Path) -> list[str]:
   251	    if target.is_symlink():
   252	        raise InstallError("target must not be a symlink")
   253	    target = target.resolve()
   254	    sources = _sources(source)
   255	    manifest = _load_manifest(target)
   256	    failures = []
   257	    for name, path in sources.items():
   258	        entry = manifest["managed"].get(name)
   259	        state = _integrity_state(target / name, path)
   260	        if entry is None:
   261	            state = "unmanaged" if state != "missing" else "missing"
   262	        elif state == "present" and (
   263	            Path(entry["source_target"]).resolve() != path.resolve()
   264	            or entry["source_sha256"] != _sha256(path)
   265	        ):
   266	            state = "stale"
   267	        if state != "present":
   268	            failures.append(f"{name}={state}")
   269	    for name in sorted(set(manifest["managed"]) - set(sources)):
   270	        failures.append(f"{name}=retired")
   271	    return failures
   272	
   273	
   274	def plan(source: Path, target: Path) -> dict[str, str]:
   275	    sources = _sources(source)
   276	    if target.is_symlink():
   277	        try:
   278	            if target.resolve(strict=True) == source.resolve(strict=True):
   279	                return {}
   280	        except (OSError, RuntimeError):
   281	            pass
   282	        raise InstallError("target must not be a non-canonical symlink")
   283	    target = target.resolve()
   284	    manifest = _load_manifest(target)
   285	    states = {
   286	        name: _state(target / name, path, manifest["managed"].get(name))
   287	        for name, path in sources.items()
   288	    }
   289	    conflicts = [
   290	        name for name, state in states.items() if state in {"conflicting", "unmanaged"}
   291	    ]
   292	    for name in sorted(set(manifest["managed"]) - set(sources)):
   293	        destination = target / name
   294	        recorded_source = Path(manifest["managed"][name]["source_target"])
   295	        if (destination.exists() or destination.is_symlink()) and not _same_link(
   296	            destination, recorded_source
   297	        ):
   298	            conflicts.append(name)
   299	    if conflicts:
   300	        raise InstallError("conflicting agent targets: " + ", ".join(conflicts))
   301	    return states
   302	
   303	
   304	def run(action: str, source: Path, target: Path, summary: bool) -> int:
   305	    if action == "validate-sources":
   306	        sources = _sources(source)
   307	        if summary:
   308	            print(f"agents sources={len(sources)} source={source}")
   309	        else:
   310	            print(json.dumps({"schema_version": 1, "action": action, "items": [
   311	                {"name": name, "source": str(path)}
   312	                for name, path in sources.items()
   313	            ], "changed": []}, indent=2))
   314	        return 0
   315	    if action == "plan":
   316	        states = plan(source, target)
   317	        if summary:
   318	            print(f"agents planned={len(states)} target={target}")
   319	        else:
   320	            print(json.dumps({"schema_version": 1, "action": action, "items": [
   321	                {"name": name, "state": state}
   322	                for name, state in states.items()
   323	            ], "changed": []}, indent=2))
   324	        return 0
   325	    if action == "install":
   326	        linked, existing, failures = install(source, target)
   327	        print(f"agents linked={linked} existing={existing} target={target}")
   328	        if failures:
   329	            print(
   330	                "conflicting: agent installation integrity failed: "
   331	                + ", ".join(failures),
   332	                file=sys.stderr,
   333	            )
   334	            return 3
   335	        return 0
   336	    if action == "check":
   337	        failures = check(source, target)
   338	        print(f"agents checked={len(_sources(source))} target={target}")
   339	        if failures:
   340	            print(
   341	                "conflicting: agent installation integrity failed: "
   342	                + ", ".join(failures),
   343	                file=sys.stderr,
   344	            )
   345	            return 3
   346	        return 0
   347	    raise InstallError(f"unsupported agents action: {action}")
