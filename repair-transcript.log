   106	def _same_link(destination: Path, source: Path) -> bool:
   107	    if not destination.is_symlink():
   108	        return False
   109	    try:
   110	        return destination.resolve(strict=False) == source.resolve()
   111	    except (OSError, RuntimeError):
   112	        return False
