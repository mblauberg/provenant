    79	def test_agent_installer_preserves_an_unmanaged_definition(tmp_path):
    80	    target = tmp_path / "agents"
    81	    target.mkdir()
    82	    unmanaged = target / "codex-analyst.md"
    83	    original = b"# User-owned definition\n"
    84	    unmanaged.write_bytes(original)
    85	
    86	    result = run(target)
    87	
    88	    assert result.returncode == 3
    89	    assert unmanaged.read_bytes() == original
    90	    assert not unmanaged.is_symlink()
    91	    assert "codex-analyst.md=unmanaged" in result.stderr
    92	    manifest = json.loads((target.parent / MANIFEST_NAME).read_text())
    93	    assert "codex-analyst.md" not in manifest["managed"]
    94	    assert all(
    95	        (target / name).is_symlink()
    96	        for name in AGENT_NAMES - {"codex-analyst.md"}
    97	    )
