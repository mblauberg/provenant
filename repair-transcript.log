   648	    parser.add_argument("--custom-source", type=Path)
   649	    parser.add_argument("--renames", type=Path)
   650	    parser.add_argument("--summary", action="store_true")
   651	    args = parser.parse_args(argv)
   652	    if args.surface == "agents":
   653	        if agent_installation is None:
   654	            print("conflicting: agents installation mechanics are unavailable", file=sys.stderr)
   655	            return 3
   656	        try:
   657	            return agent_installation.run(
   658	                args.action, args.source, args.target, args.summary
   659	            )
   660	        except (OSError, agent_installation.InstallError) as exc:
   661	            print(f"conflicting: {exc}", file=sys.stderr)
   662	            return 3
   663	    try:
   664	        result = execute(
   665	            args.action,
   666	            args.source,
   667	            args.target,
   668	            args.renames,
   669	            args.custom_source,
   670	        )
   671	    except (OSError, InstallError) as exc:
   672	        print(f"conflicting: {exc}", file=sys.stderr)
   673	        return 3
   674	    if args.action == "check":
   675	        warnings = [item for item in result["items"] if item["scope"] == "extra" and item["state"] != "present"]
   676	        if warnings:
   677	            detail = ", ".join(f'{item["name"]}={item["state"]}' for item in warnings)
   678	            print(f"warning: unmanaged skill links outside catalogue: {detail}", file=sys.stderr)
   679	    if args.action == "check" and not result["ok"]:
   680	        print(json.dumps(result, indent=2))
   681	        custom_failures = [
   682	            item
   683	            for item in result["items"]
   684	            if item.get("owner") == "custom"
   685	            and item["scope"] == "required"
   686	            and item["state"] != "present"
   687	        ]
   688	        if custom_failures:
   689	            remedies = "; ".join(
   690	                "manually restore "
   691	                f"{item['name']} from {item['source_target']} "
   692	                "or provide --custom-source pointing to the intended custom skills directory"
   693	                for item in custom_failures
   694	            )
   695	            print(
   696	                f"conflicting: custom skill installation integrity failed: {remedies}",
   697	                file=sys.stderr,
   698	            )
   699	            return 3
   700	        failures = ", ".join(
   701	            f'{item["name"]}={item["state"]}'
   702	            for item in result["items"]
   703	            if item["scope"] == "required" and item["state"] != "present"
   704	        )
   705	        print(f"conflicting: skill installation integrity failed: {failures}", file=sys.stderr)
   706	        return 3
   707	    if args.summary:
   708	        if args.action == "check":
   709	            print(f"skills checked={len(result['items'])} target={args.target}")
   710	            return 0
   711	        linked = len(result["changed"])
   712	        existing = sum(
   713	            item["state"] in {"managed", "unmanaged", "custom"}
   714	            for item in result["items"]
   715	        ) - linked
   716	        print(f"skills linked={linked} existing={existing} target={args.target}")
   717	    else:
   718	        print(json.dumps(result, indent=2))
   719	    return 0
