   344	        not isinstance(item, dict)
   345	        or set(item) != {"from", "to"}
   346	        or not SKILL_NAME.fullmatch(str(item["from"]))
   347	        or not SKILL_NAME.fullmatch(str(item["to"]))
   348	        for item in renames
