    65	def _shared(source: Path) -> dict[str, Path]:
    66	    """Report shared libraries the skills import; they carry no SKILL.md."""
    67	    return {
    68	        name: (source / name).resolve()
    69	        for name in SHARED_NAMES
    70	        if (source / name).is_dir() and not (source / name).is_symlink()
    71	    }
