    40	def _skills(
    41	    source: Path,
    42	    *,
    43	    optional: bool = False,
    44	    validate_content: bool = True,
    45	) -> dict[str, Path]:
    46	    if not source.is_dir():
    47	        if optional and not source.exists() and not source.is_symlink():
    48	            return {}
    49	        raise InstallError("source must be an existing skill directory")
    50	    if validate_content:
    51	        for child in sorted(source.rglob("*")):
    52	            if child.is_symlink():
    53	                raise InstallError(
    54	                    f"skill source contains a symlink: {child.relative_to(source)}"
    55	                )
    56	    skills = {
    57	        path.parent.name: path.parent.resolve()
    58	        for path in sorted(source.glob("*/SKILL.md"))
    59	    }
    60	    if any(not SKILL_NAME.fullmatch(name) for name in skills):
    61	        raise InstallError("source contains an invalid skill name")
    62	    return skills
