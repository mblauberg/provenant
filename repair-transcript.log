    37	def test_agent_definitions_are_tracked_by_installer(tmp_path):
    38	    source = ROOT / "agents"
    39	    assert source.is_dir(), "repository-owned agent source directory is missing"
    40	    assert {path.name for path in source.glob("*.md")} == AGENT_NAMES
    41	
    42	    target = tmp_path / "agents"
    43	    result = run(target)
    44	
    45	    assert result.returncode == 0, result.stderr
    46	    assert {path.name for path in target.iterdir()} == AGENT_NAMES
    47	    assert all((target / name).is_symlink() for name in AGENT_NAMES)
    48	    assert all(
    49	        (target / name).resolve() == (source / name).resolve()
    50	        for name in AGENT_NAMES
    51	    )
    52	    manifest = json.loads((target.parent / MANIFEST_NAME).read_text())
    53	    assert set(manifest["managed"]) == AGENT_NAMES
    54	    assert {
    55	        name: hashlib.sha256((source / name).read_bytes()).hexdigest()
    56	        for name in AGENT_NAMES
    57	    } == AGENT_DIGESTS
