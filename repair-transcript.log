   135	def _plan(
   136	    managed_catalogue: dict[str, Path],
   137	    custom_catalogue: dict[str, Path],
   138	    target: Path,
   139	    manifest: dict[str, Any],
   140	    *,
   141	    custom_source_provided: bool,
   142	) -> list[dict[str, str]]:
   143	    managed = manifest["managed"]
   144	    custom = manifest["custom"]
   145	    items: list[dict[str, str]] = []
   146	    for name, source_path in managed_catalogue.items():
   147	        if not custom_source_provided and name in custom:
   148	            continue
   149	        destination = target / name
   150	        entry = managed.get(name)
   250	        if owner == "custom" and (
   251	            not source_path.is_dir()
   252	            or not (source_path / "SKILL.md").is_file()
   253	        ):
   254	            state = "missing-source"
   255	        elif _same_link(destination, source_path):
   256	            state = "present"
   257	        elif not destination.exists() and not destination.is_symlink():
   258	            state = "missing"
   259	        elif destination.is_symlink():
   260	            state = "foreign"
   261	        elif name in custom_catalogue:
   262	            state = "noncanonical"
   263	        else:
   264	            try:
   265	                state = "present" if _sha_skill(destination) == _sha_skill(source_path) else "noncanonical"
   266	            except (OSError, InstallError):
   267	                state = "noncanonical"
   268	        items.append(
   269	            {
   270	                "name": name,
   271	                "owner": owner,
   272	                "scope": "required",
   273	                "source_target": str(source_path),
   274	                "state": state,
   275	            }
   276	        )
   277	
   278	    if target.is_dir():
   279	        for destination in sorted(target.iterdir()):
   280	            name = destination.name
   281	            if name == ".DS_Store" or name in catalogue or not destination.is_symlink():
   282	                continue
   283	            try:
   284	                resolved = destination.resolve(strict=False)
   285	                if not any(
   286	                    resolved.is_relative_to(source_path.parent)
   287	                    for source_path in catalogue.values()
   288	                ):
   289	                    raise ValueError
   290	                state = "noncanonical"
   291	            except (OSError, ValueError):
   292	                state = "foreign"
   293	            items.append({"name": name, "scope": "extra", "state": state})
   294	    return items
