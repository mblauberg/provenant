    65	def instance_root_for(home: Path) -> Path:
    66	    """Where `install-harness` seeds the instance under a scratch HOME."""
    67	    return home / ".agents"
    68	
    69	
    70	def run(platform: str, home: Path, *arguments: str, **extra_env):
    71	    provider_bin = home / ".local" / "bin"
    72	    provider_bin.mkdir(parents=True, exist_ok=True)
    73	    for name in ("claude", "codex", "agy", "cursor-agent", "kiro-cli", "opencode"):
    74	        executable = provider_bin / name
    75	        if not executable.exists():
    76	            executable.write_text("#!/bin/sh\nexit 0\n")
    77	            executable.chmod(0o700)
    78	    python_shim = provider_bin / "python3"
    79	    python_shim.write_text(f"#!/bin/sh\nexec {sys.executable} \"$@\"\n")
    80	    python_shim.chmod(0o700)
    81	    env = os.environ.copy()
    82	    env.update({"HOME": str(home)})
    83	    # Keep the instance root deterministic in the scratch HOME. AGENTS_HOME now
    84	    # names only the product root, but an explicit instance value also keeps the
    85	    # test independent of any caller-provided instance selection.
    86	    env["AGENT_FABRIC_INSTANCE_ROOT"] = str(instance_root_for(home))
    87	    env["PROVENANT_ALLOW_LINKED_WORKTREE_INSTALL"] = "1"
    88	    env.update(extra_env)
    89	    env["PATH"] = f"{provider_bin}{os.pathsep}{env.get('PATH', os.environ.get('PATH', ''))}"
    90	    return subprocess.run(
    91	        [str(SCRIPT), "--platform", platform, *arguments],
    92	        cwd=ROOT,
    93	        env=env,
    94	        text=True,
