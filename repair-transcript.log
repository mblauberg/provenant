   251	def main(argv: list[str] | None = None) -> int:
   252	    parser = argparse.ArgumentParser(
   253	        prog="install-workflows",
   254	        usage="install-workflows --target <global-workflows-directory>",
   255	    )
   256	    parser.add_argument("--target", required=True, type=Path)
   257	    args = parser.parse_args(argv)
   258	    if args.target.is_symlink():
   259	        try:
   260	            canonical_directory_link = (
   261	                args.target.resolve(strict=True) == SOURCE.resolve(strict=True)
   262	            )
   263	        except (OSError, RuntimeError):
   264	            canonical_directory_link = False
   265	        if canonical_directory_link:
   266	            print(f"workflows existing=directory-link target={args.target}")
   267	            return 0
   268	    try:
   269	        linked, existing, failures = install(args.target)
   270	    except (OSError, InstallError) as exc:
   271	        print(f"conflicting: {exc}", file=sys.stderr)
   272	        return 3
   273	    print(f"workflows linked={linked} existing={existing} target={args.target}")
   274	    if failures:
   275	        print(
   276	            "conflicting: workflow installation integrity failed: "
   277	            + ", ".join(failures),
   278	            file=sys.stderr,
   279	        )
   280	        return 3
   281	    return 0
   282	
   283	
   284	if __name__ == "__main__":
   285	    raise SystemExit(main())
