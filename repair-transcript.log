    74	def _catalogues(
    75	    source: Path,
    76	    custom_source: Path | None = None,
    77	) -> tuple[dict[str, Path], dict[str, Path]]:
    78	    """Every directory a per-entry installation owns: skills and shared libraries.
    79	
    80	    A whole-directory projection exposes both without a manifest, so the
    81	    catalogue only drives per-entry layouts.
    82	    """
    83	    managed = {**_skills(source), **_shared(source)}
    84	    custom = (
    85	        _skills(custom_source, optional=True, validate_content=False)
    86	        if custom_source is not None
    87	        else {}
    88	    )
    89	    collisions = sorted(set(managed) & set(custom))
    90	    if collisions:
    91	        details = "; ".join(
    92	            f"{managed[name]} conflicts with {custom[name]}" for name in collisions
    93	        )
    94	        raise InstallError(f"skill source name collision: {details}")
    95	    return managed, custom
