   184	def _integrity_state(destination: Path, source: Path) -> str:
   185	    if _same_link(destination, source):
   186	        return "present"
   187	    if not destination.exists() and not destination.is_symlink():
   188	        return "missing"
   189	    if destination.is_symlink():
   190	        return "foreign"
   191	    try:
   192	        return "present" if _sha256(destination) == _sha256(source) else "noncanonical"
   193	    except OSError:
   194	        return "noncanonical"
   195	
