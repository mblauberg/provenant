   354	def _prepare_renames(
   355	    source: Path,
   356	    target: Path,
   357	    manifest: dict[str, Any],
   358	    renames: list[dict[str, str]],
   359	) -> list[dict[str, Any]]:
   360	    skills = _skills(source)
   361	    managed = manifest["managed"]
   362	    operations: list[dict[str, Any]] = []
   363	    # Several sources may converge on one target: only the first such rename
   364	    # creates the shared link, while all source history remains on the target.
   365	    creating: set[str] = set()
   366	    target_history: dict[str, list[dict[str, str]]] = {}
   367	    for rename in renames:
   368	        old, new = rename["from"], rename["to"]
   369	        if old not in managed or new not in skills:
   370	            continue
   371	        # A manifest-recorded custom name stays custom-owned even while its
   372	        # projected link is missing, so a managed rename may never claim it.
   373	        if new in manifest["custom"]:
   374	            raise InstallError(
   375	                f"managed rename target {new} is a recorded custom skill: "
   376	                f"manually restore {new} from "
   377	                f"{manifest['custom'][new]['source_target']} or retire the "
   378	                "custom record via --custom-source before renaming onto it"
   379	            )
   380	        old_destination = target / old
   381	        new_destination = target / new
   382	        old_source = Path(managed[old]["source_target"])
   383	        if (old_destination.exists() or old_destination.is_symlink()) and not _same_link(old_destination, old_source):
   384	            raise InstallError(f"conflicting managed rename source: {old}")
   385	        new_is_correct = _same_link(new_destination, skills[new])
   386	        if (new_destination.exists() or new_destination.is_symlink()) and not new_is_correct:
   387	            raise InstallError(f"conflicting rename target: {new}")
   388	        if new_is_correct and new in managed and Path(managed[new]["source_target"]).resolve() != skills[new]:
   389	            raise InstallError(f"conflicting managed rename target: {new}")
   390	        if new not in target_history:
   391	            target_history[new] = list(managed.get(new, {}).get("history", []))
   392	        target_history[new].extend(managed.get(old, {}).get("history", []))
   393	        target_history[new].append({"from": old, "to": new, "at": _now()})
   394	        create_new = not new_is_correct and new not in creating
   395	        if create_new:
   396	            creating.add(new)
   397	        operations.append({
   398	            "old": old,
   399	            "new": new,
   400	            "old_destination": old_destination,
   401	            "old_source": old_source,
   402	            "new_destination": new_destination,
   403	            "new_source": skills[new],
   404	            "create_new": create_new,
   405	            "manage_new": new in managed or new in creating,
   406	            "entry": _entry(new, skills[new], list(target_history[new])),
   407	            "old_entry": managed[old],  # Store for potential rollback
   408	        })
   409	    return operations
