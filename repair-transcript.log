    60	def test_agent_installer_is_idempotent_and_manifest_stable(tmp_path):
    61	    target = tmp_path / "agents"
    62	    first = run(target)
    63	    assert first.returncode == 0, first.stderr
    64	    before_manifest = (target.parent / MANIFEST_NAME).read_bytes()
    65	    before_links = {
    66	        path.name: path.lstat().st_mtime_ns for path in target.iterdir()
    67	    }
    68	
    69	    second = run(target)
    70	
    71	    assert second.returncode == 0, second.stderr
    72	    assert "agents linked=0 existing=3" in second.stdout
    73	    assert (target.parent / MANIFEST_NAME).read_bytes() == before_manifest
    74	    assert {
    75	        path.name: path.lstat().st_mtime_ns for path in target.iterdir()
    76	    } == before_links
