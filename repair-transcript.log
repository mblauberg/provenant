   301	def _raise_on_conflicts(
   302	    items: list[dict[str, str]],
   303	    manifest: dict[str, Any],
   304	    target: Path,
   305	    *,
   306	    excluded_names: set[str],
   307	) -> None:
   308	    custom_conflicts = [
   309	        item["name"]
   310	        for item in items
   311	        if item["state"] == "custom-conflicting"
   312	        and item["name"] not in excluded_names
   313	    ]
   314	    if custom_conflicts:
   315	        remedies = "; ".join(
   316	            "manually restore "
   317	            f"{name} from {manifest['custom'][name]['source_target']} "
   318	            "or provide --custom-source pointing to the intended custom skills directory"
   319	            for name in custom_conflicts
   320	        )
   321	        raise InstallError(f"custom targets changed outside harness: {remedies}")
   322	    conflicts = [
   323	        item["name"]
   324	        for item in items
   325	        if item["state"] == "conflicting"
   326	        and item["name"] not in excluded_names
   327	    ]
   328	    if conflicts:
   329	        raise InstallError(
   330	            "conflicting managed targets changed outside harness: "
   620	        "action": action,
   621	        "items": _plan(
   622	            managed_catalogue,
   623	            custom_catalogue,
   624	            target,
   625	            manifest,
   626	            custom_source_provided=custom_source_provided,
   627	        ),
   628	        "changed": changed,
   629	    }
