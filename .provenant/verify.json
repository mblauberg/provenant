{
  "integrations": [
    {
      "paths": [
        "tools/front-door/src/build_slot.rs",
        "tools/front-door/tests/build_slot.rs",
        "tools/front-door/crates/os/src/build_slots.rs"
      ],
      "package": "provenant",
      "binary": "build_slot"
    },
    {
      "paths": [
        "tools/front-door/crates/cli/src/run/*",
        "tools/front-door/tests/dispatch_provider.rs"
      ],
      "package": "provenant",
      "binary": "dispatch_provider"
    }
  ],
  "runners": {
    "ci": [
      "scripts/verify-ci-runner",
      "{commit}",
      "{tier}"
    ]
  }
}
