{
  "schema": "provenant.lane.launch.v1",
  "argv": [
    "/usr/bin/codex",
    "exec"
  ],
  "cwd": "/workspace",
  "env": [
    "PATH",
    "OPENAI_API_KEY"
  ],
  "stdin": {
    "path": "/run/prompt.md"
  },
  "attempt_dir": "/run/attempt-001",
  "run_token": "token-1",
  "capture": {
    "events": "events.jsonl",
    "stderr": "stderr.log",
    "max_bytes": 8388608
  },
  "silence_observation_ms": 300000,
  "timeouts_ms": {
    "startup": 300000,
    "wall": 3600000,
    "settle": 1500,
    "child_grace": 500,
    "root_flush": 2000
  },
  "progress": {
    "writer_tree": {
      "root": "/workspace",
      "exclude": [
        ".git",
        "node_modules"
      ]
    }
  },
  "cancel_markers": [
    "cancel.request"
  ],
  "observer": {
    "argv": [
      "/usr/bin/python3",
      "provider_exec.py",
      "observe"
    ]
  },
  "spare": {
    "code_mode_host": true
  }
}
