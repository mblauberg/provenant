{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/adapter-receipt.schema.json",
  "title": "Adapter Receipt",
  "type": "object",
  "properties": {
    "tool": {},
    "adapter": {},
    "execution_intent": {},
    "resolved_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_family": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_family": {
      "type": [
        "string",
        "null"
      ]
    },
    "endpoint_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_source": {},
    "output_path": {
      "type": "string"
    },
    "output_digest": {
      "type": "string"
    },
    "read_only_guarantee": {},
    "status": {},
