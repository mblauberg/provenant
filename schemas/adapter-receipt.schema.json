        "tool",
        "adapter",
        "execution_intent",
        "resolved_model",
        "provider_family",
        "model_family",
        "endpoint_provider",
        "identity_source",
        "output_path",
        "output_digest",
        "read_only_guarantee",
        "status",
        "exit",
        "cross_family",
        "certification_eligible"
      ]
