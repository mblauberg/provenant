{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/dispatch-owner.schema.json",
  "title": "Dispatch Owner",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "run_dir",
    "run_token",
    "owner_pid",
    "owner_pgid",
    "owner_started_at",
    "host_pid",
    "host_started_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "dispatch",
        "batch"
      ]
    },
    "run_dir": {},
    "workspace": {},
    "run_token": {},
    "owner_pid": {},
    "owner_pgid": {},
    "owner_started_at": {},
    "host_pid": {},
    "host_started_at": {},
    "started_at": {},
    "owner_stdout": {},
    "owner_stderr": {}
  },
  "additionalProperties": true
}
