{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/dispatch-owner.schema.json",
  "title": "Dispatch Owner",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "type": "string",
      "enum": [
        "dispatch",
        "batch"
      ]
    },
    "run_dir": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "run_token": {
      "type": "string",
      "minLength": 1
    },
    "owner_pid": {
      "type": "integer",
      "minimum": 1
    },
    "owner_pgid": {
      "type": "integer",
      "minimum": 1
    },
    "owner_started_at": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "host_pid": {
      "type": "integer",
      "minimum": 1
    },
    "host_started_at": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_stdout": {
      "type": "string"
    },
    "owner_stderr": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "run_dir",
    "run_token",
    "owner_pid",
    "owner_pgid",
    "owner_started_at",
    "host_pid",
    "host_started_at"
  ],
  "additionalProperties": false
}
