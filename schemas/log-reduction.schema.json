{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/log-reduction.schema.json",
  "title": "Log Reduction Record",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "provenant-log-reduction.v1"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "exit_status": {
      "type": "integer"
    },
    "source_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "reduced_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "quoted_lines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dropped_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "dropped_lines": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "start_line",
          "end_line",
          "dropped_lines"
        ],
        "additionalProperties": false
      }
    },
    "reduced": {
      "type": "boolean"
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "command",
    "source_sha256",
    "exit_status",
    "source_bytes",
    "reduced_bytes",
    "quoted_lines",
    "dropped_spans",
    "reduced",
    "text"
  ],
  "additionalProperties": false
}
