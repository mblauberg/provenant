{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/wip-checkpoint.schema.json",
  "title": "Wip Checkpoint",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "fabric.wip.v1"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "process_alive": {
      "type": "boolean"
    },
    "silent_seconds": {
      "type": "number",
      "minimum": 0
    },
    "last_event_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_output_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_worktree_write_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "worktree_scan_complete": {
      "type": "boolean"
    },
    "diff_summary": {
      "type": "string"
    },
    "last_tool_call": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_tool_call_scope": {
      "type": "string",
      "minLength": 1
    },
    "next_step": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "checked_at",
    "pid",
    "process_alive",
    "silent_seconds",
    "last_event_at",
    "last_output_at",
    "last_worktree_write_at",
    "worktree_scan_complete",
    "diff_summary",
    "last_tool_call",
    "last_tool_call_scope",
    "next_step"
  ],
  "additionalProperties": false
}
