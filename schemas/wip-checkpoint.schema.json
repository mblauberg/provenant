{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/wip-checkpoint.schema.json",
  "title": "Wip Checkpoint",
  "type": "object",
  "required": [
    "schema",
    "checked_at",
    "pid",
    "process_alive",
    "silent_seconds",
    "last_event_at",
    "last_output_at",
    "last_worktree_write_at",
    "worktree_scan_complete",
    "diff_summary",
    "last_tool_call",
    "last_tool_call_scope",
    "next_step"
  ],
  "properties": {
    "schema": {
      "const": "fabric.wip.v1"
    },
    "checked_at": {},
    "pid": {},
    "process_alive": {
      "type": "boolean"
    },
    "silent_seconds": {
      "type": "number"
    },
    "last_event_at": {},
    "last_output_at": {},
    "last_worktree_write_at": {},
    "worktree_scan_complete": {
      "type": "boolean"
    },
    "diff_summary": {},
    "last_tool_call": {},
    "last_tool_call_scope": {},
    "next_step": {}
  },
  "additionalProperties": true
}
