{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/manifest-row.schema.json",
  "title": "Manifest Row",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "produced_by": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "verified",
        "superseded",
        "retired"
      ]
    },
    "retention": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "path",
    "topic",
    "produced_by",
    "date",
    "status",
    "retention",
    "supersedes"
  ],
  "additionalProperties": false
}
