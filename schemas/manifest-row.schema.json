{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/manifest-row.schema.json",
  "title": "Manifest Row",
  "type": "object",
  "required": [
    "id",
    "path",
    "topic",
    "produced_by",
    "date",
    "status",
    "retention",
    "supersedes"
  ],
  "properties": {
    "id": {},
    "path": {},
    "topic": {},
    "produced_by": {},
    "date": {},
    "status": {
      "enum": [
        "draft",
        "verified",
        "superseded",
        "retired"
      ]
    },
    "retention": {},
    "supersedes": {}
  },
  "additionalProperties": false
}
