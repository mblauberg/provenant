{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/graph-node-receipt.schema.json",
  "title": "Graph Node Receipt",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "provenant.graph-node-receipt.v1"
    },
    "identity": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "graph_id": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "restart": {
          "type": "integer",
          "minimum": 0
        },
        "input_attempts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "required": [
        "project",
        "graph_id",
        "node_id",
        "revision",
        "attempt",
        "restart",
        "input_attempts"
      ],
      "additionalProperties": false
    },
    "spec_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "read_only",
            "worktree_write"
          ]
        },
        "confidential": {
          "type": "boolean"
        },
        "worktree": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tier",
        "mode",
        "confidential"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "pool": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "line": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "requested",
        "pool",
        "line"
      ],
      "additionalProperties": false
    },
    "dispatch": {
      "type": "object",
      "properties": {
        "run_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "run_dir": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "task_id",
        "run_dir"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "gating",
            "passed",
            "failed",
            "blocked",
            "cancelling",
            "cancelled",
            "superseded",
            "stopped"
          ]
        },
        "lane_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "base_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "signal": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stdout": {
                "type": "string",
                "minLength": 1
              },
              "stderr": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "index",
              "argv",
              "exit_code",
              "signal",
              "stdout",
              "stderr"
            ],
            "additionalProperties": false
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "state",
        "lane_status",
        "stale",
        "base_sha",
        "head_sha",
        "result_path",
        "gates"
      ],
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "context": {
          "oneOf": [
            {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "context",
        "usage_source"
      ],
      "additionalProperties": false
    },
    "written_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema",
    "identity",
    "spec_hash",
    "plan",
    "route",
    "dispatch",
    "outcome",
    "tokens",
    "written_at"
  ],
  "additionalProperties": false
}
