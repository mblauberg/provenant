{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/batch-summary.schema.json",
  "title": "Batch Summary",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "record_type": {
      "type": "string",
      "const": "dispatch-batch"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "task_count": {
      "type": "integer",
      "minimum": 0
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "blocked",
          "ok",
          "quarantined",
          "failed",
          "rejected",
          "timed_out",
          "cancelled"
        ]
      }
    },
    "source_manifest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "blocked",
              "ok",
              "quarantined",
              "failed",
              "rejected",
              "timed_out",
              "cancelled"
            ]
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "dispatch_exit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "attempt_path": {
            "type": "string",
            "minLength": 1
          },
          "attempt_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "result_path": {
            "type": "string",
            "minLength": 1
          },
          "landable": {
            "type": "boolean"
          },
          "quarantine": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "requested_route": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "route": {
            "type": "object",
            "properties": {
              "adapter": {
                "type": "string"
              },
              "alias": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "effort": {
                "type": "string"
              },
              "provider_family": {
                "type": "string"
              },
              "model_family": {
                "type": "string"
              },
              "resolved_model": {
                "type": "string"
              },
              "execution_intent": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "question": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "needs_input"
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "code",
                  "prompt"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "task_id",
          "status",
          "outcome"
        ],
        "additionalProperties": false
      }
    },
    "reducer_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "blocked",
              "ok",
              "quarantined",
              "failed",
              "rejected",
              "timed_out",
              "cancelled"
            ]
          },
          "attempt_path": {
            "type": "string",
            "minLength": 1
          },
          "result_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "task_id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "reconciliation_error": {
      "type": "string",
      "minLength": 1
    },
    "summary_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "batch_id",
    "status",
    "task_count",
    "concurrency",
    "counts",
    "source_manifest",
    "tasks",
    "reducer_inputs"
  ],
  "additionalProperties": false
}
