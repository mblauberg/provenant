  "properties": {
    "schema": {
      "const": "provenant.lane.exit.v1"
    },
    "pid": {},
    "pgid": {},
    "started_at": {},
    "ended_at": {},
    "last_progress_at": {},
    "exit": {},
    "signal": {},
    "forced": {
      "type": [
        "string",
        "null"
      ]
    },
    "terminal_event_seen": {},
    "reaped": {},
    "spared": {},
    "census_warnings": {
      "type": "array"
    },
    "observer_lost": {
      "type": "boolean"
    },
    "io_errors": {
      "type": "array"
    }
