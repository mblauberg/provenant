{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/supervisor-exit.schema.json",
  "title": "Supervisor Exit Record",
  "type": "object",
  "required": [
    "schema",
    "pid",
    "pgid",
    "started_at",
    "ended_at",
    "last_progress_at",
    "exit",
    "signal",
    "forced",
    "terminal_event_seen",
    "reaped",
    "spared",
    "census_warnings",
    "observer_lost",
    "io_errors"
