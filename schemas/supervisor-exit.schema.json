{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/supervisor-exit.schema.json",
  "title": "Supervisor Exit Record",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "provenant.lane.exit.v1"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "pgid": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_progress_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "exit": {
      "type": [
        "integer",
        "null"
      ]
    },
    "signal": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "forced": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Null or the supervisor forced reason, including an observer-provided stop reason. The retired stalled reason is forbidden.",
      "not": {
        "const": "stalled"
      }
    },
    "terminal_event_seen": {
      "type": "boolean"
    },
    "reaped": {
      "type": "boolean"
    },
    "spared": {
      "type": "integer",
      "minimum": 0
    },
    "census_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observer_lost": {
      "type": "boolean"
    },
    "io_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "pid",
    "pgid",
    "started_at",
    "ended_at",
    "last_progress_at",
    "exit",
    "signal",
    "forced",
    "terminal_event_seen",
    "reaped",
    "spared",
    "census_warnings",
    "observer_lost",
    "io_errors"
  ],
  "additionalProperties": true
}
