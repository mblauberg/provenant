{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/attempt-digest-sidecar.schema.json",
  "title": "Attempt Digest Sidecar",
  "type": "object",
  "required": [
    "digest",
    "filename"
  ],
  "properties": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "filename": {
      "const": "attempt.json"
    }
  },
  "additionalProperties": false
}
