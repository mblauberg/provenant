{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/observer-record.schema.json",
  "title": "Observer Record",
  "type": "object",
  "properties": {
    "session_id": {
      "type": ["string", "null"]
    },
    "observed_model": {
      "type": ["string", "null"]
    },
    "reset_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "retry_after": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "live_failure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "status": {"type": "string", "minLength": 1},
            "signature": {"type": "string", "minLength": 1},
            "excerpt": {"type": "string"},
            "reset_at": {"type": ["string", "null"], "format": "date-time"},
            "retry_after": {"type": ["number", "null"], "minimum": 0}
          },
          "required": ["status", "signature", "excerpt", "reset_at", "retry_after"],
          "additionalProperties": false
        }
      ]
    },
    "semantic_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "s": {"type": "string", "enum": ["out", "err"]},
          "line": {"type": "string"}
        },
        "required": ["s", "line"],
        "additionalProperties": false
      }
    }
  },
  "required": ["session_id", "observed_model", "reset_at", "retry_after", "live_failure", "semantic_lines"],
  "additionalProperties": false
}
