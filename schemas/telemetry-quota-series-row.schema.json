{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/telemetry-quota-series-row.schema.json",
  "title": "Telemetry Quota Series Row",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "account": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "used_percent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "window_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "reset_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "plan": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_detected": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_tier": {
      "type": [
        "string",
        "null"
      ]
    },
    "credit_balance": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "reset_credits": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "provider",
    "account",
    "host",
    "window",
    "observed_at",
    "last_seen_at",
    "source",
    "used_percent",
    "window_minutes",
    "reset_at",
    "plan",
    "plan_detected",
    "plan_tier",
    "credit_balance",
    "reset_credits"
  ],
  "additionalProperties": false
}
