{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/model-preferences.schema.json",
  "title": "Model Preferences",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "task_classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "family_affinity": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "deprioritise": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [],
        "additionalProperties": true
      }
    },
    "roles": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "deprioritise": {
      "type": "object",
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "families",
        "models",
        "adapters"
      ],
      "additionalProperties": true
    },
    "spreading": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "fair-round-robin"
          ]
        }
      },
      "required": [
        "policy"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "task_classes",
    "roles",
    "deprioritise",
    "spreading"
  ],
  "additionalProperties": true
}
