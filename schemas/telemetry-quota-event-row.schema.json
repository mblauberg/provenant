{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/telemetry-quota-event-row.schema.json",
  "title": "Telemetry Quota Event Row",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "account": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "previous_observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "previous_used_percent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "used_percent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "previous_reset_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reset_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "provider",
    "account",
    "host",
    "window",
    "kind",
    "observed_at",
    "previous_observed_at",
    "previous_used_percent",
    "used_percent",
    "previous_reset_at",
    "reset_at"
  ],
  "additionalProperties": false
}
