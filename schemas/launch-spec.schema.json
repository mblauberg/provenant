{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/launch-spec.schema.json",
  "title": "Launch Spec",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "provenant.lane.launch.v1"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "env": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "stdin": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "attempt_dir": {
      "type": "string",
      "minLength": 1
    },
    "run_token": {
      "type": "string",
      "minLength": 1
    },
    "capture": {
      "type": "object",
      "properties": {
        "events": {
          "type": "string",
          "minLength": 1
        },
        "stderr": {
          "type": "string",
          "minLength": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "events",
        "stderr",
        "max_bytes"
      ],
      "additionalProperties": false
    },
    "silence_observation_ms": {
      "type": "integer",
      "minimum": 1
    },
    "timeouts_ms": {
      "type": "object",
      "properties": {
        "startup": {
          "type": "integer",
          "minimum": 1
        },
        "wall": {
          "type": "integer",
          "minimum": 1
        },
        "settle": {
          "type": "integer",
          "minimum": 1
        },
        "child_grace": {
          "type": "integer",
          "minimum": 1
        },
        "root_flush": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "startup",
        "wall",
        "settle",
        "child_grace",
        "root_flush"
      ],
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "properties": {
        "writer_tree": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "root",
            "exclude"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "writer_tree"
      ],
      "additionalProperties": false
    },
    "cancel_markers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observer": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "spare": {
      "type": "object",
      "properties": {
        "code_mode_host": {
          "type": "boolean"
        }
      },
      "required": [
        "code_mode_host"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "argv",
    "cwd",
    "env",
    "stdin",
    "attempt_dir",
    "run_token",
    "capture",
    "silence_observation_ms",
    "timeouts_ms",
    "progress",
    "cancel_markers",
    "observer",
    "spare"
  ],
  "additionalProperties": false,
  "description": "Draft persisted launch.json projection from rust-supervisor.md. The stdin launch spec carries env values; this redacted disk form stores only environment variable names."
}
