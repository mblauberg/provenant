{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/quota-snapshot.schema.json",
  "title": "Quota Snapshot",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "provenant.quota.v1"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "account": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": [
        "string",
        "null"
      ]
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "active": {
      "type": "boolean"
    },
    "priority": {
      "type": [
        "integer",
        "null"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "attempted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "unreported",
        "disabled",
        "signed_out",
        "unavailable",
        "stale"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "unreported": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "credits": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "reset_credits": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "manual",
                "provider",
                null
              ]
            }
          },
          "required": [
            "reset_credits"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "raw_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "used_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "window_minutes": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "reset_at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "window_start": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "used_amount": {
            "type": "number"
          },
          "limit_amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "currency": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{3}$"
          },
          "advisory": {
            "type": "boolean",
            "const": true
          },
          "pool": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
          }
        },
        "required": [
          "name",
          "raw_kind",
          "used_percent",
          "window_minutes",
          "reset_at",
          "window_start"
        ],
        "additionalProperties": false
      }
    },
    "usage_credits": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "balance": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "unlimited": {
                "type": "boolean"
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Z]{3}$"
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z_]{0,15}$"
              },
              "expires_at": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "type": "string",
                "const": "provider"
              }
            },
            "required": [
              "kind",
              "balance",
              "unlimited",
              "currency",
              "unit",
              "expires_at",
              "source"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "unlimited": {
                      "const": true
                    }
                  },
                  "required": [
                    "unlimited"
                  ]
                },
                "then": {
                  "properties": {
                    "balance": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "unlimited": {
                      "const": false
                    }
                  },
                  "required": [
                    "unlimited"
                  ]
                },
                "then": {
                  "properties": {
                    "balance": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "resets": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "available": {
              "type": "integer",
              "minimum": 1
            },
            "expires_at": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "date-time"
              }
            },
            "source": {
              "type": "string",
              "enum": [
                "manual",
                "provider"
              ]
            }
          },
          "required": [
            "available",
            "expires_at",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "allowance": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ordinary_usage_allowed": {
              "type": "boolean"
            },
            "spend_control_reached": {
              "type": "boolean"
            },
            "limit_reached_type": {
              "type": "string",
              "pattern": "^[a-z][a-z_]{0,63}$"
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "credit_anchor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "balance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "balance",
            "observed_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "fetch": {
      "type": "object",
      "properties": {
        "trigger": {
          "type": "string",
          "enum": [
            "timer",
            "panel",
            "manual",
            "event",
            "wake",
            "power"
          ]
        },
        "source_kind": {
          "type": "string",
          "const": "fetch"
        },
        "last_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        },
        "error_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "rate_limited",
            "network",
            "auth",
            "missing",
            "other",
            null
          ]
        },
        "backoff_until": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_after_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "trigger",
        "source_kind",
        "last_duration_ms",
        "failures",
        "error_kind",
        "backoff_until",
        "retry_after_s"
      ],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "next_due_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "enum": [
            "first_fetch",
            "active",
            "idle",
            "near_exhaustion",
            "low_power",
            "exhausted_until_reset",
            "reset_passed",
            "backoff",
            "cache_seconds"
          ]
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "trigger": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "timer",
            "panel",
            "manual",
            "event",
            "wake",
            "power",
            null
          ]
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        },
        "backoff_until": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "rate_limited",
            "network",
            "auth",
            "missing",
            "other",
            null
          ]
        },
        "last_duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "fetch",
            null
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "next_due_at",
        "reason",
        "ttl_seconds",
        "trigger",
        "failures",
        "backoff_until",
        "error_kind",
        "last_duration_ms",
        "source_kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "provider",
    "account",
    "plan",
    "host",
    "active",
    "priority",
    "observed_at",
    "attempted_at",
    "source",
    "status",
    "error",
    "unreported",
    "credits",
    "windows"
  ],
  "additionalProperties": false,
  "description": "Persisted account snapshot written by scripts/provider_quota.py; provider-dependent raw credential data is excluded."
}
