{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/run-receipt.schema.json",
  "title": "Run Receipt",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ok",
        "quarantined",
        "input_required",
        "failed",
        "cancelled",
        "complete"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string"
    },
    "retention_policy": {
      "type": "string",
      "minLength": 1
    },
    "terminal_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_plan": {
      "type": "object",
      "properties": {
        "risk_tier": {
          "type": "string",
          "enum": [
            "routine",
            "substantial",
            "crucial",
            "terminal"
          ]
        },
        "chair_family": {
          "type": "string",
          "enum": [
            "",
            "openai",
            "anthropic"
          ]
        },
        "concurrency_ceiling": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "enum": [
                  "targeted",
                  "primary"
                ]
              },
              "lens": {
                "type": "string",
                "minLength": 1
              },
              "family": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "type": "string",
                "enum": [
                  "junior",
                  "senior",
                  "principal"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "complete",
                  "failed",
                  "unavailable",
                  "omitted"
                ]
              },
              "substitution_for": {
                "type": "string"
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "digest"
                ],
                "additionalProperties": false
              },
              "reason": {
                "type": "string"
              },
              "verdict": {
                "type": "string"
              },
              "terminal_result": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "digest"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "wave": {
                "type": "integer",
                "minimum": 0
              },
              "adapter": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string"
              },
              "catalog_model": {
                "type": "string"
              },
              "route_receipt": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "digest"
                ],
                "additionalProperties": false
              },
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "adapter_gate": {
                "type": "string",
                "enum": [
                  "fabric",
                  "direct-cli"
                ]
              }
            },
            "required": [
              "id",
              "scope",
              "lens",
              "family",
              "tier",
              "status",
              "substitution_for",
              "evidence",
              "reason",
              "verdict",
              "terminal_result",
              "wave",
              "adapter",
              "model",
              "catalog_model",
              "route_receipt",
              "reviewer_id",
              "adapter_gate"
            ],
            "additionalProperties": false
          }
        },
        "panels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "spec": {
                "type": "object",
                "properties": {
                  "preset": {
                    "type": "string",
                    "enum": [
                      "council",
                      "breadth"
                    ]
                  },
                  "membership": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "distribution": {
                    "type": "string",
                    "enum": [
                      "shared",
                      "split"
                    ]
                  },
                  "reduction": {
                    "type": "string",
                    "enum": [
                      "agreements-conflicts",
                      "union"
                    ]
                  },
                  "degradation": {
                    "type": "string",
                    "enum": [
                      "require-all",
                      "allow-shortfall"
                    ]
                  }
                },
                "required": [
                  "preset",
                  "membership",
                  "distribution",
                  "reduction",
                  "degradation"
                ],
                "additionalProperties": false
              },
              "result": {
                "type": "object",
                "properties": {
                  "shortfall": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "output": {
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                },
                "required": [
                  "shortfall",
                  "output"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "spec",
              "result"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "risk_tier",
        "chair_family",
        "concurrency_ceiling",
        "panels",
        "reviews"
      ],
      "additionalProperties": false
    },
    "pair": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "solo",
            "paired-primary"
          ]
        },
        "chair_family": {
          "type": "string"
        },
        "chair_id": {
          "type": "string"
        },
        "peer_family": {
          "type": "string"
        },
        "peer_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "degradation_reason": {
          "type": "string"
        },
        "lease_path": {
          "type": "string",
          "minLength": 1
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_generation": {
          "type": "integer",
          "minimum": 0
        },
        "current_stage": {
          "type": "string"
        },
        "in_flight": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assignment_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "stage_ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "owner_family": {
                "type": "string",
                "enum": [
                  "anthropic",
                  "openai"
                ]
              },
              "peer_family": {
                "type": "string",
                "enum": [
                  "anthropic",
                  "openai"
                ]
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "type": "string",
                "const": "complete"
              },
              "acknowledged": {
                "type": "boolean",
                "const": true
              },
              "assignment_path": {
                "type": "string",
                "minLength": 1
              },
              "acknowledgement_path": {
                "type": "string",
                "minLength": 1
              },
              "output_path": {
                "type": "string",
                "minLength": 1
              },
              "assignment_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "acknowledgement_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "output_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "command": {
                      "type": "string",
                      "minLength": 1
                    },
                    "exit_code": {
                      "type": "integer",
                      "const": 0
                    }
                  },
                  "required": [
                    "command",
                    "exit_code"
                  ],
                  "additionalProperties": false
                }
              },
              "human_gates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "base_revision": {
                "type": "string",
                "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
              },
              "result_revision": {
                "type": "string",
                "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
              }
            },
            "required": [
              "stage",
              "owner_family",
              "peer_family",
              "generation",
              "status",
              "acknowledged",
              "assignment_path",
              "assignment_sha256",
              "acknowledgement_path",
              "acknowledgement_sha256",
              "output_path",
              "output_sha256",
              "checks",
              "human_gates",
              "base_revision",
              "result_revision"
            ],
            "additionalProperties": false
          }
        },
        "handoff_generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "chair_family",
        "chair_id",
        "peer_family",
        "peer_id",
        "status",
        "degradation_reason",
        "lease_path",
        "lease_generation",
        "checkpoint_generation",
        "current_stage",
        "in_flight",
        "assignment_artifacts",
        "stage_ledger",
        "handoff_generation"
      ],
      "additionalProperties": false
    },
    "owned_panes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pane_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "provider_family": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "lease_generation": {
            "type": "integer",
            "minimum": 0
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "pane_id",
          "role",
          "provider_family",
          "model"
        ],
        "additionalProperties": false
      }
    },
    "closed_panes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pane_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "provider_family": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "closed_by": {
            "type": "string",
            "minLength": 1
          },
          "closed_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "const": "verified"
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "pane_id",
          "role",
          "provider_family",
          "model",
          "closed_by",
          "closed_at",
          "status",
          "evidence_path",
          "evidence_sha256"
        ],
        "additionalProperties": false
      }
    },
    "handed_off_panes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pane_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "provider_family": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "handoff_target": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "const": "acknowledged"
          },
          "handed_off_at": {
            "type": "string",
            "format": "date-time"
          },
          "lease_generation": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "pane_id",
          "role",
          "provider_family",
          "model",
          "handoff_target",
          "owner",
          "status",
          "handed_off_at",
          "lease_generation",
          "evidence_path",
          "evidence_sha256"
        ],
        "additionalProperties": false
      }
    },
    "unclassified_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pruned_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "created_at",
    "closed_at",
    "owner",
    "task",
    "retention_policy",
    "terminal_reason",
    "review_plan",
    "pair",
    "owned_panes",
    "closed_panes",
    "handed_off_panes",
    "unclassified_paths",
    "pruned_paths"
  ],
  "additionalProperties": false
}
