{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/dispatch-status.schema.json",
  "title": "Dispatch Status",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "next_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "dispatch",
        "batch"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      }
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "ok",
        "quarantined",
        "input_required",
        "failed",
        "cancelled"
      ]
    },
    "owner_stdout": {
      "type": "string",
      "minLength": 1
    },
    "owner_stderr": {
      "type": "string",
      "minLength": 1
    },
    "host_pid": {
      "type": "integer",
      "minimum": 1
    },
    "host_started_at": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "task_alias": {
      "type": "string"
    },
    "cwd_projects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "owner_pid": {
      "type": "integer",
      "minimum": 1
    },
    "owner_started_at": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "run_token": {
      "type": "string",
      "minLength": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "type": "string"
    },
    "exitCode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "signal": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "next_attempt",
    "kind",
    "started_at",
    "routes",
    "task_ids",
    "timeout_seconds",
    "status",
    "owner_stdout",
    "owner_stderr",
    "host_pid",
    "host_started_at"
  ],
  "additionalProperties": false
}
