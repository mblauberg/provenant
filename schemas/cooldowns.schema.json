{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/cooldowns.schema.json",
  "title": "Fabric Cooldowns",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "fabric.cooldowns.v1"
    },
    "cooldowns": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "account": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "rate_limited",
              "usage_limited"
            ]
          },
          "cooling_until": {
            "type": "string",
            "format": "date-time"
          },
          "source_run": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          },
          "backoff_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "adapter",
          "model",
          "status",
          "cooling_until",
          "source_run",
          "recorded_at",
          "signature"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "cooldowns"
  ],
  "additionalProperties": false
}
