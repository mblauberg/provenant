{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/model-routing.schema.json",
  "title": "Model Routing",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "catalog_date": {
      "type": "string",
      "format": "date"
    },
    "context": {
      "type": "object",
      "properties": {
        "ceiling_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "ceiling_tokens"
      ],
      "additionalProperties": true
    },
    "rate_limit_pacing": {
      "type": "object",
      "properties": {
        "base_delay_seconds": {
          "type": "number",
          "minimum": 0
        },
        "cap_seconds": {
          "type": "number",
          "minimum": 0
        },
        "jitter_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_budget_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "base_delay_seconds",
        "cap_seconds",
        "jitter_fraction",
        "minimum_budget_seconds"
      ],
      "additionalProperties": true
    },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "weight": {
              "type": "string",
              "enum": [
                "high",
                "normal",
                "sparing"
              ]
            },
            "effort": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "ultra"
                ]
              }
            },
            "confidential": {
              "type": "boolean"
            }
          },
          "required": [
            "model",
            "weight"
          ],
          "additionalProperties": true
        }
      }
    },
    "route_synonyms": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "model_traits": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "task_class_routes": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "catalog_date",
    "context",
    "rate_limit_pacing",
    "routes"
  ],
  "additionalProperties": true
}
