{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/watchdog-observation.schema.json",
  "title": "Watchdog Observation",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "fabric.watchdog.v1"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "process_alive": {
      "type": "boolean"
    },
    "silent_seconds": {
      "type": "number",
      "minimum": 0
    },
    "last_event_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_output_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_worktree_write_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "worktree_scan_complete": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "checked_at",
    "pid",
    "process_alive",
    "silent_seconds",
    "last_event_at",
    "last_output_at",
    "last_worktree_write_at",
    "worktree_scan_complete"
  ],
  "additionalProperties": false
}
