{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/route-health.schema.json",
  "title": "Route Health",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "fabric.route-health.v1"
    },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "task_class": {
            "type": "string",
            "minLength": 1
          },
          "recent": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "quarantined",
                    "failed",
                    "empty_output",
                    "cancelled",
                    "rate_limited",
                    "usage_limited",
                    "permission_blocked"
                  ]
                },
                "task_class": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "run_id": {
                  "type": "string"
                },
                "warning": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "task_class",
                "at",
                "run_id"
              ],
              "additionalProperties": false
            }
          },
          "recent_failures": {
            "type": "integer",
            "minimum": 0
          },
          "rate_limits": {
            "type": "integer",
            "minimum": 0
          },
          "cooling_until": {
            "type": "string"
          }
        },
        "required": [
          "adapter",
          "model",
          "task_class",
          "recent"
        ],
        "additionalProperties": false
      }
    },
    "task_class_routes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema",
    "routes"
  ],
  "additionalProperties": false
}
