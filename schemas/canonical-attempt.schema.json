{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/canonical-attempt.schema.json",
  "title": "Canonical Attempt",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "fabric.attempt.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "task_class": {
      "type": "string"
    },
    "profile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{12}$"
            },
            "task_class": {
              "type": [
                "string",
                "null"
              ]
            },
            "risk_tier": {
              "type": [
                "string",
                "null"
              ]
            },
            "knobs": {
              "type": "object",
              "additionalProperties": true
            },
            "floored": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "preset",
            "digest",
            "task_class",
            "risk_tier",
            "knobs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "null"
            },
            "digest": {
              "type": "null"
            },
            "error": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "preset",
            "digest",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "terminal"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ok",
        "partial",
        "quarantined",
        "failed",
        "usage_limited",
        "rate_limited",
        "auth_required",
        "model_unavailable",
        "permission_blocked",
        "stalled",
        "startup_timeout",
        "writer_changed",
        "timed_out",
        "cancelled",
        "interrupted",
        "lost",
        "rejected",
        "tool_missing",
        "input_required",
        null
      ]
    },
    "usage_source": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "read_only",
        "worktree_write"
      ]
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1
    },
    "worktree": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_progress_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "pgid": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "pgid_started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "reset_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retry_after": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "fix": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "question": {
      "type": [
        "string",
        "null"
      ]
    },
    "applied": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "secret_scan": {
      "type": "object",
      "properties": {
        "allow_secrets": {
          "type": "boolean"
        },
        "finding_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "allow_secrets",
        "finding_names"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "queued_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "phases"
      ],
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "properties": {
        "result": {
          "type": [
            "string",
            "null"
          ]
        },
        "stderr": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "string",
          "minLength": 1
        },
        "watchdog": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "result",
        "stderr",
        "events",
        "watchdog",
        "receipt"
      ],
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "minLength": 1
    },
    "run_dir": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      }
    },
    "placement_fallback": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "delivery_run_id": {
      "type": "string",
      "minLength": 1
    },
    "read_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retry_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "escalation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "account": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "reason": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "reaped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "command": {
            "type": "string"
          }
        },
        "required": [
          "pid",
          "command"
        ],
        "additionalProperties": false
      }
    },
    "spared": {
      "type": "integer",
      "minimum": 0
    },
    "landable": {
      "type": "boolean"
    },
    "quarantine": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "result_partial": {
      "type": "boolean"
    },
    "empty_patch": {
      "type": "boolean"
    },
    "model_check": {
      "type": "string"
    },
    "model_check_detail": {
      "type": "string"
    },
    "model_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      }
    },
    "process_error": {
      "type": "string"
    },
    "error_class": {
      "type": "string",
      "minLength": 1
    },
    "legacy_attempt_path": {
      "type": "string",
      "minLength": 1
    },
    "requested_route": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "queue_reason": {
      "type": "string"
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "parent": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "run_dir": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "run_id",
        "task_id",
        "attempt",
        "run_dir"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "run_id",
    "task_id",
    "task_class",
    "profile",
    "attempt",
    "state",
    "status",
    "usage_source",
    "mode",
    "cwd",
    "workspace_root",
    "worktree",
    "started_at",
    "ended_at",
    "last_progress_at",
    "pgid",
    "pgid_started_at",
    "session_id",
    "retryable",
    "reset_at",
    "retry_after",
    "fix",
    "evidence",
    "question",
    "applied",
    "warnings",
    "provenance",
    "secret_scan",
    "timing",
    "paths",
    "digest",
    "run_dir",
    "account",
    "host"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "terminal"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "timing": {
            "required": [
              "queued_seconds"
            ]
          }
        }
      }
    }
  ]
}
