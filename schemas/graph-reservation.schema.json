{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenant.dev/schemas/graph-reservation.schema.json",
  "title": "Graph Worktree Reservation",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "provenant.graph-reservation.v1"
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "token": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    }
  },
  "required": [
    "schema",
    "graph_id",
    "node_id",
    "revision",
    "attempt",
    "token",
    "owner"
  ],
  "additionalProperties": false
}
