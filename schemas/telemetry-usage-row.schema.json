    "requested_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "delivery_run_id": {
      "type": [
        "string",
        "null"
      ]
    }
