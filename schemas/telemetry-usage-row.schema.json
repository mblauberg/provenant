    "reported_cost",
    "status",
    "error_class",
    "task_class",
    "route",
    "duration_ms",
    "provider_ms",
    "classified_by",
    "classifier_confidence",
    "shadow_answers",
    "parent_run_id",
    "parent_task_id",
    "parent_attempt",
    "requested_model",
    "resolved_model",
    "observed_model",
    "delivery_run_id"
