    "adapter",
    "provider",
    "model",
    "effort",
    "account",
    "repository",
    "revision",
    "timestamp",
    "input_tokens",
    "cache_read_tokens",
    "cache_write_tokens",
    "output_tokens",
    "reasoning_tokens",
