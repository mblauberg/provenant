      "type": [
        "string",
        "null"
      ]
    },
    "reported_cost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "route": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "provider_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "classified_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "classifier_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
