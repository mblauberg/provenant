#!/usr/bin/env python3
"""Select repository verification work from changed paths and tier data."""
import argparse
import copy
import fnmatch
import json
import os
from pathlib import Path
import subprocess
import sys

SCRIPT_ROOT = Path(__file__).resolve().parent.parent
ROOT = SCRIPT_ROOT  # Direct repository CI keeps using the script's own checkout.
PORTS_ASSET = SCRIPT_ROOT / "tools/front-door/crates/config/assets/ports.json"
try:
    with PORTS_ASSET.open() as stream:
        BUILTIN_PORTS = json.load(stream)
    DEFAULTS = BUILTIN_PORTS["verify"]
except FileNotFoundError:
    # Installed product invocations receive the effective verify owner from
    # Provenant; this source-tree-only default serves direct repository CI.
    BUILTIN_PORTS = None
    DEFAULTS = None


def config(root, effective_config_json=None):
    # Repository CI owns config/ports.json; the optional .provenant entry is a
    # link for the agent integration, never a build dependency. Provenant passes
    # only the resolved verify owner so other repository and host ports stay private.
    if effective_config_json is not None:
        verify = json.loads(effective_config_json)
    else:
        path = root / "config" / "ports.json"
        if not path.exists():
            if DEFAULTS is None:
                raise ValueError("no verify port is available for this project")
            return copy.deepcopy(DEFAULTS)
        with path.open() as stream:
            ports = json.load(stream)
        names = set(BUILTIN_PORTS) - {"schema_version"}
        if (not isinstance(ports, dict)
                or type(ports.get("schema_version")) is not int
                or ports["schema_version"] != BUILTIN_PORTS["schema_version"]
                or {name for name in ports if name != "schema_version"} != names):
            raise ValueError("invalid port table shape")
        verify = ports.get("verify")
    if not isinstance(verify, dict):
        raise ValueError("invalid verify port")
    if verify.get("default_tier") not in verify.get("tiers", {}):
        raise ValueError("verify default tier must name a declared tier")
    return verify


def changed_paths(root, base):
    def git(*args):
        return subprocess.check_output(["git", *args], cwd=root, text=True).splitlines()
    paths = set(git("diff", "--name-only", f"{base}...HEAD"))
    paths.update(git("diff", "--name-only", "HEAD"))
    paths.update(git("ls-files", "--others", "--exclude-standard"))
    return sorted(paths)


def select(paths, packages, mappings, package_mappings=()):
    touched = set()
    for path in paths:
        candidates = [(p["manifest_path"], p["name"]) for p in packages
                      if path == p["manifest_path"] or path.startswith(str(Path(p["manifest_path"]).parent) + "/")]
        if candidates:
            touched.add(max(candidates, key=lambda p: len(p[0]))[1])
    for rule in package_mappings:
        if any(fnmatch.fnmatchcase(path, pattern)
               for path in paths for pattern in rule["paths"]):
            touched.add(rule["package"])
    selected = []
    for rule in mappings:
        matches = [path for path in paths if any(fnmatch.fnmatchcase(path, pattern) for pattern in rule["paths"])]
        if matches:
            selected.append((rule["package"], rule["binary"], matches))
    return sorted(touched), selected


def main():
    import shlex
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tier", default=os.environ.get("PROVENANT_VERIFY_TIER"))
    parser.add_argument("--host", default="local")
    parser.add_argument("--project", default=os.environ.get("PROVENANT_VERIFY_PROJECT_ROOT", str(ROOT)))
    parser.add_argument(
        "--effective-config-json",
        default=os.environ.get("PROVENANT_VERIFY_EFFECTIVE_CONFIG_JSON"),
        help=argparse.SUPPRESS,
    )
    args = parser.parse_args()
    root = Path(args.project).resolve()
    cfg = config(root, args.effective_config_json)
    if not cfg["tiers"]:
        parser.error("no verification tiers are configured")
    args.tier = args.tier or cfg["default_tier"]
    if args.tier not in cfg["tiers"]:
        parser.error(f"no verification tier named {args.tier}")
    workspace = root / cfg["workspace"]
    commit = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip()
    if args.host != "local":
        runner = cfg["runners"].get(args.host)
        if not runner:
            parser.error(f"no runner configured for {args.host}")
        refs = subprocess.check_output(["git", "ls-remote", "--heads", cfg["remote"]], cwd=root, text=True)
        if not any(line.split()[0] == commit for line in refs.splitlines() if line.split()):
            parser.error("commit is not the tip of a pushed branch")
        command = [part.replace("{commit}", commit).replace("{tier}", args.tier).replace("{remote}", cfg["remote"]) for part in runner]
        print(f"tier {args.tier} on {args.host}, commit {commit}: {shlex.join(command)}", flush=True)
        result = subprocess.run(command, cwd=root, capture_output=True, text=True)
        if result.stderr:
            print(result.stderr, file=sys.stderr, end="")
        lines = result.stdout.splitlines()
        for line in lines[:-1]:
            print(line)
        try:
            receipt = json.loads(lines[-1])
            status = receipt["exit_status"]
            if (receipt["commit"] != commit or receipt["tier"] != args.tier
                    or type(status) is not int or not 0 <= status <= 255
                    or result.returncode != 0):
                raise ValueError("runner receipt or transport status does not match")
        except (IndexError, KeyError, TypeError, ValueError) as error:
            print(f"invalid runner receipt: {error}", file=sys.stderr)
            return 1
        print(f"result: host={args.host} tier={args.tier} commit={commit} exit_status={status}", flush=True)
        return status
    tier = cfg["tiers"][args.tier]
    if tier["warn_for_host_load"] and os.getloadavg()[0] > cfg["load_per_cpu"] * (os.cpu_count() or 1):
        host = next(iter(cfg["runners"]), None)
        suggestion = f"; consider --host {host}" if host else ""
        print(f"warning: {args.tier} may load this host{suggestion}", file=sys.stderr)
    templates = tier["commands"]
    selection = tier["selection"]
    touched, integrations = [], []
    if selection in ("packages", "integrations"):
        metadata = json.loads(subprocess.check_output(["cargo", "metadata", "--no-deps", "--format-version", "1"], cwd=workspace, text=True))
        packages = [{"name": p["name"], "manifest_path": str(Path(p["manifest_path"]).relative_to(root))} for p in metadata["packages"] if p["id"] in metadata["workspace_members"]]
        paths = changed_paths(root, cfg["base"])
        touched, integrations = select(
            paths, packages, cfg["integrations"], cfg["package_paths"]
        )
    print(f"tier {args.tier} on local, commit {commit}; touched crates: {', '.join(touched) or 'none'}", flush=True)
    for package, binary, matches in integrations:
        print(f"integration {package}/{binary}: {', '.join(matches)}", flush=True)
    if (selection == "packages" and not touched) or (selection == "integrations" and not integrations):
        print(f"No matching tests selected. result: host=local tier={args.tier} commit={commit} exit_status=0")
        return 0
    packages_arg = " ".join(f"-p {shlex.quote(name)}" for name in touched)
    if not templates:
        print(f"{args.tier} has no configured commands", file=sys.stderr)
        return 2
    env = os.environ.copy()
    for name in (
            "PROVENANT_VERIFY_EFFECTIVE_CONFIG_JSON",
            "PROVENANT_VERIFY_PROJECT_ROOT",
            "PROVENANT_VERIFY_TIER"):
        env.pop(name, None)
    threads = cfg.get("test_threads")
    if threads is not None:
        if type(threads) is not int or threads < 1:
            print("test_threads must be a positive integer", file=sys.stderr)
            return 2
        env["VERIFY_TIER_TEST_THREADS"] = str(threads)
        env["RUST_TEST_THREADS"] = str(threads)
    quarantine_args = ""
    if any("{quarantine_args}" in template for template in templates):
        command = cfg.get("quarantine_command") or ["true"]
        try:
            quarantine = subprocess.check_output(command, cwd=root, text=True).strip()
        except (OSError, subprocess.CalledProcessError) as error:
            print(f"quarantine command failed: {error}", file=sys.stderr)
            return 2
        if quarantine:
            quarantine_args = "-E " + shlex.quote(f"not ({quarantine})")
    for template in templates:
        targets = integrations if "{integration_args}" in template else [None]
        for target in targets:
            target_args = (f"-p {shlex.quote(target[0])} --test {shlex.quote(target[1])}" if target else "")
            command_text = template.replace("{packages}", packages_arg).replace("{integration_args}", target_args).replace("{quarantine_args}", quarantine_args)
            command = shlex.split(command_text)
            print(f"+ {shlex.join(command)}", flush=True)
            status = subprocess.run(command, cwd=workspace, env=env).returncode
            if status:
                print(f"result: host=local tier={args.tier} commit={commit} exit_status={status}", flush=True)
                return status
    print(f"result: host=local tier={args.tier} commit={commit} exit_status=0", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
