#!/usr/bin/env python3
"""Exercise main-health's GitHub boundary with a fake gh executable."""
import json
import os
from pathlib import Path
import subprocess
import tempfile

script = Path(__file__).with_name('report-main-health')
# Spec: docs/specs/ci.md#red-main-is-visible
with tempfile.TemporaryDirectory() as tmp:
    fake = Path(tmp) / 'gh'
    fake.write_text('''#!/usr/bin/env python3
import json, os, sys
with open(os.environ['LOG'], 'a') as f: f.write(json.dumps(sys.argv[1:]) + "\\n")
if sys.argv[1] == 'api':
    arg = sys.argv[-1]
    if '/jobs?' in arg:
        print(os.environ['JOBS'])
    elif 'ci%3Aflaky' in arg:
        print(os.environ.get('FLAKY_ISSUES', '[]'))
    else:
        print(os.environ['ISSUES'])
''')
    fake.chmod(0o755)
    log = Path(tmp) / 'log'
    env = dict(os.environ, PATH=tmp + os.pathsep + os.environ['PATH'], LOG=str(log), GITHUB_REPOSITORY='owner/repo', SHA='new', RUN_ID='123', RUN_URL='https://example/run', SELECTION_JSON=json.dumps({'evidence': {'main': 'old'}}), JOBS=json.dumps([{'jobs': [{'name': 'lint', 'conclusion': 'failure'}]}]))
    def run(result, issues):
        log.write_text('')
        subprocess.run([script], env=dict(env, CI_RESULT=result, ISSUES=json.dumps([issues])), check=True)
        return [json.loads(line) for line in log.read_text().splitlines()]
    calls = run('failure', [])
    create = calls[-1]
    assert create[:2] == ['issue', 'create'] and 'lint' in create[-1] and 'old...new' in create[-1]
    calls = run('failure', [{'number': 12}])
    assert calls[-1][:3] == ['issue', 'comment', '12']
    calls = run('success', [{'number': 12}, {'number': 13}])
    assert [call[2] for call in calls[1:]] == ['12', '13']
    assert 'new' in calls[-1][-1]
    assert len(run('success', [])) == 1
    env['SELECTION_JSON'] = '{}'
    assert 'No green main found' in run('failure', [])[-1][-1]

    # Spec: docs/specs/ci.md#red-main-is-visible — a known flake opens no issue.
    junit = Path(tmp) / 'main-junit'
    junit.mkdir()
    (junit / 'rust-nextest-junit-1').mkdir()
    (junit / 'rust-nextest-junit-1' / 'partition.xml').write_text(
        '<testsuites><testsuite><testcase classname="provenant" name="b::flaky">'
        '<failure message="timed out"/></testcase></testsuite></testsuites>'
    )
    env['JUNIT_DIR'] = str(junit)
    env['RERUN_JUNIT_DIR'] = str(Path(tmp) / 'no-rerun')
    flaky_body = ('<!-- provenant-flaky:v1 -->\n- package: provenant\n'
                  '- name: b::flaky\n- owner: chair\n- expires: 2030-12-31')
    env['FLAKY_ISSUES'] = json.dumps([[{'number': 99, 'body': flaky_body}]])
    env['JOBS'] = json.dumps([{'jobs': [
        {'name': 'Rust front door (1/3)', 'conclusion': 'failure'},
        {'name': 'ci-status', 'conclusion': 'failure'},
    ]}])
    calls = run('failure', [])
    assert not [call for call in calls if call[:2] in (['issue', 'create'], ['issue', 'comment'])], calls

    # A known failure cannot hide an unrelated failed test job with no JUnit evidence.
    env['JOBS'] = json.dumps([{'jobs': [
        {'name': 'Rust front door (1/3)', 'conclusion': 'failure'},
        {'name': 'Rust macOS tests (custody)', 'conclusion': 'failure'},
        {'name': 'ci-status', 'conclusion': 'failure'},
    ]}])
    calls = run('failure', [])
    assert (calls[-1][:2] == ['issue', 'create'] and 'ci:red-main' in calls[-1]
            and 'Rust macOS tests (custody)' in calls[-1][-1]), calls

    # Missing JUnit leaves the failed CI job actionable and reporting still runs.
    env['JUNIT_DIR'] = str(Path(tmp) / 'missing-junit')
    env['JOBS'] = json.dumps([{'jobs': [
        {'name': 'Rust front door (1/3)', 'conclusion': 'failure'},
        {'name': 'ci-status', 'conclusion': 'failure'},
    ]}])
    calls = run('failure', [])
    assert calls[-1][:2] == ['issue', 'create'] and 'ci:red-main' in calls[-1], calls
    env['JUNIT_DIR'] = str(junit)

    # A failure that passes on re-run is quarantined with an issue per test.
    env['FLAKY_ISSUES'] = '[]'
    env['JOBS'] = json.dumps([{'jobs': [
        {'name': 'Rust front door (1/3)', 'conclusion': 'failure'},
        {'name': 'ci-status', 'conclusion': 'failure'},
    ]}])
    rerun = Path(tmp) / 'rerun-junit'
    rerun.mkdir()
    (rerun / 'again.xml').write_text(
        '<testsuites><testsuite><testcase classname="provenant" name="b::flaky"/>'
        '</testsuite></testsuites>'
    )
    env['RERUN_JUNIT_DIR'] = str(rerun)
    calls = run('failure', [])
    creates = [call for call in calls if call[:2] == ['issue', 'create']]
    assert len(creates) == 1, calls
    assert 'ci:flaky' in creates[0] and 'b::flaky' in creates[0][-1], creates
    assert 'ci:red-main' not in creates[0], creates

    # The cap keeps a full quarantine from silently disabling more tests.
    full = [
        {'number': n, 'body': (
            '<!-- provenant-flaky:v1 -->\n- package: provenant\n'
            f'- name: tracked::{n}\n- owner: chair\n- expires: 2030-12-31'
        )}
        for n in range(200, 210)
    ]
    env['FLAKY_ISSUES'] = json.dumps([full])
    calls = run('failure', [])
    creates = [call for call in calls if call[:2] == ['issue', 'create']]
    assert len(creates) == 1 and 'ci:red-main' in creates[0], calls

    fake.write_text('#!/bin/sh\nexit 1\n')
    assert subprocess.run([script], env=dict(env, CI_RESULT='failure'), capture_output=True).returncode != 0
print('Main-health fixtures passed.')
