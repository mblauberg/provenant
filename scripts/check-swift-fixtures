#!/bin/sh
# Fail when the Swift replay fixtures no longer match the Rust wire values.
# On drift the script regenerates the fixtures in place and prints the exact
# patch, so a change can take the generated bytes from CI's log (git apply)
# instead of editing fixture bytes by hand.
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
fixtures="$root/apps/quota-menubar/Tests/ProvenantTestSupport/Fixtures"

cd "$root/tools/front-door"
# CI reuses this job's release target; local runs use the debug profile.
generate() {
  if [ -n "${CARGO_PROFILE_ARG:-}" ]; then
    cargo run --quiet "$CARGO_PROFILE_ARG" -p provenant-cli \
      --bin generate-swift-fixtures -- "$@"
  else
    cargo run --quiet -p provenant-cli --bin generate-swift-fixtures -- "$@"
  fi
}

if generate --check "$fixtures"; then
  exit 0
fi
generate --out "$fixtures"
echo "Regeneration patch (apply from the repository root with git apply):" >&2
git -C "$root" --no-pager diff --no-color -- "$fixtures" >&2
exit 1
