#!/bin/sh
# Fail when the Swift replay fixtures no longer match the Rust wire values.
# The generator's error carries the regeneration command.
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
fixtures="$root/apps/quota-menubar/Tests/ProvenantTestSupport/Fixtures"

cd "$root/tools/front-door"
# CI reuses this job's release target; local runs use the debug profile.
if [ -n "${CARGO_PROFILE_ARG:-}" ]; then
  exec cargo run --quiet "$CARGO_PROFILE_ARG" -p provenant-cli \
    --bin generate-swift-fixtures -- --check "$fixtures"
fi
exec cargo run --quiet -p provenant-cli --bin generate-swift-fixtures -- \
  --check "$fixtures"
