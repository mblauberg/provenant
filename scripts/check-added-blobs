#!/usr/bin/env python3
"""Reject large blobs introduced in commits since the merge base."""
import subprocess
import sys


def git(*args):
    return subprocess.check_output(["git", *args])


def main():
    head = sys.argv[1] if len(sys.argv) > 1 else "HEAD"
    base = git("merge-base", "origin/main", head).strip().decode()
    objects = git("rev-list", "--objects", head, "--not", base).splitlines()
    ids = [line.split(b" ", 1)[0] for line in objects]
    if not ids:
        return
    result = subprocess.run(["git", "cat-file", "--batch-check=%(objectname) %(objecttype) %(objectsize)"],
                            input=b"\n".join(ids) + b"\n", stdout=subprocess.PIPE, check=True)
    names = {line.split(b" ", 1)[0]: line.split(b" ", 1)[-1] for line in objects}
    failed = False
    for line in result.stdout.splitlines():
        oid, kind, size = line.split()
        if kind == b"blob" and int(size) > 1_000_000:
            print(f"large blob {oid.decode()} ({int(size)} bytes): {names[oid].decode(errors='replace')}", file=sys.stderr)
            failed = True
    if failed:
        sys.exit(1)


if __name__ == "__main__":
    main()
