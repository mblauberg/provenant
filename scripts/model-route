#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "$ROOT/scripts/lib/harness-python.sh"

if run_yaml "$ROOT/scripts/model_route.py" "$@"; then
  exit 0
else
  exit_code=$?
fi
if [[ "$exit_code" -eq 3 ]]; then
  printf '{"schema_version":1,"status":"interpreter_unavailable"}\n'
fi
exit "$exit_code"
