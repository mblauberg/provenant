#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "$ROOT/scripts/lib/harness-python.sh"
TARGET=""
CUSTOM_SOURCE=""

usage() {
  echo "usage: install-skills --target <global-skills-directory> [--custom-source <instance-custom-skills-directory>]" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --target)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      TARGET="$2"
      shift 2
      ;;
    --custom-source)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      CUSTOM_SOURCE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

[[ -n "$TARGET" ]] || { usage; exit 2; }
manager_args=(--source "$ROOT/skills" --target "$TARGET")
if [[ -n "$CUSTOM_SOURCE" ]]; then
  manager_args+=(--custom-source "$CUSTOM_SOURCE")
fi

# Claude installations may intentionally expose the canonical skill tree as
# one directory-level symlink. Preserve that layout instead of resolving the
# target into the source tree and treating source directories as unmanaged.
# One directory-level link has nowhere to hang an instance-owned custom skill,
# so the first install that carries any converts the layout to per-entry links
# and then installs normally. The conversion is idempotent: a target that is
# already per-entry never reaches this branch.
if [[ -L "$TARGET" ]] \
  && [[ "$(cd "$TARGET" && pwd -P)" == "$(cd "$ROOT/skills" && pwd -P)" ]]; then
  custom_count=0
  if [[ -n "$CUSTOM_SOURCE" ]]; then
    for skill_file in "$CUSTOM_SOURCE"/*/SKILL.md; do
      [[ -f "$skill_file" ]] || continue
      custom_count=$((custom_count + 1))
    done
  fi
  if [[ "$custom_count" -eq 0 ]]; then
    echo "skills existing=directory-link target=$TARGET"
    exit 0
  fi
  run_stdlib "$ROOT/scripts/manage_installation.py" validate-sources \
    "${manager_args[@]}" >/dev/null
  run_stdlib "$ROOT/scripts/manage_installation.py" migrate-directory-link \
    "${manager_args[@]}" --summary
  echo "skills converted=directory-link custom=$custom_count target=$TARGET"
fi

run_stdlib "$ROOT/scripts/manage_installation.py" install \
  "${manager_args[@]}" \
  --summary

run_stdlib "$ROOT/scripts/manage_installation.py" check \
  "${manager_args[@]}" \
  --summary
