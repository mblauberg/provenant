#!/usr/bin/env python3
"""Check provenant commands, long flags, repo paths and ADRs against the CLI.

Unknown commands and flags in runbooks, skills and ambient instructions fail,
inline or in fenced `provenant` lines; in other documents, and for paths and
ADRs, they are advisory warnings.
Deleted commands, research index omissions and projection mismatches fail;
strict inventory enforces headers, Anchor paths and diagram metadata. Rust
comments citing Spec: sections always resolve strictly. Runtime absolute paths
and templates are excluded. Commands
scope flags to their own help; flags are checked only after a provenant command.
Lines that say removed, replaced or retired are skipped. Documentation snippets
are never executed. Full mode builds the CLI command catalogue unless
--binary or --help-json supplies it; --inventory-only checks source inventory
without building.
"""

import argparse
import html
import json
from pathlib import Path
import re
import shlex
import subprocess
import sys
import unicodedata
from urllib.parse import unquote


def warn(path, line, kind, reference, level="warning"):
    reference = " ".join(str(reference).split())
    print(f"{path}:{line}: {level}: unresolved {kind} `{reference}`")


def catalogue(args, root):
    try:
        if args.help_json:
            payload = json.loads(Path(args.help_json).read_text())
        else:
            if not args.binary:
                print(
                    "check-doc-truth: building CLI help with cargo run; use --binary, "
                    "--help-json or --inventory-only to avoid a build",
                    file=sys.stderr, flush=True,
                )
            command = (
                [str(Path(args.binary).resolve()), "help", "--all", "--json"]
                if args.binary
                else ["cargo", "run", "--quiet", "--locked", "--bin", "provenant",
                      "--", "help", "--all", "--json"]
            )
            result = subprocess.run(
                command, cwd=root / "tools/front-door", check=True,
                capture_output=True, text=True,
            )
            payload = json.loads(result.stdout)
        data = payload.get("data", payload)
        commands = {entry["command"]: entry for entry in data["commands"]}
        if "provenant" not in commands:
            raise ValueError("catalogue has no provenant command")
        for entry in commands.values():
            flags(entry)
        return commands
    except (OSError, ValueError, KeyError, TypeError, AttributeError, subprocess.CalledProcessError) as error:
        # A missing source must be visible, even though this check is advisory.
        detail = str(error).splitlines()[0]
        warn("check-doc-truth", 1, "CLI help source", detail)
        return None


def inline_code(text):
    """Keep source offsets while excluding fenced examples from inline code."""
    lines = text.splitlines(keepends=True)
    fence = None
    for index, line in enumerate(lines):
        marker = re.match(r"^ {0,3}(`{3,}|~{3,})", line)
        if fence:
            if marker and marker[1][0] == fence[0] and len(marker[1]) >= len(fence):
                fence = None
            lines[index] = re.sub(r"[^\n]", " ", line)
        elif marker:
            fence = marker[1]
            lines[index] = re.sub(r"[^\n]", " ", line)
    masked = "".join(lines)
    for match in re.finditer(r"(?<!`)(`{1,2})(?!`)(.*?)(?<!`)\1(?!`)", masked, re.S):
        first = text.count("\n", 0, match.start())
        last = text.count("\n", 0, match.end())
        context = " ".join(text.splitlines()[first:last + 1])
        yield first + 1, " ".join(match[2].split()), context


def fenced_commands(text):
    """Yield `provenant` command lines from fenced examples, joining continuations."""
    fence, pending = None, None
    for number, line in enumerate(text.splitlines(), 1):
        marker = re.match(r"^ {0,3}(`{3,}|~{3,})", line)
        if fence:
            if marker and marker[1][0] == fence[0] and len(marker[1]) >= len(fence):
                fence = pending = None
                continue
            joined = line.strip()
            if pending:
                pending = (pending[0], pending[1] + " " + joined)
            elif re.match(r"^(?:\$ )?provenant\b", joined):
                pending = (number, joined)
            else:
                continue
            if pending[1].endswith("\\"):
                pending = (pending[0], pending[1][:-1].rstrip())
                continue
            command = re.sub(r"\s#\s.*$", "", pending[1])
            yield pending[0], command, command
            pending = None
        elif marker:
            fence = marker[1]


def flags(entry):
    return {"--" + arg["long"] for arg in entry.get("arguments", []) if arg.get("long")}


def command_scope(reference, commands):
    """Resolve verb words, stopping at a leaf's positional arguments."""
    try:
        words = shlex.split(reference)
    except ValueError:
        words = reference.split()
    if words and words[0] == "$":
        words.pop(0)
    if not words or words.pop(0) != "provenant":
        return None, None
    scopes = ["provenant"]
    index = 0
    while index < len(words):
        word = words[index].strip("[]")
        if word.startswith("-"):
            # Global options may precede verbs. A child name is never a value.
            if "=" not in word and word not in ("--json", "--help", "--version"):
                if index + 1 < len(words) and not any(
                    scope + " " + words[index + 1] in commands for scope in scopes
                ):
                    index += 1
        else:
            if scopes == ["provenant"] and word == "help":
                index += 1
                continue
            if word == "..." or re.fullmatch(r"<[^>]+>|[A-Z][A-Z_]*", word):
                break
            candidates = [scope + " " + alternative for scope in scopes
                          for alternative in word.split("|")]
            if all(candidate in commands for candidate in candidates):
                scopes = candidates
            elif any(key.startswith(scope + " ") for key in commands for scope in scopes):
                return scopes, next(candidate for candidate in candidates if candidate not in commands)
            else:
                break
        index += 1
    return scopes, None


def path_reference(word):
    word = word.strip("\"'(),;[]").rstrip(".")
    # Runtime paths, URLs, model IDs and templates cannot resolve in the repo.
    if (not word or word.startswith(("-", "/", "~", "$"))
            or "://" in word or re.search(r"[<>={}()\"' ]", word)
            or "..." in word.split("/")):
        return None
    word = word.split("#", 1)[0].split("::", 1)[0].rstrip(":")
    if not word or re.search(r"\b[A-Z][A-Z_]+\b", word.replace(".md", "")):
        # Uppercase Markdown filenames (AGENTS.md, CLAUDE.md) are literal.
        if "/" in word or not word.endswith(".md"):
            return None
    if "/" not in word and not re.search(r"\.(?:md|rs|py|sh|toml|json|jsonl|ya?ml|sql|sb)$", word):
        return None
    if "/" in word and not ("." in word.rsplit("/", 1)[-1] or word.startswith(("docs/", "skills/", "scripts/", "tools/front-door/", "config/", "./", "../"))):
        return None
    return word


RETIRED = re.compile(r"\b(?:deleted|removed|replaced|retired|deprecated)\b", re.I)
# Internal commands hidden from `help --json` (clap `hide = true`).
HIDDEN = {"provenant fabric peer", "provenant fabric peer-agent", "provenant hook claude"}


def resolves_path(root, document, reference, gone):
    for base in (root, document.parent, root / "tools/front-door"):
        if any(mark in reference for mark in "*?["):
            if list(base.glob(reference)):
                return True
        elif (base / reference).exists():
            return True
    if "/" not in reference:
        # Bare filenames are runtime state or other tools' files unless they
        # were once tracked and are now gone.
        return reference not in gone
    return False


AMBIENT_DOCS = ("AGENTS.md", "CLAUDE.md", "GLOBAL-AGENTS.md", "MAINTAINING.md")


def is_strict(root, document):
    """Runbooks, skills and ambient instructions must name only real commands and flags."""
    return (document.parent == root / "docs/runbooks"
            or (root / "skills") in document.parents
            or (document.parent == root and document.name in AMBIENT_DOCS))


def retired_section_lines(text):
    """Line numbers under a heading that names removed or retired spellings, listed on purpose."""
    lines, heading = set(), ""
    for number, line in enumerate(text.splitlines(), 1):
        if match := re.match(r"^#{1,6}\s+(.*)", line):
            heading = match[1]
        if RETIRED.search(heading):
            lines.add(number)
    return lines


def check_references(root, document, commands, adrs, gone):
    """Report unresolved references; return the number that fail the check."""
    display = document.relative_to(root)
    text = document.read_text()
    strict = is_strict(root, document)
    level = "error" if strict else "warning"
    failures = 0
    references = list(inline_code(text))
    if strict:
        references += list(fenced_commands(text))
    retired_lines = retired_section_lines(text)
    for line, reference, context in references:
        if RETIRED.search(context) or line in retired_lines:
            continue
        scopes, missing = command_scope(reference, commands) if commands else (None, None)
        if missing and missing not in HIDDEN:
            warn(display, line, "command", missing, level)
            failures += strict
        if commands and scopes:
            known_flags = (set().union(*(flags(commands[scope]) for scope in scopes))
                           | flags(commands["provenant"]))
            if re.match(r"^(?:\$ )?provenant help\b", reference):
                known_flags.add("--all")
            # Flags inside a shell substitution belong to another command.
            own = re.sub(r"\$\((?:[^()]|\([^()]*\))*\)", "", reference)
            for flag in dict.fromkeys(re.findall(r"(?<![\w-])--[a-z][a-z0-9-]*", own)):
                if flag not in known_flags:
                    warn(display, line, "flag", flag, level)
                    failures += strict
        for number in dict.fromkeys(re.findall(r"\bADR[ -]+(\d{1,4})\b", reference, re.I)):
            if int(number) not in adrs:
                warn(display, line, "ADR", f"ADR {number}")
        for word in dict.fromkeys(reference.split()):
            path = path_reference(word)
            if path and not resolves_path(root, document, path, gone):
                warn(display, line, "path", path)
    return failures



def heading_anchors(text):
    """GitHub heading slugs: inline text, punctuation removal and unique suffixes."""
    text = re.sub(r"<!--.*?-->", "", text, flags=re.S)
    used, fence, previous = set(), None, ""
    for line in text.splitlines():
        marker = re.match(r"^ {0,3}(`{3,}|~{3,})", line)
        if fence:
            if marker and marker[1][0] == fence[0] and len(marker[1]) >= len(fence):
                fence = None
            continue
        if marker:
            fence, previous = marker[1], ""
            continue
        atx = re.match(r"^ {0,3}#{1,6}(?:[ \t]+(.*?)|$)$", line)
        setext = re.fullmatch(r" {0,3}(?:=+|-+)[ \t]*", line)
        if atx:
            title = re.sub(r"[ \t]+#+[ \t]*$", "", atx[1] or "")
        elif setext and previous.strip():
            title = previous.strip()
        else:
            previous = line if not line.startswith(("    ", "\t")) else ""
            continue
        # Protect code spans: underscores and angle brackets there are literal.
        code = []
        def protect(match):
            code.append(match[2])
            return f"\x00{len(code) - 1}\x00"
        title = re.sub(r"(`+)(.*?)\1", protect, title)
        # Render links as labels and HTML as its visible text before slugging.
        title = re.sub(r"!?\[([^]]*)\]\((?:[^()]|\([^()]*\))*\)", r"\1", title)
        title = re.sub(r"!?\[([^]]*)\]\[[^]]*\]", r"\1", title)
        title = re.sub(r"<((?:https?://|mailto:)[^>]+)>", r"\1", title)
        title = re.sub(r"<[^>]*>", "", title)
        title = re.sub(r"(?<!\w)(_+)(.*?)\1(?!\w)", r"\2", title)
        title = html.unescape(title)
        title = re.sub(r"\x00(\d+)\x00", lambda match: code[int(match[1])], title).lower()
        slug = "".join(char for char in title if char in "-_ " or
                       unicodedata.category(char)[0] in "LMN").replace(" ", "-")
        anchor, suffix = slug, 0
        while anchor in used:
            suffix += 1
            anchor = f"{slug}-{suffix}"
        used.add(anchor)
        previous = ""
    return used


# Skip Rust strings and character literals so examples cannot become evidence.
RUST_TOKENS = re.compile(
    r'\b(?:br|cr|r)(?P<hashes>\#{0,255})".*?"(?P=hashes)'
    r'|"(?:\\.|[^"\\])*"'
    r"|'(?:\\(?:u\{[^}]*\}|x[0-9a-fA-F]{2}|.)|[^'\\\n])'"
    r'|(?P<line>//[^\n]*)|(?P<block>/\*)', re.S,
)


def rust_comments(text):
    """Yield comment offsets and text, including nested Rust block comments."""
    offset = 0
    while token := RUST_TOKENS.search(text, offset):
        offset = token.end()
        if token.lastgroup == "line":
            yield token.start(), token[0]
        elif token.lastgroup == "block":
            depth = 1
            while depth and (marker := re.search(r"/\*|\*/", text[offset:])):
                depth += 1 if marker[0] == "/*" else -1
                offset += marker.end()
            if depth:
                offset = len(text)
            yield token.start(), text[token.start():offset]


def check_spec_citations(root):
    """Rust comments point to a living spec section; dangling links always fail."""
    cache, errors = {}, 0
    for source in sorted((root / "tools/front-door").rglob("*.rs")):
        text = source.read_text()
        for offset, comment in rust_comments(text):
            for match in re.finditer(r"(?<![\w:])Spec:(?!:)\s*([^\s*]+)?", comment):
                reference = (match[1] or "").strip("`.,;()[]{}")
                target = re.fullmatch(r"(docs/specs/[\w.-]+\.md)#([^#]+)", reference)
                valid = False
                if target:
                    path = root / target[1]
                    if path.is_file():
                        if path not in cache:
                            cache[path] = heading_anchors(path.read_text())
                        valid = unquote(target[2]) in cache[path]
                if not valid:
                    line = text.count("\n", 0, offset + match.start()) + 1
                    warn(source.relative_to(root), line, "spec citation", reference or "Spec: (missing target)", "error")
                    errors += 1
    return errors


def check_anchors(root, document):
    """Resolve paths in the opening Anchor, including Markdown link targets."""
    lines = document.read_text().splitlines()
    start = next((i for i, line in enumerate(lines) if line.startswith("Anchor:")), None)
    if start is None:
        return 0  # Missing headers are reported by inventory().
    block = [lines[start]]
    for line in lines[start + 1:]:
        if not line.strip() or not (line.startswith(("`", "[", " ", "\t"))
                                    or block[-1].rstrip().endswith((",", ";"))):
            break
        block.append(line)
    text = " ".join(block)
    targets = re.findall(r"\]\(([^)]+)\)", text)
    # Remove links first: their labels may name symbols rather than paths.
    text = re.sub(r"\[[^\]]*\]\([^)]+\)", "", text)
    targets += [word.strip("`;, ") for word in text.removeprefix("Anchor:").split()]
    missing = 0
    for target in dict.fromkeys(targets):
        path = path_reference(target)
        if path and not resolves_path(root, document, path, {path}):
            warn(document.relative_to(root), start + 1, "Anchor path", target)
            missing += 1
    return missing


def check_spec_index(root):
    """Every living area spec must be reachable from its directory index."""
    index = root / "docs/specs/README.md"
    if not index.exists():
        return 0
    targets = {target.split("#", 1)[0] for target in
               re.findall(r"\]\(([^)]+)\)", index.read_text())}
    missing = 0
    for spec in sorted(index.parent.glob("*.md")):
        if spec != index and spec.name not in targets:
            warn(index.relative_to(root), 1, "spec index entry", spec.name)
            missing += 1
    return missing


SPEC_WORD_CAP = 2000


def check_spec_length(root):
    """Specs are invariants pages; past the cap, behaviour is being narrated."""
    for spec in sorted((root / "docs/specs").glob("*.md")):
        words = len(spec.read_text().split())
        if words > SPEC_WORD_CAP:
            print(f"{spec.relative_to(root)}:1: warning: spec has {words} words, "
                  f"over the {SPEC_WORD_CAP}-word cap; name owning symbols instead of narrating")


def check_diagrams(root, document):
    """Mermaid accessibility metadata is structural; visual review is separate."""
    missing = 0
    text = document.read_text()
    for match in re.finditer(r"^```mermaid\n(.*?)^```", text, re.M | re.S):
        for field in ("accTitle", "accDescr"):
            description = re.search(r"^\s*accDescr\s*\{([^}]+)\}", match[1], re.M | re.S)
            multiline = field == "accDescr" and description and description[1].strip()
            if not multiline and not re.search(r"^\s*" + field + r"\s*:[ \t]*\S", match[1], re.M):
                warn(document.relative_to(root), text.count("\n", 0, match.start()) + 1,
                     "diagram metadata", field)
                missing += 1
    return missing


def inventory(root, document):
    """Owner: and Anchor: open the first paragraph below the title; values may wrap."""
    lines = document.read_text().splitlines()
    title = next((index for index, line in enumerate(lines) if line.startswith("# ")), None)
    start = title + 1 if title is not None else 0
    while start < len(lines) and not lines[start].strip():
        start += 1
    end = start
    while end < len(lines) and lines[end].strip():
        end += 1
    block = lines[start:end]
    missing = 0
    for name, first in (("Owner", True), ("Anchor", False)):
        found = [line for line in block if re.fullmatch(name + r":\s*\S.*", line)]
        if not found or (first and not block[0].startswith("Owner:")):
            warn(document.relative_to(root), start + 1, "inventory", f"{name}: in the paragraph below the title")
            missing += 1
    return missing


def check_research_index(root):
    """Every note under docs/research is linked from its README index."""
    base = root / "docs/research"
    index = base / "README.md"
    if not index.exists():
        return 0
    text = index.read_text()
    errors = 0
    for path in sorted(base.rglob("*.md")):
        relative = path.relative_to(base).as_posix()
        if path != index and relative not in text and path.parent.relative_to(base).as_posix() + "/README.md" not in text:
            print(f"{index.relative_to(root)}: error: {relative} is not linked from the research index")
            errors += 1
    return errors


ANCHOR_PATH = re.compile(r"`([^`\s]+)`|(?<![\w./-])([\w-]+\.(?:md|rs|py|toml|json|ya?ml|sh))(?![\w/-])|(?<![\w./-])((?:\.\./|\.github/|docs/|scripts/|skills/|tools/|config/|crates/|src/|tests/)[\w./-]+)")


def anchors(root, document):
    """Each Anchor: path resolves, and at least one names a file, not a directory."""
    lines = document.read_text().splitlines()
    index = next((number for number, line in enumerate(lines) if line.startswith("Anchor:")), None)
    if index is None:
        return 0  # inventory() reports the missing header.
    block = [lines[index][len("Anchor:"):]]
    # A wrapped value continues after a trailing separator or on a line that opens with a reference.
    while index + len(block) < len(lines) and (
            re.match(r"[`\[]", lines[index + len(block)]) or block[-1].rstrip().endswith((",", ";"))):
        block.append(lines[index + len(block)])
    display = document.relative_to(root)
    found = []
    text = " ".join(block)
    # A link's target is the evidence; its label is only a name for it.
    references = re.findall(r"\]\(([^)\s#]+)[^)]*\)", text)
    text = re.sub(r"\[[^\]]*\]\([^)]*\)", " ", text)
    references += [match[1] or match[2] or match[3] for match in ANCHOR_PATH.finditer(text)]
    for reference in references:
        reference = reference.split("#", 1)[0].split("::", 1)[0].rstrip(".,;:")
        if not reference or "://" in reference or ("/" not in reference and "." not in reference):
            continue
        bases = (document.parent, root, root / "tools/front-door")
        target = next((base / reference for base in bases if (base / reference).exists()), None)
        if target is None:
            print(f"{display}:{index + 1}: error: Anchor path `{reference}` does not resolve")
            return 1
        found.append(target)
    if not any(path.is_file() for path in found):
        print(f"{display}:{index + 1}: error: Anchor names no source file or declaration")
        return 1
    return 0


# Cutover surfaces are explicit so archived ADRs, release notes and source-symbol
# citations remain usable evidence. These are the maintained command guides.
COMMAND_GUIDES = (
    "README.md", "AGENTS.md", "CLAUDE.md", "GLOBAL-AGENTS.md", "MAINTAINING.md",
    "docs/worktrees.md", "docs/ARCHITECTURE.md", "docs/glossary.md",
    "config/harness-knobs.json", "tools/front-door/crates/run/README.md",
)
# Bare verb names in code spans are read as removed commands only here; elsewhere
# (skills, other runbooks) a span such as `review set` is ordinary prose.
SHORTHAND_GUIDES = (
    "README.md", "docs/worktrees.md", "tools/front-door/crates/run/README.md",
    "docs/runbooks/ci.md",
)
# Directories whose Markdown (or template) files are command guides too.
COMMAND_GUIDE_GLOBS = (
    "docs/runbooks/*.md", "docs/specs/*.md", "skills/**/*.md",
    "tools/front-door/crates/fabric-runtime/assets/templates/*.toml",
)
GLOBAL_SWITCHES = {"--json", "--full", "--help", "--version", "-h", "-V"}
GLOBAL_VALUES = {"--project", "--state-dir"}
# The one source of removed spellings is the CLI's own REMOVED table.
REMOVED_SOURCE = "tools/front-door/crates/config/src/removed.rs"


def removed_table(source):
    """Read (command words, flag or None, replacement) from the CLI's REMOVED table."""
    text = source.read_text()
    block = text.split("pub const REMOVED", 1)[1].split("\n];", 1)[0]
    entries = []
    for match in re.finditer(
            r"\b(verb|flag)\(\s*&\[([^\]]*)\]\s*,\s*(?:\"([^\"]+)\"\s*,\s*)?\"([^\"]+)\"", block):
        words = tuple(re.findall(r'"([^"]+)"', match[2]))
        flag = match[3] if match[1] == "flag" else None
        entries.append((words, flag, match[4]))
    if not entries or len(entries) != len(re.findall(r"\b(?:verb|flag)\(", block)):
        raise ValueError(f"{source}: cannot read every REMOVED entry")
    return entries


def command_words(text):
    """Command words and long flags of one command, after `provenant`, up to a shell operator."""
    segment = re.split(r"\|\||&&|[|;]|\s>|\s2>|`", text, maxsplit=1)[0]
    try:
        tokens = shlex.split(segment)
    except ValueError:
        tokens = segment.split()
    words, flags, tokens = [], [], iter(tokens)
    for token in tokens:
        token = token.strip("[]").rstrip(".,;:)")
        option, equal, _ = token.partition("=")
        if option in GLOBAL_VALUES:
            if not equal:
                next(tokens, None)  # A quoted path is one value, even if it names a verb.
        elif option in GLOBAL_SWITCHES or not token:
            continue
        elif option.startswith("--"):
            flags.append(option[2:])
        elif not token.startswith("-") and token != "help":
            words.append(token)
    return words, flags


def removed_use(text, table):
    """The table entry a command uses (as the CLI's own parser matches it), or None."""
    words, flags = command_words(text)
    for entry in table:
        path, flag, _ = entry
        if (words[:len(path)] == list(path)) and (flag is None or flag in flags):
            return entry
    return None


def spelling(entry):
    path, flag, _ = entry
    return "provenant " + " ".join(path) + (f" --{flag}" if flag else "")


def command_guides(root):
    found = {root / name for name in COMMAND_GUIDES}
    for pattern in COMMAND_GUIDE_GLOBS:
        found |= set(root.glob(pattern))
    return sorted(path for path in found if path.is_file())


def check_deleted_commands(root):
    """Fail on removed command and flag uses, keeping template names, wire fields and prose valid."""
    try:
        table = removed_table(Path(__file__).resolve().parent.parent / REMOVED_SOURCE)
    except (OSError, IndexError, ValueError) as error:
        print(f"check-doc-truth: error: cannot read the CLI's removed spellings: {error}")
        return 1
    verbs = sorted({path[0] for path, flag, _ in table if flag is None and len(path) == 1})
    verb_pattern = "(?:" + "|".join(re.escape(verb) for verb in verbs) + ")"
    # A bare code span such as `output --trace` names its command by its first
    # word, so only a removed flag of that command is read from it.
    flagged = {path[0] for path, flag, _ in table if flag}
    count = 0
    for document in command_guides(root):
        relative = document.relative_to(root)
        text = document.read_text()
        findings = {}
        retired_lines = retired_section_lines(text)
        # Explicit commands include fenced shell examples and table cells; a
        # command continued with a trailing backslash is one command.
        joined, pending = [], None
        for number, line in enumerate(text.splitlines(), 1):
            if pending:
                pending = (pending[0], pending[1] + " " + line.strip())
            else:
                pending = (number, line)
            if pending[1].rstrip().endswith("\\"):
                pending = (pending[0], pending[1].rstrip()[:-1])
                continue
            joined.append(pending)
            pending = None
        if pending:
            joined.append(pending)
        for number, line in joined:
            if RETIRED.search(line) or number in retired_lines:
                continue
            for match in re.finditer(r"\bprovenant\s+", line):
                if entry := removed_use(line[match.end():], table):
                    findings.setdefault(number, {})[spelling(entry)] = entry[2]
        for number, reference, context in inline_code(text):
            if RETIRED.search(context) or number in retired_lines:
                continue
            if re.match(r"(?:\$ )?provenant\s", reference):
                continue  # Read above, on its own line.
            if (reference.split(" ", 1)[0] in flagged
                    and (entry := removed_use(reference, table)) and entry[1]):
                findings.setdefault(number, {})[spelling(entry)] = entry[2]
                continue
            if relative.as_posix() not in SHORTHAND_GUIDES and relative.parent.as_posix() != "docs/specs":
                continue
            # Bare names may be template names or structured field values. A
            # following argument, or an explicit command/tool label, makes the
            # command intent unambiguous. Symbols and file paths do not match.
            shorthand = re.match(
                r"^(?:fabric\s+graph|graph\s+(?:resume|cancel))(?=\s|$)"
                r"|^fabric_graph$|^" + verb_pattern + r"\s+\S", reference,
            )
            labelled = (re.fullmatch(verb_pattern, reference)
                        and re.search(
                            r"(?:\b(?:command|verb|tool|run|use|invoke|call)\s+`"
                            + re.escape(reference) + r"`(?!\s+(?:template|field|parameter)\b)"
                            r"|`" + re.escape(reference) + r"`\s+(?:command|verb|tool)\b)",
                            context, re.I))
            if shorthand or labelled:
                findings.setdefault(number, {})[reference] = "the graph CLI"
        for number, references in sorted(findings.items()):
            for reference, replacement in sorted(references.items()):
                print(f"{relative}:{number}: error: deleted command `{reference}`; use {replacement}")
                count += 1
    return count


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    source = parser.add_mutually_exclusive_group()
    source.add_argument("--binary", help="worktree-built CLI (reuses the CI build)")
    source.add_argument("--help-json", help="CLI help catalogue fixture, with or without result envelope")
    parser.add_argument("--inventory-only", action="store_true", help="check documentation evidence without loading the CLI catalogue")
    parser.add_argument("--strict-inventory", action="store_true", help="fail on missing headers, Anchor paths, spec index entries or diagram metadata")
    args = parser.parse_args()
    root = args.root.resolve()
    command_errors = check_deleted_commands(root) + check_research_index(root)
    commands = None if args.inventory_only else catalogue(args, root)
    adrs = {int(match[1]) for path in (root / "docs/adr").glob("*.md")
            if (match := re.match(r"(\d+)-", path.name))}
    # Bare filenames are checked only against paths once tracked and now gone:
    # deleted in history, or listed in the index but missing from the worktree.
    gone = set()
    try:
        listed = subprocess.run(["git", "ls-files", "-z"], cwd=root, check=True,
                                capture_output=True, text=True).stdout.split("\0")
        gone |= {Path(path).name for path in listed if path and not (root / path).exists()}
        deleted = subprocess.run(
            ["git", "log", "--diff-filter=D", "--name-only", "--pretty=format:", "-z"],
            cwd=root, check=True, capture_output=True, text=True).stdout.split("\0")
        gone |= {Path(path.strip()).name for path in deleted
                 if path.strip() and not (root / path.strip()).exists()}
    except (OSError, subprocess.CalledProcessError):
        pass
    documents = sorted((root / "docs/runbooks").glob("*.md")) + sorted((root / "docs/specs").glob("*.md"))
    maintained = [root / "docs/worktrees.md", root / "docs/ARCHITECTURE.md", root / "docs/glossary.md"]
    maintained = [path for path in maintained if path.exists()]
    evidence = documents + maintained
    missing = sum(inventory(root, document) for document in evidence
                  if document in documents or document.name == "worktrees.md")
    missing += sum(check_anchors(root, document) for document in evidence)
    missing += check_spec_index(root)
    check_spec_length(root)
    adr_documents = sorted((root / "docs/adr").glob("*.md"))
    missing += sum(check_diagrams(root, document) for document in evidence + adr_documents)
    citations = check_spec_citations(root)
    missing += sum(anchors(root, document) for document in evidence
                   if document in documents)
    reference_errors = 0
    if not args.inventory_only:
        ambient = [root / name for name in AMBIENT_DOCS]
        skills = sorted((root / "skills").rglob("*.md"))
        for document in [path for path in ambient if path.exists()] + skills + documents + maintained + adr_documents:
            reference_errors += check_references(root, document, commands, adrs, gone)
    return int(bool(command_errors) or bool(reference_errors) or (args.strict_inventory and bool(missing)) or bool(citations))


if __name__ == "__main__":
    raise SystemExit(main())
