#!/usr/bin/env python3
"""Select nextest packages affected by paths changed between BASE_SHA and HEAD_SHA."""

import json
import os
import subprocess
import sys


FULL_RUN_PATHS = (
    "tools/front-door/Cargo.toml",
    "tools/front-door/rust-toolchain.toml",
    "tools/front-door/.config/nextest.toml",
    ".github/workflows/ci.yml",
)


def git(*args):
    result = subprocess.run(["git", *args], capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "git command failed")
    return result.stdout


def full(reason):
    print(f"{reason}; running the full Rust workspace", file=sys.stderr)
    return "", True


def select(root, base, head, is_main):
    if is_main:
        return full("main push")
    if not base or not head:
        return full("base or head SHA unavailable")
    try:
        git("merge-base", base, head)
        changed = git("diff", "--name-only", "--no-renames", f"{base}...{head}").splitlines()
    except RuntimeError:
        return full("base, head, or merge base unavailable")
    if not changed:
        return full("no changed paths found")

    for path in changed:
        if path in FULL_RUN_PATHS or os.path.basename(path) in ("Cargo.lock", "build.rs") or path.startswith(
            ("tools/front-door/assets/", "skills/", "roles/")
        ):
            return full(f"{path} is a full-run trigger")

    try:
        metadata = json.loads(
            subprocess.run(
                ["cargo", "metadata", "--format-version", "1", "--no-deps"],
                cwd=os.path.join(root, "tools/front-door"),
                capture_output=True,
                text=True,
                check=True,
            ).stdout
        )
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return full("Cargo workspace metadata unavailable")

    packages = {}
    for package in metadata.get("packages", []):
        manifest = os.path.relpath(package["manifest_path"], root)
        packages[os.path.dirname(manifest)] = package["name"]

    selected = set()
    for path in changed:
        directory = os.path.dirname(path)
        while directory and directory != ".":
            if directory in packages:
                selected.add(packages[directory])
                break
            parent = os.path.dirname(directory)
            if parent == directory:
                break
            directory = parent
        else:
            return full(f"{path} is outside a workspace crate")
        if not directory or directory == ".":
            return full(f"{path} is outside a workspace crate")

    workspace_packages = {package["name"]: package for package in metadata["packages"]}
    graph = {name: set() for name in workspace_packages}
    for depender, package in workspace_packages.items():
        for dependency in package.get("dependencies", []):
            dependency_name = dependency["name"]
            if dependency_name in graph:
                graph[dependency_name].add(depender)

    affected = set(selected)
    pending = list(selected)
    while pending:
        package = pending.pop()
        for depender in graph.get(package, ()):
            if depender not in affected:
                affected.add(depender)
                pending.append(depender)

    expression = " | ".join(f"rdeps(={name})" for name in sorted(selected))
    print(
        f"{', '.join(sorted(selected))} changed; selecting {', '.join(sorted(affected))}",
        file=sys.stderr,
    )
    return expression, "provenant-providers" in affected


def main():
    repository = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    root = os.path.abspath(os.environ.get("GITHUB_WORKSPACE", repository))
    expression, provider_affected = select(
        root,
        os.environ.get("BASE_SHA", ""),
        os.environ.get("HEAD_SHA", ""),
        os.environ.get("IS_MAIN", "false") == "true",
    )
    output_path = os.environ.get("GITHUB_OUTPUT")
    if output_path:
        with open(output_path, "a", encoding="utf-8") as output:
            output.write(f"nextest_filter={expression}\n")
            output.write(f"run_provider_example={str(provider_affected).lower()}\n")
        print(f"nextest filter: {expression or '(full workspace)'}")
    else:
        print(expression)


if __name__ == "__main__":
    try:
        main()
    except RuntimeError as error:
        print(f"{error}; running the full Rust workspace", file=sys.stderr)
        print()
