#!/usr/bin/env python3
"""Exercise the inventory through its command-line interface."""

import json
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest


SCRIPT = Path(__file__).with_name("check-skill-negatives")


class InventoryTests(unittest.TestCase):
    def test_reports_a_gap_unless_two_distinct_negatives_exclude_the_target(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            skill = root / "example"
            (skill / "evals").mkdir(parents=True)
            (skill / "SKILL.md").write_text("# Example\n")
            fixture = skill / "evals/trigger_cases.json"
            negative = {
                "id": "q1", "relation": "negative", "prompt": "Adjacent task",
                "tags": ["near-miss"],
                "expected": {"primary_skill": "other", "companion_skills": []},
            }
            second = dict(negative, id="q2", prompt="Another adjacent task")

            def check(cases):
                fixture.write_text(json.dumps({
                    "schema_version": 1, "target_skill": "example", "cases": cases,
                }))
                return subprocess.run(
                    [sys.executable, str(SCRIPT), str(root)],
                    capture_output=True, text=True, check=False,
                )

            self.assertEqual(check([negative, second]).returncode, 0)
            for short in (
                [negative],
                [negative, negative],
                [negative, dict(second, expected={
                    "primary_skill": "other", "companion_skills": ["example"],
                })],
                [negative, dict(second, tags=["adjacent"])],
            ):
                result = check(short)
                self.assertEqual(result.returncode, 0)
                self.assertIn("example", result.stdout)
                self.assertIn("need at least 2", result.stdout)
            fixture.unlink()
            missing = subprocess.run(
                [sys.executable, str(SCRIPT), str(root)],
                capture_output=True, text=True, check=False,
            )
            self.assertNotEqual(missing.returncode, 0)
            self.assertIn("example", missing.stderr)

    def test_inventories_every_root_given(self):
        negative = {
            "id": "q1", "relation": "negative", "prompt": "Adjacent task",
            "tags": ["near-miss"],
            "expected": {"primary_skill": "other", "companion_skills": []},
        }
        with tempfile.TemporaryDirectory() as directory:
            base = Path(directory)
            for name in ("skills", "library"):
                skill = base / name / "example"
                (skill / "evals").mkdir(parents=True)
                (skill / "SKILL.md").write_text("# Example\n")
            cases = {
                "skills": [negative, dict(negative, id="q2", prompt="Another adjacent task")],
                "library": [negative],
            }

            def check():
                for name, selected in cases.items():
                    (base / name / "example/evals/trigger_cases.json").write_text(json.dumps({
                        "schema_version": 1, "target_skill": "example", "cases": selected,
                    }))
                return subprocess.run(
                    [sys.executable, str(SCRIPT), str(base / "skills"), str(base / "library")],
                    capture_output=True, text=True, check=False,
                )

            single = check()
            self.assertEqual(single.returncode, 0)
            self.assertIn("library/example", single.stdout)
            cases["library"] = [negative, dict(negative, id="q3", prompt="Third adjacent task")]
            self.assertEqual(check().returncode, 0)


if __name__ == "__main__":
    unittest.main()
