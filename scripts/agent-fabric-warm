#!/bin/sh
# Rebuild the workspace dist when the compiled fabric CLI is absent or older
# than its TypeScript sources, so scripts/agent-fabric and
# scripts/agent-fabric-mcp keep executing compiled JS instead of falling back
# to the slow tsx loader path. No-op when the dist is already fresh.
set -eu

script_path=$0
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case "$link" in
    /*) script_path=$link ;;
    *) script_path=$(dirname "$script_path")/$link ;;
  esac
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
agents_home=${AGENTS_HOME:-"$(dirname -- "$script_dir")"}
case "$agents_home" in /*) ;; *) echo "AGENTS_HOME must be absolute" >&2; exit 2 ;; esac
package_root="$agents_home/runtime/agent-fabric"

node "$package_root/scripts/verify-npm-ci-attestation.mjs" "$agents_home"

dist_cli="$package_root/dist/cli/main.js"
dist_mcp="$package_root/dist/mcp/main.js"
protocol_root="$agents_home/runtime/agent-fabric-protocol"
protocol_dist="$protocol_root/dist/index.js"
herdr_root="$agents_home/runtime/agent-fabric-herdr"
herdr_dist="$herdr_root/dist/bin.js"
console_root="$agents_home/runtime/agent-fabric-console"
console_dist="$console_root/dist/bin.js"
build_lock_library="$script_dir/lib/agent-fabric-protocol-build-lock.sh"
repair_command="AGENTS_HOME=\"$agents_home\" \"$agents_home/scripts/agent-fabric-warm\""

. "$script_dir/lib/agent-fabric-workspace-freshness.sh"

node --import tsx "$package_root/scripts/generate-runtime-build-identity.ts"

workspace_stale=false
if workspace_is_stale "$protocol_root" "$protocol_dist" \
  || workspace_is_stale "$package_root" "$dist_cli" "$dist_mcp" \
  || workspace_is_stale "$herdr_root" "$herdr_dist" \
  || workspace_is_stale "$console_root" "$console_dist"; then
  workspace_stale=true
fi

if [ "$workspace_stale" = false ]; then
  echo "agent-fabric dist fresh: $dist_cli"
  exit 0
fi

if [ ! -d "$agents_home/node_modules" ]; then
  echo "agent-fabric dist stale and node_modules missing; rerun $agents_home/scripts/install-agent-fabric-dependencies first" >&2
  exit 1
fi

[ -f "$build_lock_library" ] || {
  echo "AGENT_FABRIC_PROTOCOL_BUILD_LOCK_INCOMPLETE: missing \"$build_lock_library\"" >&2
  echo "repair: reinstall the harness scripts directory, including scripts/lib" >&2
  exit 78
}
. "$build_lock_library"
protocol_build_lock_acquire "$protocol_root/dist" "$repair_command"

# Another repair may have completed while this caller waited. Re-evaluate every
# output under the lock and return without a second root build when that repair
# already produced and stamped the complete workspace.
workspace_stale=false
if workspace_is_stale "$protocol_root" "$protocol_dist" \
  || workspace_is_stale "$package_root" "$dist_cli" "$dist_mcp" \
  || workspace_is_stale "$herdr_root" "$herdr_dist" \
  || workspace_is_stale "$console_root" "$console_dist"; then
  workspace_stale=true
fi
if [ "$workspace_stale" = false ]; then
  echo "agent-fabric dist fresh after repair wait: $dist_cli"
  exit 0
fi

echo "agent-fabric dist stale; rebuilding workspace"
cd "$agents_home"
manifest_digest=$(workspace_root_manifest_digest "$agents_home") || {
  echo "agent-fabric warm cannot digest the root manifests in $agents_home" >&2
  exit 1
}
npm run build
manifest_digest_after=$(workspace_root_manifest_digest "$agents_home") || {
  echo "agent-fabric warm could not re-read the root manifests after the build" >&2
  exit 1
}
[ "$manifest_digest" = "$manifest_digest_after" ] || {
  echo "agent-fabric warm inputs changed during the build; retry" >&2
  exit 1
}
printf '%s\n' "$manifest_digest" > "$protocol_root/dist/.root-manifests.sha256" || {
  echo "agent-fabric warm could not record protocol root-manifest freshness" >&2
  exit 1
}

# The incremental build re-emits only changed outputs, so bump the wrapper
# freshness sentinels once the build has succeeded; otherwise an unchanged
# entrypoint can remain older than a dependency and force every warm to build.
touch "$protocol_dist" "$dist_cli" "$dist_mcp" "$herdr_dist" "$console_dist"
