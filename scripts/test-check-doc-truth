#!/usr/bin/env python3
"""Focused controls for runbook reference failures, advisory spec warnings and the inventory gate."""

import test_git_env
test_git_env.isolate()

import importlib.machinery
import importlib.util
import json
from pathlib import Path
import shutil
import subprocess
import tempfile
import unittest


SCRIPTS = Path(__file__).resolve().parent
FIXTURES = SCRIPTS / "fixtures/doc-truth"
_loader = importlib.machinery.SourceFileLoader("check_doc_truth", str(SCRIPTS / "check-doc-truth"))
check_doc_truth = importlib.util.module_from_spec(importlib.util.spec_from_loader(_loader.name, _loader))
_loader.exec_module(check_doc_truth)


class DocTruthTests(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory(prefix="provenant-doc-truth-")
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)
        for directory in ("docs/runbooks", "docs/specs", "docs/adr", "tools/front-door"):
            (self.root / directory).mkdir(parents=True)
        (self.root / "AGENTS.md").write_text("# Instructions\n")
        (self.root / "docs/adr/0001-example.md").write_text("# Example\n")
        (self.root / "tools/front-door/src").mkdir()
        (self.root / "tools/front-door/src/main.rs").write_text("fn main() {}\n")

    def check(self, *args, source=True):
        command = [str(SCRIPTS / "check-doc-truth"), "--root", str(self.root)]
        if source:
            command += ["--help-json", str(FIXTURES / "help.json")]
        return subprocess.run(command + list(args), capture_output=True, text=True)

    def document(self, text):
        path = self.root / "docs/runbooks/example.md"
        path.write_text(text)
        return path

    def test_test_citations_resolve_and_fail_strictly(self):
        source = self.root / "tools/front-door/crates/example/src/lib.rs"
        source.parent.mkdir(parents=True)
        source.write_text("mod tests { fn present() {} }\n")
        spec = self.root / "docs/specs/example.md"
        spec.write_text("# Example\n\nOwner: example\nAnchor: example\n\n"
                        "- Test: `crates/example/src/lib.rs::present`;\n"
                        "  `crates/example/src/lib.rs::missing`\n")
        result = self.check("--inventory-only", "--strict-citations", source=False)
        self.assertEqual(result.returncode, 1, result.stdout)
        self.assertIn("lib.rs::missing", result.stdout)
        self.assertNotIn("lib.rs::present", result.stdout)
        source.write_text("mod tests { fn present() {} fn missing() {} }\n")
        self.assertEqual(self.check("--inventory-only", "--strict-citations", source=False).returncode, 0)

    def test_grouped_and_shorthand_citations_share_only_the_current_test_block(self):
        source = self.root / "tools/front-door/tests/example.rs"
        source.parent.mkdir(parents=True)
        source.write_text("fn first() {} fn second() {} fn third() {}\n")
        spec = self.root / "docs/specs/example.md"
        spec.write_text("# Example\nOwner: example\nAnchor: tests/example.rs\n\n"
                        "- Test: `tests/example.rs::tests::{first, second}`;\n"
                        "  `::third`; `::missing`\n"
                        "- Why: grouped lists have one source.\n\n"
                        "- Test: `::first`\n")
        result = self.check("--inventory-only", "--strict-citations", source=False)
        self.assertEqual(result.returncode, 1, result.stdout)
        self.assertEqual(result.stdout.count("unresolved test citation"), 2, result.stdout)
        self.assertIn("example.md:6:", result.stdout)
        self.assertIn("(no preceding path)::first", result.stdout)

    def test_plural_hash_and_file_citations_are_checked(self):
        source = self.root / "tools/front-door/tests/example.rs"
        source.parent.mkdir(parents=True)
        source.write_text("fn present() {}\n")
        spec = self.root / "docs/specs/example.md"
        spec.write_text("# Example\nOwner: example\nAnchor: tools/front-door\n\n"
                        "Tests: `tests/example.rs#present`; `tests/example.rs#missing`;\n"
                        "  `tests/absent.rs`\n")
        result = self.check("--inventory-only", "--strict-citations", source=False)
        self.assertEqual(result.returncode, 1, result.stdout)
        self.assertEqual(result.stdout.count("unresolved test citation"), 2, result.stdout)
        self.assertNotIn("#present", result.stdout)
        source.write_text("fn present() {} fn missing() {}\n")
        (source.parent / "absent.rs").write_text("fn file_level_coverage() {}\n")
        self.assertEqual(self.check("--inventory-only", "--strict-citations", source=False).returncode, 0)

    def test_strict_inventory_checks_anchor_paths_index_and_diagram_metadata(self):
        self.document("# Example\nOwner: maintainers\nAnchor: `tools/front-door/missing.rs#check`\n")
        (self.root / "docs/specs/README.md").write_text(
            "# Specs\nOwner: maintainers\nAnchor: tools/front-door/missing.rs\n")
        (self.root / "docs/specs/new.md").write_text(
            "# New\nOwner: maintainers\nAnchor: [source](../../tools/front-door/missing.rs)\n")
        architecture = self.root / "docs/ARCHITECTURE.md"
        architecture.write_text("# Architecture\n\n```mermaid\nflowchart LR\nA --> B\n```\n")
        result = self.check("--inventory-only", "--strict-inventory", source=False)
        self.assertEqual(result.returncode, 1, result.stdout)
        for kind in ("Anchor path", "spec index entry", "diagram metadata"):
            self.assertIn("unresolved " + kind, result.stdout)
        self.assertEqual(result.stdout.count("diagram metadata"), 2)
        (self.root / "tools/front-door/missing.rs").write_text("fn check() {}\n")
        index = self.root / "docs/specs/README.md"
        index.write_text(index.read_text() + "\n[New](new.md)\n")
        architecture.write_text("# Architecture\n\n```mermaid\nflowchart LR\n"
                                "accTitle: Example\naccDescr {\nA points to B.\n}\nA --> B\n```\n")
        self.assertEqual(self.check("--inventory-only", "--strict-inventory", source=False).returncode, 0)

    def test_strict_citations_check_every_spec(self):
        for name in ("disk", "supervisor", "routing"):
            (self.root / f"docs/specs/{name}.md").write_text(
                "# Spec\nOwner: maintainers\nAnchor: tools/front-door\n\n"
                "Test: `tests/missing.rs::missing`\n")
        result = self.check("--inventory-only", "--strict-citations", source=False)
        self.assertEqual(result.returncode, 1, result.stdout)
        self.assertEqual(result.stdout.count("unresolved test citation"), 3, result.stdout)
        for name in ("disk", "supervisor", "routing"):
            self.assertIn(f"docs/specs/{name}.md", result.stdout)
            (self.root / f"docs/specs/{name}.md").unlink()
        self.assertEqual(self.check("--inventory-only", "--strict-citations", source=False).returncode, 0)

    def test_a_spec_over_the_word_cap_warns_without_failing(self):
        spec = self.root / "docs/specs/long.md"
        header = "# Long\nOwner: maintainers\nAnchor: `tools/front-door/src/main.rs`\n\n"
        spec.write_text(header + "word " * 1990)
        result = self.check("--inventory-only", "--strict-inventory", "--strict-citations", source=False)
        self.assertNotIn("word cap", result.stdout)
        spec.write_text(header + "word " * 2001)
        result = self.check("--inventory-only", "--strict-inventory", "--strict-citations", source=False)
        self.assertIn("docs/specs/long.md:1: warning: spec has", result.stdout)
        self.assertIn("2000-word cap", result.stdout)
        self.assertEqual(result.returncode, 0, result.stdout)

    def test_deleted_commands_check_every_spec(self):
        (self.root / "docs/specs/new-area.md").write_text(
            "# Area\nOwner: maintainers\nAnchor: tools/front-door\n\n"
            "Run `provenant dispatch ID`.\n")
        result = self.check("--inventory-only", source=False)
        self.assertEqual(result.returncode, 1, result.stdout)
        self.assertIn("new-area.md:5: error: deleted command", result.stdout)

    def test_deleted_commands_fail_even_in_fenced_examples(self):
        (self.root / "README.md").write_text(
            "```sh\nprovenant dispatch --route junior\n```\n"
            "Use `preset show NAME` or `fabric_graph`.\n")
        result = self.check("--inventory-only", source=False)
        self.assertEqual(result.returncode, 1, result.stdout)
        self.assertIn("README.md:2: error: deleted command", result.stdout)
        self.assertIn("deleted command `fabric_graph`", result.stdout)
        self.assertIn("deleted command `preset show NAME`", result.stdout)

    def test_each_deleted_verb_fails_as_an_explicit_command(self):
        guide = self.root / "README.md"
        for verb in ("dispatch", "review", "lanes", "resume", "cancel", "preset", "fabric_graph"):
            with self.subTest(verb=verb):
                guide.write_text(f"Run `provenant {verb} ID`.\n")
                result = self.check("--inventory-only", source=False)
                self.assertEqual(result.returncode, 1, result.stdout)
                self.assertIn(f"deleted command `provenant {verb}`", result.stdout)

    def test_every_removed_flag_in_the_cli_table_fails_as_a_command(self):
        # The table is the CLI's own; the check reads it, so a new entry is covered.
        guide = self.root / "README.md"
        for path, flag, _ in check_doc_truth.removed_table(
                SCRIPTS.parent / check_doc_truth.REMOVED_SOURCE):
            if flag is None:
                continue
            command = "provenant " + " ".join(path) + f" NAME --{flag} VALUE"
            with self.subTest(command=command):
                guide.write_text(f"```sh\n{command}\n```\n")
                result = self.check("--inventory-only", source=False)
                self.assertEqual(result.returncode, 1, result.stdout)
                self.assertIn(f"README.md:2: error: deleted command `provenant {' '.join(path)} --{flag}`",
                              result.stdout)

    def test_a_removed_flag_fails_across_a_continued_line_and_in_every_guide_kind(self):
        for relative in ("README.md", "docs/runbooks/example.md", "skills/demo/SKILL.md"):
            with self.subTest(relative=relative):
                path = self.root / relative
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text("```sh\nprovenant run implement BRIEF \\\n  --tier senior --branch b\n```\n")
                result = self.check("--inventory-only", source=False)
                self.assertIn(f"{relative}:2: error: deleted command `provenant run --tier`", result.stdout)

    def test_a_removed_flag_in_prose_for_another_command_is_allowed(self):
        (self.root / "README.md").write_text(
            "Use `provenant land 12 --tier substantial --wait=30m` and `provenant wait NAME --any`.\n"
            "Use `provenant route override set --until 1d` and `provenant output NAME --part events`.\n")
        result = self.check("--inventory-only", source=False)
        self.assertEqual(result.returncode, 0, result.stdout)

    def test_global_options_cannot_hide_deleted_verbs(self):
        guide = self.root / "README.md"
        options = (
            "--project .", "--project=.", "--state-dir /tmp/state",
            "--state-dir=/tmp/state", "--json --project 'a project' --full",
            "--state-dir='/tmp/a state' --project=.",
        )
        for verb in ("dispatch", "review", "lanes", "resume", "cancel", "preset", "fabric_graph"):
            for globals_ in options:
                with self.subTest(verb=verb, globals_=globals_):
                    guide.write_text(f"```sh\nprovenant {globals_} {verb} ID\n```\n")
                    result = self.check("--inventory-only", source=False)
                    self.assertEqual(result.returncode, 1, result.stdout)
                    self.assertIn(f"README.md:2: error: deleted command `provenant {verb}`",
                                  result.stdout)

    def test_global_option_values_are_not_commands(self):
        (self.root / "README.md").write_text(
            "Use `provenant --project 'dispatch review' run review BRIEF`.\n"
            "Use `provenant --project=cancel --state-dir /tmp/preset status`.\n")
        result = self.check("--inventory-only", source=False)
        self.assertEqual(result.returncode, 0, result.stdout)
        self.assertEqual(result.stdout, "")

    def test_template_names_fields_and_historical_commands_are_allowed(self):
        (self.root / "README.md").write_text(
            "Use `provenant run review BRIEF`, `provenant retry ID` and `status`.\n"
            "The `review` template has a `preset` parameter and `lanes` field.\n"
            "Deleted: `provenant cancel ID`.\n"
            "See `src/dispatch.rs#review` and `fabric_graph.schema.json`.\n")
        result = self.check("--inventory-only", source=False)
        self.assertEqual(result.returncode, 0, result.stdout)
        self.assertEqual(result.stdout, "")

    def test_a_section_headed_as_removed_may_list_old_spellings(self):
        (self.root / "README.md").write_text(
            "## Removed spellings\n\n| `lanes`, `fabric graph` | `status` |\n\n"
            "## Usage\n\nRun `provenant dispatch ID`.\n")
        result = self.check("--inventory-only", source=False)
        self.assertEqual(result.returncode, 1, result.stdout)
        self.assertNotIn("README.md:3:", result.stdout)
        self.assertIn("README.md:7: error: deleted command", result.stdout)

    def test_git_deleted_paths_do_not_become_command_errors(self):
        def git(*args):
            return subprocess.run(["git", *args], cwd=self.root, check=True,
                                  capture_output=True, text=True)
        git("init", "--quiet")
        git("config", "user.name", "Michael Blauberg")
        git("config", "user.email", "103556269+mblauberg@users.noreply.github.com")
        historical = self.root / "old.txt"
        historical.write_text("historical file\n")
        git("add", "old.txt")
        git("commit", "--quiet", "-m", "test: seed deleted path")
        git("rm", "--quiet", "old.txt")
        git("commit", "--quiet", "-m", "test: remove historical path")
        result = self.check("--inventory-only", "--strict-inventory", source=False)
        self.assertEqual(result.returncode, 0, result.stdout)
        self.assertEqual(result.stdout, "")

    def test_clean_fixture_is_silent(self):
        shutil.copyfile(FIXTURES / "clean.md", self.root / "docs/runbooks/example.md")
        result = self.check("--strict-inventory")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, "")

    def test_each_seeded_stale_reference_warns_once_without_failing(self):
        shutil.copyfile(FIXTURES / "stale.md", self.root / "docs/specs/example.md")
        result = self.check("--strict-inventory")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout.splitlines(), [
            "docs/specs/example.md:5: warning: unresolved command `provenant vanished`",
            "docs/specs/example.md:5: warning: unresolved flag `--vanished`",
            "docs/specs/example.md:6: warning: unresolved path `docs/vanished.md`",
            "docs/specs/example.md:6: warning: unresolved ADR `ADR 9999`",
        ])

    def test_flags_are_scoped_to_the_command(self):
        self.document("# Scope\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      "Run `provenant route list --apply`, then `provenant gc --apply`.\n")
        result = self.check()
        self.assertEqual(result.returncode, 1, result.stderr)
        self.assertEqual(result.stdout.count("error:"), 1)
        self.assertIn("unresolved flag `--apply`", result.stdout)

    def test_unknown_runbook_commands_and_flags_fail_inline_and_fenced(self):
        self.document("# Scope\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n\n"
                      "```sh\nprovenant route list --pool x \\\n  --vanished  # --comment\n"
                      "$ provenant gone --json\nprovenant gc --apply\n```\n")
        result = self.check()
        self.assertEqual(result.returncode, 1, result.stderr)
        self.assertEqual(result.stdout.splitlines(), [
            "docs/runbooks/example.md:6: error: unresolved flag `--vanished`",
            "docs/runbooks/example.md:8: error: unresolved command `provenant gone`",
        ])

    def test_unknown_skill_and_ambient_commands_and_flags_fail(self):
        skill = self.root / "skills/example/SKILL.md"
        skill.parent.mkdir(parents=True)
        skill.write_text("# Example\n\nRun `provenant route list --vanished`.\n\n"
                         "```sh\nprovenant route list --pool example\nprovenant gone --json\n```\n")
        (self.root / "GLOBAL-AGENTS.md").write_text("Run `provenant gone`.\n")
        result = self.check()
        self.assertEqual(result.returncode, 1, result.stderr)
        self.assertEqual(result.stdout.splitlines(), [
            "GLOBAL-AGENTS.md:1: error: unresolved command `provenant gone`",
            "skills/example/SKILL.md:3: error: unresolved flag `--vanished`",
            "skills/example/SKILL.md:7: error: unresolved command `provenant gone`",
        ])

    def test_unknown_commands_in_specs_stay_advisory_even_when_fenced(self):
        (self.root / "docs/specs/example.md").write_text(
            "# Spec\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n\n"
            "```sh\nprovenant gone --json\n```\nRun `provenant gone`.\n")
        result = self.check()
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout.count("warning:"), 1)
        self.assertNotIn("error:", result.stdout)

    def test_help_all_and_retired_lines_do_not_fail_runbooks(self):
        self.document("# Scope\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      "Run `provenant help --all --json`.\nRemoved: `provenant gone --old`.\n")
        result = self.check()
        self.assertEqual(result.returncode, 0, result.stdout)
        self.assertEqual(result.stdout, "")

    def test_command_must_resolve_through_all_parent_verbs(self):
        self.document("# Scope\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      "Run `provenant route vanished --json`.\n")
        result = self.check()
        self.assertEqual(result.stdout.count("error:"), 1)
        self.assertIn("unresolved command `provenant route vanished`", result.stdout)

    def test_help_after_globals_still_checks_requested_command(self):
        self.document("# Scope\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      "Run `provenant --json help route vanished`.\n")
        result = self.check()
        self.assertEqual(result.stdout.count("error:"), 1)
        self.assertIn("unresolved command `provenant route vanished`", result.stdout)

    def test_alternative_verbs_are_each_resolved(self):
        self.document("# Scope\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      "Run `provenant config set|unset|vanished`.\n")
        result = self.check()
        self.assertEqual(result.stdout.count("error:"), 1)
        self.assertIn("unresolved command `provenant config vanished`", result.stdout)

    def test_missing_headers_are_advisory_unless_inventory_gate_is_requested(self):
        self.document("# Missing inventory\n\nProse first.\n\nOwner: too late\nAnchor: too late\n")
        result = self.check("--inventory-only", source=False)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout.count("unresolved inventory"), 2)
        result = self.check("--inventory-only", "--strict-inventory", source=False)
        self.assertEqual(result.returncode, 1, result.stderr)
        self.assertEqual(result.stdout.count("unresolved inventory"), 2)

    def test_headers_may_follow_a_blank_line_and_wrap(self):
        (self.root / "tools/front-door/tests").mkdir()
        (self.root / "tools/front-door/tests/a.rs").write_text("fn example() {}\n")
        (self.root / "tests").mkdir()
        (self.root / "tests/a.rs").write_text("// a\n")
        self.document("# Wrapped\n\nOwner: `crates/a` (one),\n`crates/b` (two)\nAnchor: `tests/a.rs`\n")
        result = self.check("--inventory-only", "--strict-inventory", source=False)
        self.assertEqual(result.returncode, 0, result.stdout)
        self.assertEqual(result.stdout, "")

    def test_test_name_suffix_is_not_part_of_the_path(self):
        code = self.root / "tools/front-door/crates/example/src/lib.rs"
        code.parent.mkdir(parents=True)
        code.write_text("// example\n")
        self.document("# Paths\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      "Test: `crates/example/src/lib.rs::keeps_order`.\n")
        result = self.check()
        self.assertEqual(result.stdout, "")

    def test_inline_multiline_references_keep_source_line_numbers(self):
        self.document("# Lines\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      "`provenant route\nvanished` and ``ADR 9999``.\n")
        result = self.check()
        self.assertIn("example.md:4: error: unresolved command", result.stdout)
        self.assertIn("example.md:5: warning: unresolved ADR", result.stdout)

    def test_invalid_help_sources_warn_once_and_paths_are_still_checked(self):
        self.document("# Sources\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      "Read `docs/vanished.md`.\n")
        for name, contents in (
            ("missing.json", None),
            ("non-object.json", "[]"),
            ("bad-argument.json", '{"commands": [{"command": "provenant", "arguments": [{"long": 17}]}]}'),
        ):
            with self.subTest(name=name):
                path = self.root / name
                if contents is not None:
                    path.write_text(contents)
                result = self.check("--help-json", str(path), source=False)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(result.stdout.count("unresolved CLI help source"), 1)
                self.assertIn("unresolved path `docs/vanished.md`", result.stdout)

    def test_workspace_relative_paths_resolve(self):
        code = self.root / "tools/front-door/crates/example/src/lib.rs"
        code.parent.mkdir(parents=True)
        code.write_text("// example\n")
        self.document("# Paths\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      "Read `crates/example/src/lib.rs#example`.\n")
        result = self.check()
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, "")

    def test_deleted_tracked_basename_warns(self):
        code = self.root / "tools/front-door/crates/example/src/gone.rs"
        code.parent.mkdir(parents=True)
        code.write_text("// example\n")
        subprocess.run(["git", "init", "-q", str(self.root)], check=True)
        subprocess.run(["git", "-C", str(self.root), "add", str(code)], check=True)
        code.unlink()
        self.document("# Paths\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      "Read `gone.rs`.\n")
        result = self.check()
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout.count("warning:"), 1)
        self.assertIn("unresolved path `gone.rs`", result.stdout)

    def test_false_positive_classes_stay_silent(self):
        for text in (
            "Writes `release.json`, `prompt.md` and `auth.json` at runtime.",
            "Uses `git push --force-with-lease` and `rg --include`.",
            "Passes `--author-email` to the other tool.",
            "| `--council` | replaced by `provenant route` |",
            "The `--chain` flag was removed and `provenant gc --chain` is retired.",
        ):
            with self.subTest(text=text):
                self.document("# Quiet\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n" + text + "\n")
                result = self.check()
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(result.stdout, "")

    def test_standalone_flag_is_not_checked_without_a_command(self):
        self.document("# Quiet\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      "Pass `--vanished` to the other tool.\n")
        self.assertEqual(self.check().stdout, "")

    def test_hidden_internal_commands_stay_silent(self):
        catalogue = self.root / "help.json"
        catalogue.write_text(json.dumps({"commands": [
            {"command": "provenant", "arguments": []},
            {"command": "provenant fabric", "arguments": []},
            {"command": "provenant fabric send", "arguments": []},
        ]}))
        self.document("# Hidden\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      "Run `provenant fabric peer`, then `provenant fabric gone`.\n")
        result = self.check("--help-json", str(catalogue), source=False)
        self.assertEqual(result.stdout.count("unresolved command"), 1, result.stdout)
        self.assertIn("`provenant fabric gone`", result.stdout)

    def test_anchor_must_resolve_to_a_source_file(self):
        for anchor, message in (
            ("`tools/front-door/src/gone.rs`", "Anchor path `tools/front-door/src/gone.rs` does not resolve"),
            ("`tools/front-door/src`", "Anchor names no source file or test"),
        ):
            with self.subTest(anchor=anchor):
                self.document(f"# Anchored\nOwner: maintainers\nAnchor: {anchor}\n")
                result = self.check("--inventory-only", source=False)
                self.assertEqual(result.returncode, 0, result.stdout)
                self.assertIn(message, result.stdout)
                result = self.check("--inventory-only", "--strict-inventory", source=False)
                self.assertEqual(result.returncode, 1, result.stdout)

    def test_anchor_link_targets_and_wrapped_values_resolve(self):
        self.document("# Anchored\nOwner: maintainers\nAnchor: [`main`](../../tools/front-door/src/main.rs),\n"
                      "`tools/front-door`\nProse naming `missing.rs` is not part of the anchor.\n")
        result = self.check("--inventory-only", "--strict-inventory", source=False)
        self.assertEqual(result.returncode, 0, result.stdout)
        self.assertEqual(result.stdout, "")

    def delivery(self, rows):
        specs = self.root / "tools/front-door/crates/records/src/adapters.rs"
        hooks = self.root / "tools/front-door/crates/cli/src/hooks.rs"
        for path in (specs, hooks):
            path.parent.mkdir(parents=True, exist_ok=True)
        specs.write_text('Spec { name: "alpha", local_offer_reader: true },\n'
                         'Spec { name: "beta", local_offer_reader: false },\n')
        hooks.write_text("DeliveryCapability { provider: Harness::Alpha, live_injection: true });\n")
        (self.root / "docs/runbooks/human-inbox.md").write_text(
            "# Inbox\nOwner: maintainers\nAnchor: `tools/front-door/src/main.rs`\n\n## Delivery service\n\n"
            "| Adapter | Channel | Reader | Live |\n|---|---|---|---|\n" + rows)

    def test_delivery_table_matches_adapter_capabilities(self):
        self.delivery("| `alpha` | Fabric mail | Library API | Unavailable |\n"
                      "| `alpha` | hook | Available | Tool-call boundary |\n"
                      "| Every other adapter | Fabric mail | Unavailable | Unavailable |\n")
        result = self.check("--inventory-only", "--strict-inventory", source=False)
        self.assertEqual(result.returncode, 0, result.stdout)
        self.delivery("| `beta` | Fabric mail | Library API | Unavailable |\n")
        result = self.check("--inventory-only", source=False)
        self.assertEqual(result.returncode, 1, result.stdout)
        self.assertIn("must end with an 'Every other adapter' row", result.stdout)
        self.assertIn("library offer readers are ['alpha'], documented ['beta']", result.stdout)

    def test_binary_is_used_only_for_help_and_document_snippets_never_run(self):
        binary = self.root / "provenant"
        binary.write_text("#!/bin/sh\n[ \"$*\" = 'help --all --json' ] || exit 1\n"
                          f"cat '{FIXTURES / 'help.json'}'\n")
        binary.chmod(0o755)
        marker = self.root / "executed"
        self.document("# Execution\nOwner: maintainers\nAnchor: tools/front-door/src/main.rs\n"
                      f"`touch {marker}` and `provenant gc --apply`.\n")
        result = self.check("--binary", str(binary), source=False)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, "")
        self.assertFalse(marker.exists())


if __name__ == "__main__":
    unittest.main()
