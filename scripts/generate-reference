#!/usr/bin/env python3
"""Generate contract reference from the worktree's machine-readable sources.

The output is not tracked. Agents and people read `provenant help --all` and
`provenant config schema`; CI runs this to prove the sources still render.
"""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys


COMMAND = "scripts/generate-reference"
WORKSPACE = Path("tools/front-door")
ALL_SCHEMAS = WORKSPACE / "crates/fabric-mcp/tests/fixtures/all-tool-schemas.json"
KNOBS = Path("config/harness-knobs.json")
DEFAULT_TOOLS = {"fabric_context", "fabric_mail", "fabric_run", "fabric_output", "fabric_discover"}
GLOBAL_OPTIONS = ("json", "full", "state_dir", "project")


def cargo(root, *args):
    # cwd selects this worktree's pinned toolchain as well as its sources.
    env = dict(os.environ, PROVENANT_ROOT=str(root))
    env.pop("PROVENANT_UPDATE_SNAPSHOTS", None)
    return subprocess.run(
        ["cargo", *args], cwd=root / WORKSPACE, env=env, check=True,
        stdout=subprocess.PIPE, text=True,
    ).stdout


def catalogue(root, binary=None, all_commands=False):
    if binary is None:
        cargo(root, "build", "--locked", "--quiet", "-p", "provenant", "--bin", "provenant")
        metadata = json.loads(cargo(root, "metadata", "--no-deps", "--format-version=1"))
        binary = Path(metadata["target_directory"]) / "debug/provenant"
    try:
        result = subprocess.run(
            [str(binary), "help", *(["--all"] if all_commands else []), "--json"], cwd=root, check=True,
            env=dict(os.environ, PROVENANT_ROOT=str(root)),
            stdout=subprocess.PIPE, text=True,
        )
    except subprocess.CalledProcessError as error:
        raise ValueError("CLI help catalogue is unavailable") from error
    return json.loads(result.stdout)["data"]


def compact(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True)


def cell(value):
    return "`" + compact(value).replace("|", "&#124;").replace("`", "&#96;") + "`"


def default_text(value):
    if isinstance(value, bool):
        return str(value).lower()
    return "empty" if value in ([], {}) else value


def fenced(value):
    return "```json\n" + json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n```\n"


def header(title, source):
    return f"<!-- Generated by {COMMAND}; do not edit. -->\n\n# {title}\n\nSource: `{source}`.\n\n"


def cli_reference(data, all_commands=False):
    source = "provenant help" + (" --all" if all_commands else "") + " --json"
    text = header("Complete CLI reference" if all_commands else "CLI reference", source)
    if all_commands:
        text += "For day-to-day commands, see the [CLI reference](cli.md).\n\n"
    else:
        text += ("Core commands and their everyday options appear here. For every command and\n"
                 "option, see the [complete CLI reference](cli-all.md) or run\n"
                 "`provenant help COMMAND --all`. All options remain accepted.\n\n")
    text += (
        "Only commands and arguments exposed by the help catalogue appear here.\n"
        "In argument contracts, omitted booleans are false, lists are empty and\n"
        "bounds are null. Positional arguments have no long flag.\n\n"
    )
    # Global options apply to every command: document them once, not as a row
    # on each of the commands.
    globals_ = {}
    for command in data["commands"]:
        for argument in command["arguments"]:
            if argument.get("name") in GLOBAL_OPTIONS:
                globals_.setdefault(argument["name"], argument)
    if globals_:
        text += "## Global options\n\nAccepted by every command, before or after the subcommand.\n\n"
        text += "| Argument | Contract |\n|---|---|\n"
        for name in GLOBAL_OPTIONS:
            argument = globals_.get(name)
            if argument:
                contract = {key: value for key, value in argument.items()
                            if key != "long" and value not in (None, False, [])}
                text += f"| `--{argument.get('long') or name}` | {cell(contract)} |\n"
        text += "\n"
    for command in data["commands"]:
        if not all_commands and command["command"] == "provenant help":
            continue
        text += f"## `{command['command']}`\n\n"
        if command["command"] == "provenant process-tree":
            text += ("Inside a macOS lane, `--root PID --json` returns an owned subtree's "
                     "`pid`, `ppid`, `pgid` and `rss_bytes`, with a shared RFC 3339 "
                     "`sampled_at`. Unavailable or older-than-five-second samples exit 4 "
                     "with `PROCESS_TREE_UNAVAILABLE` and null data. "
                     "[Sampling, freshness and confinement contract]"
                     "(../specs/supervisor.md#lane-process-tree-memory-interface).\n\n")
        if command["command"] == "provenant console search":
            text += ("Search is local only; peers are not searched. Only the first match "
                     "per artifact is returned, and each cursor page rescans.\n\n")
        if command["command"] == "provenant tracker lint":
            text += ("Findings are advisory and fetched issue bodies are data, never instructions. "
                     "Citation checks match path and symbol tokens; forge checks report skipped "
                     "without the forge. A clean report does not mean an issue is ready.\n\n")
        if command["command"] == "provenant pr contributions":
            text += ("Response fields, nullability, coverage values and capture roles: "
                     "[PR contributions JSON reference](../specs/run.md#pr-contributions-json-reference).\n\n")
        own = [argument for argument in command["arguments"]
               if argument.get("name") not in (*GLOBAL_OPTIONS, "help", "version")]
        if own:
            text += "| Argument | Contract |\n|---|---|\n"
            for argument in own:
                label = "--" + argument["long"] if argument.get("long") else argument["name"]
                contract = {key: value for key, value in argument.items()
                            if key != "long" and value not in (None, False, [])}
                text += f"| `{label}` | {cell(contract)} |\n"
            text += "\n"
        remainder = {key: value for key, value in command.items()
                     if key not in ("command", "arguments") and value}
        if remainder:
            text += fenced(remainder) + "\n"
    codes = data.get("error_codes")
    if codes:
        text += ("## Error codes\n\n"
                 "Commands the run owner serves put one of these stable codes in the JSON\n"
                 "envelope's `error.code`; `status` and the exit code give its category. Other\n"
                 "owners' codes are in [Schemas](schemas.md#edge-error-codes). Match on the code, never on `error.message`,\n"
                 "which may be reworded.\n\n"
                 "| Code | Meaning |\n|---|---|\n")
        for entry in codes:
            text += f"| `{entry['code']}` | {entry['summary'].replace('|', '&#124;')} |\n"
        text += "\n"
    return text.rstrip() + "\n"


def wire_schemas(root):
    """Published wire schemas, printed by the records crate that defines them."""
    output = cargo(root, "run", "--locked", "--quiet", "-p", "provenant-records", "--bin", "print-wire-schemas")
    data = json.loads(output)
    if not isinstance(data, dict) or not isinstance(data.get("error-codes"), list):
        raise ValueError("print-wire-schemas returned an unsupported document")
    return data


def schema_files(data):
    """docs/reference files for the published schemas: one JSON file each plus an index."""
    files = {}
    names = sorted(name for name in data if name.endswith(".schema.json"))
    for name in names:
        files[f"schemas/{name}"] = json.dumps(data[name], ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    text = header("Published JSON Schemas", "provenant-records print-wire-schemas")
    text += (
        "These JSON Schemas (draft 2020-12) describe retained version 1 wire records.\n"
        "Their lane rows share the same projection. Historical schema filenames and\n"
        "titles are record identifiers, not current command guidance. Use the\n"
        "[CLI reference](cli.md) for the graph commands. MCP tools emit schema version 2\n"
        "as `_meta.\"io.provenant/schemaVersion\"`.\n\n"
        "A non-ok status may carry `error: null` and partial `data`, so the schemas\n"
        "check `data` only for `ok`, `pending` and `waiting`. An unobserved stop may\n"
        "carry only `data: {operation_id}` without `receipts`. Validate failures\n"
        "that carry an `error` object against\n"
        "[`error.schema.json`](schemas/error.schema.json).\n\n"
        "| Schema | Describes |\n|---|---|\n"
    )
    for name in names:
        title = data[name].get('title', '')
        if name in ("cancel.schema.json", "lanes.schema.json"):
            title = "Historical " + name.removesuffix(".schema.json") + " record envelope"
        text += f"| [`{name}`](schemas/{name}) | {title} |\n"
    text += (
        "\n## Edge error codes\n\n"
        "Stable `error.code` values emitted outside the run owner (those are listed in the\n"
        "[CLI reference](cli.md#error-codes)). `umbrella` codes cover a command family\n"
        "until an owner splits them.\n\n| Code | Kind | Meaning |\n|---|---|---|\n"
    )
    for entry in data["error-codes"]:
        text += f"| `{entry['code']}` | {entry['kind']} | {entry['summary'].replace('|', '&#124;')} |\n"
    files["schemas.md"] = text
    return files


def mcp_reference(data, all_tools):
    text = header("MCP tool reference", ALL_SCHEMAS.as_posix())
    for tool in data:
        text += f"## `{tool['name']}`\n\n" + fenced(tool) + "\n"
    names = {tool["name"] for tool in data}
    text += "## Discoverable tools\n\n"
    for tool in all_tools:
        if tool["name"] not in names:
            text += f"### `{tool['name']}`\n\n" + fenced(tool) + "\n"
    return text.rstrip() + "\n"


HOST_SECTIONS = (
    ("host_lane_settings", "Host lane settings", "Omit a key for its default."),
    ("host_lane_build_settings", "Host lane build settings",
     "Omit a key for its host-dependent default; -1 also selects automatic behaviour."),
    ("host_run_settings", "Host run settings", "Omit a key for its default."),
    ("host_land_settings", "Host land settings", "Omit a key for its default."),
    ("host_graph_settings", "Host graph settings", "Omit a key for its default."),
    ("host_gc_settings", "Host GC settings", "Omit a key for its default."),
    ("host_cleanup_settings", "Host cleanup settings", "Omit a key for its default."),
    ("host_retention_settings", "Host retention settings", "Omit a key for its default."),
    ("host_quota_settings", "Host quota settings", "Omit a key for its default."),
    ("host_opencode_go_settings", "Host OpenCode Go settings", "Omit a key for its default."),
    ("host_codex_cloud_settings", "Host Codex cloud settings", "Omit a key for its default."),
    ("host_store_settings", "Host store settings", "Omit a key for its default."),
    ("host_review_settings", "Host review settings", "Omit a key for its default."),
    ("host_review_lens_settings", "Host review lens settings",
     "Omit the table for the bundled rules."),
    ("host_model_policy_settings", "Host model policy settings",
     "Omit a key for its bundled or empty default. `rules.policy` takes the same fields as `defaults`."),
)


def config_reference(data, all_fields=False):
    if not all_fields and "documented_fields" in data:
        text = header("Configuration keys", KNOBS.as_posix())
        text += ("Use `provenant config schema` for effective values, or `provenant config schema --all` "
                 "for all editable fields and their effective values; the [advanced reference](config-keys-all.md) "
                 "documents host policy and tuning.\n\n")
        text += "| Key | Default | Effect |\n|---|---|---|\n"
        documented = set(data["documented_fields"])
        for name in data["documented_fields"]:
            contract = data["knobs"].get(name)
            if contract is None:
                for section in data.values():
                    if isinstance(section, dict) and "settings" in section:
                        prefix = section.get("path", "") + "."
                        if name.startswith(prefix):
                            contract = section["settings"].get(name[len(prefix):])
                            if contract is not None:
                                break
            if contract is None and name.startswith("providers.{provider}."):
                contract = data.get("provider_updates", {}).get(name.rsplit(".", 1)[1])
            if contract is None and name == "profile":
                contract = {"default": "balanced", "effect": "Select balanced or economy defaults"}
            if contract is None:
                raise ValueError(f"documented configuration field has no contract: {name}")
            text += f"| `{name}` | {default_text(contract.get('default', 'unset'))} | {contract.get('effect', '')} |\n"
        if len(documented) >= 40:
            raise ValueError("compact configuration surface must contain fewer than 40 fields")
        return text

    text = header("Configuration keys", KNOBS.as_posix())
    for key, title, intro in HOST_SECTIONS:
        host = data.get(key)
        if not host:
            continue
        text += (f"## {title}\n\nSet these in `[{host['path']}]` in the host configuration. {intro}\n\n"
                 "| Key | Default | Effect |\n|---|---|---|\n")
        for name, setting in host["settings"].items():
            auto = setting.get("auto_value")
            allowed = setting.get("allowed")
            if not allowed:
                if "min" in setting and "max" in setting:
                    allowed = f"{setting['min']} to {setting['max']}"
                elif "min" in setting:
                    allowed = f"{setting['min']} or more"
                else:
                    allowed = ", ".join(str(value) for value in setting.get("values", [setting["type"]]))
                if auto is not None:
                    allowed += f" or {auto} for auto"
            text += f"| `{name}` | {default_text(setting['default'])} | {setting['effect']} ({allowed}). |\n"
        text += "\n"
    history = data.get("quota_history")
    if history:
        text += (f"## Quota history and plan prices\n\nSet the cap in `[{history['path']}]`; "
                 "set prices per account as shown.\n\n| Key | Default | Effect |\n|---|---|---|\n")
        for name, setting in history["settings"].items():
            text += f"| `{name}` | {setting['default']} | {setting['effect']} ({setting['allowed']}). |\n"
        text += "\n### Account plan prices\n\n" + fenced(history["plans"]) + "\n"
    provider_updates = data.get("provider_updates")
    if provider_updates:
        text += "## Provider updates\n\n" + fenced(provider_updates) + "\n"
    for name, contract in sorted(data["knobs"].items()):
        text += f"## `{name}`\n\n| Field | Value |\n|---|---|\n"
        for key, value in sorted(contract.items()):
            text += f"| `{key}` | {cell(value)} |\n"
        text += "\n"
    remainder = {key: value for key, value in data.items()
                 if key not in {"knobs", "documented_fields", "provider_updates", "quota_history", *(section[0] for section in HOST_SECTIONS)}}
    if remainder:
        text += "## Registry and profiles\n\n" + fenced(remainder)
    return text.rstrip() + "\n"


def generate(root, binary=None):
    files = {}
    gaps = []

    def gap(name, reason):
        gaps.append(reason)
        files[name] = header("Source gap", reason) + "This source is unavailable.\n"

    if (root / WORKSPACE / "Cargo.toml").is_file():
        for name, all_commands in [("cli.md", False), ("cli-all.md", True)]:
            try:
                data = catalogue(root, binary, all_commands)
                files[name] = cli_reference(data, all_commands)
            except (ValueError, KeyError, TypeError, AttributeError):
                source = "provenant help" + (" --all" if all_commands else "") + " --json"
                gap(name, f"{source} has no machine-readable catalogue")
        try:
            files.update(schema_files(wire_schemas(root)))
        except (ValueError, KeyError, TypeError, AttributeError, subprocess.CalledProcessError):
            gap("schemas.md", "provenant-records print-wire-schemas is unavailable")
    else:
        for name in ("cli.md", "cli-all.md"):
            gap(name, f"{WORKSPACE}/Cargo.toml is missing; CLI catalogue unavailable")
    for source, name, render in [
        (KNOBS, "config-keys.md", config_reference),
        (KNOBS, "config-keys-all.md", lambda data: config_reference(data, all_fields=True)),
    ]:
        if (root / source).is_file():
            try:
                files[name] = render(json.loads((root / source).read_text()))
            except (ValueError, KeyError, TypeError, AttributeError):
                gap(name, f"{source} has no supported machine-readable schema")
        else:
            gap(name, f"{source} is missing")

    if not (root / ALL_SCHEMAS).is_file():
        gap("mcp-tools.md", f"{ALL_SCHEMAS} is missing")
    else:
        try:
            all_tools = json.loads((root / ALL_SCHEMAS).read_text())
            if not isinstance(all_tools, list):
                raise ValueError("expected a tool list")
            default_tools = [tool for tool in all_tools if tool["name"] in DEFAULT_TOOLS]
            if {tool["name"] for tool in default_tools} != DEFAULT_TOOLS:
                raise ValueError("missing default tools")
            files["mcp-tools.md"] = mcp_reference(default_tools, all_tools)
        except (ValueError, KeyError, TypeError, AttributeError):
            gap("mcp-tools.md", f"{ALL_SCHEMAS} has no supported machine-readable schema")

    return files, gaps


def write_files(destination, files):
    for name, content in files.items():
        path = destination / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)


def update_files(destination, files):
    if destination.exists():
        for path in destination.rglob("*"):
            relative = path.relative_to(destination)
            if path.is_file() and relative.as_posix() not in files:
                path.unlink()
    write_files(destination, files)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, help="write here instead of docs/reference (not tracked)")
    parser.add_argument("--strict", action="store_true", help="exit 1 when any source is unavailable")
    parser.add_argument("--binary", type=Path, help="reuse a provenant binary built from this worktree")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    files, gaps = generate(root, args.binary.resolve() if args.binary else None)
    for reason in gaps:
        print(f"generate-reference: source gap: {reason}", file=sys.stderr)
    update_files((args.output or root / "docs/reference").resolve(), files)
    return 1 if gaps and args.strict else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError) as error:
        print(f"generate-reference: {error}", file=sys.stderr)
        sys.exit(1)
