#!/usr/bin/env python3
"""Generate contract reference from the worktree's machine-readable sources."""

import argparse
import difflib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile


COMMAND = "scripts/generate-reference"
WORKSPACE = Path("tools/front-door")
ALL_SCHEMAS = WORKSPACE / "crates/fabric-mcp/tests/fixtures/all-tool-schemas.json"
KNOBS = Path("config/harness-knobs.json")
DEFAULT_TOOLS = {"fabric_context", "fabric_mail", "fabric_run", "fabric_output", "fabric_discover"}
GLOBAL_OPTIONS = ("json", "full", "state_dir", "project")
SNAPSHOTS = WORKSPACE / "crates/providers/tests/snapshots/seatbelt"


def cargo(root, *args):
    # cwd selects this worktree's pinned toolchain as well as its sources.
    env = dict(os.environ, PROVENANT_ROOT=str(root))
    env.pop("PROVENANT_UPDATE_SNAPSHOTS", None)
    return subprocess.run(
        ["cargo", *args], cwd=root / WORKSPACE, env=env, check=True,
        stdout=subprocess.PIPE, text=True,
    ).stdout


def catalogue(root, binary=None):
    if binary is None:
        cargo(root, "build", "--locked", "--quiet", "-p", "provenant", "--bin", "provenant")
        metadata = json.loads(cargo(root, "metadata", "--no-deps", "--format-version=1"))
        binary = Path(metadata["target_directory"]) / "debug/provenant"
    try:
        result = subprocess.run(
            [str(binary), "help", "--all", "--json"], cwd=root, check=True,
            env=dict(os.environ, PROVENANT_ROOT=str(root)),
            stdout=subprocess.PIPE, text=True,
        )
    except subprocess.CalledProcessError as error:
        raise ValueError("CLI help --all --json is unavailable") from error
    return json.loads(result.stdout)["data"]


def compact(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True)


def cell(value):
    return "`" + compact(value).replace("|", "&#124;").replace("`", "&#96;") + "`"


def fenced(value):
    return "```json\n" + json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n```\n"


def header(title, source):
    return f"<!-- Generated by {COMMAND}; do not edit. -->\n\n# {title}\n\nSource: `{source}`.\n\n"


def cli_reference(data):
    text = header("CLI reference", "provenant help --all --json")
    text += (
        "Only commands and arguments exposed by the help catalogue appear here.\n"
        "In argument contracts, omitted booleans are false, lists are empty and\n"
        "bounds are null. Positional arguments have no long flag.\n\n"
    )
    # Global options apply to every command: document them once, not as a row
    # on each of the commands.
    globals_ = {}
    for command in data["commands"]:
        for argument in command["arguments"]:
            if argument.get("name") in GLOBAL_OPTIONS:
                globals_.setdefault(argument["name"], argument)
    if globals_:
        text += "## Global options\n\nAccepted by every command, before or after the subcommand.\n\n"
        text += "| Argument | Contract |\n|---|---|\n"
        for name in GLOBAL_OPTIONS:
            argument = globals_.get(name)
            if argument:
                contract = {key: value for key, value in argument.items()
                            if key != "long" and value not in (None, False, [])}
                text += f"| `--{argument.get('long') or name}` | {cell(contract)} |\n"
        text += "\n"
    for command in data["commands"]:
        text += f"## `{command['command']}`\n\n"
        if command["command"] == "provenant pr contributions":
            text += ("Response fields, nullability, coverage values and capture roles: "
                     "[PR contributions JSON reference](../specs/run.md#pr-contributions-json-reference).\n\n")
        own = [argument for argument in command["arguments"]
               if argument.get("name") not in GLOBAL_OPTIONS]
        if own:
            text += "| Argument | Contract |\n|---|---|\n"
            for argument in own:
                label = "--" + argument["long"] if argument.get("long") else argument["name"]
                contract = {key: value for key, value in argument.items()
                            if key != "long" and value not in (None, False, [])}
                text += f"| `{label}` | {cell(contract)} |\n"
            text += "\n"
        remainder = {key: value for key, value in command.items()
                     if key not in ("command", "arguments") and value}
        if remainder:
            text += fenced(remainder) + "\n"
    return text.rstrip() + "\n"


def mcp_reference(data, all_tools):
    text = header("MCP tool reference", ALL_SCHEMAS.as_posix())
    for tool in data:
        text += f"## `{tool['name']}`\n\n" + fenced(tool) + "\n"
    names = {tool["name"] for tool in data}
    text += "## Discoverable tools\n\n"
    for tool in all_tools:
        if tool["name"] not in names:
            text += f"### `{tool['name']}`\n\n" + fenced(tool) + "\n"
    return text.rstrip() + "\n"


HOST_SECTIONS = (
    ("host_lane_build_settings", "Host lane build settings",
     "Omit a key for its host-dependent default; -1 also selects automatic behaviour."),
    ("host_graph_settings", "Host graph settings", "Omit a key for its default."),
    ("host_model_policy_settings", "Host model policy settings",
     "Omit a key for its bundled or empty default. `rules.policy` takes the same fields as `defaults`."),
)


def config_reference(data):
    text = header("Configuration keys", KNOBS.as_posix())
    for key, title, intro in HOST_SECTIONS:
        host = data.get(key)
        if not host:
            continue
        text += (f"## {title}\n\nSet these in `[{host['path']}]` in the host configuration. {intro}\n\n"
                 "| Key | Default | Effect |\n|---|---|---|\n")
        for name, setting in host["settings"].items():
            auto = setting.get("auto_value")
            allowed = setting.get("allowed") or (
                f"{setting['min']} to {setting['max']}" + (f" or {auto} for auto" if auto is not None else ""))
            text += f"| `{name}` | {setting['default']} | {setting['effect']} ({allowed}). |\n"
        text += "\n"
    provider_updates = data.get("provider_updates")
    if provider_updates:
        text += "## Provider updates\n\n" + fenced(provider_updates) + "\n"
    for name, contract in sorted(data["knobs"].items()):
        text += f"## `{name}`\n\n| Field | Value |\n|---|---|\n"
        for key, value in sorted(contract.items()):
            text += f"| `{key}` | {cell(value)} |\n"
        text += "\n"
    remainder = {key: value for key, value in data.items()
                 if key not in {"knobs", "provider_updates", *(section[0] for section in HOST_SECTIONS)}}
    if remainder:
        text += "## Registry and profiles\n\n" + fenced(remainder)
    return text.rstrip() + "\n"


def generate(root, binary=None):
    files = {}
    gaps = []

    def gap(name, reason):
        gaps.append(reason)
        files[name] = header("Source gap", reason) + "This source is unavailable.\n"

    if (root / WORKSPACE / "Cargo.toml").is_file():
        try:
            files["cli.md"] = cli_reference(catalogue(root, binary))
        except (ValueError, KeyError, TypeError, AttributeError):
            gap("cli.md", "provenant help --all --json has no machine-readable catalogue")
    else:
        gap("cli.md", f"{WORKSPACE}/Cargo.toml is missing; CLI catalogue unavailable")
    for source, name, render in [
        (KNOBS, "config-keys.md", config_reference),
    ]:
        if (root / source).is_file():
            try:
                files[name] = render(json.loads((root / source).read_text()))
            except (ValueError, KeyError, TypeError, AttributeError):
                gap(name, f"{source} has no supported machine-readable schema")
        else:
            gap(name, f"{source} is missing")

    if not (root / ALL_SCHEMAS).is_file():
        gap("mcp-tools.md", f"{ALL_SCHEMAS} is missing")
    else:
        try:
            all_tools = json.loads((root / ALL_SCHEMAS).read_text())
            if not isinstance(all_tools, list):
                raise ValueError("expected a tool list")
            default_tools = [tool for tool in all_tools if tool["name"] in DEFAULT_TOOLS]
            if {tool["name"] for tool in default_tools} != DEFAULT_TOOLS:
                raise ValueError("missing default tools")
            files["mcp-tools.md"] = mcp_reference(default_tools, all_tools)
        except (ValueError, KeyError, TypeError, AttributeError):
            gap("mcp-tools.md", f"{ALL_SCHEMAS} has no supported machine-readable schema")

    if (root / SNAPSHOTS).is_dir():
        # The goldens are verified by the rust job's provider tests; copy only.
        profiles = sorted((root / SNAPSHOTS).glob("*.sb"))
        if not profiles:
            gap("seatbelt/README.md", f"{SNAPSHOTS} contains no profile snapshots")
        for path in profiles:
            files[f"seatbelt/{path.name}"] = (
                f"; Generated by {COMMAND}; do not edit.\n" + path.read_text()
            )
    else:
        gap("seatbelt/README.md", f"{SNAPSHOTS} is missing; Seatbelt goldens unavailable")
    return files, gaps


def write_files(destination, files):
    for name, content in files.items():
        path = destination / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)


def differences(expected, actual):
    names = {path.relative_to(directory) for directory in (expected, actual)
             if directory.exists() for path in directory.rglob("*") if path.is_file()}
    changed = False
    for name in sorted(names):
        left, right = actual / name, expected / name
        before = left.read_text().splitlines(keepends=True) if left.exists() else []
        after = right.read_text().splitlines(keepends=True) if right.exists() else []
        if before != after or left.exists() != right.exists():
            changed = True
            sys.stdout.writelines(difflib.unified_diff(
                before, after, fromfile=f"docs/reference/{name}",
                tofile=f"regenerated/{name}",
            ))
            if before == after:
                print(f"generated file inventory differs: {name}")
    return changed


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="regenerate in a temporary directory and diff")
    parser.add_argument("--binary", type=Path, help="reuse a provenant binary built from this worktree")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    files, gaps = generate(root, args.binary.resolve() if args.binary else None)
    for reason in gaps:
        print(f"generate-reference: source gap: {reason}", file=sys.stderr)
    destination = root / "docs/reference"
    if args.check:
        with tempfile.TemporaryDirectory(prefix="provenant-reference-") as temporary:
            expected = Path(temporary)
            write_files(expected, files)
            if differences(expected, destination):
                print(f"Generated reference differs; run {COMMAND}.", file=sys.stderr)
                return 1
    else:
        # This directory is wholly generated; remove stale generated files too.
        if destination.exists():
            for path in destination.rglob("*"):
                if path.is_file() and path.relative_to(destination).as_posix() not in files:
                    path.unlink()
        write_files(destination, files)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError) as error:
        print(f"generate-reference: {error}", file=sys.stderr)
        sys.exit(1)
