#!/usr/bin/env bash
# Use the existing interpreter owner even under SSH's minimal nonlogin PATH.
set -euo pipefail
SCRIPT_DIRECTORY="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIRECTORY/lib/harness-python.sh"
if run_stdlib "$SCRIPT_DIRECTORY/fabric_hosts.py" "$@"; then
  exit 0
else
  status=$?
  if [ "$status" -eq 3 ]; then
    printf 'fabric-hosts: Python 3.11 or newer is required; configure HARNESS_PYTHON with a supported executable interpreter.\n' >&2
  fi
  exit "$status"
fi
