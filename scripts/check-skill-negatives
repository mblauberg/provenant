#!/usr/bin/env python3
"""Inventory tagged near-miss negatives; quality and routing accuracy stay advisory.

The strict trigger fixture format expresses should_trigger: false as
relation: negative, tagged near-miss, with the target absent from both
expected routes. Checks skills/ and library/ unless root directories are given.
"""

import argparse
import json
from pathlib import Path
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    repo = Path(__file__).resolve().parent.parent
    parser.add_argument(
        "roots", nargs="*", type=Path,
        default=[repo / "skills", repo / "library"],
    )
    skills = []
    failures = []
    for root in parser.parse_args().roots:
        found = sorted(root.glob("*/SKILL.md"))
        if not found:
            failures.append(f"{root}: no skills found")
        skills.extend(found)
    for entrypoint in skills:
        skill = entrypoint.parent.name
        fixture = entrypoint.parent / "evals/trigger_cases.json"
        try:
            data = json.loads(fixture.read_text())
            if data["schema_version"] != 1 or data["target_skill"] != skill:
                raise ValueError("invalid version or target")
            prompts = set()
            ids = set()
            for case in data["cases"]:
                if case["relation"] != "negative" or "near-miss" not in case["tags"]:
                    continue
                expected = case["expected"]
                if (expected["primary_skill"] == skill
                        or skill in expected["companion_skills"]):
                    continue
                prompt = " ".join(case["prompt"].split()).casefold()
                if prompt and case["id"] not in ids:
                    ids.add(case["id"])
                    prompts.add(prompt)
            if len(prompts) < 2:
                failures.append(f"{fixture}: {len(prompts)} near-miss negatives, need at least 2")
        except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
            failures.append(f"{fixture}: {error}")
    if failures:
        print("\n".join(failures), file=sys.stderr)
        return 1
    print(f"{len(skills)} skills: at least two distinct near-miss negatives each")
    return 0


if __name__ == "__main__":
    sys.exit(main())
