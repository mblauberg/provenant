#!/usr/bin/env bash
set -euo pipefail

DOCTOR=false
if [[ "${1:-}" == "--doctor" ]]; then
  DOCTOR=true
  shift
fi
[[ $# -eq 0 ]] || { echo "usage: check-harness [--doctor]" >&2; exit 2; }

PRODUCT_ROOT="${AGENT_FABRIC_PRODUCT_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
SCRIPTS_ROOT="${PROVENANT_SCRIPTS_ROOT:-$PRODUCT_ROOT/scripts}"
SKILLS_ROOT="${PROVENANT_SKILLS_ROOT:-$PRODUCT_ROOT/skills}"
DOCS_ROOT="${PROVENANT_DOCS_ROOT:-$PRODUCT_ROOT/docs}"
TESTS_ROOT="${PROVENANT_TESTS_ROOT:-$PRODUCT_ROOT/tests}"
for component_root in "$PRODUCT_ROOT" "$SCRIPTS_ROOT" "$SKILLS_ROOT" "$DOCS_ROOT" "$TESTS_ROOT"; do
  [[ "$component_root" == /* ]] || {
    echo "check-harness: component roots must be absolute: $component_root" >&2
    exit 3
  }
done
if [[ -x "${HARNESS_PYTHON:-}" ]]; then
  PYTHON=("$HARNESS_PYTHON")
elif [[ -x "$PRODUCT_ROOT/.venv/bin/python" ]]; then
  PYTHON=("$PRODUCT_ROOT/.venv/bin/python")
elif PYTHON3="$(command -v python3 2>/dev/null)" &&
     "$PYTHON3" -c 'import pytest, yaml' >/dev/null 2>&1; then
  PYTHON=("$PYTHON3")
elif command -v uv >/dev/null 2>&1; then
  PYTHON=(uv run --frozen --only-group test python)
else
  echo "check-harness: no Python with pytest and PyYAML found; install uv or set HARNESS_PYTHON" >&2
  exit 3
fi

cd "$PRODUCT_ROOT"
"${PYTHON[@]}" "$SCRIPTS_ROOT/check-provenant-install.py"
"${PYTHON[@]}" "$SCRIPTS_ROOT/check_harness.py"
"${PYTHON[@]}" "$SCRIPTS_ROOT/check_specs.py"
"${PYTHON[@]}" "$SCRIPTS_ROOT/check_adr_index.py"
"${PYTHON[@]}" "$SCRIPTS_ROOT/check_spec_schema_drift.py"
"${PYTHON[@]}" "$SCRIPTS_ROOT/check_spec_check_assertions.py"
"${PYTHON[@]}" "$SKILLS_ROOT/orchestrate/evals/check_skill_triggers.py"
# Lifecycle-skill alignment is a deterministic current-tree gate. Historical
# provider routing evidence stays immutable under docs/archive and is not
# rewritten or treated as a live-catalogue result.
"${PYTHON[@]}" "$SKILLS_ROOT/orchestrate/evals/lifecycle_skill_evaluation.py" validate-inputs
"${PYTHON[@]}" "$SKILLS_ROOT/orchestrate/evals/lifecycle_skill_evaluation.py" probe

while IFS= read -r -d '' script; do
  case "$script" in
    *cross-family.sh) sh -n "$script" ;;
    *) bash -n "$script" ;;
  esac
done < <(find "$SKILLS_ROOT" -type f -name '*.sh' -print0)

"$SCRIPTS_ROOT/check-skill-javascript" "$SKILLS_ROOT"
if [[ -d "$HOME/.claude/workflows" ]]; then
  while IFS= read -r -d '' workflow; do
    node --check "$workflow" >/dev/null
  done < <(find "$HOME/.claude/workflows" -maxdepth 1 -type f -name '*.js' -print0)
fi

"${PYTHON[@]}" "$SCRIPTS_ROOT/public_release_check.py"
"${PYTHON[@]}" "$SCRIPTS_ROOT/static-security-check.py"
"${PYTHON[@]}" "$SCRIPTS_ROOT/validate_delivery_scenarios.py" \
  --product-root "$PRODUCT_ROOT" --skills-root "$SKILLS_ROOT"
"${PYTHON[@]}" "$SCRIPTS_ROOT/render_skill_catalogue.py" --check \
  --readme "$PRODUCT_ROOT/README.md" --skills-root "$SKILLS_ROOT"
# Derived doc regions and drift gates (issue #548). --check renders in memory
# and diffs; CI never writes. Maintainers regenerate with --write.
"${PYTHON[@]}" "$SCRIPTS_ROOT/render_doc_projections.py" --check \
  --architecture "$DOCS_ROOT/ARCHITECTURE.md" --skills-root "$SKILLS_ROOT"
"${PYTHON[@]}" "$SCRIPTS_ROOT/check_doc_constants.py" \
  --architecture "$DOCS_ROOT/ARCHITECTURE.md" \
  --harness "$PRODUCT_ROOT/HARNESS.md" \
  --readme "$PRODUCT_ROOT/README.md" \
  --skills-root "$SKILLS_ROOT"
"${PYTHON[@]}" "$SCRIPTS_ROOT/check_doc_paths.py" \
  --root "$PRODUCT_ROOT" \
  "$DOCS_ROOT/ARCHITECTURE.md" "$PRODUCT_ROOT/README.md"
# House style is gated on the root documents and on every skill front door.
# skills/*/references/ and docs/ are not yet clean and are not gated.
"${PYTHON[@]}" "$SKILLS_ROOT/engineering-writing/scripts/check_engineering_style.py" \
  "$PRODUCT_ROOT/README.md" \
  "$PRODUCT_ROOT/HARNESS.md" \
  "$PRODUCT_ROOT/MAINTAINING.md" \
  "$PRODUCT_ROOT/AGENTS.md" \
  "$DOCS_ROOT/ARCHITECTURE.md" \
  "$SKILLS_ROOT"/*/SKILL.md

"${PYTHON[@]}" -m pytest -q \
  "$TESTS_ROOT" \
  "$SKILLS_ROOT/implement/tests/test_checkpoint_run.py" \
  "$SKILLS_ROOT/orchestrate/evals/test_cf_dispatch.py"

if [[ "$DOCTOR" == true ]]; then
  echo "environment doctor"
  if host_bin="$(command -v codex-code-mode-host 2>/dev/null)" && [[ -x "$host_bin" ]]; then
    echo "codex-code-mode-host=ok path=$host_bin"
  else
    echo "codex-code-mode-host=WARN not executable on PATH"
    app_host="/Applications/ChatGPT.app/Contents/Resources/codex-code-mode-host"
    [[ -x "$app_host" ]] && echo "codex-code-mode-host-candidate=$app_host"
  fi
  if command -v herdr >/dev/null 2>&1; then
    herdr status server || true
    herdr integration status || true
  else
    echo "herdr=WARN not found"
  fi
  provenant route resolve --adapter claude --alias flagship --role lead || true
  caps="$(mktemp)"
  if "$SKILLS_ROOT/orchestrate/scripts/codex_capabilities.py" --out "$caps"; then
    provenant route resolve --adapter codex --alias flagship --role lead --capabilities-file "$caps" || true
  else
    echo "codex-capabilities=WARN discovery failed"
  fi
  rm -f "$caps"
fi
