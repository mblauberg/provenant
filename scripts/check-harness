#!/usr/bin/env bash
set -euo pipefail

DOCTOR=false
if [[ "${1:-}" == "--doctor" ]]; then
  DOCTOR=true
  shift
fi
[[ $# -eq 0 ]] || { echo "usage: check-harness [--doctor]" >&2; exit 2; }

# Git discovery for checkout identity and interpreter selection must not inherit
# caller redirects that can point the gate at another repository.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
unset GIT_CEILING_DIRECTORIES GIT_DISCOVERY_ACROSS_FILESYSTEM
PROVENANT_GIT_BIN=""
for git_candidate in \
  /opt/homebrew/bin/git /usr/local/bin/git /opt/local/bin/git /usr/bin/git /bin/git; do
  if [[ -x "$git_candidate" ]]; then
    PROVENANT_GIT_BIN="$git_candidate"
    break
  fi
done
[[ -n "$PROVENANT_GIT_BIN" ]] || {
  echo "check-harness: trusted Git executable is unavailable" >&2
  exit 3
}
export PROVENANT_GIT_BIN
PROVENANT_CMP_BIN=""
for cmp_candidate in /usr/bin/cmp /bin/cmp /opt/homebrew/bin/cmp /usr/local/bin/cmp; do
  if [[ -x "$cmp_candidate" ]]; then
    PROVENANT_CMP_BIN="$cmp_candidate"
    break
  fi
done
[[ -n "$PROVENANT_CMP_BIN" ]] || {
  echo "check-harness: trusted cmp executable is unavailable" >&2
  exit 3
}

CAPTURED_GIT_PATH=""
capture_git_path() {
  local payload record
  payload="$(
    "$PROVENANT_GIT_BIN" "$@" 2>/dev/null || exit
    printf '\034'
  )" || return 1
  [[ "$payload" == *$'\034' ]] || return 1
  record="${payload%$'\034'}"
  [[ "$record" == *$'\n' ]] || return 1
  CAPTURED_GIT_PATH="${record%$'\n'}"
}

PRODUCT_ROOT="${AGENT_FABRIC_PRODUCT_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
SCRIPTS_ROOT="${PROVENANT_SCRIPTS_ROOT:-$PRODUCT_ROOT/scripts}"
SKILLS_ROOT="${PROVENANT_SKILLS_ROOT:-$PRODUCT_ROOT/skills}"
TESTS_ROOT="${PROVENANT_TESTS_ROOT:-$PRODUCT_ROOT/tests}"
for component_root in "$PRODUCT_ROOT" "$SCRIPTS_ROOT" "$SKILLS_ROOT" "$TESTS_ROOT"; do
  [[ "$component_root" == /* ]] || {
    echo "check-harness: component roots must be absolute: $component_root" >&2
    exit 3
  }
done
checked_head=""
git_top=""
git_metadata_valid=0
if [[ -d "$PRODUCT_ROOT/.git" && ! -L "$PRODUCT_ROOT/.git" ]]; then
  git_metadata_valid=1
elif [[ -f "$PRODUCT_ROOT/.git" && ! -L "$PRODUCT_ROOT/.git" ]] \
    && capture_git_path -C "$PRODUCT_ROOT" rev-parse --absolute-git-dir; then
  git_admin="$CAPTURED_GIT_PATH"
  if [[ -f "$git_admin/gitdir" && ! -L "$git_admin/gitdir" ]] \
      && "$PROVENANT_CMP_BIN" -s "$git_admin/gitdir" \
        <(printf '%s\n' "$PRODUCT_ROOT/.git"); then
    git_metadata_valid=1
  fi
fi
if [[ "$git_metadata_valid" == 1 ]] \
    && capture_git_path -C "$PRODUCT_ROOT" rev-parse --show-toplevel; then
  git_top="$CAPTURED_GIT_PATH"
fi
if [[ "$git_top" == "$PRODUCT_ROOT" ]]; then
  checked_head="$("$PROVENANT_GIT_BIN" -C "$PRODUCT_ROOT" rev-parse --verify HEAD 2>/dev/null || true)"
fi
[[ "$checked_head" =~ ^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$ ]] || checked_head=unavailable
echo "check-harness: product_root=$PRODUCT_ROOT"
echo "check-harness: git_head=$checked_head"
if [[ "$checked_head" == unavailable ]]; then
  echo "check-harness: cannot verify checkout ownership and a full Git HEAD for $PRODUCT_ROOT" >&2
  exit 3
fi
# shellcheck source=scripts/lib/harness-python.sh
source "$SCRIPTS_ROOT/lib/harness-python.sh"

cd "$PRODUCT_ROOT"
run_test "$SCRIPTS_ROOT/check-provenant-install.py"
run_test "$SCRIPTS_ROOT/check_harness.py"

while IFS= read -r -d '' script; do
  case "$script" in
    *cross-family.sh) sh -n "$script" ;;
    *) bash -n "$script" ;;
  esac
done < <(find "$SKILLS_ROOT" -type f -name '*.sh' -print0)

"$SCRIPTS_ROOT/check-skill-javascript" "$SKILLS_ROOT"
"$SCRIPTS_ROOT/check-skill-javascript" "$PRODUCT_ROOT/runtime/ui-evidence" "UI evidence runtime"
"$SCRIPTS_ROOT/check-skill-javascript" "$PRODUCT_ROOT/runtime/ui-live" "UI live runtime"

# Skill and runtime JavaScript tests are discovered rather than listed, so a
# new one runs in the gate the moment it lands instead of sitting unexecuted.
skill_node_tests=()
while IFS= read -r -d '' skill_test; do
  skill_node_tests+=("$skill_test")
done < <(find "$SKILLS_ROOT" -type f -name '*.test.mjs' -not -path '*/node_modules/*' -print0)
while IFS= read -r -d '' runtime_test; do
  skill_node_tests+=("$runtime_test")
done < <(find "$PRODUCT_ROOT/runtime" -type f -name '*.test.mjs' -not -path '*/node_modules/*' -print0)
if (( ${#skill_node_tests[@]} > 0 )); then
  node --test "${skill_node_tests[@]}"
fi

if [[ -d "$HOME/.claude/workflows" ]]; then
  while IFS= read -r -d '' workflow; do
    node --check "$workflow" >/dev/null
  done < <(find "$HOME/.claude/workflows" -maxdepth 1 -type f -name '*.js' -print0)
fi

run_test "$SCRIPTS_ROOT/static-security-check.py"

run_test -m pytest -q \
  "$TESTS_ROOT" \
  "$SKILLS_ROOT/implement/tests/test_checkpoint_run.py" \
  "$SKILLS_ROOT/orchestrate/evals"

if [[ "$DOCTOR" == true ]]; then
  echo "environment doctor"
  if host_bin="$(command -v codex-code-mode-host 2>/dev/null)" && [[ -x "$host_bin" ]]; then
    echo "codex-code-mode-host=ok path=$host_bin"
  else
    echo "codex-code-mode-host=WARN not executable on PATH"
    app_host="/Applications/ChatGPT.app/Contents/Resources/codex-code-mode-host"
    [[ -x "$app_host" ]] && echo "codex-code-mode-host-candidate=$app_host"
  fi
  if command -v herdr >/dev/null 2>&1; then
    herdr status server || true
    herdr integration status || true
  else
    echo "herdr=WARN not found"
  fi
  provenant route resolve --adapter claude --alias flagship --role lead || true
  caps="$(mktemp)"
  if "$SKILLS_ROOT/orchestrate/scripts/codex_capabilities.py" --out "$caps"; then
    provenant route resolve --adapter codex --alias flagship --role lead --capabilities-file "$caps" || true
  else
    echo "codex-capabilities=WARN discovery failed"
  fi
  rm -f "$caps"
fi
