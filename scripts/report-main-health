#!/usr/bin/env python3
"""Report main CI health and quarantine flakes confirmed by a re-run."""
import datetime as dt
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent


def gh(*args):
    return subprocess.run(['gh', *args], check=True, text=True, capture_output=True).stdout


def load(name):
    """Load a sibling script as a module so both sides share one parser."""
    path = ROOT / name
    spec = importlib.util.spec_from_loader(
        name, importlib.machinery.SourceFileLoader(name, str(path))
    )
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def junit_rows(directory):
    if not directory or not Path(directory).is_dir():
        return []
    junit = load('junit-failures')
    return junit.cases(junit.read_dir(directory))


def known_flaky(repo):
    """TOML entries plus open issue-backed entries (spec: docs/specs/ci.md)."""
    flaky = load('flaky-quarantine')
    config_path = ROOT.parent / 'tools/front-door/.config/quarantine.toml'
    config = flaky.parse_config(config_path.read_text(encoding='utf-8'))
    raw = gh('api', '--paginate', '--slurp',
             f'repos/{repo}/issues?state=open&labels=ci%3Aflaky&per_page=100')
    config['test'].extend(flaky.parse_issues(raw)['test'])
    return flaky, config['test']


def main():
    result = os.environ['CI_RESULT']
    if result not in ('success', 'failure'):
        print(f'No main-health update for {result}.')
        return
    repo = os.environ['GITHUB_REPOSITORY']
    sha = os.environ['SHA']
    run_url = os.environ['RUN_URL']
    issues = json.loads(gh('api', '--paginate', '--slurp', f'repos/{repo}/issues?state=open&labels=ci%3Ared-main&per_page=100'))
    issues = [issue for page in issues for issue in page if 'pull_request' not in issue]
    if result == 'success':
        for issue in issues:
            gh('issue', 'close', str(issue['number']), '--repo', repo, '--comment', f'Main is green at {sha}: {run_url}')
        return

    flaky, entries = known_flaky(repo)
    known = {(entry['package'], entry['name']) for entry in entries}
    failed = {
        (row['package'], row['name'])
        for row in junit_rows(os.environ.get('JUNIT_DIR'))
        if row['failed']
    }
    # A candidate is a flake only when a dedicated re-run of the same tests
    # passed. Without that evidence a failure stays actionable.
    rerun_passed = {
        (row['package'], row['name'])
        for row in junit_rows(os.environ.get('RERUN_JUNIT_DIR'))
        if not row['failed']
    }
    confirmed = sorted((failed & rerun_passed) - known)
    budget = max(0, flaky.MAX_ENTRIES - len(known))
    registered = set(confirmed[:budget])
    for package, name in sorted(registered):
        expiry = dt.date.today() + dt.timedelta(days=30)
        body = (
            f"{flaky.ISSUE_MARKER}\n"
            f"- package: {package}\n"
            f"- name: {name}\n"
            "- owner: chair\n"
            f"- expires: {expiry.isoformat()}\n\n"
            f"Confirmed flaky on main: failed once, then passed on re-run at {run_url}.\n"
            "The quarantine job keeps running this test; fix and remove this issue to end it."
        )
        gh('issue', 'create', '--repo', repo, '--title', f'ci:flaky {package}::{name}',
           '--label', 'ci:flaky', '--body', body)

    actionable = failed - known - registered
    if failed and not actionable:
        print(f'All {len(failed)} main failures are known or confirmed flakes; no red-main issue.')
        return

    jobs = json.loads(gh('api', '--paginate', '--slurp', f"repos/{repo}/actions/runs/{os.environ['RUN_ID']}/jobs?per_page=100"))
    failed_jobs = [job['name'] for page in jobs for job in page['jobs'] if job.get('conclusion') == 'failure']
    try:
        green = json.loads(os.environ.get('SELECTION_JSON') or '{}').get('evidence', {}).get('main')
    except (ValueError, AttributeError):
        green = None
    comparison = f'Last green main: {green}\nCompare: https://github.com/{repo}/compare/{green}...{sha}' if green else 'No green main found.'
    body = (f'CI failed on main: {run_url}\n\nSHA: {sha}\n\nFailed jobs: '
            + (', '.join(failed_jobs) if failed_jobs else 'none reported') + f'\n\n{comparison}\n\n'
            + 'Fix forward: a PR that only repairs CI merges on green ci-status.')
    if issues:
        gh('issue', 'comment', str(issues[0]['number']), '--repo', repo, '--body', body)
    else:
        gh('issue', 'create', '--repo', repo, '--title', 'main is red', '--label', 'ci:red-main', '--body', body)


if __name__ == '__main__':
    try:
        main()
    except (subprocess.CalledProcessError, ValueError, KeyError, OSError) as exc:
        print(f'main-health: {exc}', file=sys.stderr)
        sys.exit(1)
