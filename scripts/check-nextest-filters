#!/usr/bin/env python3
"""Check that every literal nextest test selector names a listed test."""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import re
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
FILTER_FILES = (ROOT / "tools/front-door/.config/nextest.toml", ROOT / ".github/workflows/ci.yml")
TEST_SELECTOR = re.compile(r"test\(=([^)]*)\)")


def native_inventory():
    """Read the native inventory through its owning checker's parser."""
    loader = importlib.machinery.SourceFileLoader("native_inventory", str(ROOT / "scripts/check-native-inventory"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module.inventory(module.INVENTORY)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--test-list", type=Path, help="Reuse a saved nextest JSON listing")
    args = parser.parse_args()
    selectors: dict[str, list[Path]] = {}
    for path in FILTER_FILES:
        for name in TEST_SELECTOR.findall(path.read_text()):
            selectors.setdefault(name, []).append(path)
    if not selectors:
        print("No literal test(=...) selectors found.")
        return 0

    command = [
        "cargo",
        "nextest",
        "list",
        "--profile",
        "ci",
        "--workspace",
        "--locked",
        "--features",
        "provenant-providers/recording",
        "--message-format",
        "json",
    ]
    if args.test_list:
        listing = json.loads(args.test_list.read_text())
    else:
        listed = subprocess.run(command, cwd=ROOT / "tools/front-door", capture_output=True, text=True)
        if listed.returncode:
            print(listed.stderr, file=sys.stderr, end="")
            return listed.returncode
        listing = json.loads(listed.stdout)
    # nextest keys each suite's test cases by test name.
    suites = listing["rust-suites"].values()
    test_names = {name for suite in suites for name in suite["testcases"]}
    unlisted = sorted(name for name in selectors if name not in test_names)
    # A platform-gated test is absent from this runner's list but still defined.
    sources = "\n".join(
        path.read_text(errors="replace") for path in (ROOT / "tools/front-door").rglob("*.rs") if "target" not in path.parts
    )
    missing = []
    inventory = {row[0] for row in native_inventory()}
    for name in unlisted:
        if name in inventory:
            if sys.platform == "darwin":
                missing.append(name)
            else:
                print(f"test(={name}) is checked against the macOS list by the native inventory gate.")
            continue
        if re.search(rf"\bfn {re.escape(name.rsplit('::', 1)[-1])}\b", sources):
            print(f"test(={name}) is not built on this platform; its definition exists.")
        else:
            missing.append(name)
    if missing:
        for name in missing:
            sources = ", ".join(path.relative_to(ROOT).as_posix() for path in selectors[name])
            print(f"No listed test matches test(={name}) in {sources}.", file=sys.stderr)
        return 1
    print(f"Validated {len(selectors)} literal test selector(s) against nextest's CI test list.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
