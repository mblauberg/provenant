#!/usr/bin/env python3
"""Exercise the CI aggregation gate using job results, not workflow text."""
import importlib.machinery
import importlib.util
from pathlib import Path

path = Path(__file__).with_name("check-ci-status")
loader = importlib.machinery.SourceFileLoader("check_ci_status", str(path))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)

needs = {name: {"result": "success"} for name in module.REQUIRED}
assert not module.failures(needs, "true")
# Every required producer, consumer and evidence gate fails closed, even when
# the filter permits a skip; a missing job is never an intentional skip.
for name in module.REQUIRED:
    for result in ("failure", "cancelled", "skipped"):
        changed = {**needs, name: {"result": result}}
        assert module.failures(changed, "true")
        if result != "skipped":
            assert module.failures(changed, "false", "false")
    missing = dict(needs)
    del missing[name]
    assert module.failures(missing, "false", "false")
for name in module.MACOS:
    needs[name] = {"result": "skipped"}
assert not module.failures(needs, "false")
for name in module.RUST:
    needs[name] = {"result": "skipped"}
assert not module.failures(needs, "false", "false")
assert module.failures(needs, "false", "true")
needs["rust"] = {"result": "failure"}
assert module.failures(needs, "false", "false")
print("CI aggregation fixtures passed.")
