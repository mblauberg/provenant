#!/usr/bin/env python3
import contextlib
import io
import json
import os
import runpy
import sys
import tempfile
import unittest
from pathlib import Path
from unittest.mock import patch


class LiveCheckTest(unittest.TestCase):
    def test_measurement_and_first_sweep(self):
        module = runpy.run_path(str(Path(__file__).with_name('event-intake-live-check')))
        main = module['main']
        state = {'status': {'last_successful_sweep': 1}, 'current': {}}
        deliveries = {'deliveries': {}}
        samples = []
        for kind in module['EVENTS']:
            for n in range(20):
                value = f'{kind}-{n}'
                samples.append({'kind': kind, 'command': ['sample', kind, value],
                                'checks': [{'pr': 12, 'resource': 'issue_comments',
                                            'expect': [{'body': value}]}]})
        plan = {'status': ['status'], 'samples': samples,
                'drill': {'stop': ['stop'], 'change': ['change'], 'start': ['start'],
                          'checks': [{'pr': 13, 'resource': 'pull_request',
                                      'expect': {'merged': True}, 'github_path': 'repos/o/r/pulls/13'}]}}
        def read(path):
            return deliveries if path.name == 'deliveries.json' else state
        def run(args):
            if args[0] == 'status':
                return json.dumps({'last_successful_sweep': 1})
            if args[0] == 'sample':
                _, kind, value = args
                state['current']['12'] = {'issue_comments': [{'body': value}]}
                deliveries['deliveries'][value] = {'event': module['EVENTS'][kind],
                    'target': {'PullRequest': 12}, 'pending': False, 'completed_at': 2}
            if args[0] == 'gh':
                return '{"merged": true}'
            if args[0] == 'start':
                state['current']['13'] = {'pull_request': {'merged': True}}
                state['status']['last_successful_sweep'] = 2
            return ''
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / 'plan.json'
            path.write_text(json.dumps(plan))
            output = io.StringIO()
            with patch.object(sys, 'argv', ['event-intake-live-check', str(path)]), \
                    patch.dict(os.environ, {'PROVENANT_INTAKE_DIR': directory}), \
                    patch.dict(main.__globals__, {'read': read, 'run': run}), \
                    contextlib.redirect_stdout(output):
                main()
            evidence = json.loads(output.getvalue())
        self.assertTrue(evidence['passed'])
        self.assertEqual({v['count'] for v in evidence['p95'].values()}, {20})
        self.assertEqual(evidence['drill']['first_sweep'], 2)
        self.assertTrue(evidence['drill']['github_confirmed'])

    def test_subset_matching(self):
        contains = runpy.run_path(str(Path(__file__).with_name('event-intake-live-check')))['contains']
        self.assertTrue(contains([{'body': 'a', 'id': 1}], [{'body': 'a'}]))
        self.assertFalse(contains([{'body': 'a'}], [{'body': 'b'}]))

    def test_drill_restarts_worker_when_github_disagrees(self):
        main = runpy.run_path(str(Path(__file__).with_name('event-intake-live-check')))['main']
        calls = []
        def run(args):
            calls.append(args[0])
            return '{"last_successful_sweep": 1}' if args[0] == 'status' else '{}'
        plan = {'status': ['status'], 'samples': [],
                'drill': {'stop': ['stop'], 'change': ['change'], 'start': ['start'],
                          'checks': [{'pr': 13, 'resource': 'pull_request',
                                      'expect': {'merged': True}, 'github_path': 'repos/o/r/pulls/13'}]}}
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / 'plan.json'
            path.write_text(json.dumps(plan))
            with patch.object(sys, 'argv', ['event-intake-live-check', str(path)]), \
                    patch.dict(os.environ, {'PROVENANT_INTAKE_DIR': directory}), \
                    patch.dict(main.__globals__, {'EVENTS': {}, 'run': run,
                               'read': lambda _: {'status': {'last_successful_sweep': 1}}}):
                with self.assertRaisesRegex(ValueError, 'GitHub did not confirm'):
                    main()
        self.assertEqual(calls[-1], 'start')


if __name__ == '__main__':
    unittest.main()
