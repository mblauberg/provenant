#!/bin/sh
set -eu

script_path=$0
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case "$link" in
    /*) script_path=$link ;;
    *) script_path=$(dirname "$script_path")/$link ;;
  esac
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
agents_home=${AGENTS_HOME:-"$(dirname -- "$script_dir")"}
case "$agents_home" in /*) ;; *) echo "AGENTS_HOME must be absolute" >&2; exit 2 ;; esac

protocol_dist="$agents_home/runtime/agent-fabric-protocol/dist/index.js"
cd "$agents_home"
npm run build --workspace=@local/agent-fabric-protocol
[ -f "$protocol_dist" ] || {
  echo "agent-fabric protocol build succeeded without producing $protocol_dist" >&2
  exit 1
}
touch "$protocol_dist"
