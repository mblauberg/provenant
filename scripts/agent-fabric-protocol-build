#!/bin/sh
set -eu

script_path=$0
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case "$link" in
    /*) script_path=$link ;;
    *) script_path=$(dirname "$script_path")/$link ;;
  esac
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
agents_home=${AGENTS_HOME:-"$(dirname -- "$script_dir")"}
case "$agents_home" in /*) ;; *) echo "AGENTS_HOME must be absolute" >&2; exit 2 ;; esac

protocol_root="$agents_home/runtime/agent-fabric-protocol"
protocol_dist="$protocol_root/dist/index.js"
manifest_stamp="$protocol_root/dist/.root-manifests.sha256"
freshness_library="$script_dir/lib/agent-fabric-workspace-freshness.sh"

[ -d "$agents_home/node_modules" ] || {
  echo "agent-fabric protocol build needs dependencies: run 'npm ci' in \"$agents_home\" first" >&2
  exit 1
}
[ -f "$freshness_library" ] || {
  echo "agent-fabric protocol build cannot record freshness: missing $freshness_library" >&2
  exit 1
}
. "$freshness_library"
manifest_digest=$(workspace_root_manifest_digest "$agents_home") || {
  echo "agent-fabric protocol build cannot digest the root manifests in $agents_home" >&2
  exit 1
}

cd "$agents_home"
# An incremental compile neither restores a deleted output nor reports its
# absence: it exits 0 and leaves the hole. A partial dist therefore survives an
# apparently successful rebuild. Clearing the output tree makes the emit total,
# so either every module is written or the build fails and the absent sentinel
# keeps the workspace honestly stale.
rm -rf "$protocol_root/dist"

# Every failure below must leave the output tree absent rather than merely
# incomplete. A type error does not stop `tsc` emitting JavaScript, and the
# build's `&&` means the schema generator is skipped, so a failed build still
# advances every mtime the preflight consults. Leaving that behind would report
# a build that never finished as fresh -- the exact signal-laundering this
# script exists to avoid.
abort() {
  rm -rf "$protocol_root/dist"
  echo "$1" >&2
  exit 1
}

npm run build --workspace=@local/agent-fabric-protocol \
  || abort "agent-fabric protocol build failed; dist removed so the workspace stays honestly stale"
[ -f "$protocol_dist" ] \
  || abort "agent-fabric protocol build succeeded without producing $protocol_dist"
# `dist/index.js` is a barrel over its siblings, so its own presence and mtime
# say nothing about whether the package loads. This script is what the preflight
# tells operators to run, and the preflight trusts mtime; stamping an artifact
# that cannot be imported would convert a detectable stale build into an
# undetectable one. Load it here so the freshness signal rests on evidence.
node --input-type=module -e 'await import(process.argv[1]);' "$protocol_dist" \
  || abort "agent-fabric protocol build produced a dist that does not load: $protocol_dist"
manifest_digest_after=$(workspace_root_manifest_digest "$agents_home") \
  || abort "agent-fabric protocol build could not re-read the root manifests after the build"
[ "$manifest_digest" = "$manifest_digest_after" ] \
  || abort "agent-fabric protocol build inputs changed during the build; retry the repair"
printf '%s\n' "$manifest_digest" > "$manifest_stamp" \
  || abort "agent-fabric protocol build could not record root-manifest freshness: $manifest_stamp"
