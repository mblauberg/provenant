#!/usr/bin/env bash
# Opt-in: build and install the on-demand OTLP collector as a LaunchAgent.
# usage: install-otel-collector [install|uninstall]
# macOS only: it builds with swiftc and runs under launchd socket activation.
# PROVENANT_OTEL_PORT picks the loopback port (default 4318).
# PROVENANT_OTEL_NO_LAUNCHCTL=1 writes files but never touches launchd (tests).
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd -P)"
bin_dir="${PROVENANT_BIN_DIR:-$HOME/.local/bin}"
binary="$bin_dir/provenant-otlp-collector"
agents="$HOME/Library/LaunchAgents"
label=com.provenant.otlp-collector
plist="$agents/$label.plist"
state="${AGENT_FABRIC_STATE_ROOT:-$HOME/.local/state/agent-harness/fabric}"
use_launchctl() { [[ "${PROVENANT_OTEL_NO_LAUNCHCTL:-}" != 1 ]] && command -v launchctl >/dev/null 2>&1; }
fail() { echo "otel collector not installed: $*" >&2; exit 1; }

case "${1:-install}" in
  install)
    system="$(uname -s)"
    [[ "$system" == Darwin ]] || fail "it needs macOS and launchd; this host is $system"
    command -v swiftc >/dev/null 2>&1 || fail "swiftc not found; install the Xcode command line tools (xcode-select --install)"
    port="${PROVENANT_OTEL_PORT:-4318}"
    [[ "$port" =~ ^[1-9][0-9]{0,4}$ ]] && (( port <= 65535 )) \
      || fail "PROVENANT_OTEL_PORT must be an integer from 1 to 65535, got '$port'"
    [[ ! -L "$state/otel" ]] || { echo "otel collector refused: $state/otel is a symlink" >&2; exit 1; }
    mkdir -p "$bin_dir" "$agents"
    mkdir -p -m 0700 "$state/otel"
    chmod 0700 "$state/otel"
    swiftc -O -swift-version 5 "$ROOT/tools/otlp-collector/otlp-collector.swift" -o "$binary.tmp"
    mv "$binary.tmp" "$binary"
    sed -e "s|@BINARY@|$binary|g" -e "s|@STATE_ROOT@|$state|g" -e "s|@PORT@|$port|g" \
      "$ROOT/tools/otlp-collector/$label.plist.template" > "$plist"
    if use_launchctl; then
      launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
      launchctl bootstrap "gui/$(id -u)" "$plist"
    fi
    echo "otel collector installed binary=$binary plist=$plist port=$port"
    ;;
  uninstall)
    if use_launchctl; then launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true; fi
    rm -f "$plist" "$binary"
    echo "otel collector removed (stored data under $state/otel is kept)"
    ;;
  *) echo "usage: install-otel-collector [install|uninstall]" >&2; exit 2 ;;
esac
