#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Git passes the remote name as $1 and the pushed refs on stdin.
heads=()
if [ ! -t 0 ]; then
  while read -r _ sha _ _; do
    [[ "$sha" =~ ^0+$ ]] || heads+=("$sha")
  done
fi
[ "${#heads[@]}" -gt 0 ] || heads=(HEAD)
for head in "${heads[@]}"; do
  scripts/check-added-blobs "$head"
done
scripts/check-doc-truth --inventory-only --strict-inventory --strict-citations
