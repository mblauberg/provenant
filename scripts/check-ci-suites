#!/usr/bin/env python3
"""Check that workflow job bindings agree with the CI suite manifest."""
import glob
import importlib.machinery
import importlib.util
import os
import re
import sys
import tomllib
from pathlib import Path

loader = importlib.machinery.SourceFileLoader('ci_selector', str(Path(__file__).with_name('select-ci-suites')))
spec = importlib.util.spec_from_loader(loader.name, loader)
selector = importlib.util.module_from_spec(spec)
loader.exec_module(selector)
PACKAGE = re.compile(r'package\(=([A-Za-z0-9_-]+)\)')


def check(config, workflow, packages):
    jobs = workflow['jobs']
    if not isinstance(jobs, dict):
        raise ValueError('workflow jobs must be a mapping')
    always = set(config['jobs']['always']); ungated = set(config['jobs']['ungated'])
    mapped = always | ungated | {j for s in config['suite'] for j in s['jobs']}
    errors = []
    for job in sorted(mapped - jobs.keys()):
        errors.append(f'missing workflow job {job}')
    if 'ci-status' not in jobs:
        return errors + ['missing ci-status']
    needs = jobs['ci-status'].get('needs', [])
    if isinstance(needs, str):
        needs = [needs]
    if not isinstance(needs, list) or any(not isinstance(n, str) for n in needs) or len(needs) != len(set(needs)):
        errors.append('invalid ci-status needs'); needs = []
    expected = set(jobs) - {'ci-status'} - ungated
    if set(needs) != expected:
        errors.append('ci-status needs do not match gated workflow jobs')
    if set(needs) != mapped - ungated:
        errors.append('ci-status needs do not match manifest jobs')
    for suite in config['suite']:
        name = suite['name']
        for job in suite['jobs']:
            condition = str(jobs.get(job, {}).get('if', ''))
            if 'needs.scope.outputs.suites' not in condition or not re.search(r'\.' + re.escape(name) + r'\b|\[[\'\"]' + re.escape(name) + r'[\'\"]\]', condition):
                errors.append(f'{job} does not bind suite {name}')
    for job in always | ungated:
        if 'needs.scope.outputs.suites' in str(jobs.get(job, {}).get('if', '')):
            errors.append(f'{job} must not bind a suite')
    return errors + unwatched_packages(config, jobs, packages) + gate_edges(config, jobs) + artifact_edges(jobs)


def artifact_edges(jobs):
    """Artifact inventories run only when their native test archive exists."""
    consumer, producer = 'rust-macos-inventory', 'rust-macos-archive'
    if consumer not in jobs:
        return []
    errors = []
    if producer not in job_needs(jobs[consumer]):
        errors.append(f'{consumer} does not wait for {producer}')
    if f"needs.{producer}.result == 'success'" not in str(jobs[consumer].get('if', '')):
        errors.append(f'{consumer} does not require {producer} success before downloading its artifact')
    return errors


def job_needs(job):
    value = job.get('needs', [])
    if isinstance(value, str):
        value = [value]
    return [n for n in value if isinstance(n, str)] if isinstance(value, list) else []


def gate_edges(config, jobs):
    """A failed cheap gate must leave every gated suite's job unstarted.

    Follow the workflow's needs graph transitively: a job that inherits the
    gate through an intermediate job counts, but a gated job cannot escape it
    with one indirect hop. A job that needs the gate directly must name the
    gate's result in its condition, or a covered gate suite would skip a gated
    suite that was independently selected to run.
    """
    edges = {name: job_needs(job) for name, job in jobs.items()}
    errors = []
    for gate in config.get('gate', []):
        gate_job = gate['job']
        for name in gate['suites']:
            suite = next((s for s in config['suite'] if s['name'] == name), None)
            if suite is None:
                errors.append(f'gate names unknown suite {name}')
                continue
            for job in suite['jobs']:
                if job == gate_job:
                    errors.append(f'gate job {gate_job} is itself gated')
                    continue
                seen, stack = set(), list(edges.get(job, []))
                while stack:
                    dep = stack.pop()
                    if dep in seen:
                        continue
                    seen.add(dep)
                    stack.extend(edges.get(dep, []))
                if gate_job not in seen:
                    errors.append(f'{job} does not wait for gate {gate_job}')
                if gate_job in edges.get(job, []) and f'needs.{gate_job}.result' not in str(jobs.get(job, {}).get('if', '')):
                    errors.append(f'{job} does not handle skipped gate {gate_job}')
    return errors


def unwatched_packages(config, jobs, packages):
    """A main-tier suite runs on a pull request only when its pr_paths match, so
    every package its jobs test by name needs a pr_paths entry inside that
    package's directory. An entry may be the whole directory or the narrow
    files those tests cover; a glob shared with other packages does not count."""
    errors = []
    for suite in config['suite']:
        if suite['tier'] != 'main':
            continue
        named = set()
        for job in suite['jobs']:
            for step in jobs.get(job, {}).get('steps') or []:
                named.update(PACKAGE.findall(str(step.get('run', ''))))
        prefixes = [re.split(r'[*?]', pattern, maxsplit=1)[0] for pattern in suite.get('pr_paths', [])]
        for package in sorted(named):
            directory = packages.get(package)
            if directory is None:
                errors.append(f"{suite['name']} tests unknown package {package}")
            elif not any(prefix.startswith(directory + '/') for prefix in prefixes):
                errors.append(f"{suite['name']} tests package {package} but no pr_paths entry lies in {directory}")
    return errors


def workspace_packages(root):
    """Cargo package name to repository-relative directory, for each workspace member."""
    packages = {}
    for workspace in root.glob('tools/*/Cargo.toml'):
        with workspace.open('rb') as f:
            members = tomllib.load(f).get('workspace', {}).get('members', [])
        for member in members:
            for manifest in sorted(map(Path, glob.glob(str(workspace.parent / member / 'Cargo.toml')))):
                with manifest.open('rb') as f:
                    name = tomllib.load(f).get('package', {}).get('name')
                if name:
                    packages[name] = manifest.parent.resolve().relative_to(root.resolve()).as_posix()
    return packages


# Walk balanced cfg expressions so nested all/any/not and multiline cfg work.
CFG_START = re.compile(r'\bcfg\s*\(')
MACOS = re.compile(r'target_os\s*=\s*["\']macos["\']')
NOT_LINUX = re.compile(r'not\s*\(\s*target_os\s*=\s*["\']linux["\']\s*\)')
UNIX = re.compile(r'\bunix\b')


def cfg_expressions(content):
    for match in CFG_START.finditer(content):
        depth = 1
        for index in range(match.end(), len(content)):
            if content[index] == '(':
                depth += 1
            elif content[index] == ')':
                depth -= 1
                if depth == 0:
                    yield content[match.end():index]
                    break


def macos_cfg_paths(root):
    for directory, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in ('.git', 'target')]
        for name in sorted(files):
            if not name.endswith('.rs'):
                continue
            path = Path(directory) / name
            content = path.read_text()
            expressions = list(cfg_expressions(content))
            if (any(MACOS.search(cfg) or NOT_LINUX.search(cfg) for cfg in expressions)
                    or (any(UNIX.search(cfg) for cfg in expressions)
                        and re.search(r'\b(?:macos|darwin)\b', content, re.IGNORECASE))):
                yield path.relative_to(root).as_posix()


def uncovered_macos(config, root):
    suite = next(s for s in config['suite'] if s['name'] == 'macos_lint')
    return [f'{path}: macOS-specific cfg is not covered by macos_lint.pr_paths'
            for path in macos_cfg_paths(root)
            if not selector.any_match(suite.get('pr_paths', []), path)]


def main():
    try:
        import yaml
        config = selector.manifest()
        workflow_path = Path(os.environ.get('CI_WORKFLOW', selector.ROOT / '.github/workflows/ci.yml'))
        workflow = yaml.safe_load(workflow_path.read_text())
        errors = check(config, workflow, workspace_packages(selector.ROOT)) + uncovered_macos(config, selector.ROOT)
        if errors:
            print('\n'.join(errors), file=sys.stderr); return 1
        print('CI workflow matches suite manifest.'); return 0
    except (ImportError, OSError, ValueError, KeyError, TypeError, tomllib.TOMLDecodeError) as error:
        print(f'CI suite check failed: {error}', file=sys.stderr); return 1


if __name__ == '__main__':
    sys.exit(main())
