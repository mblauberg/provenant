#!/usr/bin/env python3
"""Dispatch and wait for a commit-bound remote lane check."""
import json
import subprocess
import sys
import time
import uuid
from urllib.parse import urlparse


def output(*args):
    return subprocess.check_output(args, text=True).strip()


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: scripts/lane-check BRANCH-OR-SHA")
    requested = sys.argv[1]
    refs = output("git", "ls-remote", "--heads", "origin").splitlines()
    branches = [(sha, ref.removeprefix("refs/heads/")) for sha, ref in
                (line.split() for line in refs)]
    matching = [(sha, branch) for sha, branch in branches if branch == requested]
    if not matching:
        commit = output("git", "rev-parse", "--verify", "--end-of-options", requested + "^{commit}")
        matching = [(sha, branch) for sha, branch in branches if sha == commit]
    if not matching:
        sys.exit("commit must be the tip of a pushed origin branch")
    commit, branch = matching[0]
    url = output("git", "remote", "get-url", "origin")
    repo_url = output("gh", "repo", "view", url, "--json", "url", "--jq", ".url")
    parsed = urlparse(repo_url)
    if not parsed.hostname or len(parsed.path.strip("/").split("/")) != 2:
        sys.exit("could not resolve origin to a GitHub repository")
    repo = parsed.hostname + parsed.path.rstrip("/")
    request = uuid.uuid4().hex
    subprocess.run(["gh", "workflow", "run", "verify-tiers.yml", "--repo", repo, "--ref", branch,
                    "-f", f"commit={commit}", "-f", "tier=lane", "-f", f"request={request}"], check=True)
    deadline = time.monotonic() + 3600
    while time.monotonic() < deadline:
        runs = json.loads(output("gh", "run", "list", "--repo", repo, "--workflow", "verify-tiers.yml",
                                 "--limit", "100", "--json", "databaseId,displayTitle,headSha,status,conclusion"))
        for run in runs:
            if run["displayTitle"] != f"verify-{request}":
                continue
            if run["headSha"] != commit:
                sys.exit("workflow resolved a different commit")
            if run["status"] == "completed":
                print(f"Lane check {run['databaseId']} for {commit}: {run['conclusion']}")
                if run["conclusion"] != "success":
                    jobs = json.loads(output("gh", "run", "view", str(run["databaseId"]), "--repo", repo,
                                             "--json", "jobs"))["jobs"]
                    for job in jobs:
                        if job["conclusion"] not in ("success", "skipped"):
                            print(f"Failed job: {job['name']} ({job['conclusion']})", file=sys.stderr)
                    sys.exit(1)
                return
        time.sleep(10)
    sys.exit("timed out waiting for dispatched lane check")


if __name__ == "__main__":
    main()
