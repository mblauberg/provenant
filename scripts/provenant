#!/usr/bin/env python3
# Managed by scripts/install-harness; local edits to an installed copy are not preserved.
"""Stable Provenant command and Agent Fabric MCP entrypoint."""

from __future__ import annotations

import os
from pathlib import Path
import sys
from typing import NoReturn


REPAIR = "repair: set AGENT_FABRIC_PRODUCT_ROOT or AGENTS_HOME"


# Provisional for #530: that issue owns desired-state format evolution.
def resolve_product_root(instance_root: Path | None = None) -> Path:
    """Resolve the product root.

    Precedence is an explicit ``instance_root``, then
    ``AGENT_FABRIC_PRODUCT_ROOT``, then ``AGENTS_HOME``, then ``~/.agents``.
    The selected root must contain an executable ``scripts/agent-fabric-mcp``.
    """
    configured = os.environ.get("AGENT_FABRIC_PRODUCT_ROOT")
    agents_home = os.environ.get("AGENTS_HOME")
    if instance_root is not None:
        candidate = instance_root.expanduser().resolve()
    elif configured:
        candidate = Path(configured).expanduser()
        if not candidate.is_absolute():
            raise ValueError(
                f"AGENT_FABRIC_PRODUCT_ROOT must be an absolute path, got {configured}; {REPAIR}"
            )
        candidate = candidate.resolve()
    elif agents_home:
        candidate = Path(agents_home).expanduser()
        if not candidate.is_absolute():
            raise ValueError(f"AGENTS_HOME must be an absolute path, got {agents_home}; {REPAIR}")
        candidate = candidate.resolve()
    else:
        candidate = (Path.home() / ".agents").resolve()

    wrapper = candidate / "scripts/agent-fabric-mcp"
    if not wrapper.is_file() or not os.access(wrapper, os.X_OK):
        raise ValueError(f"Agent Fabric MCP target is missing or not executable at {wrapper}; {REPAIR}")
    return candidate


def usage() -> None:
    print("usage: provenant <help|route|worktree|check|fabric|doctor> [arguments...]", file=sys.stderr)


def help_text() -> None:
    print(
        """usage: provenant <command> [arguments...]

Thin front door; each command delegates to its existing owner:
  route ...      scripts/model-route ...
  worktree ...   scripts/worktree ...
  check ...      scripts/check-harness ...
  fabric ...     scripts/agent-fabric ...
  doctor ...     scripts/agent-fabric doctor ...

Fabric clients and providers are separate roles.
Kiro: optional subscription-native provider (ACP v1).
OpenCode: optional provider for explicit opencode/* account models (ACP v1)."""
    )


def execute(path: Path, arguments: list[str], product_root: Path | None = None) -> NoReturn:
    if product_root is None:
        os.execv(path, [str(path), *arguments])
    environment = os.environ.copy()
    environment["AGENTS_HOME"] = str(product_root)
    os.execve(path, [str(path), *arguments], environment)


def dispatcher_directory(command: str) -> tuple[Path, Path | None]:
    local_scripts = Path(__file__).resolve().parent
    if (local_scripts / "agent-fabric-mcp").is_file() and (local_scripts / command).is_file():
        return local_scripts, None
    product_root = resolve_product_root()
    return product_root / "scripts", product_root


def main(arguments: list[str]) -> int:
    if not arguments and "AGENT_FABRIC_SEAT" in os.environ:
        try:
            product_root = resolve_product_root()
        except ValueError as exc:
            print(f"provenant: {exc}", file=sys.stderr)
            return 3
        wrapper = product_root / "scripts/agent-fabric-mcp"
        execute(wrapper, [], product_root)

    if not arguments:
        usage()
        return 2

    command, *command_arguments = arguments
    if command in {"help", "-h", "--help"}:
        if command_arguments:
            usage()
            return 2
        help_text()
        return 0

    owners = {
        "route": ("model-route", []),
        "worktree": ("worktree", []),
        "check": ("check-harness", []),
        "fabric": ("agent-fabric", []),
        "doctor": ("agent-fabric", ["doctor"]),
    }
    owner = owners.get(command)
    if owner is None:
        usage()
        return 2
    owner_command, prefix = owner
    try:
        scripts, product_root = dispatcher_directory(owner_command)
    except ValueError as exc:
        print(f"provenant: {exc}", file=sys.stderr)
        return 3
    execute(scripts / owner_command, [*prefix, *command_arguments], product_root)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
