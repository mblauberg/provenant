def execute(
    path: Path,
    arguments: list[str],
    product_root: Path | None = None,
    *,
    clear_git_redirects: bool = False,
    python_helper: Path | None = None,
) -> NoReturn:
    try:
        if not path.is_file() or not os.access(path, os.X_OK):
            python_helper = None
        if python_helper is not None and not python_helper.is_file():
            raise FileNotFoundError(f"Python helper is missing at {python_helper}")
        program = Path("/bin/bash") if python_helper is not None else path
        argv = ([str(program), str(python_helper), str(path), *arguments]
                if python_helper is not None else [str(path), *arguments])
        if product_root is None and not clear_git_redirects:
            os.execv(program, argv)
        environment = os.environ.copy()
        if clear_git_redirects:
            for name in GIT_REDIRECT_ENVIRONMENT:
                environment.pop(name, None)
        if product_root is not None:
            environment["AGENT_FABRIC_PRODUCT_ROOT"] = str(product_root)
            environment["AGENTS_HOME"] = str(product_root)
        os.execve(program, argv, environment)
    except OSError as exc:
        print(f"provenant: cannot execute {path}: {exc.strerror or exc}; {REPAIR}", file=sys.stderr)
        raise SystemExit(3) from None


def dispatch_target(relative: str) -> tuple[Path, Path | None]:
    """Prefer the checkout this script lives in, then the resolved product root."""
    local_root = Path(__file__).resolve().parent.parent
    if (local_root / FABRIC_MCP).is_file() and (local_root / relative).is_file():
        return local_root / relative, None
    product_root = resolve_product_root()
    return product_root / relative, product_root


def check_target() -> tuple[Path, Path | None]:
    """Ask the dedicated helper to select the check owner and its custody root."""
    helper = Path(__file__).resolve().parent / "check_target.py"
    try:
        result = subprocess.run(
            [sys.executable, str(helper)], stdin=subprocess.DEVNULL,
            capture_output=True, check=False,
        )
    except OSError as exc:
        raise ValueError(f"cannot run check custody helper {helper}: {exc}") from exc
    if result.returncode != 0:
        message = result.stderr.decode(errors="replace").strip()
        if message.startswith("provenant: "):
            message = message[len("provenant: "):]
        raise ValueError(message or f"check custody helper failed (exit {result.returncode})")
    fields = result.stdout.split(b"\0")
    if len(fields) != 3 or fields[2] or not fields[0].startswith(b"/") or not fields[1].startswith(b"/"):
        raise ValueError("check custody helper gave unusable output")
    return Path(os.fsdecode(fields[0])), Path(os.fsdecode(fields[1]))


def main(arguments: list[str]) -> int:
    if not arguments and "AGENT_FABRIC_SEAT" in os.environ:
        try:
            product_root = resolve_product_root()
        except ValueError as exc:
            print(f"provenant: {exc}", file=sys.stderr)
            return 3
        execute(product_root / FABRIC_MCP, [], product_root)

    if not arguments:
        usage()
        return 2

    command, *command_arguments = arguments
    if command in {"lanes", "events", "graph"}:
        command_arguments = [command, *command_arguments]
        command = "fabric"
    if command == "lease":
        verb = command_arguments[0] if command_arguments else None
        if verb in {"-h", "--help"}:
            print(COMMAND_DETAILS["lease"])
            return 0
        if verb not in LEASE_VERBS:
            print(COMMAND_DETAILS["lease"].split("\n", 1)[0], file=sys.stderr)
            return 2
        command, command_arguments = "fabric", [f"landing-{verb}", *command_arguments[1:]]
    if command == "routes":
        command, command_arguments = "route", ["routes", *command_arguments]
    elif command == "help" and command_arguments == ["routes"]:
        command, command_arguments = "route", ["routes", "--health"]
    elif command in {"help", "-h", "--help"}:
        if not command_arguments:
            help_text()
            return 0
        if len(command_arguments) == 1 and command_arguments[0] in COMMAND_DETAILS:
            print(COMMAND_DETAILS[command_arguments[0]])
            return 0
        usage()
        return 2

    if command == "root":
        if command_arguments:
            usage()
            return 2
        try:
            print(resolve_product_root())
        except (OSError, ValueError) as exc:
            print(f"provenant: {exc}", file=sys.stderr)
            return 3
        return 0

    if command in {"stats", "retro", "digest", "classify", "extract"}:
        command_arguments = [command, *command_arguments]

    if command in {"peer", "hosts"}:
        command_arguments = [command, *command_arguments]

    owners = {
        "digest": "scripts/utility.py",
        "classify": "scripts/utility.py",
        "extract": "scripts/utility.py",
        "telemetry": "scripts/provenant-telemetry",
        "stats": "scripts/provenant-telemetry",
        "retro": "scripts/provenant-telemetry",
        "quota": "scripts/provenant-quota",
        "profile": "scripts/provenant-profile",
        "peer": "scripts/fabric-hosts",
        "hosts": "scripts/fabric-hosts",
        "route": "scripts/model-route",
        "capabilities": "skills/orchestrate/scripts/capabilities.py",
        "worktree": "scripts/worktree",
        "clean": "scripts/clean.py",
        "reap": "scripts/reap.py",
        "lint": "scripts/provenant_lint.py",
        "check": "scripts/check-harness",
        "gate": "scripts/gate",
        "fabric": FABRIC_CLI,
        "dispatch": "skills/orchestrate/scripts/dispatch_run.py",
        "batch": "skills/orchestrate/scripts/batch_run.py",
        "run": "skills/orchestrate/scripts/run_controls.py",
        "pr": "scripts/provenant-pr",
    }
    owner = owners.get(command)
    if owner is None:
        usage()
        return 2
    try:
        target, product_root = check_target() if command == "check" else dispatch_target(owner)
    except (OSError, ValueError) as exc:
        print(f"provenant: {exc}", file=sys.stderr)
        return 3
    if command == "check":
        try:
            warn_if_stale_checkout(resolve_product_root())
        except Exception as exc:  # advisory only; PROVENANT_DEBUG shows why it failed
            if os.environ.get("PROVENANT_DEBUG"):
                print(f"provenant: stale-checkout check failed: {exc!r}", file=sys.stderr)
    python_helper = (target.parents[len(Path(owner).parts) - 1] / "scripts/lib/harness-python.sh"
                     if owner.endswith(".py") else None)
    execute(target, command_arguments, product_root, clear_git_redirects=command == "check",
            python_helper=python_helper)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
