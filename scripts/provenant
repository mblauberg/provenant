#!/usr/bin/env python3
# Managed by scripts/install-harness; local edits to an installed copy are not preserved.
"""Stable Provenant command and Fabric MCP entrypoint."""

from __future__ import annotations

import os
from pathlib import Path
import sys
from typing import NoReturn

from lib.product_root_resolver import load_pointer_file


REPAIR = (
    "repair: re-run install-harness from the product checkout, "
    "or set AGENT_FABRIC_PRODUCT_ROOT"
)
FABRIC_MCP = "runtime/fabric/bin/fabric-mcp"
FABRIC_CLI = "runtime/fabric/bin/fabric"


def resolve_product_root(instance_root: Path | None = None) -> Path:
    """Resolve the product root.

    The instance root is selected by ``AGENT_FABRIC_INSTANCE_ROOT`` or
    ``~/.agents``. Product resolution then uses ``AGENT_FABRIC_PRODUCT_ROOT``,
    the instance pointer, ``AGENTS_HOME``, or ``~/.agents``.
    The selected root must contain the executable Fabric MCP launcher.
    """
    configured = os.environ.get("AGENT_FABRIC_PRODUCT_ROOT")
    agents_home = os.environ.get("AGENTS_HOME")
    configured_instance = os.environ.get("AGENT_FABRIC_INSTANCE_ROOT")
    if instance_root is None:
        instance_value = configured_instance
        instance_root = (
            Path(instance_value).expanduser()
            if instance_value is not None
            else Path.home() / ".agents"
        )
    if not instance_root.is_absolute():
        raise ValueError(f"instance root must be an absolute path, got {instance_root}; {REPAIR}")
    resolved_instance = instance_root.resolve()
    pointed = load_pointer_file(resolved_instance)

    if configured is not None:
        candidate = Path(configured).expanduser()
        if not candidate.is_absolute():
            raise ValueError(
                f"AGENT_FABRIC_PRODUCT_ROOT must be an absolute path, got {configured}; {REPAIR}"
            )
        candidate = candidate.resolve()
    elif pointed is not None:
        candidate = pointed.resolve()
    elif agents_home is not None:
        candidate = Path(agents_home).expanduser()
        if not candidate.is_absolute():
            raise ValueError(f"AGENTS_HOME must be an absolute path, got {agents_home}; {REPAIR}")
        candidate = candidate.resolve()
    else:
        candidate = (Path.home() / ".agents").resolve()

    wrapper = candidate / FABRIC_MCP
    if not wrapper.is_file() or not os.access(wrapper, os.X_OK):
        raise ValueError(f"Fabric MCP launcher is missing or not executable at {wrapper}; {REPAIR}")
    return candidate


def usage() -> None:
    print("usage: provenant <help|route|worktree|check|fabric|dispatch|batch|run> [arguments...]", file=sys.stderr)


def help_text() -> None:
    print(
        """usage: provenant <command> [arguments...]

Thin front door; each command delegates to its existing owner:
  route ...      scripts/model-route ...
  worktree ...   scripts/worktree ...
  check ...      scripts/check-harness ...
  fabric ...     runtime/fabric/bin/fabric ...
  dispatch ...   skills/orchestrate/scripts/dispatch_run.py ...
  batch ...      skills/orchestrate/scripts/batch_run.py ...
  run ...        skills/orchestrate/scripts/run_controls.py ...

Fabric derives who you are from the working directory, so run it from the
project you mean. `provenant fabric --help` lists its commands."""
    )


def execute(path: Path, arguments: list[str], product_root: Path | None = None) -> NoReturn:
    try:
        if product_root is None:
            os.execv(path, [str(path), *arguments])
        environment = os.environ.copy()
        environment["AGENT_FABRIC_PRODUCT_ROOT"] = str(product_root)
        environment["AGENTS_HOME"] = str(product_root)
        os.execve(path, [str(path), *arguments], environment)
    except OSError as exc:
        print(f"provenant: cannot execute {path}: {exc.strerror or exc}; {REPAIR}", file=sys.stderr)
        raise SystemExit(3) from None


def dispatch_target(relative: str) -> tuple[Path, Path | None]:
    """Prefer the checkout this script lives in, then the resolved product root."""
    local_root = Path(__file__).resolve().parent.parent
    if (local_root / FABRIC_MCP).is_file() and (local_root / relative).is_file():
        return local_root / relative, None
    product_root = resolve_product_root()
    return product_root / relative, product_root


def main(arguments: list[str]) -> int:
    if not arguments and "AGENT_FABRIC_SEAT" in os.environ:
        try:
            product_root = resolve_product_root()
        except ValueError as exc:
            print(f"provenant: {exc}", file=sys.stderr)
            return 3
        execute(product_root / FABRIC_MCP, [], product_root)

    if not arguments:
        usage()
        return 2

    command, *command_arguments = arguments
    if command in {"help", "-h", "--help"}:
        if command_arguments:
            usage()
            return 2
        help_text()
        return 0

    owners = {
        "route": "scripts/model-route",
        "worktree": "scripts/worktree",
        "check": "scripts/check-harness",
        "fabric": FABRIC_CLI,
        "dispatch": "skills/orchestrate/scripts/dispatch_run.py",
        "batch": "skills/orchestrate/scripts/batch_run.py",
        "run": "skills/orchestrate/scripts/run_controls.py",
    }
    owner = owners.get(command)
    if owner is None:
        usage()
        return 2
    try:
        target, product_root = dispatch_target(owner)
    except ValueError as exc:
        print(f"provenant: {exc}", file=sys.stderr)
        return 3
    execute(target, command_arguments, product_root)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
