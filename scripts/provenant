#!/usr/bin/env python3
# Managed by scripts/install-harness; local edits to an installed copy are not preserved.
"""Stable Provenant command and Fabric MCP entrypoint."""

from __future__ import annotations

import os
from pathlib import Path
import sys
from typing import NoReturn

from lib.product_root_resolver import load_pointer_file


REPAIR = (
    "repair: re-run install-harness from the product checkout, "
    "or set AGENT_FABRIC_PRODUCT_ROOT"
)
FABRIC_MCP = "runtime/fabric/bin/fabric-mcp"
FABRIC_CLI = "runtime/fabric/bin/fabric"
GIT_REDIRECT_ENVIRONMENT = (
    "GIT_DIR",
    "GIT_WORK_TREE",
    "GIT_COMMON_DIR",
    "GIT_INDEX_FILE",
    "GIT_OBJECT_DIRECTORY",
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_CEILING_DIRECTORIES",
    "GIT_DISCOVERY_ACROSS_FILESYSTEM",
)


def resolve_product_root(instance_root: Path | None = None) -> Path:
    """Resolve the product root.

    The instance root is selected by ``AGENT_FABRIC_INSTANCE_ROOT`` or
    ``~/.agents``. Product resolution then uses ``AGENT_FABRIC_PRODUCT_ROOT``,
    the instance pointer, ``AGENTS_HOME``, or ``~/.agents``.
    The selected root must contain the executable Fabric MCP launcher.
    """
    configured = os.environ.get("AGENT_FABRIC_PRODUCT_ROOT")
    agents_home = os.environ.get("AGENTS_HOME")
    configured_instance = os.environ.get("AGENT_FABRIC_INSTANCE_ROOT")
    if instance_root is None:
        instance_value = configured_instance
        instance_root = (
            Path(instance_value).expanduser()
            if instance_value is not None
            else Path.home() / ".agents"
        )
    if not instance_root.is_absolute():
        raise ValueError(f"instance root must be an absolute path, got {instance_root}; {REPAIR}")
    resolved_instance = instance_root.resolve()
    pointed = load_pointer_file(resolved_instance)

    if configured is not None:
        candidate = Path(configured).expanduser()
        if not candidate.is_absolute():
            raise ValueError(
                f"AGENT_FABRIC_PRODUCT_ROOT must be an absolute path, got {configured}; {REPAIR}"
            )
        candidate = candidate.resolve()
    elif pointed is not None:
        candidate = pointed.resolve()
    elif agents_home is not None:
        candidate = Path(agents_home).expanduser()
        if not candidate.is_absolute():
            raise ValueError(f"AGENTS_HOME must be an absolute path, got {agents_home}; {REPAIR}")
        candidate = candidate.resolve()
    else:
        candidate = (Path.home() / ".agents").resolve()

    wrapper = candidate / FABRIC_MCP
    if not wrapper.is_file() or not os.access(wrapper, os.X_OK):
        raise ValueError(f"Fabric MCP launcher is missing or not executable at {wrapper}; {REPAIR}")
    return candidate


def usage() -> None:
    print("usage: provenant <help|route|worktree|check|fabric|dispatch|batch|run> [arguments...]", file=sys.stderr)


def help_text() -> None:
    print(
        """usage: provenant <command> [arguments...]

Thin front door; each command delegates to its existing owner:
  route ...      scripts/model-route ... (low-level resolver; capability-bound
                 aliases need a fresh snapshot, normally supplied by dispatch)
  worktree ...   scripts/worktree ...
  check ...      scripts/check-harness ...
  fabric ...     runtime/fabric/bin/fabric ...
  dispatch ...   skills/orchestrate/scripts/dispatch_run.py ...
  batch ...      skills/orchestrate/scripts/batch_run.py ...
  run ...        skills/orchestrate/scripts/run_controls.py ...

`provenant run cancel` writes one cooperative cancellation request for an
exact attempt or batch and waits boundedly for owner-written evidence.

Fabric derives who you are from the working directory, so run it from the
project you mean. `provenant fabric --help` lists its commands."""
    )


def execute(
    path: Path,
    arguments: list[str],
    product_root: Path | None = None,
    *,
    clear_git_redirects: bool = False,
) -> NoReturn:
    try:
        if product_root is None and not clear_git_redirects:
            os.execv(path, [str(path), *arguments])
        environment = os.environ.copy()
        if clear_git_redirects:
            for name in GIT_REDIRECT_ENVIRONMENT:
                environment.pop(name, None)
        if product_root is not None:
            environment["AGENT_FABRIC_PRODUCT_ROOT"] = str(product_root)
            environment["AGENTS_HOME"] = str(product_root)
        os.execve(path, [str(path), *arguments], environment)
    except OSError as exc:
        print(f"provenant: cannot execute {path}: {exc.strerror or exc}; {REPAIR}", file=sys.stderr)
        raise SystemExit(3) from None


def nearest_git_metadata(root: Path) -> Path | None:
    """Return the nearest .git entry without following or trusting it."""
    requested = root.resolve()
    for ancestor in (requested, *requested.parents):
        candidate = ancestor / ".git"
        try:
            candidate.lstat()
        except FileNotFoundError:
            continue
        except OSError as exc:
            raise ValueError(f"cannot inspect Git metadata at {candidate}: {exc}") from exc
        return candidate
    return None


def registered_caller_checkout(product_root: Path) -> Path | None:
    """Return the registered product checkout containing the caller, if any."""
    # Import the existing Git-custody owner only for `check`. Other Provenant
    # commands remain usable from thin test/install dispatchers that do not
    # carry the worktree implementation.
    try:
        from worktree import PolicyError, common_git_dir, owning_root, worktree_records
    except ImportError as exc:
        raise ValueError(f"worktree policy owner is unavailable; {REPAIR}") from exc

    caller = Path.cwd().resolve()
    product_metadata = nearest_git_metadata(product_root)
    if product_metadata is None:
        return None
    try:
        product_checkout = owning_root(product_root)
        records = worktree_records(product_checkout)
    except PolicyError as exc:
        raise ValueError(f"cannot verify product checkout {product_root}: {exc}") from exc

    registered = [
        Path(str(record["worktree"])).resolve()
        for record in records
        if record.get("worktree") is not None
    ]
    containing = [
        checkout
        for checkout in registered
        if caller == checkout or caller.is_relative_to(checkout)
    ]
    if containing:
        return max(containing, key=lambda path: len(path.parts))

    caller_metadata = nearest_git_metadata(caller)
    if caller_metadata is None:
        return None
    try:
        caller_root = owning_root(caller)
    except PolicyError as exc:
        raise ValueError(
            f"invalid Git metadata at {caller_metadata}; repair: run ./scripts/check-harness "
            "from the checkout you intend to check"
        ) from exc
    if common_git_dir(caller_root) == common_git_dir(product_checkout):
        raise ValueError(
            f"caller checkout {caller_root} is not a registered worktree of product root "
            f"{product_checkout}; repair: run ./scripts/check-harness from the checkout you "
            "intend to check"
        )
    return None


def checked_target(root: Path) -> Path:
    """Require the selected checkout's own regular executable checker."""
    target = root / "scripts/check-harness"
    if target.is_symlink() or not target.is_file() or not os.access(target, os.X_OK):
        raise ValueError(
            f"selected checkout {root} has no regular executable scripts/check-harness; "
            "repair: restore that checkout or run the checker directly from another checkout"
        )
    if not target.resolve().is_relative_to(root.resolve()):
        raise ValueError(f"selected checker {target} resolves outside checkout {root}")
    return target


def dispatch_target(relative: str) -> tuple[Path, Path | None]:
    """Prefer the checkout this script lives in, then the resolved product root."""
    local_root = Path(__file__).resolve().parent.parent
    if (local_root / FABRIC_MCP).is_file() and (local_root / relative).is_file():
        return local_root / relative, None
    product_root = resolve_product_root()
    return product_root / relative, product_root


def check_target() -> tuple[Path, Path | None]:
    """Select the registered checkout containing the caller, without trusting copies."""
    local_root = Path(__file__).resolve().parent.parent
    local_target = local_root / "scripts/check-harness"
    local_available = (local_root / FABRIC_MCP).is_file() and local_target.is_file()
    product_root = local_root if local_available else resolve_product_root()
    caller_root = registered_caller_checkout(product_root)
    if caller_root is None:
        if local_available:
            return checked_target(local_root), local_root
        return checked_target(product_root), product_root
    return checked_target(caller_root), caller_root


def main(arguments: list[str]) -> int:
    if not arguments and "AGENT_FABRIC_SEAT" in os.environ:
        try:
            product_root = resolve_product_root()
        except ValueError as exc:
            print(f"provenant: {exc}", file=sys.stderr)
            return 3
        execute(product_root / FABRIC_MCP, [], product_root)

    if not arguments:
        usage()
        return 2

    command, *command_arguments = arguments
    if command in {"help", "-h", "--help"}:
        if command_arguments:
            usage()
            return 2
        help_text()
        return 0

    owners = {
        "route": "scripts/model-route",
        "worktree": "scripts/worktree",
        "check": "scripts/check-harness",
        "fabric": FABRIC_CLI,
        "dispatch": "skills/orchestrate/scripts/dispatch_run.py",
        "batch": "skills/orchestrate/scripts/batch_run.py",
        "run": "skills/orchestrate/scripts/run_controls.py",
    }
    owner = owners.get(command)
    if owner is None:
        usage()
        return 2
    try:
        target, product_root = check_target() if command == "check" else dispatch_target(owner)
    except (OSError, ValueError) as exc:
        print(f"provenant: {exc}", file=sys.stderr)
        return 3
    execute(target, command_arguments, product_root, clear_git_redirects=command == "check")


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
