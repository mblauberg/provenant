#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PLATFORM=""
MCP_CLIENTS="primary"

usage() {
  echo "usage: install-harness --platform <claude|codex> [--mcp-clients <primary|all>]" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --platform)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      PLATFORM="$2"
      shift 2
      ;;
    --mcp-clients)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      MCP_CLIENTS="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

case "$PLATFORM" in
  claude)
    platform_home="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    instructions="$platform_home/CLAUDE.md"
    ;;
  codex)
    platform_home="${CODEX_HOME:-$HOME/.codex}"
    instructions="$platform_home/AGENTS.md"
    ;;
  *)
    usage
    exit 2
    ;;
esac

case "$MCP_CLIENTS" in
  primary|all) ;;
  *) usage; exit 2 ;;
esac

provenant_bin_dir="${PROVENANT_BIN_DIR:-$HOME/.local/bin}"
provenant_command="$provenant_bin_dir/provenant"
provenant_source="$ROOT/scripts/provenant.template"
provenant_marker="# Managed by scripts/install-harness; local edits to an installed copy are not preserved."
provenant_status="installed"
instance_root="${AGENT_FABRIC_INSTANCE_ROOT:-${AGENTS_HOME:-$HOME/.agents}}"
case "$provenant_bin_dir" in
  /*) ;;
  *) echo "PROVENANT_BIN_DIR must be absolute" >&2; exit 3 ;;
esac
case "$instance_root" in
  /*) ;;
  *) echo "Agent Fabric instance root must be absolute" >&2; exit 3 ;;
esac

# Refuse a command collision before any installation mutation.
if [[ -e "$provenant_command" || -L "$provenant_command" ]]; then
  if [[ -L "$provenant_command" ]]; then
    if [[ -f "$provenant_command" ]] && grep -Fqx "$provenant_marker" "$provenant_command"; then
      provenant_status="updated"
    else
      echo "provenant command collision=$provenant_command" >&2
      exit 3
    fi
  elif [[ -f "$provenant_command" ]] && grep -Fqx "$provenant_marker" "$provenant_command"; then
    if cmp -s "$provenant_source" "$provenant_command"; then
      provenant_status="existing"
    else
      provenant_status="updated"
    fi
  else
    echo "provenant command collision=$provenant_command" >&2
    exit 3
  fi
fi

state_directory="${AGENT_FABRIC_STATE_DIRECTORY:-$HOME/.local/state/agent-harness/fabric}"
claude_mcp_config="${CLAUDE_MCP_CONFIG:-$HOME/.claude.json}"
mcp_platform="$PLATFORM"
if [[ "$MCP_CLIENTS" == "all" ]]; then
  mcp_platform="all"
fi
codex_mcp_config="${CODEX_MCP_CONFIG:-${CODEX_HOME:-$HOME/.codex}/config.toml}"
mcp_args=(
  --platform "$mcp_platform"
  --agents-home "$ROOT"
  --state-directory "$state_directory"
  --shim-path "$provenant_command"
  --claude-config "$claude_mcp_config"
  --codex-config "$codex_mcp_config"
  --cursor-config "${CURSOR_MCP_CONFIG:-$HOME/.cursor/mcp.json}"
  --agy-config "${AGY_MCP_CONFIG:-$HOME/.gemini/config/mcp_config.json}"
  --kiro-config "${KIRO_MCP_CONFIG:-$HOME/.kiro/settings/mcp.json}"
  --opencode-config "${OPENCODE_MCP_CONFIG:-$HOME/.config/opencode/opencode.jsonc}"
)

"$ROOT/scripts/configure-agent-fabric-mcp.py" "${mcp_args[@]}" --preflight

if [[ "$PLATFORM" == "codex" ]]; then
  "$ROOT/scripts/configure-codex-skill-overrides.py" --preflight \
    --config "$platform_home/config.toml"
fi

mkdir -p "$provenant_bin_dir"
if [[ "$provenant_status" == "existing" ]]; then
  echo "command existing=$provenant_command"
else
  provenant_temporary=$(mktemp "$provenant_bin_dir/.provenant.XXXXXX")
  trap 'rm -f "$provenant_temporary"' EXIT
  cp "$provenant_source" "$provenant_temporary"
  chmod 755 "$provenant_temporary"
  mv -f "$provenant_temporary" "$provenant_command"
  trap - EXIT
  echo "command $provenant_status=$provenant_command"
fi
"$ROOT/scripts/write-product-root-pointer.py" "$instance_root" "$ROOT"
echo "product root pointer updated=$instance_root/.agent-fabric/product-root.json"
case ":${PATH:-}:" in
  *":$provenant_bin_dir:"*) ;;
  *) echo "warning: $provenant_bin_dir is not on PATH" >&2 ;;
esac

# Seed the instance side before projecting anything into the client home. The
# desired state and the seeded templates are instance-owned once written (ADR
# 0019), so this is a no-op on every install after the first. `instance_root` is
# resolved once, above, on the contract #529 established.
"$ROOT/scripts/instance_installation.py" seed \
  --product-root "$ROOT" --instance-root "$instance_root" --summary

mkdir -p "$platform_home"
"$ROOT/scripts/install-skills" --target "$platform_home/skills"
if [[ "$PLATFORM" == "claude" ]]; then
  "$ROOT/scripts/install-workflows" --target "$platform_home/workflows"
fi
if [[ "$PLATFORM" == "codex" ]]; then
  "$ROOT/scripts/configure-codex-skill-overrides.py" \
    --config "$platform_home/config.toml"
fi
"$ROOT/scripts/configure-agent-fabric-mcp.py" "${mcp_args[@]}"

# AGENTS.md is instance-owned once seeded and HARNESS.md stays product-shipped
# (ADR 0019), so the client reads doctrine from the instance and the harness
# constitution from the product. In a fused layout both roots are one directory,
# so this is the text that was always emitted.
instance_doctrine="$instance_root/AGENTS.md"
# Every installer before this one wrote the product path here. That text is
# stale, not foreign, so it is migrated rather than refused: refusing it would
# break every upgrade from a previous install. In a fused layout the two paths
# are the same string and the migration is a byte-for-byte no-op.
legacy_doctrine="$ROOT/AGENTS.md"
bootstrap="Read and follow \`$instance_doctrine\` and \`$ROOT/HARNESS.md\` before making orchestration, delegation, model-routing or memory decisions. Platform/system policy and explicit user authority lead; the nearest project instruction may specialise or strengthen the global harness but may not silently broaden authority, weaken safety gates or redefine global cross-project memory policy."

migrate_instructions() {
  # Replace only the exact legacy path, leaving anything the user wrote around
  # it untouched. Scanning left to right and never rescanning replaced text
  # keeps this correct even when one path contains the other.
  local temporary
  temporary=$(mktemp "$(dirname "$instructions")/.instructions.XXXXXX")
  if ! LEGACY_DOCTRINE="$legacy_doctrine" INSTANCE_DOCTRINE="$instance_doctrine" awk '
    BEGIN { legacy = ENVIRON["LEGACY_DOCTRINE"]; instance = ENVIRON["INSTANCE_DOCTRINE"] }
    {
      out = ""; rest = $0
      while ((at = index(rest, legacy)) > 0) {
        out = out substr(rest, 1, at - 1) instance
        rest = substr(rest, at + length(legacy))
      }
      print out rest
    }
  ' "$instructions" > "$temporary"; then
    rm -f "$temporary"
    return 1
  fi
  cat "$temporary" > "$instructions"
  rm -f "$temporary"
}

if [[ ! -e "$instructions" && ! -L "$instructions" ]]; then
  {
    echo "# Provenant"
    echo
    echo "$bootstrap"
  } > "$instructions"
  echo "instructions created=$instructions"
elif [[ -L "$instructions" ]] && { [[ "$instructions" -ef "$instance_doctrine" ]] || [[ "$instructions" -ef "$legacy_doctrine" ]]; }; then
  # A link the user made to either doctrine file already resolves to doctrine;
  # repointing someone's deliberate symlink is more than an upgrade should do.
  echo "instructions existing=$instructions"
elif grep -Fq "$instance_doctrine" "$instructions" && grep -Fq "$ROOT/HARNESS.md" "$instructions"; then
  echo "instructions existing=$instructions"
elif grep -Fq "$legacy_doctrine" "$instructions" && grep -Fq "$ROOT/HARNESS.md" "$instructions"; then
  if ! migrate_instructions; then
    echo "instructions unmigrated=$instructions" >&2
    exit 3
  fi
  echo "instructions migrated=$instructions"
else
  echo "instructions preserved=$instructions" >&2
  echo "add this line to that file:" >&2
  echo "$bootstrap" >&2
  exit 3
fi
