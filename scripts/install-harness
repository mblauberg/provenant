#!/usr/bin/env bash
set -euo pipefail

script_path=$0
while [[ -L "$script_path" ]]; do
  link=$(readlink "$script_path")
  case "$link" in
    /*) script_path=$link ;;
    *) script_path=$(dirname "$script_path")/$link ;;
  esac
done
PRODUCT_ROOT="$(CDPATH= cd -- "$(dirname "$script_path")/.." && pwd -P)"
if [[ -f "$PRODUCT_ROOT/.git" && "${PROVENANT_ALLOW_LINKED_WORKTREE_INSTALL:-}" != 1 ]]; then
  echo "install-harness refuses a linked worktree product root: $PRODUCT_ROOT" >&2
  echo "repair: run from the canonical checkout, or explicitly acknowledge with PROVENANT_ALLOW_LINKED_WORKTREE_INSTALL=1" >&2
  exit 3
fi
PLATFORM=""
MCP_CLIENTS="primary"
REFRESH_ROUTING=0

usage() {
  echo "usage: install-harness --platform <claude|codex|opencode|agy|cursor|kiro|all> [--mcp-clients <primary|all>] [--refresh-routing]" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --platform)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      PLATFORM="$2"
      shift 2
      ;;
    --mcp-clients)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      MCP_CLIENTS="$2"
      shift 2
      ;;
    --refresh-routing)
      REFRESH_ROUTING=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

case "$PLATFORM" in
  claude|codex|opencode|agy|cursor|kiro) primary_platforms=("$PLATFORM") ;;
  all)
    primary_platforms=(claude codex)
    [[ -d "${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}" ]] && primary_platforms+=(opencode)
    if [[ -n "${AGY_CONFIG_DIR:-}" ]] || { [[ -d "$HOME/.gemini" ]] && command -v agy >/dev/null 2>&1; }; then
      primary_platforms+=(agy)
    fi
    [[ -d "$HOME/.cursor" ]] && primary_platforms+=(cursor)
    [[ -d "$HOME/.kiro" ]] && primary_platforms+=(kiro)
    ;;
  *) usage; exit 2 ;;
esac
REQUESTED_PLATFORM="$PLATFORM"

case "$MCP_CLIENTS" in
  primary|all) ;;
  *) usage; exit 2 ;;
esac

provenant_bin_dir="${PROVENANT_BIN_DIR:-$HOME/.local/bin}"
provenant_command="$provenant_bin_dir/provenant"
provenant_source="$PRODUCT_ROOT/scripts/provenant.template"
instance_root="${AGENT_FABRIC_INSTANCE_ROOT:-$HOME/.agents}"
case "$provenant_bin_dir" in
  /*) ;;
  *) echo "PROVENANT_BIN_DIR must be absolute" >&2; exit 3 ;;
esac
case "$provenant_command" in
  "$PRODUCT_ROOT"|"$PRODUCT_ROOT"/*)
    echo "PROVENANT_BIN_DIR must be outside the product checkout: $PRODUCT_ROOT" >&2
    exit 3
    ;;
esac
case "$instance_root" in
  /*) ;;
  *) echo "Agent Fabric instance root must be absolute" >&2; exit 3 ;;
esac

# shellcheck source=scripts/lib/harness-python.sh
source "$PRODUCT_ROOT/scripts/lib/harness-python.sh"

provenant_bin_real="$(run_stdlib -c '
from pathlib import Path
import sys
print(Path(sys.argv[1]).resolve(strict=False))
' "$provenant_bin_dir")"
case "$provenant_bin_real/provenant" in
  "$PRODUCT_ROOT"|"$PRODUCT_ROOT"/*)
    echo "PROVENANT_BIN_DIR resolves inside the product checkout: $provenant_bin_real" >&2
    exit 3
    ;;
esac

select_primary() {
  PLATFORM="$1"
  case "$PLATFORM" in
    claude)
      platform_home="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
      instructions="$platform_home/CLAUDE.md"
      ;;
    codex)
      platform_home="${CODEX_HOME:-$HOME/.codex}"
      instructions="$platform_home/AGENTS.md"
      ;;
    opencode)
      platform_home="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
      instructions="$platform_home/AGENTS.md"
      ;;
    agy)
      platform_home="${AGY_CONFIG_DIR:-$HOME/.gemini}"
      instructions="$platform_home/GEMINI.md"
      ;;
    cursor|kiro)
      platform_home="$HOME/.$PLATFORM"
      instructions=""
      ;;
    *) echo "unsupported primary: $PLATFORM" >&2; exit 2 ;;
  esac
}

preflight_directory_target() {
  local target="$1"
  local source="$2"
  if [[ ! -L "$target" ]]; then
    return 0
  fi
  local target_real=""
  local source_real=""
  if ! target_real="$(CDPATH= cd -- "$target" 2>/dev/null && pwd -P)" \
    || ! source_real="$(CDPATH= cd -- "$source" 2>/dev/null && pwd -P)" \
    || [[ "$target_real" != "$source_real" ]]; then
    echo "conflicting: managed directory is a non-canonical symlink: $target" >&2
    echo "repair: restore the directory or deliberately use the canonical product link $source" >&2
    exit 3
  fi
}

instance_doctrine="$instance_root/AGENTS.md"
product_pointer="$instance_root/.agent-fabric/product-root.json"
old_product_root=""
if [[ -f "$product_pointer" ]]; then
  old_product_root="$(run_stdlib -c '
from pathlib import Path
import sys
sys.path.insert(0, sys.argv[1])
from lib.product_root_resolver import load_pointer_path
value = load_pointer_path(Path(sys.argv[2]))
print(value or "")
' "$PRODUCT_ROOT/scripts" "$instance_root")"
fi
bootstrap="Read and follow \`$instance_doctrine\` and \`$PRODUCT_ROOT/HARNESS.md\` before making orchestration, delegation, model-routing or memory decisions. Platform/system policy and explicit user authority lead; the nearest project instruction may specialise or strengthen the global harness but may not silently broaden authority, weaken safety gates or redefine global cross-project memory policy."

is_generated_bootstrap() {
  local content expected
  content="$(<"$instructions")" || return 1
  expected=$'# Provenant\n\nRead and follow `'
  expected+=*/AGENTS.md
  expected+='` and `'
  expected+=*/HARNESS.md
  expected+=$'` before making orchestration, delegation, model-routing or memory decisions. Platform/system policy and explicit user authority lead; the nearest project instruction may specialise or strengthen the global harness but may not silently broaden authority, weaken safety gates or redefine global cross-project memory policy.'
  [[ "$content" == $expected ]]
}

is_current_generated_bootstrap() {
  local content
  content="$(<"$instructions")" || return 1
  [[ "$content" == "# Provenant"$'\n\n'"$bootstrap" ]]
}

rewrite_generated_bootstrap() {
  local temporary
  temporary="$(mktemp "${instructions}.provenant.XXXXXXXX")" || return 3
  if ! printf '# Provenant\n\n%s\n' "$bootstrap" > "$temporary"; then
    rm -f "$temporary"
    exit 3
  fi
  mv -f "$temporary" "$instructions" || { rm -f "$temporary"; return 3; }
  echo "instructions updated=$instructions"
}

create_generated_bootstrap() {
  local temporary
  temporary="$(mktemp "${instructions}.provenant.XXXXXXXX")" || return 3
  if ! {
    echo "# Provenant"
    echo
    echo "$bootstrap"
  } > "$temporary"; then
    rm -f "$temporary"
    exit 3
  fi
  mv -f "$temporary" "$instructions" || { rm -f "$temporary"; return 3; }
  echo "instructions created=$instructions"
}

preflight_instructions() {
  [[ -n "$instructions" ]] || return 0
  if [[ ! -e "$instructions" && ! -L "$instructions" ]]; then
    return 0
  fi
  if [[ -L "$instructions" ]]; then
    if [[ "$instructions" -ef "$instance_doctrine" ]]; then
      return 0
    fi
    echo "conflicting: instructions symlink is not the instance doctrine: $instructions" >&2
    echo "repair: restore the file or link it to $instance_doctrine" >&2
    exit 3
  fi
  if is_generated_bootstrap; then
    return 0
  fi
  if grep -Fq "$instance_doctrine" "$instructions" \
    && grep -Fq "$PRODUCT_ROOT/HARNESS.md" "$instructions"; then
    return 0
  fi
  echo "conflicting: instructions preserved=$instructions" >&2
  echo "add this line to that file:" >&2
  echo "$bootstrap" >&2
  exit 3
}

preflight_harness_link() {
  [[ -n "$instructions" ]] || return 0
  local harness="$platform_home/HARNESS.md"
  if [[ ! -e "$harness" && ! -L "$harness" ]]; then
    return 0
  fi
  if [[ -L "$harness" ]] && [[ "$harness" -ef "$PRODUCT_ROOT/HARNESS.md" ]]; then
    return 0
  fi
  if is_receipt_owned_old_harness "$harness"; then
    return 0
  fi
  echo "conflicting: HARNESS.md is not a canonical or receipt-owned product link: $harness" >&2
  echo "repair: restore the file or link it to $PRODUCT_ROOT/HARNESS.md" >&2
  exit 3
}

is_receipt_owned_old_harness() {
  local harness="$1" link_target
  [[ -L "$harness" && -n "$old_product_root" ]] || return 1
  link_target="$(readlink "$harness")" || return 1
  run_stdlib -c '
from pathlib import Path
import sys
target = (Path(sys.argv[1]).parent / sys.argv[2]).resolve(strict=False)
expected = Path(sys.argv[3]).resolve(strict=False) / "HARNESS.md"
raise SystemExit(0 if target == expected else 1)
' "$harness" "$link_target" "$old_product_root"
}

rebind_harness_link() {
  [[ -n "$instructions" ]] || return 0
  local harness="$platform_home/HARNESS.md"
  if [[ "$PLATFORM" == "agy" || "$PLATFORM" == "opencode" ]] \
    && [[ ! -e "$harness" && ! -L "$harness" ]]; then
    ln -s "$PRODUCT_ROOT/HARNESS.md" "$harness" || return 3
    echo "harness created=$harness"
    return 0
  fi
  if is_receipt_owned_old_harness "$harness" \
    && [[ ! "$harness" -ef "$PRODUCT_ROOT/HARNESS.md" ]]; then
    local temporary_directory temporary
    temporary_directory="$(mktemp -d "${harness}.provenant-new.XXXXXXXX")" || return 3
    temporary="$temporary_directory/HARNESS.md"
    if ! ln -s "$PRODUCT_ROOT/HARNESS.md" "$temporary" \
      || ! mv -f "$temporary" "$harness"; then
      rm -f "$temporary"
      rmdir "$temporary_directory"
      exit 3
    fi
    rmdir "$temporary_directory" || return 3
    echo "harness updated=$harness"
  fi
}

# Validate every selected primary before publishing the command, product
# pointer, seeded instance files, client links or installation receipt. A
# canonical whole-directory link was already checked above; it has no
# per-entry catalogue to preflight.
preflight_primary() {
  local primary="$1"
  select_primary "$primary"
  preflight_directory_target "$platform_home/skills" "$PRODUCT_ROOT/skills"
  if [[ "$PLATFORM" == "claude" ]]; then
    preflight_directory_target "$platform_home/agents" "$PRODUCT_ROOT/agents"
    preflight_directory_target "$platform_home/workflows" "$PRODUCT_ROOT/workflows"
  fi
  if [[ ! -L "$platform_home/skills" ]]; then
    run_stdlib "$PRODUCT_ROOT/scripts/manage_installation.py" preflight \
      --source "$PRODUCT_ROOT/skills" \
      --custom-source "$instance_root/custom-skills" \
      --target "$platform_home/skills" >/dev/null || return $?
  fi
  run_stdlib "$PRODUCT_ROOT/scripts/instance_installation.py" validate \
    --product-root "$PRODUCT_ROOT" --instance-root "$instance_root" >/dev/null || return $?
  if [[ "$PLATFORM" == "claude" ]]; then
    if [[ ! -L "$platform_home/agents" ]]; then
      run_stdlib "$PRODUCT_ROOT/scripts/manage_installation.py" plan \
        --surface agents \
        --source "$PRODUCT_ROOT/agents" \
        --target "$platform_home/agents" \
        --summary >/dev/null || return $?
    fi
    if [[ ! -L "$platform_home/workflows" ]]; then
      run_stdlib "$PRODUCT_ROOT/scripts/install-workflows" --target "$platform_home/workflows" --preflight || return $?
    fi
  fi
  preflight_instructions
  preflight_harness_link
}

selected_platforms=()
skipped_platforms=()
for primary in "${primary_platforms[@]}"; do
  if [[ "$REQUESTED_PLATFORM" == "all" && "$primary" != "claude" && "$primary" != "codex" ]]; then
    if ! diagnostic="$(preflight_primary "$primary" 2>&1)"; then
      printf '%s\n' "$diagnostic" >&2
      skip_reason=conflict
      [[ "$diagnostic" == *"instructions preserved="* ]] && skip_reason=instructions-preserved
      echo "warning: detected provider $primary skipped=$skip_reason; preserving its files" >&2
      echo "provider $primary skipped=$skip_reason"
      skipped_platforms+=("$primary")
      continue
    fi
  else
    preflight_primary "$primary"
  fi
  selected_platforms+=("$primary")
done
primary_platforms=(${selected_platforms[@]+"${selected_platforms[@]}"})

# Refuse a command collision before any installation mutation. Publication
# revalidates this state and uses atomic no-replace or exchange primitives.
provenant_preflight="$(
  run_stdlib "$PRODUCT_ROOT/scripts/install-provenant-command.py" classify \
    --source "$provenant_source" \
    --destination "$provenant_command"
)" || exit 3

state_directory="${AGENT_FABRIC_STATE_DIRECTORY:-$HOME/.local/state/agent-harness/fabric}"
claude_mcp_config="${CLAUDE_MCP_CONFIG:-$HOME/.claude.json}"
codex_mcp_config="${CODEX_MCP_CONFIG:-${CODEX_HOME:-$HOME/.codex}/config.toml}"
mcp_args=(
  --agents-home "$PRODUCT_ROOT"
  --state-directory "$state_directory"
  --shim-path "$provenant_command"
  --claude-config "$claude_mcp_config"
  --codex-config "$codex_mcp_config"
  --cursor-config "${CURSOR_MCP_CONFIG:-$HOME/.cursor/mcp.json}"
  --agy-config "${AGY_MCP_CONFIG:-${AGY_CONFIG_DIR:-$HOME/.gemini}/config/mcp_config.json}"
  --kiro-config "${KIRO_MCP_CONFIG:-$HOME/.kiro/settings/mcp.json}"
  --opencode-config "${OPENCODE_MCP_CONFIG:-${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}/opencode.jsonc}"
)
mcp_instance_root=""
if [[ -n "${AGENT_FABRIC_INSTANCE_ROOT:-}" && "$instance_root" != "$HOME/.agents" ]]; then
  mcp_instance_root="$instance_root"
  mcp_args+=(--instance-root "$instance_root")
fi

configure_fabric_mcp() {
  local client="$1" action="${2:-}"
  local mcp_command=("${mcp_args[@]}")
  if [[ -n "$action" ]]; then mcp_command+=("$action"); fi
  AGENT_FABRIC_INSTANCE_ROOT="$mcp_instance_root" \
    run_stdlib "$PRODUCT_ROOT/scripts/configure-fabric-mcp.py" \
    --platform "$client" "${mcp_command[@]}"
}

required_client() {
  [[ "$1" == "$REQUESTED_PLATFORM" ]] \
    || { [[ "$REQUESTED_PLATFORM" == all ]] && [[ "$1" == claude || "$1" == codex ]]; }
}

if [[ "$MCP_CLIENTS" == "all" ]]; then
  mcp_platforms=(claude codex cursor agy kiro opencode)
else
  mcp_platforms=(${primary_platforms[@]+"${primary_platforms[@]}"})
fi
mcp_ready=()
for client in "${mcp_platforms[@]}"; do
  skip=0
  for skipped in ${skipped_platforms[@]+"${skipped_platforms[@]}"}; do
    [[ "$client" == "$skipped" ]] && skip=1
  done
  [[ "$skip" == 1 ]] && continue
  if ! required_client "$client"; then
    if ! diagnostic="$(configure_fabric_mcp "$client" --preflight 2>&1)"; then
      printf '%s\n' "$diagnostic" >&2
      echo "warning: detected provider $client skipped=mcp-conflict; preserving its files" >&2
      echo "provider $client skipped=mcp-conflict"
      skipped_platforms+=("$client")
      continue
    fi
  else
    configure_fabric_mcp "$client" --preflight
  fi
  mcp_ready+=("$client")
done
mcp_platforms=(${mcp_ready[@]+"${mcp_ready[@]}"})
selected_platforms=()
for primary in "${primary_platforms[@]}"; do
  skip=0
  for skipped in ${skipped_platforms[@]+"${skipped_platforms[@]}"}; do
    [[ "$primary" == "$skipped" ]] && skip=1
  done
  [[ "$skip" == 0 ]] && selected_platforms+=("$primary")
done
primary_platforms=(${selected_platforms[@]+"${selected_platforms[@]}"})

if [[ "$REQUESTED_PLATFORM" == "codex" || "$REQUESTED_PLATFORM" == "all" ]]; then
  select_primary codex
  run_stdlib "$PRODUCT_ROOT/scripts/configure-codex-skill-overrides.py" --preflight \
    --config "$platform_home/config.toml"
fi

mkdir -p "$provenant_bin_dir"
provenant_status="$(
  run_stdlib "$PRODUCT_ROOT/scripts/install-provenant-command.py" publish \
    --source "$provenant_source" \
    --destination "$provenant_command" \
    --expected "$provenant_preflight"
)" || exit 3
echo "command $provenant_status=$provenant_command"
case ":${PATH:-}:" in
  *":$provenant_bin_dir:"*) ;;
  *) echo "warning: $provenant_bin_dir is not on PATH" >&2 ;;
esac

# Seed the instance side before projecting anything into the client home. The
# desired state and the seeded templates are instance-owned once written (ADR
# 0019), so this is a no-op on every install after the first. `instance_root` is
# resolved once, above, on the contract #529 established.
run_stdlib "$PRODUCT_ROOT/scripts/instance_installation.py" seed \
  --product-root "$PRODUCT_ROOT" --instance-root "$instance_root" --no-pointer --summary
if [[ "$REFRESH_ROUTING" == 1 ]]; then
  run_stdlib "$PRODUCT_ROOT/scripts/instance_installation.py" refresh-routing \
    --product-root "$PRODUCT_ROOT" --instance-root "$instance_root" --summary
fi

install_primary() {
  select_primary "$1"
  mkdir -p "$platform_home" || return $?
  "$PRODUCT_ROOT/scripts/install-skills" \
    --target "$platform_home/skills" \
    --custom-source "$instance_root/custom-skills" || return $?
  if [[ "$PLATFORM" == "claude" ]]; then
    run_stdlib "$PRODUCT_ROOT/scripts/install-workflows" --target "$platform_home/workflows" || return $?
    "$PRODUCT_ROOT/scripts/install-agents" --target "$platform_home/agents" || return $?
  fi
  if [[ "$PLATFORM" == "codex" ]]; then
    run_stdlib "$PRODUCT_ROOT/scripts/configure-codex-skill-overrides.py" \
      --config "$platform_home/config.toml" || return $?
  fi
  rebind_harness_link || return $?

  # AGENTS.md is instance-owned once seeded and HARNESS.md stays product-shipped
  # (ADR 0019), so the client reads doctrine from the instance and the harness
  # constitution from the product. In a fused layout both roots are one directory,
  # so this is the text that was always emitted.
  if [[ -z "$instructions" ]]; then
    :
  elif [[ ! -e "$instructions" && ! -L "$instructions" ]]; then
    create_generated_bootstrap
  elif [[ -L "$instructions" ]] && [[ "$instructions" -ef "$instance_doctrine" ]]; then
    # A link the user made to the instance doctrine already resolves to doctrine;
    # repointing someone's deliberate symlink is more than an upgrade should do.
    echo "instructions existing=$instructions"
  elif is_generated_bootstrap; then
    if is_current_generated_bootstrap; then
      echo "instructions existing=$instructions"
    else
      rewrite_generated_bootstrap
    fi
  elif grep -Fq "$instance_doctrine" "$instructions" && grep -Fq "$PRODUCT_ROOT/HARNESS.md" "$instructions"; then
    echo "instructions existing=$instructions"
  else
    echo "instructions preserved=$instructions" >&2
    echo "add this line to that file:" >&2
    echo "$bootstrap" >&2
    exit 3
  fi
}

for primary in "${primary_platforms[@]}"; do
  if [[ "$REQUESTED_PLATFORM" == all && "$primary" != claude && "$primary" != codex ]]; then
    if ! (install_primary "$primary"); then
      echo "warning: detected provider $primary skipped=install-conflict; inspect its files" >&2
      echo "provider $primary skipped=install-conflict"
      skipped_platforms+=("$primary")
      continue
    fi
  else
    install_primary "$primary"
  fi
done

for client in "${mcp_platforms[@]}"; do
  skip=0
  for skipped in ${skipped_platforms[@]+"${skipped_platforms[@]}"}; do
    [[ "$client" == "$skipped" ]] && skip=1
  done
  [[ "$skip" == 1 ]] && continue
  if ! required_client "$client"; then
    if ! diagnostic="$(configure_fabric_mcp "$client" 2>&1)"; then
      printf '%s\n' "$diagnostic" >&2
      echo "warning: detected provider $client skipped=mcp-conflict; preserving its files" >&2
      echo "provider $client skipped=mcp-conflict"
      continue
    fi
    printf '%s\n' "$diagnostic"
  else
    configure_fabric_mcp "$client"
  fi
done

# The pointer is the final publication. Every deterministic conflict has been
# checked above, so a failed install preserves the previous product selection.
run_stdlib "$PRODUCT_ROOT/scripts/write-product-root-pointer.py" "$instance_root" "$PRODUCT_ROOT"
echo "product root pointer updated=$instance_root/.agent-fabric/product-root.json"
