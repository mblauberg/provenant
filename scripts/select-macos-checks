#!/bin/sh
set -eu

# set_output MACOS [RUST]: Rust defaults to true so every conservative path
# keeps the full gate; only the non-code allowlist below turns it off.
set_output() {
  printf 'run_macos=%s\nrun_rust=%s\n' "$1" "${2:-true}" >> "$GITHUB_OUTPUT"
  printf 'Selected run_macos=%s run_rust=%s\n' "$1" "${2:-true}"
}

run_conservatively() {
  echo "$1; running macOS checks conservatively."
  set_output true
}

if [ "$IS_MAIN" = true ]; then
  set_output true
  exit 0
fi

if [ -z "$BASE_SHA" ] || ! git cat-file -e "$BASE_SHA^{commit}" 2>/dev/null; then
  run_conservatively 'Base commit unavailable'
  exit 0
fi

if [ -z "$HEAD_SHA" ] || ! git cat-file -e "$HEAD_SHA^{commit}" 2>/dev/null; then
  run_conservatively 'Head commit unavailable'
  exit 0
fi

if ! git merge-base "$BASE_SHA" "$HEAD_SHA" >/dev/null 2>&1; then
  run_conservatively 'No merge base found'
  exit 0
fi

changed=$(git diff --no-renames --name-only "$BASE_SHA...$HEAD_SHA")
printf 'Changed paths since merge base:\n%s\n' "$changed"
# Non-code assets still pass harness, writing and documentation checks.
# Executable or structured skill assets and the native inventory retain Rust
# and native coverage. Treat renames as deletion plus addition.
non_code='^(skills/.*\.md|roles/.*\.md|docs/.*\.(md|png|jpg|jpeg|svg|gif|webp|pdf)|[^/]+\.md|\.(editorconfig|gitattributes|gitignore)|LICENSE|NOTICE)$'
# A Markdown name proves nothing about an executable or a symlink.
not_plain=$(git diff --no-renames --raw "$BASE_SHA...$HEAD_SHA" | awk '($1 != ":100644" && $1 != ":000000") || ($2 != "100644" && $2 != "000000")')
if [ -n "$changed" ] && [ -z "$not_plain" ] && ! printf '%s\n' "$changed" | grep -Evq "$non_code" && ! printf '%s\n' "$changed" | grep -qx 'docs/runbooks/ci.md'; then
  set_output false false
  exit 0
fi
if printf '%s\n' "$changed" | grep -Eq '^(tools/front-door/|apps/|\.github/workflows/ci\.yml$|docs/runbooks/ci\.md$|scripts/(check-native-inventory|run-native-test-group|test-check-native-inventory)$)'; then
  set_output true
else
  set_output false
fi
