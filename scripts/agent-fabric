#!/bin/sh
set -eu

script_path=$0
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case "$link" in
    /*) script_path=$link ;;
    *) script_path=$(dirname "$script_path")/$link ;;
  esac
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
agents_home=${AGENTS_HOME:-"$(dirname -- "$script_dir")"}
case "$agents_home" in /*) ;; *) echo "AGENTS_HOME must be absolute" >&2; exit 2 ;; esac
package_root="$agents_home/runtime/agent-fabric"

unset AGENT_FABRIC_PROTOCOL_BUILD_VERDICT AGENT_FABRIC_PROTOCOL_BUILD_REPAIR
if [ "${1:-}" = doctor ]; then
  protocol_repair=$(
    AGENT_FABRIC_PROTOCOL_PREFLIGHT_MODE=doctor \
      "$script_dir/agent-fabric-protocol-preflight"
  )
  if [ -n "$protocol_repair" ]; then
    AGENT_FABRIC_PROTOCOL_BUILD_VERDICT=stale
    AGENT_FABRIC_PROTOCOL_BUILD_REPAIR=$protocol_repair
    export AGENT_FABRIC_PROTOCOL_BUILD_VERDICT AGENT_FABRIC_PROTOCOL_BUILD_REPAIR
  fi
else
  "$script_dir/agent-fabric-protocol-preflight"
fi

export AGENTS_HOME=$agents_home
dist_cli="$package_root/dist/cli/main.js"
if [ -f "$dist_cli" ] && ! find "$package_root/src" -type f -name '*.ts' -newer "$dist_cli" -print -quit | grep -q .; then
  exec node "$package_root/dist/cli/main.js" "$@"
fi

tsx_loader_library="$script_dir/lib/agent-fabric-tsx-loader.sh"
[ -f "$tsx_loader_library" ] || {
  echo "agent-fabric cannot resolve the tsx loader: missing $tsx_loader_library" >&2
  echo "repair: reinstall the harness scripts directory, including scripts/lib" >&2
  exit 78
}
. "$tsx_loader_library"

tsx_loader=$(resolve_tsx_loader "$package_root" "$agents_home") || {
  echo "agent-fabric found no tsx package for \"$package_root\" within \"$(resolve_tsx_loader_boundary "$agents_home")\"" >&2
  echo "repair: run 'npm ci' in the repository root that owns this workspace" >&2
  exit 1
}

exec node --import "$tsx_loader" "$package_root/src/cli/main.ts" "$@"
