#!/bin/sh
set -eu

script_path=$0
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case "$link" in
    /*) script_path=$link ;;
    *) script_path=$(dirname "$script_path")/$link ;;
  esac
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
agents_home=${AGENTS_HOME:-"$(dirname -- "$script_dir")"}
case "$agents_home" in /*) ;; *) echo "AGENTS_HOME must be absolute" >&2; exit 2 ;; esac
package_root="$agents_home/runtime/agent-fabric"
protocol_root="$agents_home/runtime/agent-fabric-protocol"
protocol_dist="$protocol_root/dist/index.js"

node "$package_root/scripts/verify-npm-ci-attestation.mjs" "$agents_home"

# A linked worktree cannot use the protocol preflight's install-root
# autobuild. Refuse its stale protocol dist here, after the content-only npm
# attestation and before preflight can either autobuild or return its generic
# exit 78. The freshness predicate is shared with protocol build and warm.
workspace_freshness_library="$script_dir/lib/agent-fabric-workspace-freshness.sh"
if [ -f "$agents_home/.git" ]; then
  # Refuse rather than skip when the predicate is unavailable, matching
  # agent-fabric-protocol-preflight. A missing library must not silently
  # turn this refusal off: that is the case where the check matters most.
  if [ ! -f "$workspace_freshness_library" ]; then
    echo "AGENT_FABRIC_LAUNCH_INCOMPLETE: missing \"$workspace_freshness_library\"" >&2
    exit 1
  fi
  . "$workspace_freshness_library"
  if workspace_is_stale "$protocol_root" "$protocol_dist"; then
    echo "AGENT_FABRIC_LINKED_WORKTREE_DIST_STALE: local @local/agent-fabric-protocol dist is missing or stale against its build inputs" >&2
    echo "repair: AGENTS_HOME=\"$agents_home\" \"$agents_home/scripts/agent-fabric-protocol-build\"" >&2
    exit 1
  fi
fi

unset AGENT_FABRIC_PROTOCOL_BUILD_VERDICT AGENT_FABRIC_PROTOCOL_BUILD_REPAIR
if [ "${1:-}" = doctor ]; then
  protocol_repair=$(
    AGENT_FABRIC_PROTOCOL_PREFLIGHT_MODE=doctor \
      "$script_dir/agent-fabric-protocol-preflight"
  )
  if [ -n "$protocol_repair" ]; then
    AGENT_FABRIC_PROTOCOL_BUILD_VERDICT=stale
    AGENT_FABRIC_PROTOCOL_BUILD_REPAIR=$protocol_repair
    export AGENT_FABRIC_PROTOCOL_BUILD_VERDICT AGENT_FABRIC_PROTOCOL_BUILD_REPAIR
  fi
else
  "$script_dir/agent-fabric-protocol-preflight"
fi

export AGENTS_HOME=$agents_home
dist_cli="$package_root/dist/cli/main.js"
if [ -f "$dist_cli" ] && ! find "$package_root/src" -type f -name '*.ts' -newer "$dist_cli" -print -quit | grep -q .; then
  exec node "$package_root/dist/cli/main.js" "$@"
fi

tsx_loader_library="$script_dir/lib/agent-fabric-tsx-loader.sh"
[ -f "$tsx_loader_library" ] || {
  echo "agent-fabric cannot resolve the tsx loader: missing $tsx_loader_library" >&2
  echo "repair: reinstall the harness scripts directory, including scripts/lib" >&2
  exit 78
}
. "$tsx_loader_library"

tsx_loader=$(resolve_attested_tsx_loader "$agents_home") || {
  echo "agent-fabric found no valid tsx loader inside the attested tree \"$agents_home/node_modules\"" >&2
  echo "repair: rerun \"$agents_home/scripts/install-agent-fabric-dependencies\"" >&2
  exit 1
}

exec node --import "$tsx_loader" "$package_root/src/cli/main.ts" "$@"
