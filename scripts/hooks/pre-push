#!/bin/sh
# Opt-in guard: no pushes to the default branch from a linked worktree, no
# non-fast-forward update or deletion of it, and no pushed conflict markers.

zero=0000000000000000000000000000000000000000

git_dir=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null) || exit 0
common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0

integration=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || integration=
integration=${integration#origin/}
if [ -z "$integration" ]; then
    for candidate in main master; do
        if git show-ref --verify --quiet "refs/heads/$candidate" ||
            git show-ref --verify --quiet "refs/remotes/origin/$candidate"; then
            integration=$candidate
            break
        fi
    done
fi

refuse() {
    printf 'pre-push: refused: %s\n' "$1" >&2
    exit 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    deleting=1
    case "$local_sha" in *[!0]*) deleting= ;; esac
    new_remote=1
    case "$remote_sha" in *[!0]*) new_remote= ;; esac

    if [ -n "$integration" ] && [ "$remote_ref" = "refs/heads/$integration" ]; then
        [ -z "$deleting" ] || refuse "deleting the default branch $integration"
        [ "$git_dir" = "$common_dir" ] ||
            refuse "pushing $integration from a linked worktree; push a topic branch and merge by pull request"
        if [ -z "$new_remote" ] &&
            ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            refuse "non-fast-forward update of $integration"
        fi
    fi

    [ -z "$deleting" ] || continue
    if [ -z "$new_remote" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range="$remote_sha..$local_sha"
        found=$(git log --format= -p -U0 --no-ext-diff --no-textconv "$range" 2>/dev/null |
            grep -E '^\+(<{7}|>{7})( |$)' | head -3)
    else
        found=$(git log --format= -p -U0 --no-ext-diff --no-textconv "$local_sha" --not --remotes 2>/dev/null |
            grep -E '^\+(<{7}|>{7})( |$)' | head -3)
    fi
    [ -z "$found" ] || refuse "conflict markers in commits pushed to $remote_ref: $found"
done
exit 0
