#!/usr/bin/env python3
"""Focused controls for reference sources and regeneration."""

import json
from pathlib import Path
import runpy
import subprocess
import tempfile
import unittest
from unittest.mock import patch


SCRIPTS = Path(__file__).resolve().parent
GEN = runpy.run_path(str(SCRIPTS / 'generate-reference'), run_name='reference_generator')
# runpy returns a copy; functions retain the original module globals.
GLOBALS = GEN['generate'].__globals__


class ReferenceTests(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix='provenant-reference-test-')
        self.addCleanup(self.temporary.cleanup)
        self.root = Path(self.temporary.name)

    def test_compact_configuration_keeps_advanced_fields_discoverable(self):
        data = {"documented_fields": ["lanes.max_depth"], "knobs": {
            "lanes.max_depth": {"default": 8, "effect": "Bound child depth"},
            "config.history_max_bytes": {"default": 1024, "effect": "Bound history"}}}
        compact = GEN['config_reference'](data)
        self.assertIn('`lanes.max_depth`', compact)
        self.assertNotIn('config.history_max_bytes', compact)
        self.assertIn('config schema --all', compact)
        self.assertIn('config.history_max_bytes', GEN['config_reference'](data, all_fields=True))


    def test_missing_sources_are_named_without_losing_available_sources(self):
        source = self.root / GEN['KNOBS']
        source.parent.mkdir(parents=True)
        source.write_text('{"knobs": {"example": {"default": false}}, "schema_version": 1}')
        files, gaps = GEN['generate'](self.root)
        self.assertEqual(len(gaps), 2)
        self.assertIn('## `example`', files['config-keys.md'])
        for name in ('cli.md', 'cli-all.md'):
            self.assertIn('Cargo.toml is missing', files[name])
        for text in files.values():
            self.assertIn('scripts/generate-reference', text.splitlines()[0])

    def test_host_build_reference_uses_registry_values(self):
        text = GEN['config_reference']({'knobs': {}, 'host_lane_build_settings': {
            'path': 'domains.fabric.lanes', 'settings': {'example': {
                'default': 'dynamic fixture', 'effect': 'fixture effect', 'min': 2, 'max': 9,
            }},
        }})
        self.assertIn('| `example` | dynamic fixture | fixture effect (2 to 9). |', text)

    def test_cli_references_follow_their_help_catalogues(self):
        workspace = self.root / GEN['WORKSPACE']
        workspace.mkdir(parents=True)
        (workspace / 'Cargo.toml').touch()
        def catalogue(root, binary, all_commands):
            name = 'advanced' if all_commands else 'core'
            return {'commands': [{'command': f'provenant {name}', 'arguments': []}]}
        with patch.dict(GLOBALS, catalogue=catalogue,
                        wire_schemas=lambda _: {'error-codes': []}):
            files, _ = GEN['generate'](self.root)
        self.assertIn('## `provenant core`', files['cli.md'])
        self.assertNotIn('## `provenant advanced`', files['cli.md'])
        self.assertIn('## `provenant advanced`', files['cli-all.md'])

    def test_cli_reference_lists_error_codes_with_their_meaning(self):
        text = GEN['cli_reference']({'commands': [], 'error_codes': [
            {'code': 'LANE_CAP', 'summary': 'The cap | is reached.'},
        ]})
        self.assertIn('## Error codes', text)
        self.assertIn('| `LANE_CAP` | The cap &#124; is reached. |', text)
        self.assertNotIn('## Error codes', GEN['cli_reference']({'commands': []}))

    def test_cli_contract_keeps_constraints_groups_and_argument_metadata(self):
        contract = {'name': 'mode', 'long': 'mode', 'required': True,
                    'repeatable': False, 'defaults': ['read-only'],
                    'values': ['read-only', 'worktree-write'], 'bounds': [1, 2],
                    'requires': ['project'], 'conflicts': ['other'],
                    'conditional_defaults': [['writer', '10800']]}
        text = GEN['cli_reference']({'commands': [{
            'command': 'provenant example', 'arguments': [contract],
            'constraints': ['must agree'], 'groups': [{'name': 'scope', 'required': True}],
        }]})
        self.assertIn('## `provenant example`', text)
        self.assertIn('| `--mode` |', text)
        for key in ('required', 'defaults', 'values', 'bounds', 'requires', 'conflicts',
                    'conditional_defaults', 'groups', 'constraints'):
            self.assertIn('"' + key + '"', text)

    def test_unsupported_help_is_a_gap_but_build_failure_is_an_error(self):
        workspace = self.root / GEN['WORKSPACE']
        workspace.mkdir(parents=True)
        (workspace / 'Cargo.toml').touch()
        failure = subprocess.CalledProcessError(2, ['provenant', 'help', '--all', '--json'])
        with patch('subprocess.run', side_effect=failure):
            files, gaps = GEN['generate'](self.root, self.root / 'built-cli')
            for name in ('cli.md', 'cli-all.md'):
                self.assertIn('no machine-readable catalogue', files[name])
            self.assertTrue(any('help --all --json' in gap for gap in gaps))
        with patch.dict(GLOBALS, cargo=unittest.mock.Mock(side_effect=failure)):
            with self.assertRaises(subprocess.CalledProcessError):
                GEN['generate'](self.root)

    def test_configuration_preserves_all_schema_fields(self):
        data = {'knobs': {'fixture': {'type': 'enum', 'default': 'a', 'values': ['a', 'b'],
                                    'effect': 'One | two `three`.'}},
                'schema_version': 1, 'profiles': {'balanced': {'fixture': 'b'}}}
        text = GEN['config_reference'](data)
        self.assertIn('## `fixture`', text)
        self.assertIn('"profiles"', text)
        self.assertIn('&#124;', text)
        self.assertIn('&#96;', text)

    def test_default_cli_is_built_from_this_worktree_and_binary_can_be_reused(self):
        target = self.root / 'lane-target'
        result = subprocess.CompletedProcess([], 0, stdout='{"data":{"commands":[]}}')
        with patch.dict(GLOBALS, cargo=unittest.mock.Mock(side_effect=[
            '', '{"target_directory":' + '"' + str(target) + '"}',
        ])), patch('subprocess.run', return_value=result) as run:
            self.assertEqual(GEN['catalogue'](self.root), {'commands': []})
            self.assertIn('build', GLOBALS['cargo'].call_args_list[0].args)
            self.assertEqual(run.call_args.args[0], [str(target / 'debug/provenant'), 'help', '--json'])
            self.assertEqual(run.call_args.kwargs['cwd'], self.root)
        with patch.dict(GLOBALS, cargo=unittest.mock.Mock()) as globals_, patch('subprocess.run', return_value=result):
            GEN['catalogue'](self.root, self.root / 'built-cli')
            globals_['cargo'].assert_not_called()

    def test_published_schemas_are_generated_files(self):
        schema = {'$schema': 'https://json-schema.org/draft/2020-12/schema', 'title': 'fixture',
                  'type': 'object'}
        data = {'lanes.schema.json': schema, 'error.schema.json': schema,
                'error-codes': [{'code': 'PR', 'kind': 'umbrella', 'summary': 'A | b.'}]}
        files = GEN['schema_files'](data)
        self.assertEqual(sorted(files), ['schemas.md', 'schemas/error.schema.json',
                                         'schemas/lanes.schema.json'])
        self.assertIn('scripts/generate-reference', files['schemas.md'].splitlines()[0])
        self.assertIn('| `PR` | umbrella | A &#124; b. |', files['schemas.md'])
        self.assertEqual(json.loads(files['schemas/lanes.schema.json']), schema)

    def test_generate_includes_schemas_and_names_an_unavailable_generator(self):
        workspace = self.root / GEN['WORKSPACE']
        workspace.mkdir(parents=True)
        (workspace / 'Cargo.toml').touch()
        document = {'lanes.schema.json': {'title': 'fixture'}, 'error-codes': []}
        with patch.dict(GLOBALS, catalogue=lambda *_: {'commands': []},
                        wire_schemas=lambda _: document):
            files, gaps = GEN['generate'](self.root)
        self.assertIn('schemas/lanes.schema.json', files)
        self.assertIn('schemas.md', files)
        self.assertFalse(any('print-wire-schemas' in gap for gap in gaps))
        with patch.dict(GLOBALS, catalogue=lambda *_: {'commands': []},
                        wire_schemas=lambda _: {'unsupported': True}):
            files, gaps = GEN['generate'](self.root)
        self.assertTrue(any('print-wire-schemas' in gap for gap in gaps))
        self.assertIn('Source gap', files['schemas.md'])
        destination = self.root / 'reference'
        GEN['write_files'](destination, {'stale.md': 'old\n'})
        GEN['update_files'](destination, files)
        self.assertFalse((destination / 'stale.md').exists())
        self.assertIn('Source gap', (destination / 'schemas.md').read_text())
        with self.assertRaises(ValueError):
            with patch.dict(GLOBALS, cargo=lambda *_: '{"error-codes": 1}'):
                GEN['wire_schemas'](self.root)


if __name__ == '__main__':
    unittest.main()
