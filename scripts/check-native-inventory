#!/usr/bin/env python3
"""Require each native inventory entry in the macOS list and passing JUnit."""
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import sys
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parent.parent
INVENTORY = ROOT / 'config/native-test-inventory.json'
loader = importlib.machinery.SourceFileLoader('flaky_quarantine', str(ROOT / 'scripts/flaky-quarantine'))
spec = importlib.util.spec_from_loader(loader.name, loader)
quarantine = importlib.util.module_from_spec(spec)
loader.exec_module(quarantine)


def inventory(path):
    entries = json.loads(path.read_text())
    fields = ('test', 'platform', 'invocation', 'environment', 'binary')
    if not isinstance(entries, list):
        raise ValueError('native inventory must be an array')
    rows = []
    for entry in entries:
        if (not isinstance(entry, dict) or set(entry) != set(fields)
                or any(not isinstance(entry[key], str) or not entry[key].strip() for key in fields)
                or entry['platform'] != 'macOS'):
            raise ValueError(f'malformed native inventory entry: {entry}')
        rows.append([entry[key] for key in fields])
    if not rows:
        raise ValueError('native inventory is empty')
    identities = [(row[4], row[0]) for row in rows]
    if len(set(identities)) != len(identities):
        raise ValueError('duplicate native inventory test')
    return rows


def check(rows, listing, results, quarantined=frozenset()):
    suites = listing['rust-suites']
    errors = []
    reports = {}
    for path in results.glob('*.xml'):
        try:
            reports[path.stem] = list(ET.parse(path).getroot().iter('testcase'))
        except (OSError, ET.ParseError) as error:
            errors.append(f'{path.name}: invalid JUnit report: {error}')
    for name, platform, lane, variables, binary in rows:
        package = suites.get(binary, {}).get('package-name')
        if (package, name) in quarantined:
            print(f'{name}: quarantined ({package})')
            continue
        if not name or name not in suites.get(binary, {}).get('testcases', {}):
            errors.append(f'{name}: absent from macOS nextest list for {binary}')
        try:
            controls = json.loads((results / f'{lane}.json').read_text())
            cases = reports[lane]
            matches = [case for case in cases if case.get('name') == name and case.get('classname') == binary]
            total = sum(case.get('name') == name and case.get('classname') == binary for cases in reports.values() for case in cases)
            if len(matches) != 1 or total != 1 or any(case.find(tag) is not None for case in matches for tag in ('skipped', 'failure', 'error')):
                errors.append(f'{name}: {lane} must contain exactly one passing testcase across all invocations (found {total})')
            for var in variables.split(', '):
                if var != '-' and controls.get(var) != '1':
                    errors.append(f'{name}: {lane} missing {var}=1')
        except (OSError, ValueError, KeyError, ET.ParseError) as error:
            errors.append(f'{name}: {lane} results unavailable: {error}')
    return errors


def main():
    if len(sys.argv) != 3:
        sys.exit('usage: check-native-inventory LIST_JSON RESULTS_DIR')
    try:
        rows = inventory(INVENTORY)
        entries = quarantine.parse_config(quarantine.DEFAULT_CONFIG.read_text(encoding='utf-8'))['test']
        quarantined = {(entry['package'], entry['name']) for entry in entries}
        errors = check(rows, json.loads(Path(sys.argv[1]).read_text()), Path(sys.argv[2]), quarantined)
    except (OSError, ValueError, KeyError, TypeError) as error:
        sys.exit(f'Cannot check native inventory: {error}')
    if errors:
        print('\n'.join(errors), file=sys.stderr)
        return 1
    print('Native inventory entries passed or were quarantined.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
