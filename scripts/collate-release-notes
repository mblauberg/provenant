#!/bin/sh
# Collate docs/release-notes/next.d/ into release notes.
#   collate-release-notes           print the notes for the next release
#   collate-release-notes --check   validate the fragments only
#   collate-release-notes vX.Y.Z    write docs/release-notes/vX.Y.Z.md and
#                                   delete the fragments, keeping _intro.md
# Each fragment is <topic>.md whose first line is one of the section headings
# below, followed by its bullets, with no later ## heading. An optional second
# line, "### <Area>", names one of the areas below. The collated notes render
# "### Area" sub-headings only in a section with more than 12 entries; smaller
# sections list their entries flat, in area order. Untagged entries come last.
# Links in fragments are relative to next.d/;
# the collated file sits one directory up, so ../../ becomes ../.
set -eu
cd "$(git rev-parse --show-toplevel)"
export LC_ALL=C
dir=docs/release-notes/next.d
sections='## Breaking changes
## Behaviour changes
## Additions
## Fixes'
areas='CLI and install
Lanes and settlement
Git and safety
Accounts, quota and routing
Pipelines and graphs
Chair, inbox and console
Fabric and MCP
Telemetry and providers'

normalise() {
  printf '%s\n' "$1" | awk '{$1=$1; print tolower($0)}'
}

section_of() {
  first=$(sed -n 1p "$1")
  case "$first" in '## '*) value=${first#\#\# } ;; *) value= ;; esac
  case "$(normalise "$value")" in
    'breaking changes') printf '%s\n' '## Breaking changes' ;;
    'behaviour changes') printf '%s\n' '## Behaviour changes' ;;
    additions) printf '%s\n' '## Additions' ;;
    fixes) printf '%s\n' '## Fixes' ;;
    *) printf '%s\n' '## Additions' ;;
  esac
}

area_of() {
  second=$(sed -n 2p "$1")
  case "$second" in
    '### '*) value=${second#\#\#\# } ;;
    *) return ;;
  esac
  case "$(normalise "$value")" in
    'cli and install') printf '%s\n' 'CLI and install' ;;
    'lanes and settlement') printf '%s\n' 'Lanes and settlement' ;;
    'git and safety') printf '%s\n' 'Git and safety' ;;
    'accounts, quota and routing') printf '%s\n' 'Accounts, quota and routing' ;;
    'pipelines and graphs') printf '%s\n' 'Pipelines and graphs' ;;
    'chair, inbox and console') printf '%s\n' 'Chair, inbox and console' ;;
    'fabric and mcp') printf '%s\n' 'Fabric and MCP' ;;
    'telemetry and providers') printf '%s\n' 'Telemetry and providers' ;;
    *) ;;
  esac
}

check() {
  status=0
  if [ -e docs/release-notes/next.md ]; then
    echo "collate-release-notes: docs/release-notes/next.md must not exist; add a fragment under $dir" >&2
    status=1
  fi
  if [ ! -f "$dir/_intro.md" ]; then
    echo "collate-release-notes: $dir/_intro.md is missing" >&2
    status=1
  fi
  for f in "$dir"/*.md; do
    [ -e "$f" ] || continue
    [ "$f" = "$dir/_intro.md" ] && continue
    if ! awk 'NF { found = 1 } END { exit !found }' "$f"; then
      echo "collate-release-notes: $f: fragment is empty" >&2
      status=1
      continue
    fi
    first=$(sed -n 1p "$f")
    if [ "$(section_of "$f")" = '## Additions' ] && [ "$(normalise "${first#\#\# }")" != additions ]; then
      echo "collate-release-notes: $f: unknown section; using Additions" >&2
    elif ! printf '%s\n' "$sections" | grep -qxF -- "$(section_of "$f")"; then
      echo "collate-release-notes: $f: malformed section heading; using Additions" >&2
    fi
    second=$(sed -n 2p "$f")
    case "$second" in '### '*)
      if [ -z "$(area_of "$f")" ]; then
        echo "collate-release-notes: $f: unknown area; leaving untagged" >&2
      fi
    esac
    if awk 'NR > 1 && /^## / { found = 1 } END { exit !found }' "$f"; then
      echo "collate-release-notes: $f: section headings are only allowed on line 1" >&2
      echo "collate-release-notes: $f: later section heading ignored" >&2
    fi
  done
  return $status
}

# Count the bullets in section $1.
section_count() {
  for f in "$dir"/*.md; do
    [ -e "$f" ] || continue
    [ "$f" = "$dir/_intro.md" ] && continue
    [ "$(section_of "$f")" = "$1" ] || continue
    grep -c '^- ' "$f" || true
  done | awk '{ n += $1 } END { print n + 0 }'
}

# Print the bodies of the fragments in section $1 tagged with area $2
# (untagged when $2 is empty).
section_part() {
  for f in "$dir"/*.md; do
    [ -e "$f" ] || continue
    [ "$f" = "$dir/_intro.md" ] && continue
    [ "$(section_of "$f")" = "$1" ] || continue
    [ "$(area_of "$f")" = "$2" ] || continue
    skip=0
    [ -z "$(sed -n 2p "$f" | sed -n '/^### /p')" ] || skip=2
    # Drop the heading, the area line and any blank lines around the bullets.
    awk -v skip="$skip" 'NR > 1 && NR != skip { if ($0 == "") { held = held "\n"; next } if (started) printf "%s", held; held = ""; started = 1; print }' "$f"
  done
}

collate() {
  if [ -n "${1:-}" ]; then
    echo "# Provenant $1"
    echo
    echo "Released $(date '+%-d %B %Y')."
  else
    echo "# Next release"
  fi
  echo
  sed 's|](\.\./\.\./|](../|g' "$dir/_intro.md"
  printf '%s\n' "$sections" | while IFS= read -r heading; do
    if [ "$(section_count "$heading")" -gt 12 ]; then
      grouped=1
    else
      grouped=0
    fi
    body=$(printf '%s\n' "$areas" | {
      first=1
      while IFS= read -r area; do
        part=$(section_part "$heading" "$area")
        [ -n "$part" ] || continue
        if [ "$grouped" = 1 ]; then
          [ "$first" = 1 ] || printf '\n'
          printf '### %s\n\n%s\n' "$area" "$part"
        else
          printf '%s\n' "$part"
        fi
        first=0
      done
    })
    rest=$(section_part "$heading" "")
    if [ -n "$rest" ]; then
      if [ -z "$body" ]; then
        :
      elif [ "$grouped" = 1 ]; then
        body="$body

$rest"
      else
        body="$body
$rest"
      fi
      [ -n "$body" ] || body=$rest
    fi
    [ -n "$body" ] || continue
    printf '\n%s\n\n%s\n' "$heading" "$body"
  done | sed 's|](\.\./\.\./|](../|g'
}

case "${1:-}" in
  --check)
    check
    ;;
  '')
    check
    collate
    ;;
  v[0-9]*.[0-9]*.[0-9]*)
    check
    out=docs/release-notes/$1.md
    if [ -e "$out" ]; then
      echo "collate-release-notes: $out already exists" >&2
      exit 1
    fi
    collate "$1" >"$out"
    for f in "$dir"/*.md; do
      [ "$f" = "$dir/_intro.md" ] || rm -- "$f"
    done
    # A version cut is a chair-log milestone when this shell belongs to a
    # known session. The release cut is complete even if logging is unavailable.
    if [ -n "${PROVENANT_SESSION_ID:-}" ] && command -v provenant >/dev/null 2>&1; then
      if log_file=$(mktemp "${TMPDIR:-/tmp}/provenant-release-log.XXXXXX" 2>/dev/null); then
        trap 'rm -f "$log_file"' EXIT HUP INT TERM
        if printf '{"kind":"release_cut","channel":"provenant","markdown":"Cut release %s."}\n' "$1" >"$log_file"; then
          issued_at=$(date +%s 2>/dev/null) || issued_at=0
          provenant chair log append \
            --session "$PROVENANT_SESSION_ID" \
            --operation-id "release-$1" \
            --issued-at "$issued_at" \
            --file "$log_file" >/dev/null 2>&1 || true
        fi
        rm -f "$log_file" || true
        trap - EXIT HUP INT TERM
      fi
    fi
    ;;
  *)
    echo "usage: collate-release-notes [--check | vX.Y.Z]" >&2
    exit 2
    ;;
esac
