#!/bin/sh
# Collate docs/release-notes/next.d/ into release notes.
#   collate-release-notes           print the notes for the next release
#   collate-release-notes --check   validate the fragments only
#   collate-release-notes vX.Y.Z    write docs/release-notes/vX.Y.Z.md and
#                                   delete the fragments, keeping _intro.md
# Each fragment is <topic>.md holding one section: line 1 is one of the section
# headings below, followed by its bullets. Two sections need two fragments. An
# optional second nonblank line, "### <Area>", names one of the areas below.
# --check fails, naming file:line, on content collation would drop or misfile (a
# later "## " heading, or content before the first heading) and warns, listing
# the choices, on an unknown section or area. The collated notes render
# "### Area" sub-headings only in a section with more than 12 entries; smaller
# sections list their entries flat, in area order. Untagged entries come last.
# Links in fragments are relative to next.d/;
# the collated file sits one directory up, so ../../ becomes ../.
set -eu
cd "$(git rev-parse --show-toplevel)"
export LC_ALL=C
dir=docs/release-notes/next.d
sections='## Breaking changes
## Behaviour changes
## Additions
## Fixes'
areas='CLI and install
Lanes and settlement
Git and safety
Accounts, quota and routing
Pipelines and graphs
Chair, inbox and console
Fabric
Telemetry and providers'

# The one reading of a fragment, shared by --check and collation so they cannot
# disagree. Prints tab-separated records for fragment $1:
#   section<TAB>## Heading   the canonical section (Additions when unknown)
#   area<TAB>Area            the canonical area (empty when untagged or unknown)
#   body<TAB>N               the first line number of the bullets
#   warn<TAB>N<TAB>message   collation recovers (unknown section or area)
#   error<TAB>N<TAB>message  collation would drop or misfile content
# Only the first nonblank line may be a "## " heading, and an optional "### "
# area line may follow it. Everything from the body line on is collated as is.
parse() {
  SECTIONS=$sections AREAS=$areas awk '
    function norm(s) {
      sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); gsub(/[ \t]+/, " ", s)
      return tolower(s)
    }
    function warn(n, m) { printf "warn\t%d\t%s\n", n, m }
    function err(n, m) { printf "error\t%d\t%s\n", n, m }
    BEGIN {
      n = split(ENVIRON["SECTIONS"], s, "\n")
      for (i = 1; i <= n; i++) {
        name = substr(s[i], 4)
        sec[norm(name)] = s[i]
        snames = snames (i > 1 ? ", " : "") name
      }
      n = split(ENVIRON["AREAS"], a, "\n")
      for (i = 1; i <= n; i++) {
        area[norm(a[i])] = a[i]
        anames = anames (i > 1 ? ", " : "") a[i]
      }
      section = "## Additions"; cur = ""; body = 1; seen = 0; want_area = 0
    }
    { sub(/\r$/, "") }
    NF == 0 { next }
    !seen {
      seen = 1
      if ($0 ~ /^## /) {
        key = norm(substr($0, 4))
        if (key in sec) section = sec[key]
        else warn(NR, "unknown section \"" substr($0, 4) "\"; filed under Additions; choose one of: " snames)
        body = NR + 1; want_area = 1
      } else {
        err(NR, "content before the first section heading; line 1 must be a \"## \" heading, one of: " snames)
      }
      next
    }
    /^## / {
      err(NR, "later section heading \"" $0 "\" would be dropped; one section per fragment; use two fragments for two sections")
      next
    }
    want_area {
      want_area = 0
      if ($0 ~ /^### /) {
        key = norm(substr($0, 5))
        if (key in area) cur = area[key]
        else warn(NR, "unknown area \"" substr($0, 5) "\"; left untagged; choose one of: " anames)
        body = NR + 1
      }
    }
    END {
      if (!seen) err(1, "fragment is empty")
      printf "section\t%s\narea\t%s\nbody\t%d\n", section, cur, body
    }
  ' "$1"
}

field() {
  parse "$1" | awk -F '\t' -v key="$2" '$1 == key { print $2; exit }'
}

section_of() { field "$1" section; }
area_of() { field "$1" area; }

# Print the bullets of fragment $1: everything after its heading and area line,
# without the blank lines around them.
body_of() {
  start=$(field "$1" body)
  awk -v start="$start" 'NR >= start {
    if ($0 == "") { held = held "\n"; next }
    if (started) printf "%s", held
    held = ""; started = 1; print
  }' "$1"
}

check() {
  status=0
  if [ -e docs/release-notes/next.md ]; then
    echo "collate-release-notes: docs/release-notes/next.md must not exist; add a fragment under $dir" >&2
    status=1
  fi
  if [ ! -f "$dir/_intro.md" ]; then
    echo "collate-release-notes: $dir/_intro.md is missing" >&2
    status=1
  fi
  for f in "$dir"/*.md; do
    [ -e "$f" ] || continue
    [ "$f" = "$dir/_intro.md" ] && continue
    parse "$f" | awk -F '\t' -v f="$f" '
      $1 == "warn" { printf "collate-release-notes: %s:%s: warning: %s\n", f, $2, $3 }
      $1 == "error" { printf "collate-release-notes: %s:%s: %s\n", f, $2, $3; bad = 1 }
      END { exit bad }
    ' >&2 || status=1
  done
  return $status
}

# Count the bullets in section $1.
section_count() {
  for f in "$dir"/*.md; do
    [ -e "$f" ] || continue
    [ "$f" = "$dir/_intro.md" ] && continue
    [ "$(section_of "$f")" = "$1" ] || continue
    grep -c '^- ' "$f" || true
  done | awk '{ n += $1 } END { print n + 0 }'
}

# Print the bodies of the fragments in section $1 tagged with area $2
# (untagged when $2 is empty).
section_part() {
  for f in "$dir"/*.md; do
    [ -e "$f" ] || continue
    [ "$f" = "$dir/_intro.md" ] && continue
    [ "$(section_of "$f")" = "$1" ] || continue
    [ "$(area_of "$f")" = "$2" ] || continue
    body_of "$f"
  done
}

collate() {
  if [ -n "${1:-}" ]; then
    echo "# Provenant $1"
    echo
    echo "Released $(date '+%-d %B %Y')."
  else
    echo "# Next release"
  fi
  echo
  sed 's|](\.\./\.\./|](../|g' "$dir/_intro.md"
  printf '%s\n' "$sections" | while IFS= read -r heading; do
    if [ "$(section_count "$heading")" -gt 12 ]; then
      grouped=1
    else
      grouped=0
    fi
    body=$(printf '%s\n' "$areas" | {
      first=1
      while IFS= read -r area; do
        part=$(section_part "$heading" "$area")
        [ -n "$part" ] || continue
        if [ "$grouped" = 1 ]; then
          [ "$first" = 1 ] || printf '\n'
          printf '### %s\n\n%s\n' "$area" "$part"
        else
          printf '%s\n' "$part"
        fi
        first=0
      done
    })
    rest=$(section_part "$heading" "")
    if [ -n "$rest" ]; then
      if [ -z "$body" ]; then
        :
      elif [ "$grouped" = 1 ]; then
        body="$body

$rest"
      else
        body="$body
$rest"
      fi
      [ -n "$body" ] || body=$rest
    fi
    [ -n "$body" ] || continue
    printf '\n%s\n\n%s\n' "$heading" "$body"
  done | sed 's|](\.\./\.\./|](../|g'
}

case "${1:-}" in
  --check)
    check
    ;;
  '')
    check
    collate
    ;;
  v[0-9]*.[0-9]*.[0-9]*)
    check
    # Breaking changes need a minor or major release
    # (docs/specs/consumer-contract.md#stability-tiers), so a patch cut with
    # them is probably mis-versioned. Warn; the owner decides.
    case "$1" in
      v*.*.0) ;;
      *)
        if [ "$(section_count '## Breaking changes')" -gt 0 ]; then
          echo "collate-release-notes: warning: $1 is a patch release but has breaking changes; breaking changes need a minor or major release (docs/specs/consumer-contract.md#stability-tiers)" >&2
        fi
        ;;
    esac
    out=docs/release-notes/$1.md
    if [ -e "$out" ]; then
      echo "collate-release-notes: $out already exists" >&2
      exit 1
    fi
    collate "$1" >"$out"
    for f in "$dir"/*.md; do
      [ "$f" = "$dir/_intro.md" ] || rm -- "$f"
    done
    # A version cut is a chair-log milestone when this shell belongs to a
    # known session. The release cut is complete even if logging is unavailable.
    if [ -n "${PROVENANT_SESSION_ID:-}" ] && command -v provenant >/dev/null 2>&1; then
      if log_file=$(mktemp "${TMPDIR:-/tmp}/provenant-release-log.XXXXXX" 2>/dev/null); then
        trap 'rm -f "$log_file"' EXIT HUP INT TERM
        if printf '{"kind":"release_cut","channel":"provenant","markdown":"Cut release %s."}\n' "$1" >"$log_file"; then
          issued_at=$(date +%s 2>/dev/null) || issued_at=0
          provenant chair log append \
            --session "$PROVENANT_SESSION_ID" \
            --operation-id "release-$1" \
            --issued-at "$issued_at" \
            --file "$log_file" >/dev/null 2>&1 || true
        fi
        rm -f "$log_file" || true
        trap - EXIT HUP INT TERM
      fi
    fi
    ;;
  *)
    echo "usage: collate-release-notes [--check | vX.Y.Z]" >&2
    exit 2
    ;;
esac
