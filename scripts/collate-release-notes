#!/bin/sh
# Collate docs/release-notes/next.d/ into release notes.
#   collate-release-notes           print the notes for the next release
#   collate-release-notes --check   validate the fragments only
#   collate-release-notes vX.Y.Z    write docs/release-notes/vX.Y.Z.md and
#                                   delete the fragments, keeping _intro.md
# Each fragment is <topic>.md whose first line is one of the section headings
# below, followed by its bullets, with no later ## heading. An optional second
# line, "### <Area>", names one of the areas below; the collated notes group
# each section's entries by area in that order, untagged entries last.
# Links in fragments are relative to next.d/;
# the collated file sits one directory up, so ../../ becomes ../.
set -eu
cd "$(git rev-parse --show-toplevel)"
export LC_ALL=C
dir=docs/release-notes/next.d
sections='## Breaking changes
## Behaviour changes
## Additions
## Fixes'
areas='CLI and install
Lanes and settlement
Git and safety
Accounts, quota and routing
Pipelines and graphs
Chair, inbox and console
Fabric and MCP
Telemetry and providers'

area_of() {
  second=$(sed -n 2p "$1")
  case "$second" in
    '### '*) printf '%s\n' "${second#\#\#\# }" ;;
  esac
}

check() {
  status=0
  if [ -e docs/release-notes/next.md ]; then
    echo "collate-release-notes: docs/release-notes/next.md must not exist; add a fragment under $dir" >&2
    status=1
  fi
  if [ ! -f "$dir/_intro.md" ]; then
    echo "collate-release-notes: $dir/_intro.md is missing" >&2
    status=1
  fi
  for f in "$dir"/*.md; do
    [ -e "$f" ] || continue
    [ "$f" = "$dir/_intro.md" ] && continue
    first=$(sed -n 1p "$f")
    if ! printf '%s\n' "$sections" | grep -qxF -- "$first"; then
      echo "collate-release-notes: $f: first line must be one of: $(printf '%s' "$sections" | paste -sd, -)" >&2
      status=1
    fi
    area=$(area_of "$f")
    if [ -n "$area" ] && ! printf '%s\n' "$areas" | grep -qxF -- "$area"; then
      echo "collate-release-notes: $f: unknown area \"$area\"; use one of: $(printf '%s' "$areas" | paste -sd, -)" >&2
      status=1
    fi
    if awk 'NR > 1 && /^## / { found = 1 } END { exit !found }' "$f"; then
      echo "collate-release-notes: $f: section headings are only allowed on line 1" >&2
      status=1
    fi
  done
  return $status
}

# Print the bodies of the fragments in section $1 tagged with area $2
# (untagged when $2 is empty).
section_part() {
  for f in "$dir"/*.md; do
    [ -e "$f" ] || continue
    [ "$f" = "$dir/_intro.md" ] && continue
    [ "$(sed -n 1p "$f")" = "$1" ] || continue
    [ "$(area_of "$f")" = "$2" ] || continue
    skip=0
    [ -z "$2" ] || skip=2
    # Drop the heading, the area line and any blank lines around the bullets.
    awk -v skip="$skip" 'NR > 1 && NR != skip { if ($0 == "") { held = held "\n"; next } if (started) printf "%s", held; held = ""; started = 1; print }' "$f"
  done
}

collate() {
  if [ -n "${1:-}" ]; then
    echo "# $1"
  else
    echo "# Next release"
  fi
  echo
  sed 's|](\.\./\.\./|](../|g' "$dir/_intro.md"
  printf '%s\n' "$sections" | while IFS= read -r heading; do
    body=$(printf '%s\n' "$areas" | {
      first=1
      while IFS= read -r area; do
        part=$(section_part "$heading" "$area")
        [ -n "$part" ] || continue
        [ "$first" = 1 ] || printf '\n'
        first=0
        printf '### %s\n\n%s\n' "$area" "$part"
      done
    })
    rest=$(section_part "$heading" "")
    if [ -n "$rest" ]; then
      [ -z "$body" ] || body="$body

$rest"
      [ -n "$body" ] || body=$rest
    fi
    [ -n "$body" ] || continue
    printf '\n%s\n\n%s\n' "$heading" "$body"
  done | sed 's|](\.\./\.\./|](../|g'
}

case "${1:-}" in
  --check)
    check
    ;;
  '')
    check
    collate
    ;;
  v[0-9]*.[0-9]*.[0-9]*)
    check
    out=docs/release-notes/$1.md
    if [ -e "$out" ]; then
      echo "collate-release-notes: $out already exists" >&2
      exit 1
    fi
    collate "$1" >"$out"
    for f in "$dir"/*.md; do
      [ "$f" = "$dir/_intro.md" ] || rm -- "$f"
    done
    ;;
  *)
    echo "usage: collate-release-notes [--check | vX.Y.Z]" >&2
    exit 2
    ;;
esac
