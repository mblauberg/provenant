#!/usr/bin/env bash
# Composite verification gate (#830): the MAINTAINING.md "Verify and release"
# list as one command with per-step pass/fail output, so agents stop
# re-copying the block. GATE_STEPS must stay identical to that fenced list;
# tests/test_ci_repository_assurance_policy.py binds the two.
set -u

[[ $# -eq 0 ]] || { echo "usage: gate" >&2; exit 2; }

# The steps verify this checkout, so Git discovery must not inherit caller
# redirects that would point a step at another repository.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
unset GIT_CEILING_DIRECTORIES GIT_DISCOVERY_ACROSS_FILESYSTEM

requested_product_root="${AGENT_FABRIC_PRODUCT_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
cd -P -- "$requested_product_root" 2>/dev/null || {
  echo "gate: product root is unavailable: $requested_product_root" >&2
  exit 3
}
PRODUCT_ROOT="$PWD"

GATE_STEPS=(
  "check-harness|scripts/check-harness"
  "workspace-checks|npm run check"
  "fabric-package-install|npm run test:package-install --workspace @local/fabric"
  "fabric-mcp-smoke|node runtime/fabric/mcp-smoke.mjs"
  "fabric-dependency-audit|npm audit --workspace=@local/fabric --omit=dev --audit-level=high"
  "static-security|scripts/static-security-check.py"
  "public-release|scripts/public-release-check"
  "diff-hygiene|git diff --check"
)

echo "gate: product_root=$PRODUCT_ROOT"
failed=0
index=0
total=${#GATE_STEPS[@]}
declare -a results=()
for entry in "${GATE_STEPS[@]}"; do
  name="${entry%%|*}"
  command="${entry#*|}"
  index=$((index + 1))
  echo "gate: [$index/$total] $name: $command"
  started=$SECONDS
  if eval "$command"; then
    status=pass
  else
    status=FAIL
    failed=$((failed + 1))
  fi
  results+=("$name=$status ($((SECONDS - started))s)")
  echo "gate: [$index/$total] $name $status ($((SECONDS - started))s)"
done

echo "gate: summary"
for line in "${results[@]}"; do
  echo "gate: $line"
done
if [[ "$failed" -ne 0 ]]; then
  echo "gate: $failed of $total steps failed" >&2
  exit 1
fi
echo "gate: all $total steps passed"
