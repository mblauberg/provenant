#!/usr/bin/env python3
"""Build nextest binaries under a build slot, then run them without one."""
import subprocess
import sys
import tempfile
from pathlib import Path


def main(args):
    if "--profile" not in args:
        sys.exit("verify-nextest requires --profile NAME")
    index = args.index("--profile")
    if index + 1 >= len(args):
        sys.exit("verify-nextest requires --profile NAME")
    profile = args[index + 1]
    args = list(args)
    test_filters = []
    if "--" in args:
        index = args.index("--")
        test_filters = args[index + 1:]
        del args[index:]
    metadata_options = []
    for flag in ("--features", "--target", "--manifest-path", "--config"):
        positions = [i for i, arg in enumerate(args) if arg == flag]
        for position in positions:
            if position + 1 >= len(args):
                sys.exit(f"{flag} requires a value")
            metadata_options.extend(args[position:position + 2])
    metadata_options.extend(arg for arg in args if arg in ("--all-features", "--no-default-features", "--offline", "--frozen"))
    run_options = []
    if "--stress-count" in args:
        index = args.index("--stress-count")
        if index + 1 >= len(args):
            sys.exit("--stress-count requires a value")
        run_options = args[index:index + 2]
        del args[index:index + 2]
    with tempfile.TemporaryDirectory(prefix="provenant-nextest-") as scratch:
        metadata = Path(scratch) / "cargo.json"
        binaries = Path(scratch) / "binaries.json"
        with metadata.open("w") as out:
            status = subprocess.run(["cargo", "metadata", "--format-version", "1", "--locked", *metadata_options], stdout=out).returncode
        if status:
            return status
        with binaries.open("w") as out:
            status = subprocess.run(["cargo", "nextest", "list", "--list-type", "binaries-only", "--message-format", "json", *args], stdout=out).returncode
        if status:
            return status
        return subprocess.run(["cargo", "nextest", "run", "--profile", profile, "--cargo-metadata", str(metadata), "--binaries-metadata", str(binaries), *run_options, *test_filters]).returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
