#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "$ROOT/scripts/lib/harness-python.sh"
TARGET=""

usage() {
  echo "usage: install-agents --target <global-agents-directory>" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --target)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      TARGET="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

[[ -n "$TARGET" ]] || { usage; exit 2; }
manager_args=(--surface agents --source "$ROOT/agents" --target "$TARGET")

# Validate the source first so a symlinked source directory cannot bypass the
# ownership boundary. Agent mechanics own the canonical directory-link rule.
run_stdlib "$ROOT/scripts/manage_installation.py" "${manager_args[@]}" validate-sources --summary >/dev/null

run_stdlib "$ROOT/scripts/manage_installation.py" "${manager_args[@]}" install --summary
run_stdlib "$ROOT/scripts/manage_installation.py" "${manager_args[@]}" check --summary
