#!/usr/bin/env python3
"""Run a named verification command and emit a cloud result as JSON.

The checkout may be a writer's branch that has advanced past the requested
commit; it must contain that commit. Changed files are allowed. The log
should be outside the checkout. The result contains no credentials.
"""
import argparse
import errno
import json
import os
import tempfile
from urllib.parse import parse_qsl, urlsplit
from pathlib import Path
import subprocess
import sys


def git(*args):
    return subprocess.check_output(["git", *args], text=True).strip()


def credential_bearing_location(location):
    parsed = urlsplit(location)
    if parsed.username is not None or parsed.password is not None:
        return True
    private_names = ("token", "secret", "password", "signature", "credential", "api_key")
    return any(key.lower() in {"key", "auth", "sig"}
               or any(name in key.lower() for name in private_names)
               for key, _ in parse_qsl(parsed.query, keep_blank_values=True))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--job-id", required=True, help="durable job ID from the request")
    parser.add_argument("--nonce", required=True, help="advisory nonce from the request")
    parser.add_argument("--observed-model", help="model observed by the VM, if known")
    parser.add_argument("--commit", required=True, help="full commit object ID the job started from")
    parser.add_argument("--trailer", action="store_true",
                        help="also print the result as a Provenant-Cloud-Result commit-message line")
    parser.add_argument("--test", required=True, help="name of the test or tier")
    parser.add_argument("--log", required=True, type=Path, help="local log file")
    parser.add_argument("--log-location", required=True, help="location to report for the log")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command or not args.test.strip() or not args.log_location.strip() or not args.job_id.strip() or not args.nonce.strip():
        parser.error("a command, job ID, nonce, test name and log location are required")
    if credential_bearing_location(args.log_location):
        parser.error("log location must not contain credentials")
    if git("ls-files", "--", ".provenant-cloud-result.json"):
        parser.error("the cloud result path must not already be tracked")
    head = git("rev-parse", "--verify", "HEAD^{commit}")
    if len(args.commit) not in (40, 64) or any(c not in "0123456789abcdefABCDEF" for c in args.commit):
        parser.error("--commit must be a full commit object ID")
    if subprocess.run(["git", "merge-base", "--is-ancestor", args.commit, head],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        parser.error("checkout does not contain the full requested commit")
    with args.log.open("wb") as log:
        try:
            completed = subprocess.run(command, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, check=False)
            status = completed.returncode if completed.returncode >= 0 else 128 - completed.returncode
        except OSError as error:
            log.write(f"Unable to start verification command: {error}\n".encode())
            status = 127 if error.errno == errno.ENOENT else 126
    # The command may commit; report the head the proof finished on.
    head = git("rev-parse", "--verify", "HEAD^{commit}")
    branch = subprocess.run(["git", "symbolic-ref", "--quiet", "--short", "HEAD"],
                            capture_output=True, text=True).stdout.strip()
    result = {
        "job_id": args.job_id,
        "nonce": args.nonce,
        "commit": args.commit.lower(),
        "exit_status": status,
        "tests_run": [args.test],
        "tests_failed": [args.test] if status else [],
        "log_location": args.log_location,
        "observed_model": args.observed_model or None,
        "head": head,
    }
    if branch:
        result["branch"] = branch
    encoded = json.dumps(result, separators=(",", ":"))
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=".", prefix=".cloud-result-", delete=False) as temporary:
        temporary.write(encoded + "\n")
        temporary.flush()
        temporary_name = temporary.name
    os.replace(temporary_name, ".provenant-cloud-result.json")
    print(encoded)
    if args.trailer:
        print("Provenant-Cloud-Result: " + encoded)
    return 0


if __name__ == "__main__":
    sys.exit(main())
