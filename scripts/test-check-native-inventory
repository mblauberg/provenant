#!/usr/bin/env python3
"""Exercise native evidence checks against synthetic nextest results."""
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import tempfile

loader = importlib.machinery.SourceFileLoader('native_inventory', str(Path(__file__).with_name('check-native-inventory')))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)
name = 'example::native_test'
row = [name, 'macOS', 'native', 'PROVENANT_CONFINEMENT_REQUIRED', 'suite']
listing = {'rust-suites': {'suite': {'testcases': {name: {}}}}}
with tempfile.TemporaryDirectory() as directory:
    root = Path(directory)
    (root / 'native.json').write_text(json.dumps({'PROVENANT_CONFINEMENT_REQUIRED': '1'}))
    report = root / 'native.xml'
    def write_case(body=''):
        report.write_text(f'<testsuites><testsuite><testcase classname="suite" name="{name}">{body}</testcase></testsuite></testsuites>')
    write_case()
    assert not module.check([row], listing, root)
    # A source definition or a selector cannot substitute for the platform list.
    assert module.check([row], {'rust-suites': {'other': {'testcases': {name: {}}}}}, root)
    report.write_text(f'<testsuite><testcase classname="other" name="{name}"/></testsuite>')
    assert module.check([row], listing, root)
    write_case()
    assert module.check([['missing', *row[1:]]], listing, root)
    for marker in ('skipped', 'failure', 'error'):
        write_case(f'<{marker}/>')
        assert module.check([row], listing, root)
    report.write_text('<testsuites/>')  # Empty filter or zero tests.
    assert module.check([row], listing, root)
    write_case()
    (root / 'native.json').write_text('{}')
    assert module.check([row], listing, root)
    (root / 'native.json').unlink()
    assert module.check([row], listing, root)
    (root / 'native.json').write_text(json.dumps({'PROVENANT_CONFINEMENT_REQUIRED': '1'}))
    (root / 'duplicate.xml').write_text(report.read_text())
    assert module.check([row], listing, root)
    (root / 'duplicate.xml').unlink()
    # Names are scoped to a binary: two suites may legitimately use the same
    # Rust module/test name, but each must supply its own execution evidence.
    other_row = [*row[:4], 'other']
    listing['rust-suites']['other'] = {'testcases': {name: {}}}
    report.write_text(f'<testsuites><testsuite><testcase classname="suite" name="{name}"/><testcase classname="other" name="{name}"/></testsuite></testsuites>')
    assert not module.check([row, other_row], listing, root)
    inventory_file = root / 'inventory.md'
    inventory_file.write_text('| Exact test name | Platform | Invocation | Environment | Binary |\n' + '\n'.join('| ' + ' | '.join(f'`{v}`' if i in (0, 4) else v for i, v in enumerate(r)) + ' |' for r in [row, other_row]))
    assert len(module.inventory(inventory_file)) == 2
    unquoted = inventory_file.read_text().replace('`example::native_test`', 'example::native_test', 1)
    inventory_file.write_text(unquoted)
    try:
        module.inventory(inventory_file)
    except ValueError:
        pass
    else:
        raise AssertionError('unquoted inventory row accepted')
    inventory_file.write_text('| Exact test name | Platform | Invocation | Environment | Binary |\n' + '\n'.join('| ' + ' | '.join(f'`{v}`' if i in (0, 4) else v for i, v in enumerate(r)) + ' |' for r in [row, other_row]))
    # A row without its leading pipe fails instead of ending the table early.
    lines = inventory_file.read_text().splitlines()
    inventory_file.write_text('\n'.join([lines[0], lines[1], lines[1].lstrip('| '), lines[2]]) + '\n')
    try:
        module.inventory(inventory_file)
    except ValueError:
        pass
    else:
        raise AssertionError('row without a leading pipe ended the table')
    inventory_file.write_text('\n'.join(lines) + '\n\nTrailing prose.\n')
    assert len(module.inventory(inventory_file)) == 2
    inventory_file.write_text('\n'.join(lines))
    inventory_file.write_text(inventory_file.read_text() + '\n' + inventory_file.read_text().splitlines()[1])
    try:
        module.inventory(inventory_file)
    except ValueError:
        pass
    else:
        raise AssertionError('duplicate binary/test identity accepted')
print('Native inventory evidence fixtures passed.')
