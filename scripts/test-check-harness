#!/usr/bin/env python3
"""Exercise the harness checker against tracked and broken fixture files."""

import test_git_env
test_git_env.isolate()

import json
from pathlib import Path
import subprocess
import tempfile
import unittest


ROOT = Path(__file__).resolve().parent.parent
CHECK = ROOT / "scripts/check-harness"


class HarnessChecks(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.root = Path(self.temp.name)
        subprocess.run(["git", "init", "-q", str(self.root)], check=True)
        self.skill = self.root / "skills/example/SKILL.md"
        self.fixture = self.root / "skills/example/evals/trigger_cases.json"
        self.skill.parent.mkdir(parents=True)
        self.fixture.parent.mkdir(parents=True)
        self.skill.write_text("---\nname: example\ndescription: Example fixture skill.\n---\n# Hello\n# Hello\n[duplicate](#hello-1)\n")
        self.fixture.write_text(json.dumps({"schema_version": 1, "target_skill": "example", "cases": [{"id": "q1", "relation": "positive", "prompt": "Use this skill", "tags": ["direct"], "expected": {"primary_skill": "example", "companion_skills": []}}]}))
        subprocess.run(["git", "-C", str(self.root), "add", "."], check=True)

    def tearDown(self):
        self.temp.cleanup()

    def check(self, expected=0):
        output = subprocess.run([str(CHECK), str(self.root)], capture_output=True, text=True)
        self.assertEqual(output.returncode, expected, output.stdout + output.stderr)
        return output.stderr

    def test_tracked_yaml_links_and_routes(self):
        (self.root / "untracked.md").write_text("[untracked](missing.md)")
        self.check()
        self.skill.write_text("---\nname: example\ndescription: Example fixture skill.\n---\n[bad](#missing)\n")
        warnings = self.check()
        self.assertIn("warning: skills/example/SKILL.md:5: unresolved Markdown anchor", warnings)
        self.fixture.write_text("{}")
        self.assertIn("invalid route fixture", self.check(1))

    def test_duplicate_yaml_is_rejected(self):
        self.skill.write_text("---\nname: example\nname: example\ndescription: A skill\n---\n")
        self.assertIn("duplicate key", self.check(1))

    def test_skill_frontmatter_allowlist_and_stale_pin(self):
        self.skill.write_text("---\nname: example\ndescription: A skill\nextra: value\n---\n")
        self.assertIn("unsupported frontmatter keys: extra", self.check(1))
        (self.root / "package.json").write_text(json.dumps({"dependencies": {"example": "1.5.0"}}))
        self.skill.write_text("---\nname: example\ndescription: A skill\nverified-against: example@1.4\n---\n")
        self.assertIn("pinned to 1.4", self.check(1))

    def test_sidecar_description_and_icon(self):
        sidecar = self.root / "skills/example/agents/openai.yaml"
        sidecar.parent.mkdir()
        def write_sidecar(description, icon=""):
            sidecar.write_text(f"interface:\n  display_name: Example\n  short_description: '{description}'\n  default_prompt: Use $example\n{icon}")
        write_sidecar("A" * 25)
        subprocess.run(["git", "-C", str(self.root), "add", "."], check=True)
        self.check()
        for description in ("A" * 24, "A" * 65):
            write_sidecar(description)
            self.assertIn("25..64", self.check(1))
        write_sidecar("A" * 64, "  icon_small: missing.svg\n")
        self.assertIn("tracked local asset", self.check(1))

    def test_issue_form_keys_and_input(self):
        form = self.root / ".github/ISSUE_TEMPLATE/bug.yml"
        form.parent.mkdir(parents=True)
        header = "name: Bug\ndescription: Report a bug\n"
        input_field = "body:\n  - type: input\n    id: summary\n    attributes:\n      label: Summary\n"
        form.write_text(header + input_field)
        subprocess.run(["git", "-C", str(self.root), "add", "."], check=True)
        self.check()
        form.write_text(header + "extra: value\n" + input_field)
        self.assertIn("unsupported issue form keys: extra", self.check(1))
        form.write_text(header + input_field + "    placeholder: misplaced\n")
        self.assertIn("unsupported issue body keys: placeholder", self.check(1))
        form.write_text(header + "body:\n  - type: markdown\n    attributes:\n      value: Instructions\n")
        self.assertIn("at least one input is required", self.check(1))

    def test_recorded_skill_and_sidecar(self):
        skill = ROOT / "skills/refactor/SKILL.md"
        sidecar = ROOT / "skills/refactor/agents/openai.yaml"
        target = self.root / "skills/refactor"
        (target / "agents").mkdir(parents=True)
        header = skill.read_text().split("---", 2)
        (target / "SKILL.md").write_text("---" + header[1] + "---\n")
        (target / "agents/openai.yaml").write_text(sidecar.read_text())
        subprocess.run(["git", "-C", str(self.root), "add", "."], check=True)
        self.check()

    def test_inline_code_and_real_links(self):
        readme = self.root / "README.md"
        readme.write_text("`[literal](missing.md)` and `` `[other](missing.md)` ``\n[real](#heading)\n# Heading\n")
        subprocess.run(["git", "-C", str(self.root), "add", "."], check=True)
        self.check()
        readme.write_text("`[literal](missing.md)` and [real](missing.md)\n")
        self.assertIn("warning: README.md:1: unresolved local link", self.check())

    def test_skill_references_are_named_only_by_their_skill(self):
        reference = self.root / "skills/example/references/depth.md"
        reference.parent.mkdir()
        reference.write_text("# Depth\n")
        self.skill.write_text("---\nname: example\ndescription: Example fixture skill.\n---\n[depth](references/depth.md)\n")
        (self.root / "NOTICE.md").write_text("Covers skills/example/references/depth.md\n")
        readme = self.root / "README.md"
        readme.write_text("[skill](skills/example/SKILL.md)\n")
        subprocess.run(["git", "-C", str(self.root), "add", "."], check=True)
        self.check()
        readme.write_text("[depth](skills/example/references/depth.md)\n")
        self.assertIn("README.md: line 1: names skills/example/references/depth.md", self.check(1))
        readme.write_text("See `skills/example/references/depth.md`.\n")
        self.assertIn("README.md: line 1: names", self.check(1))

    def test_ambient_files_name_no_repository_paths(self):
        ambient = self.root / "HARNESS.md"
        ambient.write_text("Use `orchestrate` and `~/.codex/config.toml`.\n")
        subprocess.run(["git", "-C", str(self.root), "add", "."], check=True)
        self.check()
        ambient.write_text("See `docs/runbooks/x.md`.\n")
        self.assertIn("HARNESS.md: line 1: ambient file names repository path docs/runbooks/x.md", self.check(1))
        ambient.write_text("Governed by `MAINTAINING.md`.\n")
        self.assertIn("ambient file names repository path MAINTAINING.md", self.check(1))
        ambient.write_text("See `../docs/x.md`.\n")
        self.assertIn("ambient file names repository path ../docs/x.md", self.check(1))
        ambient.unlink()
        rules = self.root / "GLOBAL-AGENTS.md"
        rules.write_text("See `scripts/verify`.\n")
        subprocess.run(["git", "-C", str(self.root), "add", "-A"], check=True)
        self.assertIn("GLOBAL-AGENTS.md: line 1: ambient file names repository path scripts/verify", self.check(1))

    def test_skill_links_must_survive_installation(self):
        for collection in ("skills", "library"):
            owner = self.root / collection / "portable"
            owner.mkdir(parents=True)
            (owner / "SKILL.md").write_text("---\nname: portable\ndescription: A portable skill.\n---\n")
            source = owner / "references/depth.md"
            source.parent.mkdir()
            source.write_text("# Depth\n")
            for directory in ("docs", "config", "scripts", "tools"):
                target = self.root / directory / "target.md"
                target.parent.mkdir(exist_ok=True)
                target.write_text("# Target\n")
                local = owner / directory / "target.md"
                local.parent.mkdir()
                local.write_text("# Target\n")
                subprocess.run(["git", "-C", str(self.root), "add", "."], check=True)
                for link in (
                    f"[target](../../../{directory}/target.md#target)",
                    f"[target](../../../{directory}/%74arget.md)",
                    f"[target][dest]\n[dest]: ../../../{directory}/target.md",
                    f"[target](/{directory}/target.md)",
                ):
                    with self.subTest(collection=collection, directory=directory, link=link):
                        source.write_text(link + "\n")
                        self.assertIn("link leaves the installed skill", self.check(1))
                source.write_text(f"[local](../{directory}/target.md#target)\n")
                self.check()
            entry = owner / "SKILL.md"
            entry.write_text(entry.read_text() + "[outside](../../docs/target.md)\n")
            self.assertIn("link leaves the installed skill", self.check(1))
            entry.write_text(entry.read_text().replace("[outside](../../docs/target.md)\n", ""))
            source.write_text("[external](https://example.org/docs/)\n[entry](../SKILL.md)\n`[literal](../../../docs/target.md)`\n```md\n[example](../../../docs/target.md)\n```\n")
            self.check()


if __name__ == "__main__":
    unittest.main()
