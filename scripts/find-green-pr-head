#!/usr/bin/env python3
"""Find a verified green synchronize predecessor, or print nothing."""

import json
import os
import re
import subprocess
import sys


def api(path):
    result = subprocess.run(
        ["gh", "api", path], capture_output=True, text=True, check=True, timeout=20
    )
    return json.loads(result.stdout)


def main():
    before = os.environ.get("PR_BEFORE", "")
    number = os.environ.get("PR_NUMBER", "")
    repository = os.environ.get("GITHUB_REPOSITORY", "")
    if (
        os.environ.get("PR_ACTION") != "synchronize"
        or not re.fullmatch(r"[0-9a-f]{40}", before)
        or not number.isdecimal()
        or not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository)
    ):
        return
    prefix = f"repos/{repository}/actions"
    runs = api(f"{prefix}/workflows/ci.yml/runs?event=pull_request&head_sha={before}&per_page=100")
    for run in runs["workflow_runs"]:
        if (
            run.get("head_sha") != before
            or run.get("status") != "completed"
            or run.get("conclusion") != "success"
            or not any(pr.get("number") == int(number) for pr in run.get("pull_requests", []))
        ):
            continue
        jobs = api(f"{prefix}/runs/{int(run['id'])}/jobs?per_page=100")
        if any(
            job.get("name") == "ci-status"
            and job.get("status") == "completed"
            and job.get("conclusion") == "success"
            for job in jobs["jobs"]
        ):
            print(before)
            return


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(f"Green predecessor lookup unavailable: {error}", file=sys.stderr)
