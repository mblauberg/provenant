#!/bin/sh
# Advisory CI signal: stress-run the tests a pull request added or changed.
#   run-stress-tests <base> [<head>]
# Runs nextest with --stress-count 20 and no retries over just those tests,
# stopped after STRESS_DURATION (default 15m) so a large diff cannot outrun
# the job timeout and lose its log. Reaching the budget is not a failure.
# A failure becomes a warning annotation and summary; the script always exits 0.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd -P)
base=${1:?usage: run-stress-tests <base> [<head>]}
head=${2:-HEAD}
count=${STRESS_COUNT:-20}
duration=${STRESS_DURATION:-15m}
budget=
if command -v timeout >/dev/null 2>&1; then budget="timeout -s INT $duration"; fi

note() { # markdown for the job summary
  if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
    printf '### Stress run (advisory)\n\n%s\n' "$1" >> "$GITHUB_STEP_SUMMARY"
  fi
}

filter=$("$root/scripts/find-changed-tests" --base "$base" --head "$head")
if [ -z "$filter" ]; then
  echo "No added or changed tests between $base and $head."
  note "No added or changed tests in this diff."
  exit 0
fi

cd "$root/tools/front-door"
log=$(mktemp "${TMPDIR:-/tmp}/provenant-stress.XXXXXX")
trap 'rm -f "$log"' EXIT HUP INT TERM
status=0
$budget cargo nextest run --profile ci --workspace --locked \
  --features provenant-providers/recording \
  --stress-count "$count" --retries 0 --failure-output immediate \
  --no-tests=pass -E "$filter" > "$log" 2>&1 || status=$?

if [ "$status" -eq 0 ]; then
  tail -n 200 "$log"
  note "Changed tests passed $count stress iterations with no retries."
elif [ -n "$budget" ] && [ "$status" -eq 124 ] && ! grep -q 'FAIL' "$log"; then
  tail -n 200 "$log"
  note "Stopped at the $duration budget before $count iterations, with no failures."
else
  # A timeout can leave thousands of PASS rows after an earlier failure. Keep
  # its name and immediate output even if neither appears in the final tail.
  echo '::group::Complete failed stress run log'
  cat "$log"
  echo '::endgroup::'
  echo "::warning title=Stress run failed::Changed tests failed under --stress-count $count with no retries (exit $status); a build error also lands here."
  failures=$(grep -E '(^|[[:space:]])(FAIL|TIMEOUT|ABORT|LEAK|XPASS)([[:space:]]|$)' "$log" || true)
  note "**Stress run failed** (exit $status), \`--stress-count $count\`, no retries. Full diagnostics are in the **Complete failed stress run log** group. Failure status rows:

\`\`\`
${failures:-No test failure status was emitted; inspect the complete log for a build or runner error.}
\`\`\`

Tail of the log:

\`\`\`
$(tail -n 60 "$log")
\`\`\`"
fi
exit 0
