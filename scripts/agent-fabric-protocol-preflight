#!/bin/sh
set -eu

script_path=$0
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case "$link" in
    /*) script_path=$link ;;
    *) script_path=$(dirname "$script_path")/$link ;;
  esac
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
if [ "${AGENTS_HOME+x}" = x ]; then
  agents_home=$AGENTS_HOME
  agents_home_was_derived=false
else
  agents_home=$(dirname -- "$script_dir")
  agents_home_was_derived=true
fi
case "$agents_home" in /*) ;; *) echo "AGENTS_HOME must be absolute" >&2; exit 2 ;; esac

# This preflight now sits in front of every entrypoint, so a partial install
# that omits scripts/lib would otherwise take them all out with a bare
# "No such file or directory" and exit 1 -- neither typed nor repairable.
if [ ! -f "$script_dir/lib/agent-fabric-workspace-freshness.sh" ]; then
  echo "AGENT_FABRIC_PREFLIGHT_INCOMPLETE: missing \"$script_dir/lib/agent-fabric-workspace-freshness.sh\"" >&2
  echo "repair: reinstall the harness scripts directory, including scripts/lib" >&2
  exit 78
fi
. "$script_dir/lib/agent-fabric-workspace-freshness.sh"
build_lock_library="$script_dir/lib/agent-fabric-protocol-build-lock.sh"
build_lock_available=false
if [ -f "$build_lock_library" ]; then
  . "$build_lock_library"
  build_lock_available=true
fi

protocol_root="$agents_home/runtime/agent-fabric-protocol"
protocol_dist="$protocol_root/dist/index.js"
repair_command="AGENTS_HOME=\"$agents_home\" \"$script_dir/agent-fabric-protocol-build\""

protocol_build_block() {
  echo "AGENT_FABRIC_PROTOCOL_BUILD_STALE: local @local/agent-fabric-protocol dist is missing, unloadable, or stale against its build inputs" >&2
  echo "repair: $repair_command" >&2
  exit 78
}

protocol_autobuild_allowed() {
  [ "$agents_home_was_derived" = true ] \
    && [ -d "$agents_home/.git" ] \
    && [ ! -L "$agents_home/.git" ] \
    && [ "${AGENT_FABRIC_PROTOCOL_NO_AUTOBUILD+x}" != x ] \
    && [ "${AGENT_FABRIC_PROTOCOL_PREFLIGHT_MODE:-}" != doctor ] \
    && [ "$build_lock_available" = true ] \
    && [ -x "$script_dir/agent-fabric-protocol-build" ]
}

# A compiler can recreate dist/index.js before the rest of the tree and the
# freshness stamp are complete. Observe lock presence before autobuild policy,
# so strict callers refuse without inspecting partial output. Eligible callers
# join only as waiters; the lock owner decides whether the prior build completed.
if [ "$build_lock_available" = true ] \
  && protocol_build_lock_is_present "$protocol_root/dist"
then
  if protocol_autobuild_allowed; then
    if AGENT_FABRIC_PROTOCOL_AUTOBUILD=1 \
      AGENT_FABRIC_PROTOCOL_AUTOBUILD_WAIT_ONLY=1 \
      AGENTS_HOME="$agents_home" \
      "$script_dir/agent-fabric-protocol-build" >/dev/null \
      && [ -f "$protocol_dist" ] \
      && ! workspace_is_stale "$protocol_root" "$protocol_dist"
    then
      exit 0
    fi
  fi
  protocol_build_block
fi

[ -f "$protocol_dist" ] || protocol_build_block

# Loadability is probed only for `doctor`, which is the caller that needs it:
# it imports the protocol package transitively, so a dist that cannot load
# leaves it unable to report anything and it must block rather than pretend.
# Every other entrypoint would be charged a Node start-up -- ~130ms measured,
# against ~10ms for the rest of this script -- on the path that runs before
# every `agent-fabric` and `agent-fabric-mcp` invocation, to learn something
# their own import is about to establish anyway.
if [ "${AGENT_FABRIC_PROTOCOL_PREFLIGHT_MODE:-}" = doctor ]; then
  node --input-type=module -e 'await import(process.argv[1]);' "$protocol_dist" \
    >/dev/null 2>&1 || protocol_build_block
fi

if workspace_is_stale "$protocol_root" "$protocol_dist"; then
  if [ "${AGENT_FABRIC_PROTOCOL_PREFLIGHT_MODE:-}" = doctor ]; then
    # Doctor reports repair state for operators and callers; it must not mutate
    # the condition it was asked to diagnose, even at the owned install root.
    printf '%s\n' "$repair_command"
    exit 0
  fi
  if protocol_autobuild_allowed; then
    # The build owns the existing shared lock and re-checks freshness after
    # acquiring it, so racing preflights serialise and only the holder that
    # still sees stale inputs enters npm.
    if AGENT_FABRIC_PROTOCOL_AUTOBUILD=1 \
      AGENTS_HOME="$agents_home" \
      "$script_dir/agent-fabric-protocol-build" >/dev/null \
      && [ -f "$protocol_dist" ] \
      && ! workspace_is_stale "$protocol_root" "$protocol_dist"
    then
      exit 0
    fi
  fi
  protocol_build_block
fi
