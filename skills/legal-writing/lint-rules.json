{
  "version": 1,
  "exclusions": {
    "regex": ["(?m)^[ \t]*[|:-][|: \t-]*$", "(?s)\\A---\\r?\\n.*?\\r?\\n---(?:\\r?\\n|\\z)", "\\]\\([^\\s)]+\\)", "https?://\\S+"],
    "latex_commands": ["Cref", "Gls", "acrfull", "acrlong", "acrshort", "autoref", "begin", "bibliography", "bibliographystyle", "cite", "citep", "citet", "code", "cref", "end", "eqref", "gls", "glspl", "include", "includegraphics", "input", "label", "lstinline", "metric", "mintinline", "model", "path", "ref", "result", "texttt", "ttfamily", "url", "verb"],
    "verbatim_commands": ["verb", "lstinline", "mintinline"],
    "latex_environments": ["verbatim", "lstlisting", "minted", "Verbatim", "equation", "align", "gather", "multline", "eqnarray", "alignat", "flalign"],
    "math_delimiters": [["$$", "$$"], ["$", "$"], ["\\(", "\\)"], ["\\[", "\\]"]]
  },
  "shared": [],
  "sets": {
    "legal": {
      "latex": false,
      "quoted_example_paths": ["skills/legal-writing/"],
      "skip_files": ["readme.md", "index.md"],
      "rules": [
        {"id": "legal.blocker.001", "message": "em dash (banned in all output)", "severity": "blocker", "kind": "regex", "pattern": "—", "case_insensitive": false},
        {"id": "legal.blocker.002", "message": "US legalese: COMES NOW", "severity": "blocker", "kind": "regex", "pattern": "\\bCOMES NOW\\b", "case_insensitive": true},
        {"id": "legal.blocker.003", "message": "US legalese: wherefore", "severity": "blocker", "kind": "regex", "pattern": "\\bwherefore\\b", "case_insensitive": true},
        {"id": "legal.blocker.004", "message": "US legalese: herein", "severity": "blocker", "kind": "regex", "pattern": "\\bherein\\b", "case_insensitive": true},
        {"id": "legal.blocker.005", "message": "US legalese: therein", "severity": "blocker", "kind": "regex", "pattern": "\\btherein\\b", "case_insensitive": true},
        {"id": "legal.blocker.006", "message": "US legalese: heretofore", "severity": "blocker", "kind": "regex", "pattern": "\\bheretofore\\b", "case_insensitive": true},
        {"id": "legal.blocker.007", "message": "US legalese: aforementioned", "severity": "blocker", "kind": "regex", "pattern": "\\baforementioned\\b", "case_insensitive": true},
        {"id": "legal.blocker.008", "message": "US legalese: the undersigned", "severity": "blocker", "kind": "regex", "pattern": "\\bthe undersigned\\b", "case_insensitive": true},
        {"id": "legal.blocker.009", "message": "US legalese: respectfully prays", "severity": "blocker", "kind": "regex", "pattern": "\\brespectfully prays\\b", "case_insensitive": true},
        {"id": "legal.blocker.010", "message": "US legalese: Honorable Court", "severity": "blocker", "kind": "regex", "pattern": "\\bHonorable Court\\b", "case_insensitive": true},
        {"id": "legal.blocker.011", "message": "US legalese: pro se", "severity": "blocker", "kind": "regex", "pattern": "\\bpro se\\b", "case_insensitive": true},
        {"id": "legal.blocker.012", "message": "US legalese: esq.", "severity": "blocker", "kind": "regex", "pattern": "\\besq\\.", "case_insensitive": true},
        {"id": "legal.blocker.013", "message": "banned evidence path: .work", "severity": "blocker", "kind": "regex", "pattern": "(^|[/` ])\\.work(/|`| |$)", "case_insensitive": false},
        {"id": "legal.blocker.014", "message": "banned evidence path: docs/audits", "severity": "blocker", "kind": "regex", "pattern": "(^|[/` ])docs/audits(/|`| |$)", "case_insensitive": false},
        {"id": "legal.blocker.015", "message": "banned evidence path: _audit", "severity": "blocker", "kind": "regex", "pattern": "(^|[/` ])_audit(/|`| |$)", "case_insensitive": false},
        {"id": "legal.blocker.016", "message": "internal marker: TODO", "severity": "blocker", "kind": "regex", "pattern": "\\bTODO\\b", "case_insensitive": false},
        {"id": "legal.blocker.017", "message": "internal marker: TBD", "severity": "blocker", "kind": "regex", "pattern": "\\bTBD\\b", "case_insensitive": false},
        {"id": "legal.blocker.018", "message": "internal marker: TBC", "severity": "blocker", "kind": "regex", "pattern": "\\bTBC\\b", "case_insensitive": false},
        {"id": "legal.blocker.019", "message": "internal marker: FIXME", "severity": "blocker", "kind": "regex", "pattern": "\\bFIXME\\b", "case_insensitive": false},
        {"id": "legal.blocker.020", "message": "internal marker: drafting note", "severity": "blocker", "kind": "regex", "pattern": "\\bdrafting note\\b", "case_insensitive": true},
        {"id": "legal.blocker.021", "message": "agent or AI process language", "severity": "blocker", "kind": "regex", "pattern": "\\b(agent note|AI-generated|generated by AI|hallucination)\\b", "case_insensitive": true},
        {"id": "legal.blocker.022", "message": "safety-instrument overstatement", "severity": "blocker", "kind": "regex", "pattern": "\\b(?:protective|protection|intervention|safety|police-issued)\\b.{0,50}\\b(?:notice|direction|order|instrument|application|material)\\b.{0,80}\\b(?:proves?|establish(?:es|ed))\\b.{0,80}\\b(?:family|domestic) violence\\b", "case_insensitive": true},
        {"id": "legal.warning.001", "message": "en dash (allowed; use sparingly, e.g. number/date/page ranges)", "severity": "warning", "kind": "regex", "pattern": "–", "case_insensitive": false},
        {"id": "legal.warning.002", "message": "AI tell / inflated word", "severity": "warning", "kind": "regex", "pattern": "\\b(?:comprehensive|crucial|delve|foster|groundbreaking|holistic|intricate|leverage|leverages|leveraging|meticulous|multifaceted|myriad|nuanced|paramount|pivotal|plethora|realm|robust|seamless|tapestry|transformative|vital)\\b", "case_insensitive": true},
        {"id": "legal.warning.003", "message": "AI tell / prestige verb", "severity": "warning", "kind": "regex", "pattern": "\\b(showcases?|underscores?|highlights?|facilitates?|enhances?|drives?|leverages?)\\b", "case_insensitive": true},
        {"id": "legal.warning.004", "message": "AI tell / empty transition", "severity": "warning", "kind": "regex", "pattern": "\\b(it is worth noting that|in light of the foregoing|having regard to the above|as outlined above)\\b", "case_insensitive": true},
        {"id": "legal.warning.005", "message": "AI tell / notability opener", "severity": "warning", "kind": "regex", "pattern": "\\b(importantly|notably|interestingly),", "case_insensitive": true},
        {"id": "legal.warning.006", "message": "AI tell / additive transition chain (name the real relation or omit)", "severity": "warning", "kind": "regex", "pattern": "\\b(moreover|furthermore|additionally|in addition)\\b", "case_insensitive": true},
        {"id": "legal.warning.007", "message": "AI tell / additive background padding (cut or move to the owning document)", "severity": "warning", "kind": "regex", "pattern": "\\b(broader background context|ongoing dispute|sets? out the broader background|additional context)\\b", "case_insensitive": true},
        {"id": "legal.warning.008", "message": "AI tell / copula avoidance", "severity": "warning", "kind": "regex", "pattern": "\\b(serves as|serves to|stands as|plays a role in|is indicative of|represents)\\b", "case_insensitive": true},
        {"id": "legal.warning.009", "message": "AI tell / negative parallelism padding", "severity": "warning", "kind": "regex", "pattern": "\\b(not only|not just|not merely|is not merely|isn't merely)\\b", "case_insensitive": true},
        {"id": "legal.warning.010", "message": "AI tell / empty ing-tail", "severity": "warning", "kind": "regex", "pattern": ",\\s+(ensuring|enhancing|highlighting|showcasing|driving|facilitating)\\s+(fairness|reliability|concerns|evidence|impact|performance|compliance|clarity|efficiency|outcomes?)\\b", "case_insensitive": true},
        {"id": "legal.warning.011", "message": "hyphenation / -ly adverb compound", "severity": "warning", "kind": "regex", "pattern": "\\b(?:highly|clearly|fully|newly|rapidly|widely|closely|broadly|tightly|loosely|poorly|badly|heavily|finely|partly|wholly|purely|simply|directly|carefully|randomly|statistically|formally|naturally|locally|globally|recently|previously|increasingly|deeply|nearly|largely|mostly|readily|equally|strongly|weakly|densely|sparsely|manually|automatically|empirically|theoretically|significantly|substantially|relatively|inherently|explicitly|implicitly|publicly|properly|legally|procedurally|factually)-[A-Za-z]+\\b", "case_insensitive": true},
        {"id": "legal.warning.012", "message": "AI tell / stock document opener", "severity": "warning", "kind": "regex", "pattern": "\\b(this (?:application|submission|affidavit|letter|section|document) (?:explores|delves|sets out to|highlights|underscores|showcases|demonstrates))\\b", "case_insensitive": true},
        {"id": "legal.warning.013", "message": "internal process language in filing text", "severity": "warning", "kind": "regex", "pattern": "\\b(agent summary|review set|render check|manifest proves|router status|gate fired|source pack|audit found)\\b", "case_insensitive": true},
        {"id": "legal.warning.014", "message": "weak abstraction (name the act, source, order or consequence)", "severity": "warning", "kind": "regex", "pattern": "\\b(concerns regarding|issues surrounding|matters pertaining to|in relation to|with respect to|with regard to|in respect of)\\b", "case_insensitive": true},
        {"id": "legal.warning.015", "message": "legal noun-stack risk (unpack abstract head and keep one defined term)", "severity": "warning", "kind": "regex", "pattern": "\\b(?:cross-proceeding|source-boundary|filing-facing|safety-context|family-violence|case-management|enforcement|relationship-finance|document-function|protected-address)\\s+(?:[a-z]+-)?[a-z]+\\s+(?:context|framework|posture|material|risk|issue|position|process|concern|boundary|interface)\\b", "case_insensitive": true},
        {"id": "legal.warning.016", "message": "wordy filler: in order to (prefer to unless source-bound)", "severity": "warning", "kind": "regex", "pattern": "\\bin order to\\b", "case_insensitive": true},
        {"id": "legal.warning.017", "message": "wordy filler: for the purpose of (prefer for or the specific purpose)", "severity": "warning", "kind": "regex", "pattern": "\\bfor the purpose of\\b", "case_insensitive": true},
        {"id": "legal.warning.018", "message": "wordy filler: the fact that (name the fact directly)", "severity": "warning", "kind": "regex", "pattern": "\\bthe fact that\\b", "case_insensitive": true},
        {"id": "legal.warning.019", "message": "wordy filler: question as to whether (prefer whether)", "severity": "warning", "kind": "regex", "pattern": "\\bquestion as to whether\\b", "case_insensitive": true},
        {"id": "legal.warning.020", "message": "wordy filler: is able to / has the ability to (prefer can unless capacity is the issue)", "severity": "warning", "kind": "regex", "pattern": "\\b(is able to|has the ability to)\\b", "case_insensitive": true},
        {"id": "legal.warning.021", "message": "wordy filler: in circumstances where (prefer where, when or the actual condition)", "severity": "warning", "kind": "regex", "pattern": "\\bin circumstances where\\b", "case_insensitive": true},
        {"id": "legal.warning.022", "message": "stock submission formula (usually state the submission directly)", "severity": "warning", "kind": "regex", "pattern": "\\b(it is submitted that|respectfully submits?|respectfully requests?)\\b", "case_insensitive": true},
        {"id": "legal.warning.023", "message": "proposed order vagueness (needs actor, act, object and deadline or trigger)", "severity": "warning", "kind": "regex", "pattern": "\\b(as soon as practicable|appropriate to make orders|ensure that the parties understand)\\b", "case_insensitive": true},
        {"id": "legal.warning.024", "message": "dated legalism: at all material times (state the date range if it matters)", "severity": "warning", "kind": "regex", "pattern": "\\bat all material times\\b", "case_insensitive": true},
        {"id": "legal.warning.025", "message": "empty hedge", "severity": "warning", "kind": "regex", "pattern": "\\b(clearly|obviously)\\b", "case_insensitive": true},
        {"id": "legal.warning.026", "message": "overstatement intensifier (assert the proposition and pin it to a source instead)", "severity": "warning", "kind": "regex", "pattern": "\\b(overwhelmingly|incontrovertibly|indisputably|undoubtedly|unquestionably|beyond (?:any )?doubt)\\b", "case_insensitive": true},
        {"id": "legal.warning.027", "message": "modal hedge stack (keep one accurate qualifier)", "severity": "warning", "kind": "regex", "pattern": "\\b(?:may|might|could)\\s+(?:arguably|possibly|perhaps|potentially)\\b|\\b(?:arguably|possibly|perhaps)\\s+(?:may|might|could)\\b", "case_insensitive": true},
        {"id": "legal.warning.028", "message": "ceremonial doublet (collapse to the operative word unless quoted or statutory)", "severity": "warning", "kind": "regex", "pattern": "\\b(null and void|each and every|any and all|cease and desist|full and complete|aid and abet)\\b", "case_insensitive": true},
        {"id": "legal.warning.029", "message": "self-narration opener (cut drafting meta-discourse)", "severity": "warning", "kind": "regex", "pattern": "\\b(this (?:part|section|document) (?:gathers|establishes the)|is stated once, here|is not reproduced here|is not restated here|as (?:mentioned|noted) (?:earlier|above))\\b", "case_insensitive": true},
        {"id": "legal.warning.030", "message": "empty opener", "severity": "warning", "kind": "regex", "pattern": "\\bit is important to note that\\b", "case_insensitive": true},
        {"id": "legal.warning.031", "message": "email throat-clearing", "severity": "warning", "kind": "regex", "pattern": "\\b(I trust this email finds you well|I hope you are well|please be advised|for the avoidance of doubt|kindly|as previously stated|we note with concern|thank you for your understanding|at your earliest convenience)\\b", "case_insensitive": true},
        {"id": "legal.warning.032", "message": "rights-reservation formula (check instruction and legal effect)", "severity": "warning", "kind": "regex", "pattern": "\\b(we reserve all rights|all rights are reserved|without prejudice)\\b", "case_insensitive": true},
        {"id": "legal.warning.033", "message": "dated wording: telephone (prefer phone unless quoted, source-bound, form-field or rule/title wording)", "severity": "warning", "kind": "regex", "pattern": "\\btelephone\\b", "case_insensitive": true},
        {"id": "legal.warning.034", "message": "dated wording: pursuant to (prefer under unless quoted, source-bound, form-field or rule/title wording)", "severity": "warning", "kind": "regex", "pattern": "\\bpursuant to\\b", "case_insensitive": true},
        {"id": "legal.warning.035", "message": "dated wording: prior to (prefer before unless quoted, source-bound or a defined legal phrase)", "severity": "warning", "kind": "regex", "pattern": "\\bprior to\\b", "case_insensitive": true},
        {"id": "legal.warning.036", "message": "dated wording: subsequent to (prefer after unless quoted, source-bound or a defined legal phrase)", "severity": "warning", "kind": "regex", "pattern": "\\bsubsequent to\\b", "case_insensitive": true},
        {"id": "legal.warning.037", "message": "dated wording: whilst (prefer while)", "severity": "warning", "kind": "regex", "pattern": "\\bwhilst\\b", "case_insensitive": true},
        {"id": "legal.warning.038", "message": "dated wording: utilise/utilize (prefer use)", "severity": "warning", "kind": "regex", "pattern": "\\butili[sz]e[sd]?\\b", "case_insensitive": true},
        {"id": "legal.warning.039", "message": "dated wording: furnish/furnished (prefer send, give or provide unless rule-bound)", "severity": "warning", "kind": "regex", "pattern": "\\bfurnish(?:ed|es|ing)?\\b", "case_insensitive": true},
        {"id": "legal.warning.040", "message": "dated wording: hereby/thereof/thereafter (name the act, thing or date)", "severity": "warning", "kind": "regex", "pattern": "\\b(hereby|thereof|thereafter)\\b", "case_insensitive": true},
        {"id": "legal.warning.041", "message": "dated wording: said as adjective (prefer the/that/defined noun)", "severity": "warning", "kind": "regex", "pattern": "\\bthe said\\b|\\bsaid (?:application|affidavit|agreement|amount|appeal|court|decision|document|email|form|hearing|material|order|party|proceeding|request|rule|sum)\\b", "case_insensitive": true},
        {"id": "legal.warning.042", "message": "US prose date", "severity": "warning", "kind": "regex", "pattern": "\\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)[a-z]* \\d{1,2}, \\d{4}\\b", "case_insensitive": false},
        {"id": "legal.warning.043", "message": "US numeric date", "severity": "warning", "kind": "regex", "pattern": "\\b\\d{1,2}/\\d{1,2}/\\d{4}\\b", "case_insensitive": false},
        {"id": "legal.warning.044", "message": "relative date", "severity": "warning", "kind": "regex", "pattern": "\\b(today|yesterday|tomorrow|currently|recently)\\b", "case_insensitive": true},
        {"id": "legal.warning.045", "message": "placeholder", "severity": "warning", "kind": "regex", "pattern": "\\[(?:insert|to come|confirm|check)[^\\]]*\\]", "case_insensitive": true},
        {"id": "legal.warning.046", "message": "possible affidavit advocacy", "severity": "warning", "kind": "regex", "pattern": "\\b(jurisdictional error|plainly wrong|bad faith|abuse of process)\\b", "case_insensitive": true},
        {"id": "legal.warning.047", "message": "emphasis-bolded money amount (do not bold amounts in prose)", "severity": "warning", "kind": "regex", "pattern": "^[^|\\n]*\\*\\*\\$\\d", "case_insensitive": false},
        {"id": "legal.warning.048", "message": "bolded party short-form (define once with single quotes, then plain)", "severity": "warning", "kind": "regex", "pattern": "\\*\\*(?:Mr|Ms|Mrs|Dr|Justice|Adjudicator|Member) [A-Z][a-z]+\\*\\*", "case_insensitive": false},
        {"id": "legal.warning.049", "message": "sub-list marker should be ((a)) / ((i)) form, not 'a.' / 'a)'", "severity": "warning", "kind": "regex", "pattern": "^ {4}[a-z]{1,4}[.\\)]\\s", "case_insensitive": false},
        {"id": "legal.heading-gap", "message": "Heading needs a preceding blank line", "severity": "blocker", "kind": "heading_gap"},
        {"id": "legal.long-sentence", "message": "Sentence exceeds 60 words; review precision and structure", "severity": "warning", "kind": "sentence_words", "words": 60},
        {"id": "legal.comment.1", "message": "Internal leak token in HTML comment: run-dir / audit path", "severity": "blocker", "kind": "comment_regex", "pattern": "\\bdocs/audits/"},
        {"id": "legal.comment.2", "message": "Internal leak token in HTML comment: scratch / build path", "severity": "blocker", "kind": "comment_regex", "pattern": "(?:^|[^A-Za-z.])\\.work/|\\breview_set/|/scratchpad|/private/tmp/"},
        {"id": "legal.comment.3", "message": "Internal leak token in HTML comment: absolute repo path", "severity": "blocker", "kind": "comment_regex", "pattern": "/Users/[^\\s`)>\\]]+"},
        {"id": "legal.comment.4", "message": "Internal leak token in HTML comment: internal task id", "severity": "blocker", "kind": "comment_regex", "pattern": "\\bTASK-[A-Z]+-\\d+\\b"}
      ]
    }
  }
}
