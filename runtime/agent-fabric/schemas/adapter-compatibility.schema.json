{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/agent-fabric/v1/adapter-compatibility.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activation_policy", "adapters"],
  "properties": {
    "schema_version": {"const": 1},
    "activation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real_adapters_require_separate_gate", "default_enabled"],
      "properties": {
        "real_adapters_require_separate_gate": {"const": true},
        "default_enabled": {"const": false},
        "executable_resolution_version": {"const": 2}
      }
    },
    "adapters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/adapter"}
    }
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string"},
        "package": {"type": "string"},
        "command": {"type": "string"},
        "wrapper_entrypoint": {"type": "string", "minLength": 1},
        "executable": {"type": "string"},
        "executable_override": {"type": "string", "pattern": "^/"},
        "cursor_install_root": {"type": "string"},
        "provider_install_root": {"type": "string"},
        "provider_identity": {"enum": ["apple-designated", "cursor-partial-signed-helpers", "owner-controlled-install-root"]}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol"],
      "properties": {
        "protocol": {"type": "string", "minLength": 1}
      }
    },
    "runtimeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms"],
      "properties": {
        "fabric_node": {"type": "string"},
        "upstream_node": {"type": "string"},
        "minimum_macos": {"type": "string"},
        "platforms": {"$ref": "#/$defs/stringArray"}
      }
    },
    "modelConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "requires_explicit_model"],
      "properties": {
        "allowed": {"$ref": "#/$defs/stringArray"},
        "allowed_model_patterns": {"$ref": "#/$defs/stringArray"},
        "requires_explicit_model": {"type": "boolean"},
        "route_role": {"type": "string"}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "delivery_stage", "implementation", "contract", "runtime_range", "model_family_constraints", "official_source_url"],
      "properties": {
        "enabled": {"type": "boolean"},
        "disabled_reason": {"type": "string", "minLength": 1},
        "delivery_stage": {"type": "integer", "minimum": 3, "maximum": 4},
        "implementation": {"$ref": "#/$defs/implementation"},
        "contract": {"$ref": "#/$defs/contract"},
        "runtime_range": {"$ref": "#/$defs/runtimeRange"},
        "model_family_constraints": {"$ref": "#/$defs/modelConstraints"},
        "official_source_url": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {"const": true}
            },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "implementation": {
                "type": "object",
                "properties": {
                  "wrapper_entrypoint": {"type": "string", "minLength": 1},
                  "provider_identity": {"enum": ["apple-designated", "cursor-partial-signed-helpers", "owner-controlled-install-root"]}
                },
                "required": ["wrapper_entrypoint", "provider_identity"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "implementation": {
                "type": "object",
                "properties": {"provider_identity": {"const": "cursor-partial-signed-helpers"}},
                "required": ["provider_identity"]
              }
            }
          },
          "then": {
            "properties": {
              "implementation": {
                "type": "object",
                "properties": {"cursor_install_root": {"type": "string"}},
                "required": ["cursor_install_root"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "implementation": {
                "type": "object",
                "properties": {"provider_identity": {"const": "owner-controlled-install-root"}},
                "required": ["provider_identity"]
              }
            }
          },
          "then": {
            "properties": {
              "implementation": {
                "type": "object",
                "properties": {"provider_install_root": {"type": "string"}},
                "required": ["provider_install_root"]
              }
            }
          }
        }
      ]
    }
  }
}
