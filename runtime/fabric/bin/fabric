#!/bin/sh
# Fabric from a shell. Symlink this onto PATH to run `fabric watch` anywhere.
#
# The working directory selects the repository; its registered worktrees share
# one Fabric project while retaining their own cwd.
set -eu

supported() {
  [ -x "$1" ] && "$1" -e '
    const [major, minor] = process.versions.node.split(".").map(Number);
    process.exit(major === 24 && minor >= 15 ? 0 : 1);
  ' 2>/dev/null
}
range="Node >=24.15.0 and <25"
if [ -n "${FABRIC_NODE:-}" ]; then
  # An explicit choice is used or refused, never silently replaced.
  if ! supported "$FABRIC_NODE"; then
    echo "fabric: FABRIC_NODE=$FABRIC_NODE is not an executable $range. Point it at a supported node, or unset it to search PATH." >&2
    exit 127
  fi
  node=$FABRIC_NODE
else
  node=
  tried=
  for candidate in "$(command -v node 2>/dev/null || true)" /opt/homebrew/bin/node /usr/local/bin/node \
      /usr/bin/node "${HOME:-/nonexistent}/.local/bin/node"; do
    [ -n "$candidate" ] || continue
    if supported "$candidate"; then
      node=$candidate
      break
    fi
    [ ! -e "$candidate" ] || tried="$tried $candidate"
  done
  if [ -z "$node" ]; then
    echo "fabric: requires $range; none found on PATH or in /opt/homebrew/bin, /usr/local/bin, /usr/bin or ~/.local/bin.${tried:+ Unsupported:$tried.} Install Node 24 or set FABRIC_NODE to a supported node binary." >&2
    exit 127
  fi
fi

script_path=$("$node" -e 'process.stdout.write(require("node:fs").realpathSync.native(process.argv[1]))' "$0")
here=$(dirname "$script_path")
package_root=$(cd "$here/.." && pwd)
product_root=${AGENT_FABRIC_PRODUCT_ROOT:-$(cd "$package_root/../.." && pwd)}

loader=${AGENT_FABRIC_TSX_LOADER:-}
if [ -z "$loader" ]; then
  for candidate in \
    "$package_root/node_modules/tsx/dist/loader.mjs" \
    "$package_root/../../tsx/dist/loader.mjs" \
    "$product_root/node_modules/tsx/dist/loader.mjs"; do
    if [ -f "$candidate" ]; then
      loader=$candidate
      break
    fi
  done
fi
if [ ! -f "${loader:-}" ]; then
  echo "fabric: tsx loader not found. Install package dependencies or set AGENT_FABRIC_TSX_LOADER." >&2
  exit 127
fi

exec "$node" --import "$loader" "$package_root/src/cli.ts" "$@"
