#!/bin/sh
# Fabric over MCP. Registered directly in ~/.claude.json and ~/.codex/config.toml.
#
# There is no build step and no install step: this runs the TypeScript source in
# place, so what the agents talk to is what is in the tree.
set -eu

here=$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")
package_root=$(cd "$here/.." && pwd)
product_root=${AGENT_FABRIC_PRODUCT_ROOT:-$(cd "$package_root/../.." && pwd)}

# MCP clients do not always pass a login shell's PATH.
node=${FABRIC_NODE:-$(command -v node 2>/dev/null || true)}
if [ ! -x "${node:-}" ]; then
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
    if [ -x "$candidate" ]; then
      node=$candidate
      break
    fi
  done
fi
if [ ! -x "${node:-}" ]; then
  echo "fabric: no node on PATH. Set FABRIC_NODE to a node binary." >&2
  exit 127
fi

loader=${AGENT_FABRIC_TSX_LOADER:-}
if [ -z "$loader" ]; then
  for candidate in \
    "$package_root/node_modules/tsx/dist/loader.mjs" \
    "$product_root/node_modules/tsx/dist/loader.mjs"; do
    if [ -f "$candidate" ]; then
      loader=$candidate
      break
    fi
  done
fi
if [ ! -f "${loader:-}" ]; then
  echo "fabric: tsx loader not found. Install package dependencies or set AGENT_FABRIC_TSX_LOADER." >&2
  exit 127
fi

exec "$node" --import "$loader" "$package_root/src/server.ts" "$@"
