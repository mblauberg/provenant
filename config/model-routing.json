          "prompt_any": [
            "review",
            "audit"
          ]
        },
        "class": "review"
      },
      {
        "when": {
          "prompt_any": [
            "security",
            "vulnerability",
            "threat model"
          ]
        },
        "class": "critical-review"
      },
      {
        "when": {
          "prompt_any": [
            "migration",
            "schema migration"
          ]
        },
        "class": "implementation"
      },
      {
        "when": {
          "prompt_any": [
            "screenshot",
            "visual compare"
          ]
        },
        "class": "screenshots"
      }
    ],
    "default": "implementation",
    "size_tiers": [
      {
        "name": "small",
        "min_files": 0,
        "min_lines": 0,
        "alias": "junior",
        "effort": "low"
      },
      {
        "name": "medium",
        "min_files": 6,
        "min_lines": 201,
        "alias": "senior",
        "effort": "medium"
      },
      {
        "name": "large",
        "min_files": 21,
        "min_lines": 1001,
        "alias": "principal",
        "effort": "high"
      }
    ],
    "size_table": [
      {
        "label": "small",
        "files": "1-5",
        "lines": "up to 200",
        "alias": "junior",
        "effort": "low"
      },
      {
        "label": "medium",
