{
  "schema_version": 1,
  "catalog_date": "2026-08-22",
  "task_class_routes": {
    "mechanical": {"alias": "scout", "effort": "low", "role": "worker"},
    "legwork": {"alias": "workhorse", "effort": "medium", "role": "worker"},
    "critical-review": {"alias": "flagship", "effort": "high", "role": "critical-review"},
    "orchestration": {"alias": "flagship", "effort": "high", "role": "orchestrator"}
  },
  "families": {
    "anthropic": {
      "aliases": {
        "flagship": ["opus"],
        "workhorse": ["opus", "sonnet"],
        "scout": ["haiku"]
      },
      "role_overrides": {
        "critical-review": {
          "flagship": ["opus"]
        },
        "reviewer": {
          "flagship": ["opus"]
        }
      },
      "risk_tier_overrides": {
        "crucial": {
          "roles": ["synthesis", "adjudication"],
          "alias": "flagship",
          "models": ["fable"],
          "default_effort": "medium",
          "maximum_effort": "medium"
        },
        "terminal": {
          "roles": ["synthesis", "adjudication"],
          "alias": "flagship",
          "models": ["fable"],
          "default_effort": "medium",
          "maximum_effort": "medium"
        }
      }
    },
    "openai": {
      "aliases": {
        "flagship": ["gpt-5.6-sol"],
        "workhorse": ["gpt-5.6-luna", "gpt-5.6-terra"],
        "scout": ["gpt-5.6-luna"]
      },
      "role_overrides": {},
      "role_effort_defaults": {
        "lead": {"flagship": "ultra"},
        "orchestrator": {"flagship": "ultra"},
        "critical-review": {"flagship": "max"},
        "worker": {"workhorse": "high"}
      },
      "ultra_eligible_roles": ["lead", "orchestrator"],
      "effort_fallback_order": ["max", "xhigh", "high", "medium", "low"]
    },
    "google": {
      "aliases": {
        "flagship": ["gemini-3.1-pro"],
        "workhorse": ["gemini-3.7-flash"],
        "scout": ["gemini-3.7-flash"]
      },
      "role_overrides": {},
      "effort_fallback_order": ["high", "medium", "low"],
      "per_model_efforts": {
        "gemini-3.1-pro": ["low", "high"],
        "gemini-3.7-flash": ["low", "medium", "high"],
        "gemini-3.6-flash": ["low", "medium", "high"],
        "gemini-3.5-flash": ["low", "medium", "high"]
      }
    }
  },
  "adapters": {
    "claude": {"endpoint_provider": "anthropic", "fixed_model_family": "anthropic", "effort_transport": "flag"},
    "codex": {"endpoint_provider": "openai", "fixed_model_family": "openai", "effort_transport": "flag"},
    "cursor": {
      "endpoint_provider": "cursor",
      "fixed_model_family": null,
      "effort_transport": "model-id",
      "model_family_preferences": {
        "preferred": ["xai", "cursor-composer"],
        "fallback": {
          "anthropic": "claude",
          "openai": "codex",
          "google": "agy"
        }
      }
    },
    "agy": {
      "endpoint_provider": "agy",
      "fixed_model_family": null,
      "effort_transport": "flag",
      "model_family_preferences": {
        "preferred": ["google", "anthropic"],
        "fallback": {}
      }
    },
    "copilot": {"endpoint_provider": "github", "fixed_model_family": null, "effort_transport": "flag"},
    "kiro": {"endpoint_provider": "aws", "fixed_model_family": null, "effort_transport": "flag"},
    "opencode": {"endpoint_provider": "opencode", "fixed_model_family": "generic-open", "effort_transport": "flag"},
    "pi": {"endpoint_provider": "configured", "fixed_model_family": null, "effort_transport": "none"}
  },
  "model_patterns": [
    {"pattern": "^opencode/", "family": "generic-open"},
    {"pattern": "claude|fable|opus|sonnet|haiku", "family": "anthropic"},
    {"pattern": "gpt|codex|^o1|^o3|^o4", "family": "openai"},
    {"pattern": "gemini", "family": "google"},
    {"pattern": "grok", "family": "xai"},
    {"pattern": "composer", "family": "cursor-composer"},
    {"pattern": "deepseek", "family": "deepseek"},
    {"pattern": "minimax", "family": "minimax"},
    {"pattern": "qwen", "family": "alibaba"},
    {"pattern": "kimi", "family": "moonshot"},
    {"pattern": "glm", "family": "zhipu"},
    {"pattern": "mistral|mixtral", "family": "mistral"},
    {"pattern": "llama", "family": "meta"}
  ]
}
